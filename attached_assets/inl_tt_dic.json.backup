    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "inova",
    "class": "Verbu",
    "meaning": "Hatama buat ka elementu foun ruma, haseluk ka muda sasán tuan ka baibain nian. Sin. hakfoun"
  },
  {
    "word": "inovadór - inovadora",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé bele hafoun ka hamosu hanoin ka buat foun ida. Sin. makfoun Substantivu Ema ne'ebé iha jeitu atu hamosu buat foun ida."
  },
  {
    "word": "inovasaun",
    "class": "Substantivu",
    "meaning": "1. Hahalok hafoun ka hamosu buat foun ida. Sin. hakfoun 2. Buat, prátika ka kostume foun."
  },
  {
    "word": "inova",
    "class": "Verbu",
    "meaning": "; Sin. hakfoun"
  },
  {
    "word": "insatisfatóriu - insatisfatória",
    "class": "f. Adjetivu",
    "meaning": "1. Ne'ebé la fó satisfasaun. 2. Neʼebé la natoon ka la to'o."
  },
  {
    "word": "insatisfeitu - insatisfeita",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé la iha satisfasaun, la kontente ho buat ka situasaun ida."

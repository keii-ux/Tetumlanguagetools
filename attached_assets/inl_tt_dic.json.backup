  {
    "word": "Filipinas, (rai-)",
    "class": "Substantivu",
    "meaning": "Nusa-lubun no nasaun ida iha Ázia Sudeste."
  },
  {
    "word": "filipinu - filipina",
    "class": "f. Adjetivu",
    "meaning": "Rai-Filipinas nian, kona-ba rai- Filipinas. Lia-filipinu ne'e naran neʼebé governu Filipinas fó ba liatagalu. Substantivu Ema Filipinas."
  },
  {
    "word": "Fillu",
    "class": "Substantivu",
    "meaning": "Oan-Mane, hodi refere de'it ba Jezús Kristu nu'udar Maromak Nia Oan. Ez. Hodi Padre, hodi Fillu, hodi Espíritu Santu Sira naran."
  },
  {
    "word": "filma",
    "class": "Verbu",
    "meaning": "Hasai filme ho kámara ka mákina filme nian. Ez. Turista sira gosta filma serimónia oioin neʼebé sira tuir iha rai-Timór."
  },
  {
    "word": "filme",
    "class": "Substantivu",
    "meaning": "Imajen moris tuituir malu neʼebé hatudu iha televizaun ka sinema, hodi hato'o istória ka dokumentáriu. Ez. Tinan-tinan governu hatudu filme ida kona-ba Masakre Santa Krús neʼebé ako-ntese iha loron 12 fulan- Novembru 1991."
  },
  {
    "word": "filozofia",
    "class": "Substantivu",
    "meaning": "1. Matenek kona-ba prinsípiu jerál sira iha ita ema nia ha-noin. Filozofia ne'e matenek naturál ema sira-nian, la'ós matenek sobre-naturál neʼebé Maromak de'it mak haraik ba ita ema. 2. Prinsipiu sira konaba moris neʼebé ema ida halo tuir. Ez. Seminarista sira estuda filozofia iha semináiru."
  },
  {
    "word": "filózofu - filózofa",
    "class": "f. Substantivu",
    "meaning": "1. Ema peritu iha área filozofia. Ez. Ema matenek sira konsidera Sókrates nu'udar filózofu boot ida. 2. Ema neʼebé hanoin ho kle'an kona-ba mundu no moris."
  },
  {
    "word": "filtra",
    "class": "Verbu",
    "meaning": "Halo been, substánsia seluk, naroman ka son ida liu hosi filtru."
  },
  {
    "word": "filtru",
    "class": "Substantivu",
    "meaning": "Instrumentu ida hanesan tata'es neʼebé husik substánsia balu liu, no ta'es fali substánsia seluseluk. Sin. kata'es Ez. Karreta balun iha filtru atubele filtra mina ne'ebé enxe ba tanke karreta nian."
  },
  {
    "word": "finál",
    "class": "Adjetivu",
    "meaning": "Ikus nian. Sin. dahikus Ez. Ezame finál sei haldo iha fulan-Maiu. Substantivu 1. Atu be dahikus iha rep-rezentasaun teatru nian. 2. (desportu) Jogu dahikus."
  },
  {
    "word": "finansa",
    "class": "Substantivu",
    "meaning": "1. Osan neʼebé uza hodi halo ka selu buat ida. 2. Knaarkaatividade habarak osan nian, liuhosi empresta no investimentu."
  },
  {
    "word": "finanseiru - finanseira",
    "class": "f. Adjetivu",
    "meaning": "Finansas nian, kona-ba osan. Substantivu Ema ida neʼebé matenek finansas no mós hatene habarak osan."
  },
  {
    "word": "finansia",
    "class": "Verbu",
    "meaning": "Fó osan ba knaar ka projetu ruma. Ez. Governu Japonés maka sei fin-ansia reabilitasaun uma Fakuldade-En-jeñaria nian."
  },
  {
    "word": "fini",
    "class": "Substantivu",
    "meaning": "Musan ka parte ida hosi planta ida neʼebé uza hodi kuda ai-horis foun ida. Ez. Ita presiza buka batar-musan di'aknu'udarfiniatu kudaihatempuudan."
  },
  {
    "word": "finje",
    "class": "Verbu",
    "meaning": "Habosok hodi halo hanesan buat ruma loos ka tebes bainhira buat ne'e afinál la nune'e. Sin. hakfudik. Ez. Tan kolega nee baruk-teen, nia finje moras atu bele deskansa iha uma."
  },
  {
    "word": "Finlandia, (rai-)",
    "class": "Substantivu",
    "meaning": "Rain ida iha Europa Norte."
  },
  {
    "word": "finlandés - finlandeza",
    "class": "f. Adjetivu",
    "meaning": "Rai-Fin-lándia nian; hosi rai- Finlandia. Sub-stantivu Ema Finlandia."
  },
  {
    "word": "finta",
    "class": "Substantivu",
    "meaning": "Hahalok ida atu habosok de'it. Sin. lohin, lalohik, babutar Verbu Habosok, liuliu atu halo ema susar tuir ita. Ez. Maradona jogadór ida ne'ebé finta maka'as tanba ne'e susar atu ema hadau bola hosi nia ain."
  },
  {
    "word": "firaku",
    "class": "Substantivu",
    "meaning": "Ema hosi parte lorosa'e Timór nian, makdalek fataluku, makasae ka kawaimina (kairui, waimaʼa, midiki, naueti). Liafuan ne'e mai hosi espresaun makasae fi raku 'ita maluk'."
  },
  {
    "word": "fiskál",
    "class": "Adjetivu",
    "meaning": "1. Fisku nian, kona-ba fisku. 2. Kona-ba finansas, finansas nian. Sin. finanseiru Ez. Ita-nia tinan fiskál hahú iha fulan-Jullu. Substantivu Supervizór ka ofisiál alfándega nian."
  },
  {
    "word": "fiskaliza",
    "class": "Verbu",
    "meaning": "Hala’o funsaun fiskál nian; superviziona ka halo inspesaun. Ez. Governu mak fiskaliza ekonomia rai-Timór nian."
  },
  {
    "word": "fisku",
    "class": "Substantivu",

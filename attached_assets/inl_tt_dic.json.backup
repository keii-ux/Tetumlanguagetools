    "word": "feto-bikan",
    "class": "",
    "meaning": "haree fetoaat"
  },
  {
    "word": "feto-faluk",
    "class": "Substantivu",
    "meaning": "Feto ka feen neʼebé nia la'en mate hela tiha. Ez. Feto-faluk barak tenke hetan tulun hosi governu tanba sira-nia la'en mate durante rez-isténsia nuʼudar asua'in."
  },
  {
    "word": "feto-foun",
    "class": "Substantivu",
    "meaning": "Oan-mane nia feen. Liafuan-sorun: banin-feto"
  },
  {
    "word": "fetok",
    "class": "Adjetivu",
    "meaning": "1. Feto nian, kona-ba feto, neʼebé pertense ba seksu ida neʼebé bele iha oan. Sin. inak 2. (Mane) neʼebé halo an hanesan feto."
  },
  {
    "word": "feto-kait",
    "class": "Substantivu",
    "meaning": "Feto ida neʼebé mane ida hadomi no hala'o relasaun seksuál ho nia, maibé la’ós nia feen. Sin. amante, fetonona, kamarua, kait"
  },
  {
    "word": "feto-klosan",
    "class": "Substantivu",
    "meaning": "Feto neʼebé seidauk kaben. Sin. feto-raan"
  },
  {
    "word": "feto-lurón",
    "class": "Substantivu",
    "meaning": "Feto neʼebé simu osan hodi entrega nia an ba mane sira nu'udar objetu seksuál. Sin. prostituta"
  },
  {
    "word": "feto-manas",
    "class": "",
    "meaning": "haree fetoaat"
  },
  {
    "word": "feton",
    "class": "Substantivu",
    "meaning": "Mane ida nia alin-feto ka prima."
  },
  {
    "word": "feto-nona",
    "class": "Substantivu",
    "meaning": "1. Feto ida neʼebé mane ida hadomi no hala'o relasaun seksuál ho nia, maibé la'ós nia feen. Sin. amante, kamarua, feto-kait, kait2. Feto neʼebé simu osan hodi entrega nia an ba mane sira nu'udar objetu seksuál. Sin. feto-lurón, prostituta"
  },
  {
    "word": "feto-oan",
    "class": "Substantivu",
    "meaning": "Feto neʼebé tinan na-toon hela ka sei ki'ik. Ez. Feto-oan nain-rua simu no tara ai-funan ba liurai nia kakorok."
  },
  {
    "word": "feto-raan",
    "class": "Substantivu",
    "meaning": "Feto neʼebé sei klosan no seidauk kaben. Sin. virjen Ez. Feto-raan no maneklosan barak mak gosta bá festa."
  },
  {
    "word": "feto uma-laran",
    "class": "Substantivu",
    "meaning": "Feto neʼebé ser-bisu ba umakain ka família ida."
  },
  {
    "word": "fetosaa",
    "class": "Substantivu",
    "meaning": "Família feto nianka noiva nian. Ez. Fetosaa sira lori fahi bainhira bá mate-uma hosi família mane nian."
  },
  {
    "word": "Fevereiru, (fulan-)",
    "class": "Substantivu",
    "meaning": "Fulan daruak tinan nian neʼebé tuir Janeiru no uluk-ba Marsu."
  },
  {
    "word": "fexu-eklér",
    "class": "Substantivu",
    "meaning": "Korrente neʼebé suku hamutukhohena, kulitka plástiku neʼebé baibain ema tau iha faru, kalsa ka botas."
  },
  {
    "word": "fiadór",
    "class": "Substantivu",
    "meaning": "Ema ka grupu ida neʼebé fó apoiu liuliu osan ka matéria ruma atu ida neʼebé hetan tulun ne'e bele uza hodi avansa ba oin."
  },
  {
    "word": "fiambre",
    "class": "Substantivu",
    "meaning": "Na'an-fahi neʼebé baibain hasai hosi fahi nia kelen."
  },
  {
    "word": "fiansa",
    "class": "Substantivu",
    "meaning": "Osan neʼebé ema duun ka akuzadu (ka nia família ka kolega) selu ba tribunál atu lalika dadur to'o nia prosesu hahú. Sin. osanhametin"
  },
  {
    "word": "fiar",
    "class": "Verbu",
    "meaning": "1. Hanoin katak buat ruma loos duni. Ez. Ha'u fiar Kristu nu'udar hau-nia maksoin. 2. Hanoin katak buat neʼebé ema ruma dehan ne'e loos. Ez. Ami ladún fiar buat ne'ebé sira dehan. Substantivu 1. Hanoin metin kona-ba buat ruma, liuliu katak buat ne'e loos. 2. Prinsípiu sira neʼebé forma sistema relijiaun ka moralidade nian. 3. Hahalok rona no halo tuir buat neʼebé ema ida dehan ka haruka."
  },
  {
    "word": "fiar-laek",
    "class": "Adjetivul Substantivu",
    "meaning": "1. (Neʼebé) la iha fiar. 2. (Neʼebé) la tuir relijiaun ida. Ez. Bainhira komunista sira ukun rai-Rúsia, ema barak maka fiar-laek."
  },
  {
    "word": "fiar-fraku",
    "class": "Adjetivul Substantivu",
    "meaning": "(Kualidade ema) neʼebé beik uitoan tanba fiar buat hotu neʼebé ema seluk dehan, maski bele laloos. Sin. krédulu"
  },
  {
    "word": "fiar-metin",
    "class": "Adjetivul Substantivu",
    "meaning": "(Neʼebé) hakru'uk hodi halo tuir buat neʼebé ema ida haruka atu halo; neʼebé depende ba ema seluk."
  },
  {
    "word": "fiar-na'in",
    "class": "Adjetivu",
    "meaning": "Neʼebé iha fiar. Substan-tivu Ema neʼebé fiar sistema relijiaun ida."
  },
  {
    "word": "fibra",
    "class": "Substantivu",
    "meaning": "1. Lahan mihis iha ai nia laran (n.e. tali-metan) selae iha fulun laran, neʼebé uza atu halo henahatais no sasán seluseluk. 2. Parte hosi planta ida neʼebé ita bele han maibé la bele di-jere fibra ne'e tulun ai-han atu liu lailais hosi kabun-laran no teeoan."
  },
  {
    "word": "fibradevidru",
    "class": "Substantivu",
    "meaning": "Vidru neʼebé toos no tahan hasoru nakfera."
  },
  {
    "word": "figu",
    "class": "Substantivu",
    "meaning": "Ai-fuan mamar no midar ho isinkór-rozaneʼebénakonuhomusanki'ik."
  },
  {
    "word": "figura",
    "class": "Substantivu",
    "meaning": "1. Isin-lolon nia ilas, imajen ka forma li'ur nian; 2. Ema ka buat nia feisaun ka karakterístika sira. Sin. personalidade; 3. Ema importante. Sin. personalidade; 4. Símbolu ka sinál. Sin. tadak; 5. Dezeñu ka ilustrasaun. Sin. hatuin"
  },
  {
    "word": "figuraun",
    "class": "Substantivu",
    "meaning": "1. Ema importante ka naranboot; 2. (pejorativu) ema boot neʼebé gosta loko an."
  },
  {
    "word": "fihir",
    "class": "Verbu",
    "meaning": "1. Haree didi'ak. Sin. lehat, ezamina 2. Hili depoizde haree didi'ak. Ez. Povu tenke fihir didi'ak sé mak bele sai sira-nia ulun-boot. 3. Hateke maran ba ema ka buat ida."
  },
  {
    "word": "fiksaun",
    "class": "Substantivu",
    "meaning": "Istória konaba ema ka akontesimentu ida ne'ebé imajináriu de'it."
  },
  {
    "word": "fiktivu - fiktiva",
    "class": "f. Adjetivu",
    "meaning": ""
  },
  {
    "word": "fila",
    "class": "Verbu",
    "meaning": "1. Muda diresaun, halaʼo ba sorin, ba leten, ba kraik nst. 2. Kedok (hahán ruma) iha taxu laran atu labele motuk ka maran tiha. 3. La'o fali ba fatin uluk nian. buat belak ida hosi kraik ba fila, Substantivu Liña, latar. Ez. Sira forma iha fila rua."
  },
  {
    "word": "filafali",
    "class": "Advérbiu",
    "meaning": "Dala ida tan. Sin. filahikas Ez. Ami halo filafali uma ne'e tanba nia kondisaun ladún diak ona."
  },
  {
    "word": "filan",
    "class": "Substantivu",
    "meaning": "Hahalok fila dala ida. Ad-jetivu Neʼebé ema fila tiha ona."
  },
  {
    "word": "Filipinas, (rai-)",
    "class": "Substantivu",
    "meaning": "Nusa-lubun no nasaun ida iha Ázia Sudeste."
  },
  {
    "word": "filipinu - filipina",
    "class": "f. Adjetivu",
    "meaning": "Rai-Filipinas nian, kona-ba rai- Filipinas. Lia-filipinu ne'e naran neʼebé governu Filipinas fó ba liatagalu. Substantivu Ema Filipinas."
  },
  {
    "word": "Fillu",
    "class": "Substantivu",
    "meaning": "Oan-Mane, hodi refere de'it ba Jezús Kristu nu'udar Maromak Nia Oan. Ez. Hodi Padre, hodi Fillu, hodi Espíritu Santu Sira naran."
  },
  {
    "word": "filma",
    "class": "Verbu",
    "meaning": "Hasai filme ho kámara ka mákina filme nian. Ez. Turista sira gosta filma serimónia oioin neʼebé sira tuir iha rai-Timór."
  },
  {
    "word": "filme",
    "class": "Substantivu",
    "meaning": "Imajen moris tuituir malu neʼebé hatudu iha televizaun ka sinema, hodi hato'o istória ka dokumentáriu. Ez. Tinan-tinan governu hatudu filme ida kona-ba Masakre Santa Krús neʼebé ako-ntese iha loron 12 fulan- Novembru 1991."
  },
  {
    "word": "filozofia",
    "class": "Substantivu",
    "meaning": "1. Matenek kona-ba prinsípiu jerál sira iha ita ema nia ha-noin. Filozofia ne'e matenek naturál ema sira-nian, la'ós matenek sobre-naturál neʼebé Maromak de'it mak haraik ba ita ema. 2. Prinsipiu sira konaba moris neʼebé ema ida halo tuir. Ez. Seminarista sira estuda filozofia iha semináiru."
  },
  {
    "word": "filózofu - filózofa",
    "class": "f. Substantivu",
    "meaning": "1. Ema peritu iha área filozofia. Ez. Ema matenek sira konsidera Sókrates nu'udar filózofu boot ida. 2. Ema neʼebé hanoin ho kle'an kona-ba mundu no moris."
  },
  {
    "word": "filtra",
    "class": "Verbu",
    "meaning": "Halo been, substánsia seluk, naroman ka son ida liu hosi filtru."
  },
  {
    "word": "filtru",
    "class": "Substantivu",
    "meaning": "Instrumentu ida hanesan tata'es neʼebé husik substánsia balu liu, no ta'es fali substánsia seluseluk. Sin. kata'es Ez. Karreta balun iha filtru atubele filtra mina ne'ebé enxe ba tanke karreta nian."
  },
  {
    "word": "finál",
    "class": "Adjetivu",
    "meaning": "Ikus nian. Sin. dahikus Ez. Ezame finál sei haldo iha fulan-Maiu. Substantivu 1. Atu be dahikus iha rep-rezentasaun teatru nian. 2. (desportu) Jogu dahikus."
  },
  {
    "word": "finansa",
    "class": "Substantivu",
    "meaning": "1. Osan neʼebé uza hodi halo ka selu buat ida. 2. Knaarkaatividade habarak osan nian, liuhosi empresta no investimentu."
  },
  {
    "word": "finanseiru - finanseira",
    "class": "f. Adjetivu",
    "meaning": "Finansas nian, kona-ba osan. Substantivu Ema ida neʼebé matenek finansas no mós hatene habarak osan."
  },
  {
    "word": "finansia",
    "class": "Verbu",
    "meaning": "Fó osan ba knaar ka projetu ruma. Ez. Governu Japonés maka sei fin-ansia reabilitasaun uma Fakuldade-En-jeñaria nian."
  },
  {
    "word": "fini",
    "class": "Substantivu",
    "meaning": "Musan ka parte ida hosi planta ida neʼebé uza hodi kuda ai-horis foun ida. Ez. Ita presiza buka batar-musan di'aknu'udarfiniatu kudaihatempuudan."
  },
  {
    "word": "finje",
    "class": "Verbu",
    "meaning": "Habosok hodi halo hanesan buat ruma loos ka tebes bainhira buat ne'e afinál la nune'e. Sin. hakfudik. Ez. Tan kolega nee baruk-teen, nia finje moras atu bele deskansa iha uma."
  },
  {
    "word": "Finlandia, (rai-)",
    "class": "Substantivu",
    "meaning": "Rain ida iha Europa Norte."
  },
  {
    "word": "finlandés - finlandeza",
    "class": "f. Adjetivu",
    "meaning": "Rai-Fin-lándia nian; hosi rai- Finlandia. Sub-stantivu Ema Finlandia."
  },
  {
    "word": "finta",
    "class": "Substantivu",
    "meaning": "Hahalok ida atu habosok de'it. Sin. lohin, lalohik, babutar Verbu Habosok, liuliu atu halo ema susar tuir ita. Ez. Maradona jogadór ida ne'ebé finta maka'as tanba ne'e susar atu ema hadau bola hosi nia ain."
  },
  {
    "word": "firaku",
    "class": "Substantivu",
    "meaning": "Ema hosi parte lorosa'e Timór nian, makdalek fataluku, makasae ka kawaimina (kairui, waimaʼa, midiki, naueti). Liafuan ne'e mai hosi espresaun makasae fi raku 'ita maluk'."
  },
  {
    "word": "fiskál",
    "class": "Adjetivu",
    "meaning": "1. Fisku nian, kona-ba fisku. 2. Kona-ba finansas, finansas nian. Sin. finanseiru Ez. Ita-nia tinan fiskál hahú iha fulan-Jullu. Substantivu Supervizór ka ofisiál alfándega nian."
  },
  {
    "word": "fiskaliza",
    "class": "Verbu",
    "meaning": "Hala’o funsaun fiskál nian; superviziona ka halo inspesaun. Ez. Governu mak fiskaliza ekonomia rai-Timór nian."
  },
  {
    "word": "fisku",
    "class": "Substantivu",
    "meaning": "Parte hosi administrasaun públika neʼebé kobra impostu sira hosi populasaun."
  },
  {
    "word": "fisur",
    "class": "Substantivu",
    "meaning": "Musan bubu neʼebé mosu iha kulit, nakonu ho raan-mutin bain-hira tasak."
  },
  {
    "word": "fita",
    "class": "Substantivu",
    "meaning": "Hena ka surat-tahan neʼebé uza atu hametin ka nuʼudar dekorasaun. Halo fita katak dada lia ka hamaus ema ruma ho intensaun atu atrai ema ne'e."
  },
  {
    "word": "fita-kola",
    "class": "Substantivu",
    "meaning": "Plástikutahan mihis ho goma neʼebé ema uza atu hametin buat ruma selae atu tutan surattahan ruma."
  },
  {
    "word": "fita métrika",
    "class": "Substantivu",
    "meaning": "Fita ida neʼebé ema uza atu sukat sasán nia naruk, liuliu hena no mobília. Ez. Ha'u-nia amá uza fita métrika atu sukat aminia roupa bain-hira nia suku."
  },
  {
    "word": "fitar",
    "class": "Substantivu",
    "meaning": "Kanek-fatin neʼebé iha isin."
  },
  {
    "word": "fitun",
    "class": "Substantivu",
    "meaning": "1. Bola ahi boboot neʼebé fó naroman no ita bele haree iha lale-hankalan. Loromatan neʼebé ita haree iha lalehan-loron afinál fitun ida. 2. Forma ida ho pontu lima, hanesan fitun nabilan. 3. Atór, múziku ka jogadór di'ak ida ho naran-boot. Sin. estrela Ez. Carmen Miranda, atrís ida neʼebé moris iha Portugál no hela kleur iha rai-Brazíl, sai mós fitun-sinema iha Hollywood."
  },
  {
    "word": "fitun-libur",
    "class": "Substantivu",
    "meaning": "Fitun lubun ida ka liu neʼebé astrónomu sira tada. Sin. konstelasaun"
  },
  {
    "word": "fiu",
    "class": "Substantivu",
    "meaning": "Tali mihis ida, dala barak hosi arame ka plástiku. Fiu elétriku uza atu korrente eletrisidade nian bele liu."
  },
  {
    "word": "fivela",
    "class": "Substantivu",
    "meaning": "Besi ida neʼebé hametin iha tali ka futu-kabun nia rohan."
  },
  {
    "word": "fixa",
    "class": "Substantivu",
    "meaning": "1. Forma ida atu ita bele prenxe.Sin. formuláriu, surat2. Kartaun."
  },
  {
    "word": "fixeiru",
    "class": "Substantivu",
    "meaning": "1. Gaveta ka kaixa neʼebé ema uza atu rai fixa sira. 2. Dokumentu ida neʼebé haruka liuhosi surat ka kor-reiu eletróniku."
  },
  {
    "word": "fíziku - fízika",
    "class": "f. Adjetivu",
    "meaning": "Kona-ba isin ka buat materiál neʼebé ita bele kaer. Ez. Ema tenke halo ezersisiu fíziku tanba ida-nee importante ba saúde. Substan-tivu Ema nia isinlolon. Ez. Filipe nia fíziku kapás loos, hanesan atleta ninian."
  },
  {
    "word": "fízika",
    "class": "Substantivu",
    "meaning": "Estudu sientífiku kona-ba flamenga forsa naturál sira, porezemplu manas, naroman, son no eletrisidade."
  },
  {
    "word": "flamengu-flamenga",
    "class": "f. Adjetivu",
    "meaning": "Rai-Flandres nian, kona-ba rai- Flandres. Substantivu Ema Flandres."
  },
  {
    "word": "flamingu, (manu-)",
    "class": "Substantivu",
    "meaning": "Manu ain-naruk ida rai-Áfrika nian, hanesan mal-iboo, ho fulun kórroza no mutin."
  },
  {
    "word": "Flandres, (rai-)",
    "class": "Substantivu",
    "meaning": "Rai-Béljika nia parte norte, ho populasaun ne'ebé ko'alia lia-olandés."
  },
  {
    "word": "flanela",
    "class": "Substantivu",
    "meaning": "Henaalgodaun mahar oin ida, hanesan bibifulun."
  },
  {
    "word": "flauta",
    "class": "Substantivu",
    "meaning": "Instrumentu muzikál anin nian, halo hosi besi-asu, neʼebé ema kaer iha parte sorisorin no tau iha ibun hodi huu. Sin. kafu'i-malae"
  },
  {
    "word": "fláx",
    "class": "Substantivu",
    "meaning": "Naroman lais neʼebé mákina fotográfika halo molok atu hasai retratu."
  },
  {
    "word": "fleksivel",
    "class": "Adjetivu",
    "meaning": "Neʼebé fasil atu adapta ba situasaun ka kondisaun foun ida. Ez. Ita tenke fleksivel, selae susar atu komprende ema seluk."
  },
  {
    "word": "fleksibilidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "flora",
    "class": "Substantivu",
    "meaning": "Konjuntu planta ka ai-horis sira neʼebé moris iha rairohan ka rejiaun ida. Sin. ai-funan libur"
  },
  {
    "word": "florál",
    "class": "Adjetivu",
    "meaning": "Ai-funan nian, kona-ba ai-funan. Sin. funak"
  },
  {
    "word": "floreanu - floreana",
    "class": "f. Adjetivu",
    "meaning": "Rai-Flores nian, kona-ba rai-Flores. Substantivu Ema Flores. Ez. Floreanu sira barakliu katóliku no sira-nia rain horiuluk Por-tugés sira mak ukun, hanesan rai- Timór."
  },
  {
    "word": "Flores, (rai-)",
    "class": "Substantivu",
    "meaning": "Illa ida Repúblika Indonézia nian horik entre rai- Sum-bawa no rai- Timór."
  },
  {
    "word": "florikultura",
    "class": "Substantivu",
    "meaning": "Serbisu ka indústria kuda no kultiva ai-funan atu faan."
  },
  {
    "word": "florista",
    "class": "Substantivu",
    "meaning": "1. Ema neʼebé kuda no fa'anai-funan.2.Lojaneʼebéfa'anaifunan."
  },
  {
    "word": "fó",
    "class": "Verbu",
    "meaning": "1. Lolo ka entrega buat ida ba ema seluk. 2. Baku ho liman ka arma ruma. 3. Husik, fó lisensa."
  },
  {
    "word": "fó-agradese",
    "class": "Verbu",
    "meaning": "Hato'o obrigadu ka agradesimentu. Sin. fó neon Ez. Estu-dante sira fó-agradese mestre neʼebé ha-norin sira ba tinan sanulu ona."
  },
  {
    "word": "fo'at",
    "class": "Verbu",
    "meaning": "Kesi ho tali hanesan lasu hodi halo metin."
  },
  {
    "word": "fó-bandu",
    "class": "Verbu",
    "meaning": "Hanetik atu labele halo ka uza. Sin. bandu Ez. Governu fó-bandu kriminozu sira atu tama rai-Timór."
  },
  {
    "word": "fó-empresta",
    "class": "Verbu",
    "meaning": "Fó ba ema ida buat ida neʼebé nia bele uza maibé tenke fó filafali iha loron ida. Ez. Banku fó-empresta osan ba komersiante sira neʼebé hakarak loke kioske."
  },
  {
    "word": "fo'er",
    "class": "Adjetivu",
    "meaning": "1. Neʼebé la moos tanba iha marka, hanesan taho, rairahun, nst. Sin. door Ez. Molok han etu, ita tenke fase ita-nia liman neebé fo'er. Liafuan-sorun: moos 2. (Hahalok ka atitude) neʼebé la'ós di'ak, laiha onestidade. Sin. imorál Ez. Keta hili sira ne'ebé fo'er ba governu tanba korrupsaun bele sai buras. Substantivu Buat neʼebé la moos no la di'ak ba ema nia saúde."
  },
  {
    "word": "fogaun",
    "class": "Substantivu",
    "meaning": "Aparellu dapur nian neʼebé ita uza hodi te’in, lao ho eletrisi-dade, mina-rai ka gás."
  },
  {
    "word": "fogetaun",
    "class": "Substantivu",
    "meaning": "Veíkulu boboot ida ho forma hanesan tubu ho tutun meik neʼebé gás manas hasemo hodi tuda sa'e ba lalehan."
  },
  {
    "word": "fogete",
    "class": "Substantivu",
    "meaning": "Ahi artifisiál ida hanesan painxón neʼebé ema tiru no baibain nak-fera iha lalehan. Fogete bele uza nu'usar sinál, no mós iha festa. Fogetefesta sira halo naroman furak ho kór oioin."
  },
  {
    "word": "fó-han",
    "class": "Verbu",
    "meaning": "1. Lolo ka fornese ai-han atu ema ka balada sira bele han. Ez. Governu tenke fó-han populasaun tanba foos la to'o. 2. Hatama ai-han ba ema seluk nia ibun laran, liuliu labarik ki'ik ka ema-moras. Ez. Inan sira tenke fó-han sira-nia bebé ho ai-han neebé diak."
  },
  {
    "word": "fó-hanoin",
    "class": "Verbu",
    "meaning": "Boot ka sadik ema ida nia memória atu nia bele hanoin-hetan. Ez. Kór-metan fó-hanoinlutu."
  },
  {
    "word": "fó-haree",
    "class": "Verbu",
    "meaning": "Hatudu ba ema barak ka públiku. Ez. Feira Luzófona fóharee livru oioin hosi nasaun dalen-portugés sira."
  },
  {
    "word": "fó-hariis",
    "class": "Verbu",
    "meaning": "Fase ema ida nia isin tomak ho bee atubele sai moos, liuliu bebé no labarik sira. Ez. Inan sira fó-hariis sira-nia bebé ho bee morna."
  },
  {
    "word": "fó-hatene",
    "class": "Verbu",
    "meaning": "Hato'o ka informa atu ema seluk bele hatene mós. Ez. Governu fó-hatene populasaun atu keta soe fo'er iha mota laran."
  },
  {
    "word": "fó-hemu",
    "class": "Verbu",
    "meaning": "1. Lolo ka fornese bee ba ema ka balada. Ez. Bibi-atan neʼebé diak maka ida neʼebé buka bee-matan atu fóhemu nia balada sira. 2. Fó tua ka hemun alkóliku neʼebé bele halo ema ida sai lanu. Ez. Keta fó-hemu demais tiu Xiku tanba nia bele sai lanu."
  },
  {
    "word": "foho",
    "class": "Substantivu",
    "meaning": "1. Rai ka laletek ida neʼebé aas liu. Ez. Foho neebé aas liu hotu iha Timór Lorosa'e maka Ramelau. 2. Zona neʼebé li'ur no dook hosi sidade, zona rurál. Sin. interiór, ailaran Ez. Modo sira baratu liu iha foho duké iha sidade."
  },
  {
    "word": "Foho-",
    "class": "Prefiksu",
    "meaning": "Liafuan matadak neʼebé forma foho ida nia naran, hamriik uluik-ba Substantivu epítetu ida, n.e. Foho- Ramelau, Foho-Evereste. Bain-hira ita haktemik foho-kadoek ida, ita uza fali prefiksu Fohor-"
  },
  {
    "word": "foho-kadoek",
    "class": "Substantivu",
    "meaning": "Foho barak rabat malu hodi forma latar ka liña ida."
  },
  {
    "word": "foho-leet",
    "class": "Substantivu",
    "meaning": "Rai-tetuk kloot ka luan iha foho rua nia leet; baibain iha mota ka mota-oan neʼebé suli iha klaran."
  },
  {
    "word": "fohor",
    "class": "Substantivu",
    "meaning": "PluráltuanhosiSubstantivu foho, katak 'foho sira'."
  },
  {
    "word": "Fohor-",
    "class": "Prefiksu",
    "meaning": "Liafuan matadak neʼebé forma fohokadoek ida nia naran, hamriik uluk-ba Substantivu epítetu ida, n.e. Fohor-Pireneus, Fohor-Alpes, Foho-Andes."
  },
  {
    "word": "Fohoreen",
    "class": "Substantivu",
    "meaning": "Zona no subdistritu besik Suai iha parte loromonu rai-Timór Lorosa'e nian."
  },
  {
    "word": "foho-tutun",
    "class": "Substantivu",
    "meaning": "Fatin aas liu iha foho ida nia leten."
  },
  {
    "word": "fohorai",
    "class": "Substantivu",
    "meaning": "Samea ida neʼebé bele oho balada sira seluk ho maneira bobar ka le'u nia isin hadulas balada neʼebé nia oho to'o balada ne'e la bele dada iis hodi mate."
  },
  {
    "word": "foin",
    "class": "Advérbiu",
    "meaning": "Tempu uitoan de'it liubá, seidauk kleur. Ez. Ami foin koalia ho ema ne'ebé uluk halo mobiliáriu ba ami-nia oan sira."
  },
  {
    "word": "foin-sa'e",
    "class": "Substantivu",
    "meaning": "Ema tinan natoon hela, neʼebé seidauk kaben. Sin. joven, adolexente Ez. Foin-sae sira barak mak gosta liu festa duké serbisu."
  },
  {
    "word": "foit",
    "class": "Substantivu",
    "meaning": "Hena-hafunan naruk ida, dala barak ho ilas ka dezeńu. Sin. listra"
  },
  {
    "word": "fokal",
    "class": "Verbu",
    "meaning": "Halo sai foku, fó atensaun maka'as ba buat ka ema ruma."
  },
  {
    "word": "foka2",
    "class": "Substantivu",
    "meaning": "Balada maksusuk ida hanesan asu fulun-laek neʼebé gosta luku tasi no horik iha rai sira ho klima malirin."
  },
  {
    "word": "fokar",
    "class": "Substantivu",
    "meaning": "Bubu-oan ho been neʼebé mosu iha isin tanba ahi han ka manas. Verbu Sai bubu ho been. Sin. nakfokar"
  },
  {
    "word": "foke1",
    "class": "Verbu",
    "meaning": "(Loro-matan ka aihun neʼebé anin huu) tun, hakru’uk ka beʼok ba rai."
  },
  {
    "word": "foke2",
    "class": "Substantivu",
    "meaning": "Bero-liman ki'ik ho forma diman nian."
  },
  {
    "word": "fokit",
    "class": "Verbu",
    "meaning": "1. Hasai buat ida hosi nia fatin ho beran. Ez. Nia fokit ai-kaixote ne'ebé jardiñeiru sira kuda iha jardín laran. 2. Sai ka arranka. Ez. Ami fokit tuku ualu hosi Aileu no to'o iha Same tuku sanulu kalan."
  },
  {
    "word": "fó-konfesa",
    "class": "Verbu",
    "meaning": "(Amlulik) rona ema sarani hatete sai nia sala sira iha sakramentu peniténsia nian, hafoin fó absolvisaun."
  },
  {
    "word": "foku",
    "class": "Substantivu",
    "meaning": "Pontu ka sentru prinsipál neʼebé ema hotu haree. Ez. Masakre Santa Cruz sai foku ba matekektelevi-zaun iha mundu tomak."
  },
  {
    "word": "fó-laran",
    "class": "Adjetivu",
    "meaning": "Neʼebé fiar, tuir kahakru'uk ho laran tomak. Ez. Na'i hahi'i kriadu nee tanba ema fó-laran tebetebes. Sub-stantivu Hahalok hakru'uk no fiar ho laran tomak. Ez. Fó-laran no fó-neon ba funu importante tebes atu kontinua rezisténsia."
  },
  {
    "word": "fó-liman",
    "class": "Substantivu",
    "meaning": "1. Hahalok fó liman ba malu. Sin. tulun, ajuda 2. Hadame-malu ka rekonsiliasaun."
  },
  {
    "word": "folin",
    "class": "Substantivu",
    "meaning": "Osan hira loos mak ita tenke selu atu sosa ka hola buat ida. Sin. presu Ez. Kafé nia folin tun tanba kafé musan barak liu. Verbu Vale osan hira loos, kusta hira loos. Ez. Xapeu ne'e folin hira, sentavu 50 ka 60?"
  },
  {
    "word": "folin-aas",
    "class": "Adjetivu",
    "meaning": "Presu neʼebé boot, halo ema susar atu sosa. Sin. karu, karun Ez. Ohin loron mina-rai folin-aas tanba ema barak mak hakarak sosa hodi tein."
  },
  {
    "word": "folin-boot",
    "class": "Adjetivu",
    "meaning": "1. Neʼebé nia valór di'ak. Ez. Monumentu antigu sira folin-boot tebes tanba sira hatudu istória rain nian. 2. Neʼebé presu aas ka karun. Sin. folin-aas Ez. Billete aviaun nian sai folin-boot tanba ema barak mak halo viajen."
  },
  {
    "word": "folin-kmaan mós folinkraik",
    "class": "Adjetivu",
    "meaning": "Ne'ebé iha folin natoon de'it ka la karun. Sin. baratu"
  },
  {
    "word": "folin-laek",
    "class": "Adjetivu",
    "meaning": "1. Neʼebé la vale buat ida, la iha valór, la serve. Ez. Mákina ida-ne'e folinlaek tanba la lao. 2. (Ema) neʼebé la iha dignidade tanba laranfoʼer. Ez. Naok-teen sira sai folin-laek tanba sira-nia hahalok la diak."
  },
  {
    "word": "folin-todan",
    "class": "Adjetivu",
    "meaning": "Karun tebes. Sin. folin-aas Ez. Povu barak terus tanba foos sai folintodan hodi halo ema sosa la bele."
  },
  {
    "word": "folklore",
    "class": "Substantivu",
    "meaning": "Povu ida nia ai-knanoik no fiar tradisionál hotu-hotu. Ez. Istória Bee-MatanLoihunuhalopartefolkore Timór."
  },
  {
    "word": "folletu",
    "class": "Substantivu",
    "meaning": "Surat-tahan imprime ho liafuan balun atu influensia ema nia ha-noin, hahalok ka atitude. Ez. Durante kampaña polítika, organizadór sira fahe folletu ba partisipante sira."
  },
  {
    "word": "fó-malisan",
    "class": "Verbu",
    "meaning": "Haraik rahun-aat ba ema ida atu nia nia bele hetan susar. Ez. Inan-aman sira fómalisan ba sira-nia oan neʼebé lakohi simu sira."
  },
  {
    "word": "fó-mimu",
    "class": "Verbul Substantivu",
    "meaning": "(Hahalok) ha-kiak sala labarik hodi fó buat hotu neʼebé nia ne'e hakarak, halo nia sai maña tanba ita tuir de'it nia hakarak. Ez. Keta fó-mimu oan sira tanba sira bele sai baruk-teen bainhira sira boot."
  },
  {
    "word": "fonema",
    "class": "Substantivu",
    "meaning": "Unidade-son báziku iha dalen ida, neʼebéhamutukformaliafuaun ida. Hodi rekoñese fonema sira ita bele haketak ka distinge liafuan ida hosi li-afuan seluk. Ez. Letra 's' ho 'x' fonema rua ketak iha liafuan sira sa no xã."
  },
  {
    "word": "fonémiku - fonémika",
    "class": "f. Adjetivu",
    "meaning": "Fonema nian, kona-ba fonema. Liafuan-sorun: fonétiku Ez. Sistema-ortografia lia-tetun nian tuir prinsipiu fonémiku laós fonétiku."
  },
  {
    "word": "fó-neon",
    "class": "Adjetivu",
    "meaning": "Neʼebé hato'o agradesi-mentu ho laran. Sin. agradesidu, gratu Substantivu Hahalok hato'o agradesi-mentu ho laran."
  },
  {
    "word": "fones-rona",
    "class": "Substantivu",
    "meaning": "Aparellu neʼebé uza hodi tau ba tilun atubele rona mesak kasete, sedé ka filme, selae atu rona ho di'ak."
  },
  {
    "word": "fonétika",
    "class": "Substantivu",
    "meaning": "Siénsia konaba son sira neʼebé ita rona iha lian ema nian."
  },
  {
    "word": "fonétiku - fonétika",
    "class": "f. Adjetivu",
    "meaning": "Kona-ba ka tuir son liafuan sira-nian."
  },
  {
    "word": "fonolojia",
    "class": "Substantivu",
    "meaning": "Siénsia konaba son elementár sira neʼebé forma dalen ida. Ez. Estudante sira aprende fonolojia hanesan dixiplina ida iha Departamentu Lia- Portugés."
  },
  {
    "word": "fonte",
    "class": "Substantivu",
    "meaning": "1.Beematan.2. Kualkérhun ida, liuliu hun informasaun nian (lia-hun). Ez. Molok publika nia notisia, jornalista sira presiza husu ideia hosi fonte oioin atu konfirma nia opiniaun."
  },
  {
    "word": "foos",
    "class": "Substantivu",
    "meaning": "Musan mutin ka mean neʼebé hasai hosi hare."
  },
  {
    "word": "foradelei",
    "class": "SubstantivulAdjetivu",
    "meaning": "(Ema ida) neʼebé sosiedade konsidera nu'udar kriminozu tanba la tuir lei. Ez. Governu indonéziu uluk konsidera fretilín sira nu'udar foradelei."
  },
  {
    "word": "fore",
    "class": "Substantivu",
    "meaning": "Musan neʼebé midar ho mina barak iha nia kulit. Verbu Loke hodi dulas."
  },
  {
    "word": "fore-mungu",
    "class": "Substantivu",
    "meaning": "Musan kórmatak neʼebé baibain ema uza hodi halo modo ka sopa. Naran-Botániku: Phaseolus aureus"
  },
  {
    "word": "fore-rai",
    "class": "Substantivu",
    "meaning": "Musan ki'ikoan sira neʼebé iha kulit krutuk no moris iha rai laran."
  },
  {
    "word": "fore-tali",
    "class": "Substantivu",
    "meaning": "Fore neʼebé nia musan moris iha nia talin naruk. Dala barak liu ema uza atu halo modo."
  },
  {
    "word": "fore-xikote",
    "class": "Substantivu",
    "meaning": "Tipu fore ida neʼebé nia musan hela iha talin naruk. Baibain ema uza atu halo modo"
  },
  {
    "word": "forma",
    "class": "Substantivu",
    "meaning": "Buat ida nia kamosuk ka aparénsia li'ur nian, nia lolon ka feisaun oinsá loos. Ez. Forma ekrán komputadór nian hanesan televizaun ida. Verbu 1. Halo tuir ilas, banati ka modelu ida. Ez. Oleiru forma tiha xikra furak ida ho tahu. 2. Harii, halibur."
  },
  {
    "word": "formadu - formada",
    "class": "f. Substantivu",
    "meaning": "Ema ida neʼebé hetan ona sertidaun ofisiál ida katak nia remata estudu universitáriu sira. Ez. António ne'e formadu ida hosi universidade rai-Mosambike."
  },
  {
    "word": "formál",
    "class": "Adjetivu",
    "meaning": "1. Tuir forma. 2. Tuirhahalok be loloos no sériu, la hanesan baibain. Ez. Diak liu Ita tau gravata tanba enkontru ne'e formál. 3. Ofisiál, governu nian. Ez. Sei iha enkontru formál ida entre Primeiru-Ministru ho Prezidente atu koalia kona-ba oinsá rezolve kazu korrupsaun iha governu nia laran."
  },
  {
    "word": "formandu - formanda",
    "class": "f. Substantivu",
    "meaning": "Es-tudante ida neʼebé seidauk halo hotu nia estudu sira."
  },
  {
    "word": "formasaun",
    "class": "Substantivu",
    "meaning": "1. Hahalok forma ka halo buat ruma. 2. Dalan ka métodu partikulár atu forma buat ida. 3. Dalan hodi fó matenek, jeitu no esperiénsia neʼebé ema ida presiza atubele hala'o serbisu partikulár ida. Ez. Mestre sira sei hetan formasaun hanorin liatetun nian molok sira bá kampu."
  },
  {
    "word": "formata",
    "class": "Verbu",
    "meaning": "1. Prepara tuir formatu ida. Ez. Bainhira edita tiha testu nee, eskritór sei formata nia testu tomak atubele im-prime. 2. (komputadór) Prepara diskete ida atu uza, neʼebé apaga fixeiru sira seluk."
  },
  {
    "word": "formatasaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "formatu",
    "class": "Substantivu",
    "meaning": "Maneira arranja ka ap-rezenta dokumentu ka testu ida."
  },
  {
    "word": "formatura",
    "class": "Substantivu",
    "meaning": "1. Hamriik ka tuur tuir orden iha serimónia ida, liuliu serimónia militár. Ez. Iha formatura ne'e, komandante sira sei hamriik iha oin klaran loloos. 2. Ramata estudu universitáriusira. 3. Serimóniafódiploma ba estudante sira neʼebé foin hetan for-masaun iha universidade."
  },
  {
    "word": "Formoza, (rai-)",
    "class": "Substantivu",
    "meaning": "Nusa boot ida iha besik rai-Xina neʼebé nia kapitál Taipé. Maski nia estadu independende ho nia governu rasik, Repúblika Populár Xina konsidera nia nu'udar provínsia klebak ka rebelde ida. Sin. Taiwán"
  },
  {
    "word": "formozanu - formozana",
    "class": "f. Adjetivu",
    "meaning": "Rai-Formoza nian, kona-ba rai- Formoza. Substantivu Ema Formoza. Sin. taiwanés - taiwaneza"
  },
  {
    "word": "fórmula",
    "class": "Substantivu",
    "meaning": "1. Letra, númeru ka símbolu grupu ida neʼebé reprezenta regra matemátika ka sientífika. 2. Lista ka reseita neʼebé fó-hatene kuantidade hira loos hosi substánsia oioin neʼebé bele hamosu substánsia ida seluk, bainhira kahur tiha hamutuk, liuliu iha kímika."
  },
  {
    "word": "formuláriu",
    "class": "Substantivu",
    "meaning": "1. Fórmula lubun ida. 2. Dokumentu surattahan ida neʼebé ema presiza prenxe atu halo buat ida. Ez. Estudante sira neʼebé hakarak tuir atividade ida, presiza prenxe formuláriu."
  },
  {
    "word": "fornese",
    "class": "Verbu",
    "meaning": "Haraik buat ruma atu ema neʼebé simu tiha bele uza bainhira presiza. Sin. hafó. Ez. Departamentu Agrikultura sei fornese fini ba sira neebé hakarak kuda batar."
  },
  {
    "word": "fornesimentu",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "fornesedór - fornesedora",
    "class": "f. Substantivu",
    "meaning": ""
  },
  {
    "word": "fornu",
    "class": "Substantivu",
    "meaning": "Fatin neʼebé ema uza atu te'in aihan bá, liuliu tunu dose, ikan, nst. Sin. ahi-matan. Ez. Keta haluha tau ahi ba fornu atu paun bele tasak lailais."
  },
  {
    "word": "forru",
    "class": "Substantivu",
    "meaning": "Hena ida tan neʼebé ema suku iha bolsa, kazaku ka saku laran hodi halo metin hena, atu kabas la sai ka la lees. Sin. knabir. Ez. Tenke tau forru ba neras sira selae sira naklees lailais. Verbu Tau forru. Sin. hanabir"
  },
  {
    "word": "forsa",
    "class": "Substantivu",
    "meaning": "1. Kbiit naturál. Ez. Ita ema bele hamosu enerjia ho forsa múskulu sira-nian, selae hosi forsa loro, ahi, anin ka bee nian. 2. Podér neʼebé iha. 3. Ema-lubun ho kbiit ka autoridade hosi governu ka ezérsitu, liuliu atu hala'o knaar espesiál ruma. Ez. Governu atu haruka forsa militár ida atu ronda zona-fronteira."
  },
  {
    "word": "fortaleza",
    "class": "Substantivu",
    "meaning": "Hariin ka uma ida ho baki aas no mahar neʼebé ema harii atu satan atake hosi inimigu. Sin. kota."
  },
  {
    "word": "forte",
    "class": "Adjetivul Advérbiu",
    "meaning": "1. Neʼebé soi forsa fíziku ka morál. Sin. makaʼas Ez. Bok-sista ne'e nia tuku forte duni hodi halo nia inimigu monu. Tua-sabu ne'e forte tebetebes tanba bainhira hau horon, halo ha'u lanu. 2. Metin tebetebes, la tohar. Ez. Ai-kabelak neebá sei la tohar tanba forte. 2. Neʼebé bele tahan kleur ka aguenta tratamentutodan. Ez. Labarik ne'e forte tebes tanba maski ema baku no tebe nia maibé nia la tanis. 3. Neʼebé aten-barani, la lakon neon. Ez. Nia forte duni maski foufoun nia atu lakon salasala."
  },
  {
    "word": "fose",
    "class": "Substantivu",
    "meaning": "Ai naruk no mihis ida neʼebé baibain ema uza atu hean bero. Verbu Hean bero ho fose (baibain ida de'it)."
  },
  {
    "word": "fosfatu",
    "class": "Substantivu",
    "meaning": "Masin neʼebé sai hosi ásidu fosfóriku."
  },
  {
    "word": "fó-soku",
    "class": "Verbu",
    "meaning": "Tuku ho liman-fuan neʼebé kumu hamutuk. Ez. Boksista ida fó-soku maka'as hodi halo nia adversáriu monu ba rai."
  },
  {
    "word": "fó-susu",
    "class": "VerbulSubstantivu",
    "meaning": "(Hahalok) fó su-subeen hosi inan nia susun ba bebé atu susu. Ez. Inan sira tenke fósusu nafatin sira-nia oan to'o fulan sanulu-resin rua."
  },
  {
    "word": "fotan",
    "class": "Substantivu",
    "meaning": "Du'ut boot ida neʼebé fó fulin ho musan neʼebé serve atu fó-han balada sira. Sin. tora. Naran-Botániku: Setaria italica"
  },
  {
    "word": "fó-terus",
    "class": "Verbul Substantivu",
    "meaning": "(Hahalok) halo terus nian. Sin. haterus Ez. Oan sira keta fó-terus inan-aman sira tanba sira ferik no katuas ona."
  },
  {
    "word": "foti",
    "class": "Verbu",
    "meaning": "1. Hi'it ka hasa'e. Ez. Ha'u foti livru ne'e hodi tau iha meza leten. Foti telefone katak kaer hodi see ba tilun atu ko'alia. Foti matan ba katak hatudu ad-mirasaun ba ema ida tanba buat ida ne'e nia iha ka halo. 2. Hahi'i, gaba. 3. Fó ka hatudu interese atu tulun."
  },
  {
    "word": "foti-an",
    "class": "Adjetivu",
    "meaning": "Neʼebé halo an ka iha ar-rogánsia. Sin. arrogante Ez. Niasaifoti-an tanba de'it ema iha nia sorisorin la eskola boot. Substantivu Hahalok fotian nian. Sin. arrogánsia."
  },
  {
    "word": "foti-matan",
    "class": "Substantivu",
    "meaning": "Atitude foti matan ka admira nian. Sin. admirasaun"
  },
  {
    "word": "foti-oin",
    "class": "Adjetivu/Substantivu",
    "meaning": "Neʼebé sente kontente tan buat ida neʼebé nia iha ka hetan. Sin. fotiulun, orgullu Ez. Hau sente foti-oin ba prémiu neʼebé hau hetan."
  },
  {
    "word": "fotografa",
    "class": "Verbu",
    "meaning": "Hasai ema ida nia retratu ho mákinafotografia."
  },
  {
    "word": "fotografia mós fotu",
    "class": "(kolokiál) Substantivu",
    "meaning": "Ilas iha surattahan neʼebé fotógrafu ida hasai ho mákina no dezenvolve hodi fase pelíkula."
  },
  {
    "word": "fotógrafu - fotógrafa",
    "class": "f. Substantivu",
    "meaning": "Ema neʼebé iha serbisu ka pasatempu atu hasai fotografia."
  },
  {
    "word": "fotokopia",
    "class": "Verbu",
    "meaning": "Halo ka habarak doku-mentu ida nia kópia liuhosi mákinafo-tokópia eletróniku ka fotográfiku."
  },
  {
    "word": "fotokópia",
    "class": "Substantivu",
    "meaning": "Dokumentu ida nia kópia, halo ho fotokopiadora."
  },
  {
    "word": "fotokopiadora",
    "class": "Substantivu",
    "meaning": "Mákina neʼebé halo fotokópia liuhosi prosesu fotográ-fiku. Sin. mákina-fotokópia"
  },
  {
    "word": "fotu",
    "class": "",
    "meaning": "haree fotografia"
  },
  {
    "word": "fó-tulun",
    "class": "Verbu",
    "meaning": "Tulun ka ajuda ema ruma hodi halo kmaan nia moris. Ez. Ami mai atu fó-tulun imi."
  },
  {
    "word": "foun",
    "class": "Adjetivu",
    "meaning": "Neʼebé foin mosu, halo, ka hetan. Ez. Sira iha informasaun foun ida atu hato'o ba ita."
  },
  {
    "word": "foufoun",
    "class": "Advérbiu",
    "meaning": "Hosi hun kedas; bainhira hahú. Ez. Bainhira ami sura foufoun osan nee la too atu selu ema hotu. Ad-jetivu Uluk ka hun nian. Sin. orijinál"
  },
  {
    "word": "frade",
    "class": "Substantivu",
    "meaning": "Amlulik ka irmaun neʼebé pertense ba orden relijioza ida neʼebé fó an ba haklaken evanjellu no halo misio-nasaun iha fatin oioin, la hela iha fransiskana, mosteiru de'it hanesan monje. Ez. Frade dominikanu sira maka lori fiar sarani no kultura portugeza mai rai-Timór sékulu lima liubá."
  },
  {
    "word": "frade-libur",
    "class": "Substantivu",
    "meaning": "Orden relijioza ba frade sira."
  },
  {
    "word": "frakeza",
    "class": "Substantivu",
    "meaning": "1. Hahalok kuran kbiit, ka forsa la to'o. 2. Buat neʼebé ladún di'ak iha buat ka ema nia laran. Sin. de-feitu, kamerik Ez. Ita hotu iha frakeza ruma, tanba nee normál ba ita ema atu halo sala."
  },
  {
    "word": "fraku",
    "class": "Adjetivu",
    "meaning": "Neʼebé la iha kbiit, ka nia forsa la to'o. Ez. Avó sira bainhira ferik-katuas ona, sira sai fraku."
  },
  {
    "word": "fraldas mós fralda",
    "class": "Substantivu",
    "meaning": "Hena ka surat-tahan mahar ida neʼebé bobar hale'u bebé nia kidun atubele tahan fo'er."
  },
  {
    "word": "frambueza",
    "class": "Substantivu",
    "meaning": "Ai-fuan mean mamar ki'ikoan ida neʼebé moris iha ailaran."
  },
  {
    "word": "franja",
    "class": "Substantivu",
    "meaning": "1 Fuuk neʼebé tabele iha reen-toos. 2 Dekorasaun iha hena ka objetu sira seluk nia ninin."
  },
  {
    "word": "frankamente",
    "class": "Advérbiu",
    "meaning": "Atu dehan loloos (espresaun ida neʼebé ita baibain uza hodi fó sai ita-nia hanoin konaba buat ruma). Ez. Frankamente hau la konkorda ho sira-nia planu foun nee."
  },
  {
    "word": "franku",
    "class": "Adjetivu",
    "meaning": "Neʼebé koʼalia la taka. Ez. Kritiku sira ema neʼebé franku tanba sira ko'alia lasubar."
  },
  {
    "word": "franku-kanadianu - franku-kanadiana",
    "class": "f. Adjetivul Substantivu",
    "meaning": "(Kona-ba) ema dalenfransés rai-Kanadá nian. Ema frankukanadianu barakliu horik iha provínsia Kebeke no Eskósia Foun (rai-Akádia)."
  },
  {
    "word": "Fransa, (rai-)",
    "class": "Substantivu",
    "meaning": "Rain boot ida iha Europa Loromonu ho kapitál París."
  },
  {
    "word": "fransés - franseza",
    "class": "f. Adjetivu",
    "meaning": "Rai-Fransa nian, kona-ba rai-Fransa. Substantivu Ema Fransa."
  },
  {
    "word": "fransiskanu - fransiskana",
    "class": "f. Adjetivu",
    "meaning": "(Kreda Katólika) Kona-ba frade-libur ka orden Saun Fransisku hosi Asís nian neʼebé fó an liu ba moris kiak. Substantivu Mem-bru orden Saun Fransisku hosi Asís nian."
  },
  {
    "word": "frasaun",
    "class": "Substantivu",
    "meaning": "1. Iha aritmétika, parte ida de'it hosi hahirak ka kuantidade to-mak. 2. Hahirak ka kuantidade ki'ikoan hosi naran buat ida. Sin. kotun."
  },
  {
    "word": "fraternidade",
    "class": "Substantivu",
    "meaning": "1. Fafutuk ka re-lasaun entre maunalin sira. 2. Relasaun entre grupu rua ka liu. Ez. Timoroan tenke hametin fraternidade nu'udar hakat ida ba unidade nasionál. 3. Domin ba ema seluseluk."
  },
  {
    "word": "fraternu",
    "class": "Adjetivu",
    "meaning": "Maun-alin nian, kona-ba maun-alin. Sin. maun-alik"
  },
  {
    "word": "fratura",
    "class": "Substantivu",
    "meaning": "Tohar ka nakfera ida neʼebé akontese ba buat ruma, liuliu ruin. Sin. tatohar. Ez. Nia tenke bá hasai raiu-xís atubele hatene se iha fratura ruma bainhira monu."
  },
  {
    "word": "fraze",
    "class": "Substantivu",
    "meaning": "1. Liafuan lubun ida neʼebé bele hamriik mesak no nakfahe ba orasaun ida ka liu. Ez. Atu hakerek diak, ema tenke hatene oinsá forma fraze ida. 2. Modu partikulár atu hato'o hanoin ida. Sin. espresaun"
  },
  {
    "word": "Frei",
    "class": "Substantivu",
    "meaning": "Títulu ba frade ka irmaun, n.e. Frei Matias, Frei Jaime."
  },
  {
    "word": "frente",
    "class": "Substantivu",
    "meaning": "1. Klibur hosi partidu ka grupu polítiku rua ka liu neʼebé hakarak luta hamutuk ba objetivu ida de'it. 2. Zona neʼebé fahe ármasa rua ho tem-peratura ka umidade lahanesan."
  },
  {
    "word": "fresku - freska",
    "class": "f. Adjetivu",
    "meaning": "1. Neʼebé malirin uitoan. Sin. namata Ez. Ár fresku halo ita hetan isin-di'ak. 2. Di'ak tanba sei matak ka foin halo. Liafuan-sorun: miis, siin Ez. Bolu ne'e sei fresku. Sub-stantivu 1. Ár ka tempu neʼebé fresku. 2. Modu pinta nian ho kór oioin, baibain iha argamasa be sei bokon nia leten."
  },
  {
    "word": "freskura",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "Fretilín",
    "class": "Substantivu",
    "meaning": "(akrónimu ba naran portugés Frente Revolucionária de Timor Leste In-dependente) Substantivu 1. Partidu ida neʼebé mosu iha tinan 1974 hodi luta kontra kolonializmu. 2. (nu'udar Sub-stantivu komún: fretilín) Ema Fretilín."
  },
  {
    "word": "freun",
    "class": "Substantivu",
    "meaning": "Tali neʼebé kesi hale'u kuda nia kakorok no ibun atu kavaleiru bele kontrola bainhira kuda ne'e la'o ka halai."
  },
  {
    "word": "friksaun",
    "class": "Substantivu",
    "meaning": "1. Forsa neʼebé hapara sasan hosi movimentu livre bainhira sira kose malu. Sin. kakosek 2. Hak-sesuk-malu ka laiha lia-ida entre ema neʼebé envolve iha kazu ruma. Ez. Bain-hira friksaun mosu iha partidu ida nia laran, bele fahe nia apoiante sira."
  },
  {
    "word": "friza¹",
    "class": "Substantivul Verbu",
    "meaning": "(Fó) penteadu ida neʼebé hela metin maski ita fase fuuk depois. Sin. permanente (subst.)"
  },
  {
    "word": "friza²",
    "class": "Verbu",
    "meaning": "Fó énfaze ka importánsia boot ba buat ruma. Sin. halosu, enfatiza"
  },
  {
    "word": "froñas",
    "class": "Substantivu",
    "meaning": "Hena neʼebé ita uza atu taka xumasu. Sin. kluniknuan"
  },
  {
    "word": "fronteira",
    "class": "Substantivu",
    "meaning": "Liña ida neʼebé fahe zona ka nasaun rua. Sin. raiketan. Ez. Polisia sira kontrola fronteira atu sasán ilegál sira la bele tama Timór Lorosa'e."
  },
  {
    "word": "frota",
    "class": "Substantivu",
    "meaning": "1. Ró sira neʼebé hamutuk sai armada ida. Sin. rólubun. Ez. Bain-hira funu INTEFET tama Timór iha tinan 1999, governu Australinu haruka frota ida atu kontrola tasimane no tasi-feto. 2. Empreza komersiál nia ró sira, karreta sira ka kamiaun sira."
  },
  {
    "word": "frustra",
    "class": "Verbu",
    "meaning": "1. Hanetik ema ida hosi buat neʼebé nia hakarak no halo nia neon-sala; halo atu berleki Sin. habekan Ez. Tem-pu-udan ne'e frustra adeptu sira barak tanba sira la konsege haree jogu. 2. Halo atu la bele akontese."
  },
  {
    "word": "frustradu - frustrada",
    "class": "f. Adjetivu",
    "meaning": "Kondisaun ema ida nian hodi sente neon-sala tanba buat neʼebé hanetik ka prevene nia hosi nia hakarak. Ez. Durante okupasaun, joven barak mak sai frustradu tanba la iha liberdade."
  },
  {
    "word": "frustrante",
    "class": "Adjetivu",
    "meaning": "Neʼebé halo neon-sala tanba hanetik ka prevene buat ida atu akontese. Sin. mabekan Ez. Frustrante tebetebes ba estudante sira bainhira sira la pasa ezame, maski estuda makaas nanis."
  },
  {
    "word": "frustrasaun",
    "class": "Substantivu",
    "meaning": "Hahalok sente neon-sala tanba iha buat ida neʼebé hanetik ita-nia hakarak. Sin. habekan, berlekin Ez. Dezempregu iha Timór sai hanesan frustrasaun boot ida ba nasaun."
  },
  {
    "word": "fruteiru - fruteira",
    "class": "f. Substantivu",
    "meaning": "Mane neʼebé fa'an ai-fuan sira. Sin. makfa'an ai-fuan"
  },
  {
    "word": "fuan",
    "class": "Substantivu",
    "meaning": "1. Ida neʼebé ema ka buat ida hamosu, baibain tuir lala'ok ka prosesu naturál. 2. (ai-fuan) Parte hanbelek neʼebé ai ida halo, mosu iha aisanak nia rohan, ho fini iha laran. 3. Organ ema nian besik hirus-matan neʼebé bomba raan ba isin tomak. 4. Parte ne'ebé klaran ka hun ba buat ida."
  },
  {
    "word": "fuan-tuku mós fuantukun",
    "class": "Substantivu",
    "meaning": "1. Fuan nia baku neʼebé bele lais ka nei-neik hanesan baibain. 2. Sente laran-nakali, ka laran-manas."
  },
  {
    "word": "fuhuk",
    "class": "Substantivu",
    "meaning": "Insetu ki'ikoan ne'ebé estraga no han ai-han sira hanesan batar, foos, nst. Adjetivu Neʼebé sai dodok no aat tanba insetu han tiha."
  },
  {
    "word": "fui",
    "class": "Verbu Tranzitivu",
    "meaning": "1. Tau bee ka buat been ida ba botir, kaleen, jerikán, nst. Sin. salin Ez. André sai lanu laoras de'it tanba nia fui tua barak ba nia kopu. 2. Habokon ho buat neʼebé been, porezemplu rega aifunan iha vazu."
  },
  {
    "word": "fu'i",
    "class": "Verbu Intranzitivu",
    "meaning": "1. Halo tarutu ho apitu, kafu'i ka flauta. 2. Hotar, uza li-afuan fo'er."
  },
  {
    "word": "fulana",
    "class": "Substantivu",
    "meaning": "Kafu'i. Sin. aifu'i"
  },
  {
    "word": "fuik",
    "class": "Adjetivu",
    "meaning": "Neʼebé la hakmatek ka susar atubele kontrola tanba la maus. Li-afuan-sorun: maus"
  },
  {
    "word": "Fuiloro",
    "class": "Substantivu",
    "meaning": "Vila ida besik Lospalos iha distritu Lautein."
  },
  {
    "word": "fukar",
    "class": "Verbu",
    "meaning": "Hamorin ho buat sira hanesan masin, pimenta, du'ut-morin, liis, nst. neʼebé tau ba hahán atubele halo morin, midar ka iha gostu. Sin. tempra"
  },
  {
    "word": "fukun",
    "class": "Substantivu",
    "meaning": "1. Tali ka fita nia rohan, kesi hamutuk atu hametin buat ruma. 2. Parte hosi ita-nia liman ka ain ho ruin rua hasoru malu. Ez. Nia tuku hau ho nia liman-fukun. 3. Parte hosi ai neʼebé sanak atu moris bá."
  },
  {
    "word": "fulafulan mós fulanfulan",
    "class": "Advérbiu",
    "meaning": "Kada fulan Adjetivu Neʼebé akontese fulan ida dala ida. Ez. Nia fulafulan bá simu osan iha banku."
  },
  {
    "word": "fulan",
    "class": "Substantivu",
    "meaning": "1. Satélite ka isin-lolon boboot kabuar ida neʼebé nakdulas hale'u planeta ida, liuliu ida neʼebé na-kdulas hale'u Rai. 2. Tempu neʼebé fulan lori hodi nakdulas hale'u planeta Rai, bele loron 31, 30, 29 ka 28. 3. Raan neʼebé fulanfulan suli sai hosi feto nia oan-fatin, no baibain halo nia sente laran-sa'e. Ne'e sinál katak feto ne'e bele iha oan. Sin. fulan-sona, menstruasaun"
  },
  {
    "word": "fulan-naroman",
    "class": "Substantivu",
    "meaning": "Naromanneʼebé mai hosi fulan, liuliu bainhira nia na-konu tomak. Ez. Ema barak gosta tuur iha tasi-ibun bainhira fulan-naroman to'o."
  },
  {
    "word": "fulan-nurak",
    "class": "Substantivu",
    "meaning": "Fulan neʼebé foin hahú atu mosu iha lalehan; seidauk fu-lanbalun."
  },
  {
    "word": "fulan-sona",
    "class": "Substantivu",
    "meaning": "Períodu neʼebé feto adultu sira hetan sira-nia fulan ka men-struasaun."
  },
  {
    "word": "fulan-tomak",
    "class": "Substantivu",
    "meaning": "Fulan neʼebé na-konu hodi halo naroman maka'as."
  },
  {
    "word": "fulanu - fulana",
    "class": "f. Substantivu",
    "meaning": "(pejorativu) Naran jerál ida neʼebé ita bele fó ba ema ida bainhira ita la hatene nia naran loloos, mós bainhira ita lakohi fó sai ema ne'e nia naran. Ez. La importa sa-ida loos mak fulanu hateten."
  },
  {
    "word": "fulun",
    "class": "Substantivu",
    "meaning": "Fuuk neʼebé moris iha ema ka balada sira-nia isin."
  },
  {
    "word": "fuma",
    "class": "VerbulSubstantivu",
    "meaning": "(Hahalok) hatama tabaku-lulun ba ibun hodi husik nia suar sai hosi ibun ka inus. Ez. Fuma nee ábitu ida neebé bele estraga saúde."
  },
  {
    "word": "fumadór - fumadora",
    "class": "f. Substantivu",
    "meaning": "Ema neʼebé fuma beibeik ka lapara."
  },
  {
    "word": "funak",
    "class": "Adjetivu",
    "meaning": "1. Ai-funan nian, kona-ba ai-funan. 2. Ho kór ka hafunan barak. Sin. reborebon."
  },
  {
    "word": "funan",
    "class": "Substantivu",
    "meaning": "(ai-funan) Parte furak no dala barak morin hosi aihoris neʼebé moris iha kain nia tutun ka iha ai-sanak nia rohan. Aifunan ne'e halo ho pétala (funan-tahan) iha parte li'ur, estame (funan-utin) no pístilu (tolun-fatin) iha laran. 2. Produtu; haree mós osan-fu-nan Adjetivu Neʼebé kulapur taka ona."
  },
  {
    "word": "funda",
    "class": "Verbu",
    "meaning": "Harii ka estabelese grupu, or-ganizasaun ka instituisaun ida. Ez. Kli-bur RENETIL funda iha tinan 1980 resin liubá atu halibur estudante timoroan sira hodi hasoru invazaun indonézia."
  },
  {
    "word": "fundadór - fundadora",
    "class": "f. Substantivu",
    "meaning": "Ema neʼebé harii grupu, organizasaun ka in-stituisaun ida. Ez. Don Bosco mak fun-dadór orden saleziana nian."
  },
  {
    "word": "fundamentál",
    "class": "Adjetivu",
    "meaning": "Importantetanbabuat ruma nia hun. Sin. báziku, esensiál Ez. Labarik sira mós iha direitu funda-mentál hanesan moris, saúde diak, nst."
  },
  {
    "word": "fundasaun",
    "class": "Substantivu",
    "meaning": "1. Buat ida nia hun. 2. Hahalok funda ka harii nian. Sin. hariin 3. Organizasaun neʼebé ema sira harii ba objetivu partikulár ida. Ez. Fundasaun Alola harii iha tinan 2003."
  },
  {
    "word": "fundus",
    "class": "Substantivu",
    "meaning": "Hahirak ka kuantidade osan neʼebé ema sira rekolle atu uza ba objetivu ida. Ez. Bainhira rai-hamlaha, governu sei hasai fundus espesiál ida atu tulun nia povu."
  },
  {
    "word": "funerál",
    "class": "Substantivu",
    "meaning": "Serimónia atu hakoi ema neʼebé mate (iha tradisaun sarani), ka sunu nia isin (iha tradisaun la'ós sarani). Ez. Funerál ba soldadu sira ne'ebé mate iha funu sei hahú ho for-matura militár."
  },
  {
    "word": "funeráriu - funerária",
    "class": "f. Adjetivu",
    "meaning": ""
  },
  {
    "word": "fungu",
    "class": "Substantivu",
    "meaning": "Ai-horis ida hanesan tutukeu lahó tahan ka funan neʼebé hetan ai-han hodi belit ka tabele ba ai ka organizmu seluk neʼebé mate ona ka sei moris. Sin. kulat"
  },
  {
    "word": "funíl",
    "class": "Substantivu",
    "meaning": "Tubu nakloke hanesan kuhus ka kone ida, halo hosi plástiku, kaleen ka ai neʼebé uza atu fui tuir buat neʼebé been, porezemplu bee, mina, nst."
  },
  {
    "word": "funsaun",
    "class": "Substantivu",
    "meaning": "1. Knaar ofisiál. Ez. Funsionáriu governu nian tenke hatene sirania funsaun atubele hala'o serbisu loroloron nian. 2. Buat ida nia uzu ka lala'ok baibain nian. Ez. Fuan nia fun-saun mak atu bomba raan ba isin tomak."
  },
  {
    "word": "funsiona",
    "class": "Verbu",
    "meaning": "La’o ba oin. Ez. Atu tribunál funsiona didi'ak, juís no defensór sira tenke hatene lei loloos."
  },
  {
    "word": "funsionáriu - funsionária",
    "class": "f. Substantivu",
    "meaning": "Empregadu públiku; ema neʼebé serbisu ba governu. Ez. Funsionáriu sira tenke tama serbisu hahú tuku 08:00 too tuku 17:00."
  },
  {
    "word": "funu",
    "class": "Substantivu",
    "meaning": "1. Baku-malu entre nasaun, estadu ka grupu sira, liuliu bainhira uza kilat no ema barak maka mate no terus. 2. Kompetisaun entre ema ka grupu atu manán buat ida maski la envolve kilat."
  },
  {
    "word": "funu-balun",
    "class": "Substantivu",
    "meaning": "Ema neʼebé ita-nia inimigu iha funu laran. Ez. Jezús dehan: \"Hadomi imi-nia funubalun sira.\""
  },
  {
    "word": "funuk",
    "class": "Adjetivu",
    "meaning": "Funu nian, konaba funu. Sin. marsiál"
  },
  {
    "word": "funu-maluk",
    "class": "Substantivu",
    "meaning": "1. Soldadu neʼebé ita-nia maluk iha funu. Sin. kamarada 2. (dialetál = funubalun) Ema neʼebé itania inimigu iha funu laran."
  },
  {
    "word": "furak",
    "class": "Adjetivu",
    "meaning": "1. Neʼebé sente di'ak, midar kaiha gostu, porezemplu hahán. 2. (Ema) neʼebé oin di'ak ka bonita/bonitu. 3. Ne'ebé di'ak, hakmatek ka kalma, porezemplu situasaun ka tempu. Sub-stantivu 1. Hahán nia sente ka gostu. Sin.fafurak, beleza 2. Karakterkasasuuk furak Ez. Feto nee nia furak halo mane barak mak hakarak hola nia."
  },
  {
    "word": "furin",
    "class": "Substantivu",
    "meaning": "Musamusan kabee-kafu'ak iha líkidu ida nia leten, porezemplu bainhira loke kaleen serveja nian, furin sei mosu makaʼas ka tuda sai. Sin. dahan"
  },
  {
    "word": "furriél",
    "class": "Substantivu",
    "meaning": "Ema-mane neʼebé to'o ona ba postu militár ida ne'ebé iha grausarjentu nia kraik."
  },
  {
    "word": "fusin",
    "class": "Substantivu",
    "meaning": "Organ iha ema no balada nia isin neʼebé halo substánsia kímika ba isin atu uza, ka ajuda atu halakon produtu fo'er sira iha isin laran (n.e. ko-sarbeen, susubeen). Sin. glándula"
  },
  {
    "word": "fusik",
    "class": "Adjetivu",
    "meaning": "; Sin. glandulár"
  },
  {
    "word": "fusuk",
    "class": "Adjetivul Substantivu",
    "meaning": "(Ema) neʼebé kotuk-laran kle'uk no bubu uitoan. Sin. bonko"
  },
  {
    "word": "futar",
    "class": "Substantivu",
    "meaning": "1. Liafuan onorífiku ida neʼebé uza hodi refere ba parte ida iha liurai ka ema boot nia isin. Ez. Ita-Boot nia futar liman. 2. Buat-hafunan. Sin. ornamentu, dekorasaun"
  },
  {
    "word": "futeból",
    "class": "Substantivu",
    "meaning": "Jogu tebebola nian."
  },
  {
    "word": "futebolista",
    "class": "Substantivu",
    "meaning": "Ema neʼebé hatene no joga futeból, mós nu'udar profisaun."
  },
  {
    "word": "futi",
    "class": "Substantivu",
    "meaning": "Isin kabuar ki'ikoan ida neʼebé moris iha ema ida nia oin ka liman tanba kona virus ruma. Sin. manu-raan"
  },
  {
    "word": "futu",
    "class": "Verbu",
    "meaning": "Kesi-hale'u, kesihadulas. Ez. Soldadu sira futu tiha ema dadur nẻe ho tali naruk ida. Futu lia katak kombina subasubar ho ema seluk atu halo buat ruma be aat. Ez. Júdas futu lia ho emaaat sira atu bá kaer Jezús."
  },
  {
    "word": "futu-kabun",
    "class": "Substantivu",
    "meaning": "Talin belar ida hosi kulit ka hena neʼebé ema uza atu tahan kalsa ka saia hodi kesi hale'u kanotak. Sin. sintu"
  },
  {
    "word": "futu-laran",
    "class": "Substantivu",
    "meaning": "Hena mutin mihis neʼebé ema kesi hale'u parte isin neʼebé kanek. Sin. ligadura."
  },
  {
    "word": "futu-lia",
    "class": "Substantivu",
    "meaning": "Planu segredu neʼebé ema ka grupu ida halo. Sin. konspira-saun Ez. Hảu konsidera futulia no atake subasubar hanesan hahalok ema tauk-teen nian."
  },
  {
    "word": "futu-manu",
    "class": "Substantivu",
    "meaning": "Jogu iha neʼebé ema soran manu hodi futu."
  },
  {
    "word": "futun",
    "class": "Substantivu",
    "meaning": "Buat sira neʼebé kesi hamutuk ho tali ka borraxa, porezemplu fehuktahan, lakeru-dikin, nst."
  },
  {
    "word": "futuru",
    "class": "Adjetivu",
    "meaning": "Neʼebé seidauk mosu ka akontese, depoizde tempu daudaun ne'e. Substantivu 1. Tempu atu mai, períodu depoizde prezente. Sin. aban-bainrua 2. Ema sira neʼebé ita hein atu loron ruma bele leba responsabilidade ba buat ruma. Ez. Joven sira mak futuru nasaun ne'e nian."
  },
  {
    "word": "futus",
    "class": "Substantivul Verbu",
    "meaning": "Imprime dezeñu sira iha hena nia leten ho métodu tradi-sionál pinta nian."
  },
  {
    "word": "fuuk",
    "class": "Substantivu",
    "meaning": "Fulun neʼebé moris iha ulun-fatuk leten."
  },
  {
    "word": "fuuk-dalis",
    "class": "",
    "meaning": "haree fuuksasin"
  },
  {
    "word": "fuuk-mean",
    "class": "Adjetivu",
    "meaning": "Fuuk neʼebé kórmean. Sin. fuuk-balanda."
  },
  {
    "word": "fuuk-mulatuk",
    "class": "Adjetivu",
    "meaning": "Fuuk neʼebé nak-dulas ki'ikoan."
  },
  {
    "word": "fuuk-sasin",
    "class": "Substantivu",
    "meaning": "Fuuk naruk neʼebé kesi tiha ona. Sin. fuuk-dalis"
  },
  {
    "word": "fuza",
    "class": "Substantivu",
    "meaning": "Nota muzikál neʼebé vale semínima kaualuk ida ka semikolxeia balun ida. Nia tadak maka ne'e:"
  },
  {
    "word": "fuzivel",
    "class": "Substantivu",
    "meaning": "Fiu metáliku neʼebé ap-lika ba sirkuitu elétriku atu teri netik ka interrompe sirkuitu ne'e bainhira inten-sidade korrente nian sai makaʼas demais."
  },
  {
    "word": "gaba",
    "class": "Verbu",
    "meaning": "1. Hana'i ema ida tanba buat di'ak neʼebé nia halo. Sin. hahi'i Ez. Bainhira André hatama tiha golu, ema hotu gaba nia. 2. Ko'alia furak hodi ezajera kona-ba ema ida nia kualidade di'ak sira atu hasolok ka hamaus nia. Sin. foti Ez. Soldadu nee gaba loos ninia kapitaun iha jenerál nia oin."
  },
  {
    "word": "gaba an",
    "class": "Verbu",
    "meaning": "Ko'alia hodi foti nia an. Ez. Malandru nee gaba an, hafoin tuku tiha nia maluk ida seluk to'o inus raan."
  },
  {
    "word": "gaba-an mós gabasola",
    "class": "Adjetivu",
    "meaning": "Neʼebé gosta foti an ka hahi'i an. Ez. Hau la gosta ema neebé gabasola tanba dala barakliu sira bosokteen. Substantivu Hahalok foti an nian."
  },
  {
    "word": "Gabaun, (rai-)",
    "class": "Substantivu",
    "meaning": "Rain no estadu ida iha Áfrika Klarak."
  },
  {
    "word": "gabonés - gaboneza",
    "class": "Adjetivu",
    "meaning": "Rai-Gabaun nian. Substantivu Ema Gabaun."
  },
  {
    "word": "gabardina",
    "class": "Substantivu",
    "meaning": "Kazaku ida neʼebé ema hatais atu proteje ka satan nia an hosi udan."
  },
  {
    "word": "gaéliku",
    "class": "Substantivu",
    "meaning": "(lia-gaéliku) Dalen séltiku neʼebé iha variedade rua, rai-Eskósia nian no rai- Irlanda nian. Adje-tivu Lia-gaéliku nian."
  },
  {
    "word": "gaiola",
    "class": "Substantivu",
    "meaning": "Fatin ki’ik ida halo hosi rede, kaixa ka au neʼebé uza atu rai manu ka animál fuik iha laran, hanesan loriku, kakatua, lakateu, laku, nst."
  },
  {
    "word": "gaita mós gaitadeboka",
    "class": "Substantivu",
    "meaning": "Instru-mentumúzika ida neʼebé uza iis ibun atu halo tarutu ka toka Sin. gaitadeboka"
  },
  {
    "word": "galáksia",
    "class": "Substantivu",
    "meaning": "Konstelasaun ka fitun-lubun barak hakrobuk hamutuk. Sin. fitun-libur"
  },
  {
    "word": "galaun",
    "class": "Substantivu",
    "meaning": "1. Hena pedasuk ida neʼebé uza atu halo dekorasaun ba kor-tina, nst. 2. Faixa hena funan neʼebé uza nu'udar sinál ba ema nia postu iha sis-tema militár."
  },
  {
    "word": "galegu - galega",
    "class": "Adjetivu",
    "meaning": "Rai-Galiza nian. Substantivu 1. Ema Galiza. 2. (lia-galegu) Dalenrai-Galizanian, neʼebélia-portugés nia variedade ida."
  },
  {
    "word": "Gales, (rai-)",
    "class": "Substantivu",

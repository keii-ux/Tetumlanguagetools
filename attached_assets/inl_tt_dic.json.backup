    "word": "redasaun",
    "class": "Substantivu",
    "meaning": "1. Hakerek badak kona-ba buat ruma, neʼebé estudante ka jornalista halo. 2. Grupu ema neʼebé hala'o jornál ka revista ida."
  },
  {
    "word": "redator - redatora, f.",
    "class": "Substantivu",
    "meaning": "1. Ema neʼebé halo redasaun. 2. Ema neʼebé nia serbisu mak buka liafuan ka informasaun seluk atu publika iha jornál laran. Sin. jornalista."
  },
  {
    "word": "rede",
    "class": "Substantivu",
    "meaning": "1. Hena oin ida halo ho kabas-lahan barak suku hamutuk ho kuak ki'ik barak iha leet, neʼebé serve nu'udar fatin atu tau sasán, selae atu kaer ikan ka manu-fuik. Sin. dai. 2. Fatin ka ema balu neʼebé ketaketak maibé iha fafutuk ka ligasaun ba malu."
  },
  {
    "word": "redentór - redentora, f.",
    "class": "Substantivu",
    "meaning": "Ema neʼebé redime ka soi. Sin. maksoin."
  },
  {
    "word": "redime",
    "class": "Verbu",
    "meaning": "1. Sosa fali buat ruma neʼebé ita peñora tiha ona; 2. Sosa fali hodi liberta refein ida. Sin. soi."
  },
  {
    "word": "redensaun",
    "class": "Substantivu",
    "meaning": "Hahalok redime nian. Sin. sasoin."
  },
  {
    "word": "redentivu - redentiva, f.",
    "class": "Adjetivu",
    "meaning": "Ne'ebé soi ka salva. Sin. maksoin."
  },
  {
    "word": "redús",
    "class": "Verbu",
    "meaning": "Halo atu sai ki'ik liu ka ladún barak. Sin. hamenus, haki'ik."
  },
  {
    "word": "redusaun",
    "class": "Substantivu",
    "meaning": "Hahalok redús nian."
  },
  {
    "word": "reembolsa",
    "class": "Verbu",
    "meaning": "Fó fali osan neʼebé ema ruma gasta."
  },
  {
    "word": "reembolsu",
    "class": "Substantivu",
    "meaning": "Hahalok reebolsa nian."
  },
  {
    "word": "reen-toos",
    "class": "Substantivu",
    "meaning": "Parte ulun-fatuk nian iha fuuk no matan sira-nia leet."
  },
  {
    "word": "refein",
    "class": "Substantivu",
    "meaning": "Ema ida neʼebé kriminozu ka funu-na'in sira kaer tiha no hadadur to'o ema ne'e nia família ka kolega sira halo tuir buat ida neʼebé kriminozu ka funu-na'in sira ezije, liuliu selu osan."
  },
  {
    "word": "refeisaun",
    "class": "Substantivu",
    "meaning": "1. Han-hemu ida. 2. Ai-han neʼebé ema han durante tempu han nian. Sin. hahán."
  },
  {
    "word": "refeitóriu",
    "class": "Substantivu",
    "meaning": "Sala-jantár iha konventu ka mosteiru laran."
  },
  {
    "word": "referendu",
    "class": "Substantivu",
    "meaning": "Votasaun neʼebé hala'o hodi husu sidadaun hotuhotu nia hanoin no hakarak kona-ba hakotun polítiku ruma. Ez. Iha referendu kona-ba Timór nia futuru ne'ebé hala'o iha tinan 1999, 78% hosi Timoroan sira hili atu haketak an hosi Indonézia hodi hamriik nu'udar nasaun ida."
  },
  {
    "word": "refere",
    "class": "Verbu",
    "meaning": "1. Temi kona-ba ema ruma ka buat ruma. Sin. haktemik. 2. Haktuir, konta."
  },
  {
    "word": "referénsia",
    "class": "Substantivu",
    "meaning": "1. Hahalok temi nian. Sin. haktemik. 2. Haktemik kona-ba hakerek ka dokumentu ida-neʼebé autór konsulta tiha ka uza hodi prepara nia livru ka artigu. Ez. Iha universidade peskiza ka teze neʼebé estudante sira prepara tenke iha referénsia barak hodi hatudu informasaun ne'ebé sira hato'o mai hosi neʼebé loos."
  },
  {
    "word": "refila",
    "class": "Verbu",
    "meaning": "Hatán lahó respeitu ba ema nia ko'alia. Sin. hatán-filak."
  },
  {
    "word": "refiladór",
    "class": "Substantivu / Adjetivu",
    "meaning": "(Ema) neʼebé refila beibeik."
  },
  {
    "word": "refinaria",
    "class": "Substantivu",
    "meaning": "Fábrika hodi hamihis substánsia industriál hanesan mina-rai, ka ai-han hanesan masin-midar."
  },
  {
    "word": "reflete",
    "class": "Verbu",
    "meaning": "1. Hatudu fali, liuliu buat ka ema ida nia ilas. Sin. leno, haleno. 2. Hanoin ho kuidadu. Sin. hakbadan, baberak."
  },
  {
    "word": "reflesaun",
    "class": "Substantivu",
    "meaning": "Hahalok reflete nian."
  },
  {
    "word": "reforma",
    "class": "Verbu / Substantivu",
    "meaning": "Verbu: 1. Forma ka halo filafali. 2. Haso'i hodi hadi'a buat ida neʼebé aat ka sabraut ona, liuliu instituisaun ida. 3. Para ho hahalok aat hodi fila ba hahalok di'ak nafatin. 4. Sai hosi serbisu ona tanba ita katuas ona ka moras. Substantivu: 1. Hahalok reforma nian. 2. Fuan ka efeitu reforma nian. Istoriadór sira fó naran Reforma ba lalebak ka rebeliaun boot ida hasoru Amu-Papa no Kreda Katólika neʼebé hahú iha rai-Alemaña iha sékulu da-16 no naklekar ba rain oioin iha Europa Norte hodi hamosu kreda protestante barak."
  },
  {
    "word": "reformadór - reformadora, f.",
    "class": "Substantivu",
    "meaning": "Ema neʼebé reforma buat ruma."
  },
  {
    "word": "reformadu - reformada, f.",
    "class": "Adjetivu / Substantivu",
    "meaning": "Adjetivu: 1. Ne'ebé reforma tiha ona. 2. Neʼebé tuir prinsípiu Reforma Protestante nian. Sin. protestante. Substantivu: Ema neʼebé para nia serbisu tanba katuas ka moras ona."
  },
  {
    "word": "refreska",
    "class": "Verbu",
    "meaning": "1. Halo sai matak filafali, hanesan modo-tahan neʼebé rai iha jeleira. 2. Hafoun, hadi'a ka hamoris filafali. Sin. hamatak."
  },
  {
    "word": "refujiadu - refujiada, f.",
    "class": "Substantivu",
    "meaning": "Ema neʼebé halai hosi nia uma, knua ka rain tan dezastre naturál, funu, ka persegisaun kona-ba relijiaun ka vizaun polítika neʼebé seluk. Sin. malaik."
  },
  {
    "word": "refújiu",
    "class": "Substantivu",
    "meaning": "Fatin ida atu hakmahan liutiha halai hosi perigu ruma. Sin. hakmahan-fatin."
  },
  {
    "word": "rega",
    "class": "Verbu",
    "meaning": "1. Husik, tau ka fakar bee ba ai-horis neʼebé ema kuda atu nia bele moris. 2. Ko'alia demais hodi aumenta informasaun oioin ne'ebé la presta; hakole ema seluk tanba ita ko'alia mesak de'it hodi halo ema sira rona ita ho pasiénsia."
  },
  {
    "word": "regadór",
    "class": "Substantivu",
    "meaning": "1. Kaleen ka masa bee nian neʼebé ema uza atu tau bee hodi rega ai-horis. 2. Ema ne'ebé ko'alia barak, aumenta informasaun barak neʼebé la presiza, no la fó-tempu bá ema seluk atu ko'alia."
  },
  {
    "word": "regra",
    "class": "Substantivu",
    "meaning": "Ukun-fuan ida neʼebé ema tenke kumpre atu buat hotu bele la'o loloos no di'ak. Sin. regulamentu. Ez. Regra tránzitu nian importante ba ema hotu atu bele minimiza dezastre iha lurón."
  },
  {
    "word": "régua",
    "class": "Substantivu",
    "meaning": "Instrumentu ida hodi sukat buat ida nia naruk ka badak, ho tadak oioin neʼebé marka ho sentímetru no milímetru. Sin. ai-sukat, kasukat."
  },
  {
    "word": "regula",
    "class": "Verbu",
    "meaning": "Hala'o ka haloos tuir regra ka banati. Sin. hamkadak."
  },
  {
    "word": "regulasaun",
    "class": "Substantivu",
    "meaning": "Hahalok regula nian."
  },
  {
    "word": "regulamentu",
    "class": "Substantivu",
    "meaning": "Ukun-fuan ka regra ofisiál neʼebé aplika ba ema ka kazu hotu-hotu."
  },
  {
    "word": "regulár",
    "class": "Adjetivu",
    "meaning": "1. Neʼebé loos tanba tuir regra. 2. Neʼebé baibain nian. Sin. normál. 3. Neʼebé tuir lei. Sin. legál."
  },
  {
    "word": "regularidade",
    "class": "Substantivu",
    "meaning": "Kualidade ka kondisaun buat nian ne'ebé regulár."
  },
  {
    "word": "regulariza",
    "class": "Verbu",
    "meaning": "Halo regulár; halo atu la'o tuir regra."
  },
  {
    "word": "regularizasaun",
    "class": "Substantivu",
    "meaning": "Hahalok regulariza nian."
  },
  {
    "word": "re'i",
    "class": "Verbu",
    "meaning": "1. Halo kona ibun-tutun ba ibun-tutun atu hatudu afeisaun ka domin. Sin. muu. 2. Hakona inus ho inus hodi hatudu afeisaun. Sin. anauk. 3. Hakona ibun-tutun ka inus ba liman-belar hodi husu bensa ba ema boot, katuas ka ferik sira."
  },
  {
    "word": "re'in",
    "class": "Substantivu",
    "meaning": "Hahalok re'i nian. Sin. muun."
  },
  {
    "word": "reinadu",
    "class": "Substantivu",
    "meaning": "Tempu hira mak reinu ida tahan."
  },
  {
    "word": "reinu",
    "class": "Substantivu",
    "meaning": "1. Rain ida neʼebé liurai ida mak ukun. 2. Rain nia mahorik hotu-hotu. Sin. povu."
  },
  {
    "word": "reitór - reitora, f.",
    "class": "Substantivu",
    "meaning": "1. Ulun-boot universidade nian. 2. (reitór) Amlulik neʼebé ulun-boot semináriu nian."
  },
  {
    "word": "reitoria",
    "class": "Substantivu",
    "meaning": "Reitór ka reitora nia serbisu-fatin ka eskritóriu."
  },
  {
    "word": "rejeita",
    "class": "Verbu",
    "meaning": "La simu ka lakohi (buat ka ema ruma). Sin. hebai, hatiran. Ez. Prezidente rejeita proposta-lei kona-ba hasa'e impostu sira to'o 20%."
  },
  {
    "word": "rejeisaun",
    "class": "Substantivu",
    "meaning": "Hahalok rejeita nian. Sin. hebain, hatiran."
  },
  {
    "word": "rejente",
    "class": "Substantivu",
    "meaning": "Ema ida neʼebé hesi ka dirije orkestra. Sin. maun-hesik orkestra."
  },
  {
    "word": "rejiaun",
    "class": "Substantivu",
    "meaning": "Área neʼebé luan ho nia rain, identidade no territóriu."
  },
  {
    "word": "rejime",
    "class": "Substantivu",
    "meaning": "1. Sistema ukun ka governu daudaun nian. 2. Programa hamenus ai-han loroloron nian neʼebé ema ida tuir atu hatún nia todan ka bokur. Sin. dieta."
  },
  {
    "word": "rejimentu",
    "class": "Substantivu",
    "meaning": "Soldadu-lubun neʼebé tenente-koronél ida mak haruka."
  },
  {
    "word": "rejimentál",
    "class": "Adjetivu",
    "meaning": "Rejimentu nian."
  },
  {
    "word": "rejionál",
    "class": "Adjetivu",
    "meaning": "Rejiaun nian."
  },
  {
    "word": "rejista",
    "class": "Verbu",
    "meaning": "Tau ka hakerek naran iha lista ofisiál ida."
  },
  {
    "word": "rejistu",
    "class": "Substantivu",
    "meaning": "1. Hahalok rejista nian. 2. Lista ofisiál ida ho ema sira-nia naran sira. 3. (linguístika) Nivel ko'alia nian. Ez. Lia-tetun nia rejistu sientífiku uza liafuan portugés ka internasionál barak."
  },
  {
    "word": "rekadu",
    "class": "Substantivu",
    "meaning": "Liafuan sira neʼebé ita tatoli ba ema seluk. Sin. lia-tatoli, mensajen."
  },
  {
    "word": "rekarga",
    "class": "Substantivu",
    "meaning": "1. Hahalok rekarrega nian. 2. Forsa elétrika ka tinta kartús ida atu hatama ba mákina ruma."
  },
  {
    "word": "rekarrega",
    "class": "Verbu",
    "meaning": "Hatama filafali korrente elétrika, n.e. iha bateria karreta, komputadór, ka telefone nian; hatama filafali tinta ba impresora ka mákina imprime. Ez. Ema presiza rekarrega fali karreta nia bateria atu nia bele iha forsa bainhira serbisu."
  },
  {
    "word": "rekerente",
    "class": "Substantivu",
    "meaning": "Ema neʼebé husu buat ka kargu ida liuhosi surat formál. Sin. mahusuk."
  },
  {
    "word": "rekerimentu",
    "class": "Substantivu",
    "meaning": "Surat formál hodi husu buat ka kargu ida. Sin. hahusuk."
  },
  {
    "word": "rékien (misa-)",
    "class": "Substantivu",
    "meaning": "Misa neʼebé amlulik reza ba matebian, atu nia klamar bele sai lailais hosi purgatóriu ka sees hosi kastigu-infernu se la so'i atu bá loos lalehan. Sin. misa-matebian."
  },
  {
    "word": "reklama",
    "class": "Verbu",
    "meaning": "1. Husu namanas direitu ida. 2. Hato'o ba autoridade kona-ba susar ruma neʼebé ita foin hetan no autoridade ne'e bele remedeia. Sin. kesar."
  },
  {
    "word": "reklamasaun",
    "class": "Substantivu",
    "meaning": "Hahalok reklama nian. Sin. kakesar."
  },
  {
    "word": "reklamante",
    "class": "Substantivu",
    "meaning": "Ema neʼebé hato'o reklamasaun. Sin. makesar, kesar-na'in."
  },
  {
    "word": "reklasifika",
    "class": "Verbu",
    "meaning": "Klasifika filafali."
  },
  {
    "word": "reklasifikasaun",
    "class": "Substantivu",
    "meaning": "Hahalok reklasifika nian."
  },
  {
    "word": "rekomenda",
    "class": "Verbu",
    "meaning": "Fó-hanoin, husu ka hameno hela atu ema halo tuir buat neʼebé ita hato'o. Sin. lia-menon."
  },
  {
    "word": "rekomendasaun",
    "class": "Substantivu",
    "meaning": "Lia-menon neʼebé hato'o atu husu ema halo ka lao tuir."
  },
  {
    "word": "rekompensa",
    "class": "Verbu / Substantivu",
    "meaning": "Verbu: Selu fali servisu ida ka buat neʼebé lakon ka aat. Substantivu: Hahalok ka buat neʼebé ita selu filafali ba ema ne'ebé merese ka presiza. Sin. selu-kole."
  },
  {
    "word": "rekoñese",
    "class": "Verbu",
    "meaning": "1. Hatene filafali, hanoin hikas ema ka buat nia identidade. Sin. tada. 2. Iha konxiénsia ka hanoin filafali kona-ba buat ruma. 3. Hatene no simu buat neʼebé loos, válidu no iha. 4. Hato'o agradesimentu, ka apresiasaun."
  },
  {
    "word": "rekoñesimentu",
    "class": "Substantivu",
    "meaning": "Hahalok rekoñese nian. Sin. tatadak."
  },
  {
    "word": "rekonsilia",
    "class": "Verbu",
    "meaning": "Hamaus ema ida atu haluha nia hirus no simu ita filafali. Sin. hadame."
  },
  {
    "word": "rekonsiliasaun",
    "class": "Substantivu",
    "meaning": "Hahalok rekonsilia nian. Sin. hadamen. Ez. Rekonsiliasaun lahó justisa bele hamosu konflitu foun."
  },
  {
    "word": "rekonstrui",
    "class": "Verbu",
    "meaning": "Konstrui ka harii filafali."
  },
  {
    "word": "rekonstrusaun",
    "class": "Substantivu",
    "meaning": "Hahalok rekonstrui nian."
  },
  {
    "word": "rekordasaun",
    "class": "Substantivu",
    "meaning": "Buat neʼebé ita rai hela atu bele fó-hanoin nafatin kona-ba ema ne'ebé lakon ka mate ona, ka fatin neʼebé dook ona. Sin. katamik, lembransa."
  },
  {
    "word": "rekorde",
    "class": "Substantivu",
    "meaning": "Rezultadu foun iha kompetisaun ida neʼebé liu ida ne'ebé di'ak liu hotu be mosu to'o agora."
  },
  {
    "word": "rekreia",
    "class": "Verbu",
    "meaning": "Halo ema haksolok no hamnasa liuhosi halimar ka espetákulu ruma. Sin. diverte."
  },
  {
    "word": "rekreiu",
    "class": "Substantivu",
    "meaning": "1. Atividade ruma atu diverte ita-nia an ka ema seluk, n.e. bá pasiar, tebe bola, hariis tasi nst. 2. Iha eskola, tempu badak deskansa ka halimar nian."
  },
  {
    "word": "rekruta",
    "class": "Verbu / Substantivu",
    "meaning": "Verbu: Hatama ema foun atu halo knaar ruma iha militár ka serbisu-fatin seluk. Sin. huhi. Ez. Bainhira kompañia foun tama Timór, nia sei rekruta ema barak atu serbisu. Substantivu: Ema neʼebé tama ona tropa ka organizasaun militár ruma."
  },
  {
    "word": "rekrutamentu",
    "class": "Substantivu",
    "meaning": "Hahalok rekruta nian."
  },
  {
    "word": "rekupera",
    "class": "Verbu",
    "meaning": "1. Hetan filafali. 2. Hetan isin-di'ak filafali."
  },
  {
    "word": "rekuperasaun",
    "class": "Substantivu",
    "meaning": "Hahalok rekupera nian."
  },
  {
    "word": "rekursu",
    "class": "Substantivu",
    "meaning": "1. Remédiu ba susar ka problema ruma. 2. Hahusuk ba ajuda ruma. 3. Hahusuk ba tribunál haree fali hakotun ka sentensa ida. Sin. tamein. 4. Materiál ida neʼebé serve hodi halo serbisu ruma ka hala'o projetu ruma. Ez. Hodi hanorin lia-tetun ita presiza rekursu barak."
  },
  {
    "word": "relasaun",
    "class": "Substantivu",
    "meaning": "1. Ligasaun entre ema ka buat ruma. Sin. fafutuk. 2. Oinsá ema na'in-rua ka grupu rua konsidera malu. 3. Liafuan jogu ida neʼebé hakerek tuir malu, ida uluk ba ida seluk. 4. Kualidade neʼebé ita bele tanesan ka kompara entre buat rua ka ema naʼin-rua."
  },
  {
    "word": "relasiona",
    "class": "Verbu",
    "meaning": "1. Hatudu buat ida nia fafutuk ka relasaun ho buat seluk. Sin. haka'it. 2. Halo lista kona-ba buat ruma. Sin. halista."
  },
  {
    "word": "relativu - relativa, f.",
    "class": "Adjetivu",
    "meaning": "Kona-ba fafutuk ka relasaun entre buat rua ka ema na'in-rua. Ez. Ha'u foin lee relatóriu ida relativu ba problema bee nian iha distritu Baukau."
  },
  {
    "word": "relatóriu",
    "class": "Substantivu",
    "meaning": "Haktuir hakerek ka ko'alia kona-ba buat ka situasaun ruma, selae kona-ba ema ruma nia hahalok. Ez. Tinan-tinan, eskola sira presiza hatoo relatóriu ba aman-inan estudante sira-nian."
  },
  {
    "word": "relaxa",
    "class": "Verbu",
    "meaning": "1. (Halo atu) sai kalma, hakmatek no laran ladún ta'uk ka nakdedar. 2. Sai ladún maka'as ka formál hanesan baibain de'it; namkore uituan. Sin. hakore."
  },
  {
    "word": "relaxadu - relaxada, f.",
    "class": "Adjetivu",
    "meaning": "Iha kondisaun neʼebé informál."
  },
  {
    "word": "relaxamentu",
    "class": "Substantivu",
    "meaning": "Hahalok relaxa nian."
  }
]

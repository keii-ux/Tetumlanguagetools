  {
    "word": "insistente",
    "class": "Adjetivu",
    "meaning": "; Sin. maklitik"
  },
  {
    "word": "inskreve",
    "class": "Verbu",
    "meaning": "1. Hakerek ka halo letra iha objetu ida nia leten, nu'udar ezemplu iha fatuk ka ai nia leten. 2. Tau naran, nu'u-dar ezemplu ba kursu iha universidade."
  },
  {
    "word": "inskrisaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "insólitu - insólita",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé la baibain akontese ka eskizitu uitoan."
  },
  {
    "word": "insoluvel",
    "class": "Adjetivu",
    "meaning": "1. (Ai-moruk ka ai-han) neʼebé la nabeen bainhira ita tau tiha iha bee. 2. (Problema) neʼebé ita la kon-sege rezolve."
  },
  {
    "word": "insolubilidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "insónia",
    "class": "Substantivu",
    "meaning": "Moras neʼebé halo ema susar atu dukur. Sin. moras dukur-laek"
  },
  {
    "word": "inspesiona",
    "class": "Verbu",
    "meaning": "Fihir ka ezamina atu hatene loloos konaba buat ida. Sin. le-hat Ez. Xefe polísia nian sei inspesiona nia membru sira atu buka-hatene se sira serbisu tuir orden sira neʼebé nia halolo ba sira ida-idak."
  },
  {
    "word": "inspesaun",
    "class": "Substantivu",
    "meaning": "; Sin. lalehat"
  },
  {
    "word": "inspetór - inspetora",
    "class": "f. Substantivu",
    "meaning": "Ema neʼebé inspesiona. Sin. maklehat"
  },
  {
    "word": "inspira",
    "class": "Verbu",
    "meaning": "1. Fó hanoin ka ideia ba ema; fó esperansa no laranmanas foun. Sin. hamehi Ez. Feto bonita ida mak inspira poeta foin-sa'e nee atu hakerek poezia furak ida kona-ba domin. 2. Halo buat ida mosu hodi fó laran-manas ba ema ida; fó impulsu ba buat ruma. Sin. ha-liras Ez. Asuain sira-nia sakrífisiu inspira tebetebes povu nia luta ba ukun rasik-an."
  },
  {
    "word": "inspirasaun",
    "class": "Substantivu",
    "meaning": "; Sin. hamehin, haliras"
  },
  {
    "word": "inspiradu - inspirada",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé inspira ka fó inspirasaun; neʼebé hamehi ka haliras. Sin. mamehik, maliras Ez. Diretora foun nee fó ezemplu inspi-radór ba kolega sira."
  },
  {
    "word": "instavel",
    "class": "Substantivu",
    "meaning": "Neʼebé lametin, liuliu kona-ba seguransa no emosaun. Ez. Bainhira situasaun ne'e instavel, dezen-volvimentu sei hasoru dezafiu barak."
  },
  {
    "word": "instabilidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "instala",
    "class": "Verbu",
    "meaning": "Monta ka tau ekipamentu ida iha fatin foun ida, no halo nia prontu ba ema atu uza. Ez. Atu komunika ho fatin seluk liuhosi korreiu eletróniku, ita presiza instala liña-telefone hodi liga ba kom-putadór."
  },
  {
    "word": "instalasaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "instaladór - instadora",
    "class": "Substantivu",
    "meaning": "Emaneʼebé instala ekipamentu iha fatin foun ida."
  },
  {
    "word": "instante",
    "class": "Substantivu",
    "meaning": "Momentu ida de'it."
  },
  {
    "word": "instantáneu - instantánea",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé akontese kedas no la demora."
  },
  {
    "word": "instaura",
    "class": "Verbu",
    "meaning": "Harii no hametin sistema, instituisaun ka organizasaun ida. Sin. estabelese, institui Ez. Timor-Leste ins-taura ninia tribunál rekursu nian iha tinan 2003."
  },
  {
    "word": "instintu",
    "class": "Substantivu",
    "meaning": "Hali'is ka tendénsia naturál atu hala'o buat ida."
  },
  {

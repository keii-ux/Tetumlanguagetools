  {
    "word": "imajen",
    "class": "Substantivu",
    "meaning": "1. Dezeñu ema, balada ka buat ida nian. Sin. ilas 2. Aparénsia neʼebé ema ka organizasaun ida hatudu ba públiku. Ez. Nasaun neʼebé la respeita direitu umanu bele estraga nia imajen iha mundu."
  },
  {
    "word": "imajina",
    "class": "Verbu",
    "meaning": "1. Forma ideia ka hanoin ida iha ulun kona-ba buat ruma. Sin. haree to'ok, hakmehik 2. Hanoin kona-ba buat ida neʼebé seidauk eziste ka mosu. Ez. Susar atu imajina knaar todan ne'ebé pioneiru sira hulan hodi harii ita-nia nasaun."
  },
  {
    "word": "imajináriu - imajinária",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé eziste iha de'it ita-nia hanoin, la'ós iha realidade; neʼebé ita mehi de'it. Sin. mehik"
  },
  {
    "word": "imakuladu - imakulada",
    "class": "f. Adjetivu",
    "meaning": "1. Neʼebé moos tomak hotu tanba la iha noda ida. Sin. nodalaek 2. Neʼebé la iha sala ida. Imakulada Konseisaun ka Nanaran Noda-Laek ne'e doutrina Kreda Katólika nian kona-ba Santa Ana ko'us tiha Mar-ia Santísima lahó sala orijinál."
  },
  {
    "word": "Imalaia",
    "class": "",
    "meaning": "haree Himalaia"
  },
  {
    "word": "iman",
    "class": "Substantivu",
    "meaning": "Besi pedasuk ida ho forsa magnétika neʼebé bele dada besi seluk, halo atu belit ka ka’it ba nia."
  },
  {
    "word": "imaturidade",
    "class": "Substantivu",
    "meaning": "Kualidade neʼebé seidauk dezenvolve hotu no la tasak, refere liuliu ba ema. Liafuan-sorun: maturidade Ez. Imaturidade neʼebé pesoál membru balu iha bele hanetik xefe atu fó responsabilidade boot ba sira hodi hala'o knaar loroloron nian."
  },
  {
    "word": "imediatu - imediata",
    "class": "f. Adjetivu",
    "meaning": "1. Neʼebé tenke hala’o kedas no la bele hein tan. Sin. kedak Ez. Subdistritu barak susar ai-han tanba udan, tanba ne'e ajuda tenkesér imediata. 2. Neʼebé tempu, es-pasuno relasaun rabat ka besik hela."
  },
  {
    "word": "imediatamente",
    "class": "Advérbiu",
    "meaning": "Halo lailais kedas, la hein minutu ida. Ez. Bainhira ema na’ok nia sasán, Sr. Markus imediata-mente bá fóhatene polísia."
  },
  {
    "word": "imensu - imensa",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé nia tamañu ka kuantidade boot tebes. Sin. sukat-laek, sukatlabelek Ez. Espasu ne'ebé hale'i ita-nia planeta Rai imensu."
  },
  {
    "word": "imi",
    "class": "Pronome Emak",
    "meaning": "Liafuan ida neʼebé hak-temik ema lubun ida neʼebé ita ko'alia bá ka hakerek bá. Pronome Maksoik Forma badak ba imi-nia, n.e. imi oan = imi-nia oan"
  },
  {
    "word": "imigra",
    "class": "Verbu",
    "meaning": "Muda hodi hela metin no kleur ka ba nafatin iha rain seluk. Sin. solat Ez. Timoroan barak imigra ba Por-tugál bainhira invazaun hahú. imigras-aun Substantivu; Sin. sasolat"
  },
  {
    "word": "imigrante",
    "class": "Substantivu",
    "meaning": "Ema neʼebé husik hela nia rain hodi bá horik metin iha rain seluk. Sin. maksolat"
  },
  {
    "word": "iminente",
    "class": "Substantivu",
    "meaning": "Neʼebé atu akontese ona, hanesan tabelen hela iha ita-nia leten. Sin. tatahek Ez. Ami taʼuk katak funu iminente ona."
  },
  {
    "word": "imi-nia",
    "class": "Adjetivu Maksoik",
    "meaning": "Liafuan hodi refere ba buat neʼebé pertense ka rela-siona ho ema lubun ida neʼebé ita ko'alia ka hakerek bá. Pronome ne'e tuur uluk-ba Substantivu, n.e. Imi-nia uma."
  },
  {
    "word": "imi-nian",
    "class": "Pronome Maksoik",
    "meaning": "Maklalin ka variante ba imi-nia neʼebé baibain tuir Substantivu ida-neʼebé nia refere bá. Ez. Se uma ne'e iminian, imi tenke apre-zenta nia dokumentu sira."
  },
  {
    "word": "imita",
    "class": "Verbu",
    "meaning": "1. Hasara. Ez. Kakae no loriku gosta imita ema sira-nia lian. 2. Halo buat ida filafali hodi kopia ka reprodús nia karakterístika sira. Ez. Hodi prepara programa ne'e ba televizaun, ami imita filme fransés ida neʼebé sai tinan balu liubá. 3. Halo tuir de'it. Ez. Diak bainhira labarik sarani sira imita santu sira-nia ezemplu diak."
  },
  {
    "word": "imitasaun",
    "class": "Substantivu",
    "meaning": "; Sin. hasaran"
  },
  {
    "word": "imitadór - imitadora",
    "class": "f. Substantivu",
    "meaning": "Ida neʼebé gosta hasara, kopia ka halo tuir ema seluk ka buat ida. Sin. masarak"
  },
  {
    "word": "imobiliária",
    "class": "Substantivu",
    "meaning": "Empreza ida neʼebé faʼan propriedade no uma sira."
  },
  {
    "word": "imobiliáriu - imobiliária",
    "class": "f. Adjetivu",
    "meaning": "Ko-na-ba imobiliária. Ajente imobiliáriu ne'e ema ida neʼebé fa'an ema seluk nia uma ka rai, hodi simu kiuani ka komisaun ba nia servisu."
  },
  {
    "word": "imorál",
    "class": "Adjetivu",
    "meaning": "Neʼebé la iha moralidade; neʼebé nia hahalok baibain aat. Sin. laran-foʼer Ez. Ulun-boot neebé imorál sei bele lori nasaun ida ba susar."
  },
  {
    "word": "imoralidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "imovel",
    "class": "Adjetivu",
    "meaning": "1. Neʼebé la book an ka neʼebé metin hela iha fatin de'it. 2. Ne'ebé ita la bele muda tun-sa'e."
  },
  {
    "word": "imobilidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "impaktu",
    "class": "Substantivu",
    "meaning": "1. Hahalok hosi objetu ida kona ida seluk. Sin. xoke 2. Efeitu maka'as ba situasaun ka ema ida. Ez. Impaktu hosi ai-han nia folin aas maka povu hamlaha no terus."
  },
  {
    "word": "impar",
    "class": "Adjetivu",
    "meaning": "(Númeru) neʼebé laiha pár. Sin. kliik"
  },
  {
    "word": "imparsiál",
    "class": "Adjetivu",
    "meaning": "Neʼebé la hali'is ba ema, grupu ka hanoin ida de'it. Ez. Obser-vadór internasionál sira tenke imparsiál iha votasaun ba independénsia."
  },
  {
    "word": "imparsialidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "impasiénsia",
    "class": "Substantivu",
    "meaning": "Kualidade laiha pasiénsia. Sin. hakterus-laek Ez. Impasi-énsia bele hamosu problema barak."
  },
  {
    "word": "impasiente",
    "class": "Adjetivu",
    "meaning": ""
  },
  {
    "word": "impedidu - impedida",
    "class": "f. Adjetivu",
    "meaning": "(Liña tel-efone) neʼebé ita la bele uza tanba ema seluk uza daudaun."
  },
  {
    "word": "impedimentu",
    "class": "Substantivu",
    "meaning": "Buat-netik, buat neʼebé hanetik. Sin. kanetik, obstákulu"
  },
  {
    "word": "imperadór - imperadora",
    "class": "f. Substantivu",
    "meaning": "Ema neʼebé ukun impériu ida."
  },
  {
    "word": "imperativu - imperativa",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé urjente tebes ka importante. Adjetivul Substantivu Iha gramátika, forma Verbu nian neʼebé ita uza atu hato'o orden ka haruka halo buat ruma. Advérbiu bá maka tadak imparativu nian iha lia-tetun, n.e. hakerek bá! Sin. madenik"
  },
  {
    "word": "imperfeitu - imperfeita",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé la perfeitu. Sin. laperfeitu"
  },
  {
    "word": "imperializmu",
    "class": "Substantivu",
    "meaning": "Sistema governu nian neʼebé buka atu harii impériu ida hodi halekar nia podér. Ez. Povu Timór kontra kolonializmu no imperializmu tanba ne'e sistema be ladi'ak."
  },
  {
    "word": "imperalista",
    "class": "Adjetivu",
    "meaning": ""
  },
  {
    "word": "impériu",
    "class": "Substantivu",
    "meaning": "1.Reinu boot tebetebes, neʼebé baibain mosu bainhira nasaun ida invade hodi ukun nasaun seluseluk. Ez. Impériu romanu horiuluk ukun rai-Europa parte boot no rain seluseluk hale'u Tasi- Mediterráneu. 2. Kualkér ukun boboot no luan, inklui mós emp-reza komersiál."
  },
  {
    "word": "impesoál",
    "class": "Adjetivu",
    "meaning": "Neʼebé la foka ema ida de'it, halo ita sente katak indivíduu no nia sentimentu sira ladún importa."
  },
  {
    "word": "impesoalidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "implementa",
    "class": "Substantivu",
    "meaning": "Hala'oplanu, orden ka lei ida. Ez. Governu hatama tiha ona dekretu ida kona-ba dalen ofisiál; oras ne'e presiza implementa dekretu nee."
  },
  {
    "word": "implementasaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "implika",
    "class": "Verbu",
    "meaning": "1.Sujere, fóentende.2.Envo-lve, presiza. Sin. haklahat Ez. Hala'o pro-jetu hanesan ne'e implika matenek boot no serbisu todan. Espresaun implika ho ema katak buka lia ho ema ruma."
  },
  {
    "word": "implikante",
    "class": "Adjetivu",
    "meaning": "Neʼebé gosta buka lia ho ema seluk. Sin. bukaliadór"
  },
  {
    "word": "implísitu - implísita",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé ita bele hetan iha laran, maski la mosu iha li'ur. Ez. Linguista sira hato'o katak lia-portugés implísitu iha lia-tetun, tanba ale-inde liafuan empresta barabarak, estrutura basuk lia-tetun nian tuir banati portugés."
  },
  {
    "word": "impoin",
    "class": "Verbu",
    "meaning": "Obriga atu simu buat ruma, liuliu programa ka polítika ida. Sin. hamonu"
  },
  {
    "word": "importa",
    "class": "Verbu",
    "meaning": "1. Hameno sasán hosi tasi-balun atubele fa'an iha rai-laran. 2. Iha importánsia. 3. Sente ka hanoin katak buat ruma importante."
  },
  {
    "word": "importadu - importada",
    "class": "f. Adjetivu",
    "meaning": "(Objetu ka sasán) neʼebé ema importa ka hameno hosi tasibalun."
  },
  {
    "word": "importadór - importadora",
    "class": "f. Substantivul Adjetivu",
    "meaning": "Neʼebé hatama sasán hosi tasi-balun hodi fa'an."
  },
  {
    "word": "importante",
    "class": "Adjetivu",
    "meaning": "1. Neʼebé iha impor-tánsia ka presiza. Ez. Bee maka kom-ponente ne'ebé importante ba ita ema nia isin. 2. Neʼebé soi influénsia ka podér barak; neʼebé ita tenke fó valór bá. Ez. Prezidente-repúblika no Ambispu Dili ema naʼin-rua neʼebé importante. 3. Boot ka barak. Ez. Elementu portugés iha lia-tetun importante liu elementu malaiu."
  },
  {
    "word": "importánsia",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "importasaun",
    "class": "Substantivu",
    "meaning": "1. Hahalok ka serbisu importa sasán. 2. Buat ka pro-dutu importadu."
  },
  {
    "word": "imposivel",
    "class": "Adjetivu",
    "meaning": "Neʼebé la bele akontese ka la bele hala'o. Sin. labelek Ez. Maski iha filme ita haree ema semo, iha reali-dade ida-ne'e imposivel."
  },
  {
    "word": "imposibilidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "impostu",
    "class": "Substantivu",
    "meaning": "Osan neʼebé ema tenke selu ba governu atu nia bele haraik servisu ba públiku, porezemplu saúde, edukasaun, bee, eletrisidade nst."
  },
  {
    "word": "impotente",
    "class": "Substantivu",
    "meaning": "1. Neʼebé kuran kbiit ka forsa. Sin. kbiit-laek 2. Mane ida neʼebé la bele hala'o relasaun seksuál, liuliu tan moras ruma."
  },
  {
    "word": "impoténsia",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "impozisaun",
    "class": "Substantivu",
    "meaning": "Hahalok ka rezul-tadu impoin nian."
  },
  {
    "word": "imprensa",
    "class": "Substantivu",
    "meaning": "1. Fatin ida atu im-prime livru ka dokumentu sira. Sin. tipografia, gráfika Ez. Timór presiza imprensa nasionál ida atubele imprime dokumentu governu nian. 2. Klibur ka sosiedadekomersiálne'ebépublikajornál. 3. Indústria jornalizmu; jornalista sira. Ez. Maski governu foin fó sai dekretu kona-ba liatetun, imprensa hanetik hela lia-tetun nia progresu hodi imprime jornál oioin ho ortografia sabraut."
  },
  {
    "word": "impresaun",
    "class": "Substantivu",
    "meaning": "1. Buat ida ne'ebé ita imprime. Sin. hatuin 2. Tadak ka marka hosi buat ida ne'ebé hanehan. Sin. hanehanfatin 3. Ema nia hanoin ka opiniaun kona-ba buat foun ida. Ez. Hau hato'o tiha ona ba kolega sira ha'u-nia impresaun sira kona-baprograma foun."
  },
  {
    "word": "impresionante",
    "class": "Adjetivu",
    "meaning": "Neʼebé atrai ita ka halo ita admira tanba boot, barak, kapás ka aat liu. Ez. Jogu ne'ebé impresionante sei dada adeptu barak ba kampu atu asiste."
  },
  {
    "word": "impresizu - impresiza",
    "class": "f. Adjetivu",
    "meaning": "1. Neʼebé la kona loloos. Sin. lakonak 2. Neʼebé ladún klaru ka sabraut uitoan."
  },
  {
    "word": "impresora",
    "class": "Substantivu",
    "meaning": "Mákina neʼebé ita uza atu imprime dokumentu ida."
  },
  {
    "word": "impresora-leizer",
    "class": "Substantivu",
    "meaning": "Impresora neʼebé uza leizer atu imprime doku-mentu ho kualidade kapás."
  },
  {
    "word": "impresu",
    "class": "Substantivu",
    "meaning": "1. Surattahan neʼebé iha informasaun kona-ba asuntu par-tikular ida. 2. Fixa ka formuláriu ida neʼebé imprime ba ema sira prenxe."
  },
  {
    "word": "imprime",
    "class": "Verbu",
    "meaning": "Reprodús letra ka númeru sira iha surattahan ida ho dalan me-kániku. Sin. hatui Ez. Molok asina, ita presiza imprime lai."
  },
  {
    "word": "inabitada",
    "class": "",
    "meaning": "dokumentu ne'e iha surat-tahan ho kabesallu organizasaun nian."
  },
  {
    "word": "improvavel",
    "class": "Adjetivu",
    "meaning": "Neʼebé dala barakliu sei la akontese."
  },
  {
    "word": "improbabilidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "improviza",
    "class": "Verbu",
    "meaning": "1. Halo buat ida lahó planu uluk, no uza de'it matéria sira neʼebé iha. 2. Bainhira múziku ka atór sira improviza, sira inventa derrepente de'it múzika ka liafuan sira bainhira sira hananu ka halimar daudaun."
  },
  {
    "word": "improvizadu - improvizada",
    "class": "f. Adjetivu",
    "meaning": ""
  },
  {
    "word": "improvizasaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "impulsivu - impulsiva",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé tuir impulsu. Liafuan-sorun: kuidadu, matan-moris"
  },
  {
    "word": "impulsu",
    "class": "Substantivu",
    "meaning": "Sentimentu makaʼas ida neʼebé mai derrepente de'it hodi dada ita atu halo buat ruma."
  },
  {
    "word": "impuru",
    "class": "Substantivu",
    "meaning": "Neʼebé lamoos ka fo'er, liuliu ho sentidu morál. Sin. door"
  },
  {
    "word": "impureza",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "imune",
    "class": "Adjetivu",
    "meaning": "1. Neʼebé hetan protesaun hasoru buat ida, porezemplu moras ida. 2. Livre; dala balu mós uza ba protesaun hasoru akuzasaun ida. Sin. foruk"
  },
  {
    "word": "imunidade",
    "class": "Substantivu",
    "meaning": "1. Protesaun hasoru ka sees hosi moras ida. Ez. Bainhira ita-nia imunidade diak, ita sei la hetan mo-ras sira neʼebé da'et. 2. Priviléjiu hetan protesaun hasoru buat sira neʼebé loloos tenke hakru'uk, tuir ka submete bá. Sin. haforun Ez. Diplomata sira hetan imu-nidade tanba ne'e polísia la bele kaer sira hodi fó kastigu."
  },
  {
    "word": "imuniza",
    "class": "Verbu",
    "meaning": "Haloemaidahetan imunidade hodi sees hosi moras ida, liuliu liuhosi sona vasina."
  },
  {
    "word": "imunizasaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "inabitadu - inabitada",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé la iha ema ida horik ka hela bá. Sin. mahorik-laek Ez. Tempu uluk governu rain balu nian soe kriminozu iha nusa inabitadu atu sira bele terus iha neʼebá to'o mate."
  },
  {
    "word": "inadmisivel",
    "class": "Adjetivu",
    "meaning": "Neʼebé sei la bele simu tanba aat ka laserve. Sin. simulabelek Ez. Baku-malu ne'e sei inadmisivel iha eskola neʼebé hanorin matenek no domin."
  },
  {
    "word": "inan",
    "class": "Substantivu",
    "meaning": "1. Feto neʼebé ko'us oan iha knotak to'o tuur-ahi; hafoin fó-susu no tau matan ba nia to'o nia boot. Sin. main 2. Balada ida-ne'ebé hahoris oan no fó-susu ba nia."
  },
  {
    "word": "inan-aman",
    "class": "Substantivu",
    "meaning": "Ita-nia inan no aman. Ez. Ami-nia inan-aman hadomi no fó ezemplu diak mai ami."
  },
  {
    "word": "inan-boot",
    "class": "Substantivu",
    "meaning": "Inan nia biin ka tia neʼebé boot, uluk-ba inan. Sin. amá-boot"
  },
  {
    "word": "inan-hakiak",
    "class": "Substantivu",
    "meaning": "Feto neʼebé hakiak ita no haree ita hanesan nia oan."
  },
  {
    "word": "inanimadu - inanimada",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé la moris hanesan balada ka animál. Sin. moris-laek Ez. Fatuk mak ezemplu ba objetu inanimadu."
  },
  {
    "word": "inan-ki'ik",
    "class": "Substantivu",
    "meaning": "Feto neʼebé la kaben legalmente ho ita-nia aman ka ida ne'ebé sai aman nia feen-ki'ik."
  },
  {
    "word": "inan-ko'us",
    "class": "Substantivu",
    "meaning": "Ita-nia inan loloos, feto ida-neʼebé ko'us ita. Sin. inan-susu"
  },
  {
    "word": "inan-sarani",
    "class": "Substantivu",
    "meaning": "Feto neʼebé sai testemuña ka sasin bainhira ita simu sakramentu batizmu nian."
  },
  {
    "word": "inan-susu",
    "class": "Substantivu",
    "meaning": "Ita-nia inan loloos, feto ida-neʼebé fó-susu ita. Sin. inan-kous"
  },
  {
    "word": "inativu",
    "class": "Adjetivu",
    "meaning": "1. Neʼebé la halo asaun ida. 2. Neʼebé hakmatek hela. 3. Neʼebé reforma tiha hosi serbisu ida tanba katuas ka ferik ona. Sin. reformadu"
  },
  {
    "word": "inasaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "inaugura",
    "class": "Verbu",
    "meaning": "Loke ka hatudu ba dala uluk ba públiku atu haree ka uza. Ez. Prezidente inaugura Sentru Ba Forma Profesór Sira iha Baukau."
  },
  {
    "word": "inaugurasaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "indefensivel",
    "class": "Adjetivu",
    "meaning": "Neʼebé la bele defende. Sin. sorilabelek, defendelabelek"
  },
  {
    "word": "indefensibilidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "indefinidu - indefinida",
    "class": "f. Adjetivu",
    "meaning": "1. Neʼebé tempu atu remata nian la define loloos ka la hatene loos bainhira mak atu remata. 2. Ne'ebé ita la hatene nia rohan. Ez. Ami-nia kolega sei hela iha rai-Portugál ba tempu indefinidu."
  },
  {
    "word": "indelikadeza",
    "class": "Substantivu",
    "meaning": "Hahalok ka ma-neira neʼebé la hatudu respeitu; Hahalok neʼebé hatudu brutu. Ez. Restaurante neʼebé nia pesoál sira hatudu indelikadeza bele lakon nia kliente sira."
  },
  {
    "word": "indelikadu - indelikada",
    "class": "f. Adjetivu",
    "meaning": "; Sin. karutas"
  },
  {
    "word": "indemniza",
    "class": "Substantivu",
    "meaning": "Selu fali osan ba ema neʼebé hetan dezastre ruma. Sin. balas"
  },
  {
    "word": "indemnizasaun",
    "class": "Substantivu",
    "meaning": "; Sin. babalas"
  },
  {
    "word": "independente",
    "class": "Adjetivu",
    "meaning": "1. Neʼebé la presiza ema seluk nia tulun ka apoiu. Sin. hak-noan-laek 2. Neʼebé hela mesamesak ka ketak, la iha buat ida ka ema ida ema mak kontrola ka ukun nia. Sin. lahakno'ak"
  },
  {
    "word": "independénsia",
    "class": "Substantivu",
    "meaning": "; Sin. hakno'an laek"
  },
  {
    "word": "independentista",
    "class": "Adjetivu/Substantivu",
    "meaning": "(Ema ka partidu polítiku) neʼebé hali'is ba independénsia."
  },
  {
    "word": "indeskritivel",
    "class": "Adjetivu",
    "meaning": "Neʼebé susar atu deskreve ka hato'o ho liafuan sira, po-rezemplu akontesimentu ruma ka espe-riénsia ida. Sin. deskreve-labelek"
  },
  {
    "word": "indestrutivel",
    "class": "Adjetivu",
    "meaning": "Neʼebé sei la bele sobu ka la naksobu. Sin. sobulabelek Ez. Ami-niarelasaun ne'e indestrutivel tanba ami iha konfiansa no fiar malu."
  },
  {
    "word": "indewordinadu - indewordinada",
    "class": "f. Adjetivu",
    "meaning": "Ne'ebé la dewordina loloos bainhira. Ez. Prezidente kansela tiha nia vizita ba Lospalos no data foun ba vizita nee sei indewordinadu."
  },
  {
    "word": "Índia (rai-)",
    "class": "Substantivu",
    "meaning": "Rain no estadu boot ida iha Ázia iha Pakistaun no Bangla-dexe nia leet."
  },
  {
    "word": "indianu - indiana",
    "class": "f. Adjetivu",
    "meaning": "Rai-Índia nian; kona-ba rai-Índia. Substantivu Ema Índia, Índia-oan."
  },
  {
    "word": "indiferente",
    "class": "Adjetivu",
    "meaning": "Neʼebé ladún liga ka importa konaba buat ruma. Sin. neon-malirin"
  },
  {
    "word": "indiferensa",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "indíjena",
    "class": "Adjetivu",
    "meaning": "Neʼebé rai-na'in kedas. Sin. kahorik Substantivu Ema ka mahorik loloos iha fatin ida, la'ós malae. Sin. ema rai-nain, ema kahorik, nativu Ez. Aboríjene sira mak indíjena sira rai-Austrália nian."
  },
  {
    "word": "indijestaun",
    "class": "Substantivu",
    "meaning": "Moras neʼebé ema sente depoizde tolan tiha ai-han ruma neʼebé susar atu dulas ka dijere. Sin. laransa'e, laran-beik"
  },
  {
    "word": "indijestu - indijesta",
    "class": "f. Adjetivu",
    "meaning": "(Hahán) neʼebé la bele dulas ka dijere; neʼebé susar atu dijere. Sin. dulaslabelek"
  },
  {
    "word": "indika",
    "class": "Verbu",
    "meaning": "1. Hatudu ka aponta ba dir-esaun ida. 2. Fó-hatene."
  },
  {
    "word": "indikasaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "indikativu",
    "class": "Adjetivu",
    "meaning": "Neʼebé hatudu ka indika. Sin. matuduk Substantivu 1. (Iha gra-mátika lia-portugés nian) modu verbál neʼebé hatudu hahalok reál, neʼebé akontese duni. Liafuan-sorun: konjun-tivu 2. Númeru rain ka zona nian, neʼebé ita marka uluk hodi halo tele-fonema ida. Ez. 390 mak indikativu Timor-Leste nian."
  },
  {
    "word": "Índiku (Tasi-Boot)",
    "class": "Substantivu",
    "meaning": "Tasi neʼebé iha Ázia parte súl, entre Áfrika no Aus-trália, nia luan maizumenus kuadradu kilómetru 73.441.000. Sin. Oseanu Índiku"
  },
  {
    "word": "indireta",
    "class": "Substantivu",
    "meaning": "Hanoin, hahalok ka sujestaun neʼebé ita la hato'o loloos de'it. Sin. soelia"
  },
  {
    "word": "indiretu - indireta",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé to'o la tuir dalan ka liña loos. Sin. kabedok"
  },
  {
    "word": "índise",
    "class": "Substantivu",
    "meaning": "1. Lista alfabétiku iha livru ida nia kotuk neʼebé refere ba buat sira ne'ebé hakerek iha livru nee nia laran. 2. Buat ida ne'ebé hatudu. Sin. indikadór, katuduk"
  },
  {
    "word": "indiskretu - indiskreta",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé la delikadu liuliu kona-ba rai segredu ka buat sira ne'ebé privadu. Sin. ibun-boot"
  },
  {
    "word": "indiskrisaun",
    "class": "Substantivu",
    "meaning": "Falta diskrisaun; hahalok indiskretu."
  },
  {
    "word": "indispensavel",
    "class": "Adjetivu",
    "meaning": "Buat neʼebé ita la bele la'o ba oin se nia la iha. Sin. hak-mulik-labelek"
  },
  {
    "word": "indispostu - indisposta",
    "class": "f. Adjetivu",
    "meaning": "1. Neʼebé inkomodadu. 2. Neʼebé sente isinbaruk"
  },
  {
    "word": "indispozisaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "indistingivel",
    "class": "Adjetivu",
    "meaning": "Neʼebé susar atu dis-tinge, hatadak ka haketak hosi buat ka ema seluseluk. Sin. hatadak-labelek"
  },
  {
    "word": "indistintu - indistinta",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé ladún klaru, susar atu haree ka lee tanba moos. Sin. salabu"
  },
  {
    "word": "índiu - índia",
    "class": "f. Adjetivu",
    "meaning": "Kona-ba rai-na'in ka mahorik dahuluk kontinente Amérika nian. Substantivu Ema kahorik ka rai-na'in rai- Amérika nian."
  },
  {
    "word": "individuál",
    "class": "Adjetivu",
    "meaning": "Neʼebé mesamesak, re-lasionahoemakabuat partikuláridaloos."
  },
  {
    "word": "individualista",
    "class": "Adjetivu",
    "meaning": "Kona-ba individu-alizmu. Substantivu Ema ne'ebé hali'is ba individualizmu. Ez. Hahalok indi-vidualista sei la lao iha rai-Timór, neebé respeita serbisu-lisuk."
  },
  {
    "word": "individualizmu",
    "class": "Substantivu",
    "meaning": "1. Hanoin ka atitude ne'ebé fó importánsia ba ema ida-idak de'it, la'ós ba grupu ka komu-nidade 2. Teoria ne'ebéhareeliubadireitu individuál duké sosiál."
  },
  {
    "word": "indivíduu - indivídua",
    "class": "f. Substantivu",
    "meaning": "Ema ida, haree ketak hosi grupu. Ez. Regu-lamentu idane'e diak ba grupu, ladún di'ak fali ba indivíduu."
  },
  {
    "word": "individualidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "indivizivel",
    "class": "Adjetivu",
    "meaning": "Neʼebé ita la bele fahe. Sin. fahe-labelek"
  },
  {
    "word": "indivizibilidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "indixiplina",
    "class": "Substantivu",
    "meaning": "Falta dixiplina. Ez. Membru polisia ne'e tenke sai hosi nia s-erbisu tan indixiplina."
  },
  {
    "word": "indixiplinadu - indixiplinada",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé la iha dixiplina. Ez. Pesoál neebé indixiplinadu bele estraga progresu em-preza nian."
  },
  {
    "word": "Indonézia (rai-)",
    "class": "Substantivu",
    "meaning": "Estadu boboot iha Ázia Sudeste neʼebé okupa Nusa-lubun Malaiu nia parte boot liu, no uluk ba tinan 1945 kolónia rai-Olanda nian."
  },
  {
    "word": "indonéziu - indonézia",
    "class": "Adjetivu",
    "meaning": "Kona-ba rai- Indonézia; rai- Indonézia nian. Sub-stantivu 1. Ema Indonézia, Indonézia-oan. 2 Lia Indonézia nian, Indonézia lian. Ez. Lia-indonéziu ne'e dalen ofisiál Repúblika Indonézia nian."
  },
  {
    "word": "indonezizmu",
    "class": "Substantivu",
    "meaning": "Liafuan ka espre-saun ida neʼebé mai hosi lia-indonéziu, ka hasara liaindonéziu. Ez. Liafuan ‘desa’ neʼebé ema balu sei uza hodi hak-temik knua ne'e indonezizmu."
  },
  {
    "word": "indú",
    "class": "Adjetivu",
    "meaning": "Neʼebé tuir induizmu; indu-izmu nian. Substantivu Ema ida ne'ebé fiar iha induízmu."
  },
  {
    "word": "induizmu",
    "class": "Substantivu",
    "meaning": "Relijiaun raiÍndia nian neʼebé iha maromak barak no halo ema sira fiar katak sira sei hetan moris seluk depoizde mate hodi nakfila ba ema seluk ka balada ida."
  },
  {
    "word": "industaní",
    "class": "Adjetivu",
    "meaning": "Rai-Industaun nian; kona-ba rai- Industaun. Substantivu 1. Ema Índia, Índia-oan. 2. (lia-industaní) Dalen indu-europeu ida neʼebé ko'alia iha rai- Industaun, no nakfahe ba vari-ante rua, maka lia-hindi (lian ofisiál iha rai-Índia) no liaurdú (lian ofisiál iha rai-Pakistaun)."
  },
  {
    "word": "Industaun (rai-)",
    "class": "Substantivu",
    "meaning": "Rejiaun luan iha parte norte raiÍndia nian, neʼebé ha-kohak mós rai- Pakistaun balun ida."
  },
  {
    "word": "indústria",
    "class": "Substantivu",
    "meaning": "1. Serbisu halo pro-dutu barak, liuliu iha fábrika laran. Ez. Indústria mina-morin iha Timór bele la'o di'ak tanba ai-kameli barak. 2. Ha-halok badinas."
  },
  {
    "word": "industriál",
    "class": "Adjetivu",
    "meaning": ""
  },
  {
    "word": "industrializadu - industrializada",
    "class": "f. Adje-tivu",
    "meaning": "Neʼebé iha ona indústria barak no mós teknolojia moderna."
  },
  {
    "word": "industrializa",
    "class": "Verbu",
    "meaning": ""
  },
  {
    "word": "industrializasaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "inéditu - inédita",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé ema seidauk edita ka publika."
  },
  {
    "word": "inefikás",
    "class": "Adjetivu",
    "meaning": "Neʼebé ladún fó fuan ka rezultadu; neʼebé ladún avansa. Sin. la-saradak Liafuan-sorun: efikás Ez. Na-saun neebé kiik maibé iha ministru barak bele inefikás."
  },
  {
    "word": "inesperiente",
    "class": "Adjetivu",
    "meaning": "Neʼebé la iha espe-riénsia; neʼebé ladún iha esperiénsia. Sin. kauk Ez. Tanba André ema inespe-riente iha hanorin, governu la simu nia atu sai mestre."
  },
  {
    "word": "inesperiénsia",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "inevitavel",
    "class": "Adjetivu",
    "meaning": "Neʼebé atu akontese duni no ita la bele hanetik ona ka sees hosi. Sin. haseeslabelek Ez. Iha tinan 1998 ami hatene katak Timór nia inde-pendénsia ne'e inevitavel ona, maski ema barak la hanoin nunee."
  },
  {
    "word": "inezatu - inezata",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé la lolo-os ka la korretu. Sin. lapresizu, lakonak"
  },
  {
    "word": "inezatidaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "infalivel",
    "class": "Adjetivu",
    "meaning": "Neʼebé la bele sala. Sin. sala-labelek; Liafuan-sorun: falivel, sala-belek Ez. Konsíliu Vatikanu Dahuluk hanorin katak Amu-Papa infalivel bainhira nia haklaken dogma ka hanorin impor-tante ida kona-ba fiar ka moralidade tanba iha momentu nee Espíritu Santu mak tulun nia, maibé nia bele sala bain-hira halo desizaun ka lei baibain nian, hanesan ema seluk."
  },
  {
    "word": "infalibilidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "infánsia",
    "class": "Substantivu",
    "meaning": "1. Períodu dahuluk moris ema nian. Sin. babarik 2. Tinan sira dahuluk bainhira buat ida hahú."
  },
  {
    "word": "infantíl",
    "class": "Adjetivu",
    "meaning": "1. Labarik nian; kona-ba labarik. Ez. Moras infantíl oioin da;et bá-mai iha ita-nia rain. 2. Hanesan la-barik. Sin. kabarik Ez. Mane-oan nee hakole ema hotu ho nia komportamentu infantíl."
  },
  {
    "word": "infantilidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "infartu",
    "class": "Substantivu",
    "meaning": "Kondisaun médiku neʼebé sériu bainhira fuan tuku la hanesan baibain ka para tomak hotu. Ez. Ema balu mate tanba infartu kona molok sira konsege lori ba ospitál."
  },
  {
    "word": "inferiór",
    "class": "Adjetivu",
    "meaning": "1. Neʼebé kraik liu. Sin. ma-hokos 2. La diak hanesan buat ida seluk."
  },
  {
    "word": "inferioridade",
    "class": "Substantivu",
    "meaning": "Kompleksuinfe-rioridade katak ema ida sente nia ema folin-laek no ema seluk diak liu nia."
  },
  {
    "word": "infertil",
    "class": "Adjetivu",
    "meaning": "1. Neʼebé rai-isin la iha no ai-horis neʼebé moris iha leten ladún barak. 2. (Feto ka baladainan) neʼebé la bele hahoris oan. Sin. kiuk"
  },
  {
    "word": "infertilidade",
    "class": "Substantivu",
    "meaning": "; Sin. kakiuk"
  },
  {
    "word": "infesaun",
    "class": "Substantivu",
    "meaning": "Moras neʼebé mosu ba-inhira buat fo'er ka mikróbiu kona isin."
  },
  {
    "word": "infesiozu - infesioza",
    "class": "f. Adjetivu",
    "meaning": "(Moras) neʼebé bele da'et hosi ema ida ba ema seluk. Sin. makda'et"
  },
  {
    "word": "infiltra",
    "class": "Verbu",
    "meaning": "1. Penetra ka tama hanesan liuhosi makta'es ka filtru ida. Sin. hak-lurit 2. Tama subasubar ba fatin ka grupu ida neʼebé konsidera nuʼudar in-imigu; bele mós ho intensaun atu estraga. Ez. Molok invazaun iha 1975, ajente sekretu indonézia nian infiltra ba partidu sira balun nia leet."
  },
  {
    "word": "infiltrasaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "infiltradór - infiltradora",
    "class": "f. Substantivu",
    "meaning": "Ema neʼebé infiltra. Sin. maklurit"
  },
  {
    "word": "infinitu - infinita",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé la iha rohan. Sin. rohan-laek"
  },
  {
    "word": "infinitivu",
    "class": "Substantivu",
    "meaning": "Iha gramátika no lia-portugés nian, forma-hun Verbu nian, ho sufiksu -ar, -er ka -ir (n.e. cantar, vender, partir)."
  },
  {
    "word": "inflamadu - inflamada",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé mean no bubu, baibain tan infesaun ida."
  },
  {
    "word": "inflama",
    "class": "Verbu",
    "meaning": ""
  },
  {
    "word": "inflamasaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "inflamavel",
    "class": "Adjetivu",
    "meaning": "Neʼebé fasil atu ahi han."
  },
  {
    "word": "inflamabilidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "inflasaun",
    "class": "Substantivu",
    "meaning": "Bainhira folin sasán no serbisu sira sa'e iha nasaun ida nia laran."
  },
  {
    "word": "inflavel",
    "class": "Adjetivu",
    "meaning": "Neʼebé bele enxe ho gás, nu'udar ezemplu gás éliu, hodi halo sai boot ka bubu. Sin. habubu-belek"
  },
  {
    "word": "infleksivel",
    "class": "Adjetivu",
    "meaning": "Neʼebé metin no sei la bele muda, altera ka sobu. Sin. be'ok-labelek"
  },
  {
    "word": "infleksibilidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "influensia",
    "class": "Verbu",
    "meaning": "Kona buat ida ka ema ida hodi halo nia sai seluk uitoan ka muda nia hahalok. Sin. hamkona"
  },
  {
    "word": "influénsia",
    "class": "Substantivu",
    "meaning": "Hahalok influensia nian. Sin. hamkonan"
  },
  {
    "word": "influente",
    "class": "Adjetivu",
    "meaning": "Neʼebé influensia ka hamkona."
  },
  {
    "word": "informa",
    "class": "Verbu",
    "meaning": "Hato'o informasaun ba ema seluk. Sin. fó-hatene, hatada."
  },
  {
    "word": "informadór - informadora",
    "class": "f. Substantivu",
    "meaning": "Ema ida neʼebé feo informasaun. Sin. informante, matadak"
  },
  {
    "word": "informál",
    "class": "Adjetivu",
    "meaning": "Neʼebé baibain de'it, la hanesan iha festa ka serimónia. Sin. la-formál; Liafuan-sorun: formál Ez. Bainhira ema bá basar, hatais informál maibé hatais formál bainhira bá festa."
  },
  {
    "word": "informasaun",
    "class": "Substantivu",
    "meaning": "Matenek, dadus, fatu ka realidade neʼebé iha atu hato'o ba ema seluk."
  },
  {
    "word": "informátiku - informátika",
    "class": "f.Adjetivu",
    "meaning": "Neʼebé kona-ba komputadór. Substantivu (in-formátika) Siénsia kona-ba komputadór."
  },
  {
    "word": "informativu - informativa",
    "class": "f. Adjetivu",
    "meaning": "Ne'ebé fó informasaun barak."
  },
  {
    "word": "informatiza",
    "class": "Verbu",
    "meaning": "Organiza informasaun ho komputadór."
  },
  {
    "word": "informatizasaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "infraestrutura",
    "class": "Substantivu",
    "meaning": "Sasán sira neʼebé ema harii atubele uza hodi hala'o ativi-dade ka servisu oioin iha railaran, nu'udar ezemplu uma, ponte, telekomunika-saun, nst."
  },
  {
    "word": "infraestruturál",
    "class": "Adjetivu",
    "meaning": ""
  },
  {
    "word": "infrasaun",
    "class": "Substantivu",
    "meaning": "Violasaun ka hahalok hasoru regra ka lei ida. Sin. haraun"
  },
  {
    "word": "infundadu - infundada",
    "class": "f. Adjetivu",
    "meaning": "(Hanoin ka akuzasaun) neʼebé ita la bele simu tan-ba la iha prova metin ida. Sin. hun-laek"
  },
  {
    "word": "Inglaterra (rai-)",
    "class": "Substantivu",
    "meaning": "Rain ida iha Europa Norueste, nakfati iha nusa boot Bretaña no halo parte Reinu Naklibur."
  },
  {
    "word": "inglés - ingleza",
    "class": "f. Adjetivu",
    "meaning": "Rai-Inglaterra nian; kona-ba rai- Inglaterra. Substan-tivu 1. Ema Inglaterra. 2. (lia-inglés) Lian Inglaterra no Bretaña Boot nian, neʼebé ingrata ko'alia mós iha rai- Ir-landa, Estadu Naklibur Sira Amérika Nian, Kanadá, Áfrika Súl, Índia, Pakis-taun, Austrália, Zelándia Foun no ohin loron uza iha mundu tomak nu'udar dalen internasionál."
  },
  {
    "word": "ingratu - ingrata",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé la ha-tene agradese ka fó obrigadu ba benefí-siu ka kadi’ak sira neʼebé simu. Sin. maupagadór"
  },
  {
    "word": "ingratidaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "inibidu - inibida",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé susar atu relaxa no la konsege hatudu nia sen-timentu ka emosaun ba ema seluk."
  },
  {
    "word": "inibisaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "inimigu - inimiga",
    "class": "f. Substantivu",
    "meaning": "Ema neʼebé sai funu-balun ba ita tan hirus ka laran moras. Liafuan-sorun: belun, amigu Adjetivu Neʼebé halo an hanesan inimigu."
  },
  {
    "word": "inisiais",
    "class": "Substantivu",
    "meaning": "Letra-boot sira neʼebé hahú kada liafuan iha ita-nia naran. Ez. TL maka naran Timor-Leste no Timór Lorosa’e nia inisiais."
  },
  {
    "word": "inisiál",
    "class": "Adjetivu",
    "meaning": "Neʼebé hahú. Sin. uluk Sub-stantivu Letra dahuluk neʼebé hahú naran ka liafuan sira seluk."
  },
  {
    "word": "inisiativa",
    "class": "Substantivu",
    "meaning": "Abilidade atu hakotu ida neʼebé ita presiza hala'o, no hala'o buat ida lahó konsulta no asisténsia hosi ema seluk. Ez. Oan tenke iha inisiativa atu serbisu hodi hetan osan, lalika hein hosi aman-inan de'it."
  },
  {
    "word": "inisia",
    "class": "Verbu",
    "meaning": "Hahú ka loke. Ez. Nasaun Na-klibur Sira mak inisia sorumutu entre Timór ho Indonézia atu rezolve kazu rai-ketan nian."
  },
  {
    "word": "inísiu",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "injénuu - injénua",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé fiar lailais. Sin. fiar-fraku, fiar-teen"
  },
  {
    "word": "injenuidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "injesaun",
    "class": "Substantivu",
    "meaning": "Hahalok hatama ai-moruk been ka substánsia ba ema ka balada nia isin liuhosi daun ho seringa neʼebé sona ba isin. Sin. sasonak, sonan Ez. Ema balu hakarak liu injesaun duké hemu aimorukmusan."
  },
  {
    "word": "injeta",
    "class": "Verbu",
    "meaning": "1. Hatama substánsia ka ai-moruk been ba isin ho seringa. Sin. sona 2. Sama aselaradór ka travaun atu koko se sira funsiona normál."
  },
  {
    "word": "injúria",
    "class": "Substantivu",
    "meaning": "Hahalok hato'o ka fó sai liafuan makaʼas hasoru ema ida ho tolok."
  },
  {
    "word": "injustisa",
    "class": "Substantivu",
    "meaning": "1. Kondisaun la iha justisa. Sin. justisa-laek 2. Kondisaun trata ema la tuir loloos dalan. Ez. Se ema ida la tama kadeia maski oho ema seluk, ne'e injustisa boot ida."
  },
  {
    "word": "injustu - injusta",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé la iha justisa. Sin. lajustu, justisalaek Ez. Hahalok injustu sira mosu bainhira ema la kumpre lei no orden."
  },
  {
    "word": "inkapás",
    "class": "Adjetivu",
    "meaning": "Neʼebé la iha kapasidade atu hala'o buat ruma. Sin. lajeitu"
  },
  {
    "word": "inkapasidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "inkéritu",
    "class": "Substantivu",
    "meaning": "Peskiza ka investiga-saun jurídika ida neʼebé halo hodi buka-hatene se ema ne'e iha informasaun ruma ka ema ne'e envolve iha kazu ruma ka lae. Sin. haknokar Ez. Polísia sei halo inkéritu ba sivíl neʼebé lori kilat."
  },
  {
    "word": "inkilinu - inkilina",
    "class": "f. Substantivu",
    "meaning": "Ema neʼebé selu ba uma, rai ka fatin ida ne'ebé nia aluga ka uza. Sin. aluga-naʼin"
  },
  {
    "word": "inklinasaun",
    "class": "Substantivu",
    "meaning": "Tendénsia ba halo buat ida. Sin. hali'is Ez. Ema balu iha inklinasaun ba naʼok."
  },
  {
    "word": "inklui",
    "class": "Verbu",
    "meaning": "Tama mós ho ka sura mós ho. Sin. sura hotu, hakohak Ez. Ema barak hakarak sa'e foho Ramelau, inklui ferik-katuas sira ne'ebé sente an forte."
  },
  {
    "word": "inkluzaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "inkluzivu - inkluziva",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé sura mós, inklui mós. Ez. Otél nia folin kalan ida $25 inkluzivu taxa no mata-bixu. 2. Ne'ebé hali'is ba inklui buat ruma. Sin. makohak. Ez. Programa foun ne'e inkluzivu, tanba feto sira hotu bele hola parte, laós mane de'it."
  },
  {
    "word": "inkoerente",
    "class": "Adjetivu",
    "meaning": "Neʼebé sabraut, la tuir fatin ka la iha lójika. Ez. Ema ne'e nia argumentasaun hotu inkoerente."
  },
  {
    "word": "inkoerénsia",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "inkómodu - inkómoda",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé la kómodu, la halo ita sente avontade. Ez. Kaben-naʼin foun sira sente inkó-modu ho moris umakain nian."
  },
  {
    "word": "inkomoda",
    "class": "Verbu",
    "meaning": "Hamosu ka kauza inkó-modu. Ez. Bebé sira dala barak inkomoda sira-nia inanaman tanba sira tanis fila-fila iha kalan-boot."
  },
  {
    "word": "inkómodu",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "inkomparavel",
    "class": "Adjetivu",
    "meaning": "1. Neʼebé sei la bele kompara ho buat sira seluk. Sin. tane-san-labelek 2. Neʼebé kapás loos tanba mesak de'it. Ez. Kreda nia kontribuisaun ba independénsia ne'e inkomparavel."
  },
  {
    "word": "inkompetente",
    "class": "Adjetivu",
    "meaning": "Neʼebé la iha kom-peténsia atu hala'o buat ida. Sin. kalauk Ez. Governu lakohi ema neʼebé inkom-petente atu sai funsionáriu públiku."
  },
  {
    "word": "inkompeténsia",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "inkompletu - inkompleta",
    "class": "f. Adjetivu",
    "meaning": "Ne'ebé la kompletu ka laós tomak tanba buat ruma seidauk halo ka sei kuran hela. Ez. Dokumentu ba pasaporte ne'e inkompletu tanba sei kuran sertidaun batizmu nian."
  },
  {
    "word": "inkomprensivel mós inkompriensivel",
    "class": "Adjetivu",
    "meaning": "Neʼebé ita la bele komprende. Sin. komprende-labelek"
  },
  {
    "word": "inkondisionál",
    "class": "Adjetivu",
    "meaning": "Laiha kondisaun. Substantivu Emaida neʼebégosta tebetebes artista ka desportista ruma. Sin. adeptu"
  },
  {
    "word": "inkonstante",
    "class": "Adjetivu",
    "meaning": "1. Neʼebé muda nafa-tin, la metin ida. Sin. kadasak 2. (Ema) neʼebé muda hanoin lailais."
  },
  {
    "word": "inkonstitusionál",
    "class": "Adjetivu",
    "meaning": "Neʼebé la tuir konstituisaun, hasoru konstituisaun. Ez. Golpe atu hamonu governu demo-krátiku sei konsidera inkonstitusionál."
  },
  {
    "word": "inkontestavel",
    "class": "Adjetivu",
    "meaning": "Neʼebé sei la bele nega ka hasoru."
  },
  {
    "word": "inkontestabilidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "inkonxiente",
    "class": "Adjetivu",
    "meaning": "1. Neʼebé la iha konx-iénsia. 2. Neʼebé lakon tiha ona sentidu."
  },
  {
    "word": "inkonxiénsia",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "inkorrijivel",
    "class": "Adjetivu",
    "meaning": "Neʼebé sei la bele korrije tan. Sin. haloos-labelek Ez. Labarik ida-ne'e inkorrijivel tanba maski ami fó-kastigu beibeik, nia fó ulun."
  },
  {
    "word": "inkorrijibilidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "inkorruptivel",
    "class": "Adjetivu",
    "meaning": "1. (Buat) neʼebé la bele dodok. Sin. dodok-labelek 2. (Ema) neʼebé la sai korruptu, maski ema seluk babeur nia. Sin. harotok-labelek Ez. Ita-nia nasaun presiza funsionáriu barak neʼebé laran-moos no inkorruptivel."
  },
  {
    "word": "inkorruptibilidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "inkorruptu - inkorrupta",
    "class": "f. Adjetivu",
    "meaning": "(Buat) neʼebé la dodok. Sin. ladodok"
  },
  {
    "word": "inkrédulu - inkrédula",
    "class": "f. Adjetivu",
    "meaning": "1. Neʼebé la bele fiar. 2. Neʼebé lakohi fiar. Sin. fiar-laek"
  },
  {
    "word": "inkredulidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "inkultu - inkulta",
    "class": "f. Adjetivu",
    "meaning": "1. (Rai, to'os) neʼebé ema ida la fila; (natar) neʼebé ema ida la halai. 2. (Ema) neʼebé la iha kultura, la fó valór ba arte, múzika no literatura."
  },
  {
    "word": "inkursaun",
    "class": "Substantivu",
    "meaning": "Hahalok tama ho beran ba fatin ruma hodi estraga ka na'o sasán. Sin. hakdauk"
  },
  {
    "word": "inofensivu - inofensiva",
    "class": "f. Adjetivu",
    "meaning": "1. Neʼebé la ofende ka hatún ema seluk. Sin. had-eirlabelek Ez. Maski nia nervozu, maibé nia afinál ema inofensivu. 2. Neʼebé la halo aat. Ez. Teki nee balada inofensivu."
  },
  {
    "word": "inokula",
    "class": "Verbu",
    "meaning": "Fó vasina liuhosi sona ka injesaun. Sin. hasona"
  },
  {
    "word": "inokulasaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "inoportunu - inoportuna",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé li'ur hosi tempu ka okaziaun be natoon; neʼebé la kona loos. Sin. lakonak"
  },
  {
    "word": "inoportunidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "inosente",
    "class": "Adjetivu",
    "meaning": "Neʼebé la iha sala ka kulpa. Sin. salalaek"
  },
  {
    "word": "inoportunidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "inova",
    "class": "Verbu",
    "meaning": "Hatama buat ka elementu foun ruma, haseluk ka muda sasán tuan ka baibain nian. Sin. hakfoun"
  },
  {
    "word": "inovadór - inovadora",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé bele hafoun ka hamosu hanoin ka buat foun ida. Sin. makfoun Substantivu Ema ne'ebé iha jeitu atu hamosu buat foun ida."
  },
  {
    "word": "inovasaun",
    "class": "Substantivu",
    "meaning": "1. Hahalok hafoun ka hamosu buat foun ida. Sin. hakfoun 2. Buat, prátika ka kostume foun."
  },
  {
    "word": "inova",
    "class": "Verbu",
    "meaning": "; Sin. hakfoun"
  },
  {
    "word": "insatisfatóriu - insatisfatória",
    "class": "f. Adjetivu",
    "meaning": "1. Ne'ebé la fó satisfasaun. 2. Neʼebé la natoon ka la to'o."
  },
  {
    "word": "insatisfeitu - insatisfeita",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé la iha satisfasaun, la kontente ho buat ka situasaun ida."
  },
  {
    "word": "insatisfasaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "inseguru - insegura",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé la metin ka laiha seguransa. Ez. Iha fatin balu, ema sente inseguru liuliu kalan tanba eletrisidade la iha."
  },
  {
    "word": "inseguransa",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "inséndiu",
    "class": "Substantivu",
    "meaning": "1. Ahi neʼebé halo de-struisaun boot ka maka'as ba uma ka fatin ida. Sin. ahi-sunu 2. Ahi han foho ka ailaran ho makaʼas."
  },
  {
    "word": "insensatu - insensata",
    "class": "f. Adjetivu",
    "meaning": "1. Neʼebé lahó razaun ida; susar atu ema seluk bele simu. Ez. Hahalok insensatu bain-hira ema lakohi selu eletrisidade no bee. 2. Ne'ebé beik."
  },
  {
    "word": "insensivel",
    "class": "Adjetivu",
    "meaning": "1. La sente buat ida iha nia isin. Sin. kulit-mahar 2. Neʼebé la iha sensibilidade, la hanoin kona-ba ema seluk. Sin. laran-metan"
  },
  {
    "word": "insensibilidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "insensa",
    "class": "Verbu",
    "meaning": "Hamorin altár, santuáriu ka umakreda ho insensu-suar bainhira se-lebra santa misa ka vésperas."
  },
  {
    "word": "insensu",
    "class": "Substantivu",
    "meaning": "Ai-rahun morin neʼebé sunu iha maksuas ka turíbulu laran iha uma-kreda no fó suar hodi fó onra ba Na'i Maromak durante liturjia. Sin. kiar-been morin"
  },
  {
    "word": "insentivu",
    "class": "Substantivu",
    "meaning": "Ida neʼebé fó korajen ba ita atu halo buat ida. Ez. Amá sosa bisikleta mai ha'u nu'udar insentivu ba hau bele badinas liután bá eskola."
  },
  {
    "word": "insentiva",
    "class": "Verbu",
    "meaning": "; Sin. haliras"
  },
  {
    "word": "inseparavel",
    "class": "Adjetivu",
    "meaning": "1. Neʼebé ita la bele haketak. Sin. haketak-labelek 2. (Belun) neʼebé gosta malu tebetebes. Ez. Maria no Filomena belun inseparavel."
  },
  {
    "word": "inseparabilidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "insertu - inserta",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé la iha serteza ka la hatene loloos; sei laran-rua hela. Sin. latebes"
  },
  {
    "word": "inserteza",
    "class": "Verbu",
    "meaning": ""
  },
  {
    "word": "insetívoru - insetívora",
    "class": "f. Adjetivul Substan-tivu",
    "meaning": "(Animál) neʼebé han insetu sira. Sin. mahánkutun Ez. Manduku no teki balada insetívoru."
  },
  {
    "word": "insetu",
    "class": "Substantivu",
    "meaning": "Animál ki’ik sira neʼebé dolar, haksoit ka semo, n.e. nehek, lala'ek, lalar, susuk nst. Sin. kutun"
  },
  {
    "word": "insidente",
    "class": "Substantivu",
    "meaning": "Buat ladi’ak neʼebé akontese, kazu susar ka aat."
  },
  {
    "word": "insignifikante",
    "class": "Adjetivu",
    "meaning": "1. Neʼebé la impor-tante ka la fó sentidu ida. 2. Neʼebé la hatudu rezultadu diak ka folin diak ida."
  },
  {
    "word": "insignifikánsia",
    "class": "Verbu",
    "meaning": ""
  },
  {
    "word": "insineradór",
    "class": "Substantivu",
    "meaning": "Bidón atu sunu fo'er. Sin. bidón-sunu, madesan"
  },
  {
    "word": "insinerasaun",
    "class": "Substantivu",
    "meaning": "Hahalok sunu to-mak hotu nian. Sin. hadesan, kremasaun"
  },
  {
    "word": "insinseru - insinsera",
    "class": "Adjetivu",
    "meaning": "Neʼebé la iha sinseridade, nuʼudar ezemplu hatudu sentimentu neʼebé la'ós tuir loloos buat neʼebé nia sente ka bosok hela. Sin. lasi-nseru, laranmakerek, nanál-sanak"
  },
  {
    "word": "insinseridade",
    "class": "Substantivu",
    "meaning": "Ez. Insinseridade halo ema sira susar atu fiar malu."
  },
  {
    "word": "insiste",
    "class": "Verbu",
    "meaning": "Husu ka rekomenda ho maka’as atu hala'o buat ida. Sin. litik Ez. Gov-ernu insiste ba naʼin sira hatama sirania balada ba luhan."
  },
  {
    "word": "insisténsia",
    "class": "Substantivu",
    "meaning": "; Sin. lalitik"
  },
  {
    "word": "insistente",
    "class": "Adjetivu",
    "meaning": "; Sin. maklitik"
  },
  {
    "word": "inskreve",
    "class": "Verbu",
    "meaning": "1. Hakerek ka halo letra iha objetu ida nia leten, nu'udar ezemplu iha fatuk ka ai nia leten. 2. Tau naran, nu'u-dar ezemplu ba kursu iha universidade."
  },
  {
    "word": "inskrisaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "insólitu - insólita",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé la baibain akontese ka eskizitu uitoan."
  },
  {
    "word": "insoluvel",
    "class": "Adjetivu",
    "meaning": "1. (Ai-moruk ka ai-han) neʼebé la nabeen bainhira ita tau tiha iha bee. 2. (Problema) neʼebé ita la kon-sege rezolve."
  },
  {
    "word": "insolubilidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "insónia",
    "class": "Substantivu",
    "meaning": "Moras neʼebé halo ema susar atu dukur. Sin. moras dukur-laek"
  },
  {
    "word": "inspesiona",
    "class": "Verbu",
    "meaning": "Fihir ka ezamina atu hatene loloos konaba buat ida. Sin. le-hat Ez. Xefe polísia nian sei inspesiona nia membru sira atu buka-hatene se sira serbisu tuir orden sira neʼebé nia halolo ba sira ida-idak."
  },
  {
    "word": "inspesaun",
    "class": "Substantivu",
    "meaning": "; Sin. lalehat"
  },
  {
    "word": "inspetór - inspetora",
    "class": "f. Substantivu",
    "meaning": "Ema neʼebé inspesiona. Sin. maklehat"
  },
  {
    "word": "inspira",
    "class": "Verbu",
    "meaning": "1. Fó hanoin ka ideia ba ema; fó esperansa no laranmanas foun. Sin. hamehi Ez. Feto bonita ida mak inspira poeta foin-sa'e nee atu hakerek poezia furak ida kona-ba domin. 2. Halo buat ida mosu hodi fó laran-manas ba ema ida; fó impulsu ba buat ruma. Sin. ha-liras Ez. Asuain sira-nia sakrífisiu inspira tebetebes povu nia luta ba ukun rasik-an."
  },
  {
    "word": "inspirasaun",
    "class": "Substantivu",
    "meaning": "; Sin. hamehin, haliras"
  },
  {
    "word": "inspiradu - inspirada",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé inspira ka fó inspirasaun; neʼebé hamehi ka haliras. Sin. mamehik, maliras Ez. Diretora foun nee fó ezemplu inspi-radór ba kolega sira."
  },
  {
    "word": "instavel",
    "class": "Substantivu",
    "meaning": "Neʼebé lametin, liuliu kona-ba seguransa no emosaun. Ez. Bainhira situasaun ne'e instavel, dezen-volvimentu sei hasoru dezafiu barak."
  },
  {
    "word": "instabilidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "instala",
    "class": "Verbu",
    "meaning": "Monta ka tau ekipamentu ida iha fatin foun ida, no halo nia prontu ba ema atu uza. Ez. Atu komunika ho fatin seluk liuhosi korreiu eletróniku, ita presiza instala liña-telefone hodi liga ba kom-putadór."
  },
  {
    "word": "instalasaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "instaladór - instadora",
    "class": "Substantivu",
    "meaning": "Emaneʼebé instala ekipamentu iha fatin foun ida."
  },
  {
    "word": "instante",
    "class": "Substantivu",
    "meaning": "Momentu ida de'it."
  },
  {
    "word": "instantáneu - instantánea",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé akontese kedas no la demora."
  },
  {
    "word": "instaura",
    "class": "Verbu",
    "meaning": "Harii no hametin sistema, instituisaun ka organizasaun ida. Sin. estabelese, institui Ez. Timor-Leste ins-taura ninia tribunál rekursu nian iha tinan 2003."
  },
  {
    "word": "instintu",
    "class": "Substantivu",
    "meaning": "Hali'is ka tendénsia naturál atu hala'o buat ida."
  },
  {
    "word": "instintivu - instintiva",
    "class": "f. Adjetivu",
    "meaning": ""
  },
  {
    "word": "institui",
    "class": "Verbu",
    "meaning": "Harii ka estabelese. Sin. hanuda Ez. Governu sei institui sistema ida ne'ebé diak atu kontrola rendimentu nasaun nian."
  },
  {
    "word": "instituisaun",
    "class": "Substantivu",
    "meaning": "1. Hahalok institui nian. Sin. hanudan 2. Organizasaun boot no importante ida, nu'udar ezemplu universidade ka banku. 3. Fatin hanesan ospitál ba ema moras mentál, labarik ka prizaun iha neʼebé ema bele tau matan ba sira."
  },
  {
    "word": "institusionál",
    "class": "Adjetivu",
    "meaning": ""
  },
  {
    "word": "institusionaliza",
    "class": "Verbu",
    "meaning": "Organiza nuʼudar instituisaun; halo ka rekoñese tiha tuir sistema ka lei neʼebé iha."
  },
  {
    "word": "institutu",
    "class": "Substantivu",
    "meaning": "Organizasaun ida neʼebé hala'o knaar partikulár ida. Ez. Institutu Nasionál Linguístika Nian, ho nia sede iha Dili, mak organizasaun ofi-siál neʼebé dezenvolve dalen kahorik sira iha Repúblika Demokrátika Timor-Leste."
  },
  {
    "word": "instruidu - instruida",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé eskolaboot, matenek-boot."
  },
  {
    "word": "instrumentaliza",
    "class": "Verbu",
    "meaning": "Uza ka aproveita nu'udar instrumentu ba planu ka polí-tika ruma."
  },
  {
    "word": "instrumentalizasaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "instrumentu",
    "class": "Substantivu",
    "meaning": "1. Sasán ka besi-badain neʼebé ema uza atu halo buat ida. 2. Objetu hanesan pianu, viola, klarinete nst. neʼebé ema uza atu toka. Ez. Povu Timór soi instrumentu muz-ikál oioin, nu'udar ezemplu kafu'i, tihar, tala, babadook, lakadou, kakeit no naka."
  },
  {
    "word": "instrumentál",
    "class": "Adjetivu",
    "meaning": ""
  },
  {
    "word": "instrusaun",
    "class": "Substantivu",
    "meaning": "1. Orden, komandu. Sin. hadenin 2. Edukasaun, eskolaboot."
  },
  {
    "word": "instrutór - instrutora",
    "class": "f. Substantivu",
    "meaning": "Ema neʼebé hanorin ka fó instrusaun atu ema seluk aprende ka tuir."
  },
  {
    "word": "insubordinadu - insubordinada",
    "class": "f. Adjetivu",
    "meaning": "Ne'ebé la'ós subordinadu ka lakohi fó ulun ba dixiplina. Sin. klebak"
  },
  {
    "word": "insubordinasaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "insufisiente",
    "class": "Adjetivu",
    "meaning": "1. Neʼebé la to'o. Sin. lafetak, lasaas 2. Neʼebé la iha kom-peténsia natoon."
  },
  {
    "word": "insufisiénsia",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "insuflavel",
    "class": "Adjetivu",
    "meaning": "Neʼebé ita bele habubu. Sin. habububelek Ez. Kama borraxa ida ne'e insuflavel hanesan balaun."
  },
  {
    "word": "insulár",
    "class": "Adjetivu",
    "meaning": "Nusa ka illa nian; kona-ba nusa ka illa. Sin. nusak"
  },
  {
    "word": "insulina",
    "class": "Substantivu",
    "meaning": "Substánsia neʼebé kontrola nivel masin-midar nian iha raan. Nu'udar ezemplu, ema neʼebé sofre diabetes la iha insulina natoon ka la bele uza nia ho efisiente."
  },
  {
    "word": "insulta",
    "class": "Verbu",
    "meaning": "Ofende ema hodi hatudu dezrespeitu, hatete aat ka tarata lajustu. Sin. tolok Ez. Malandru neebá insulta katuas sira neʼebé hakilar nia bainhira nia buka atu naʼok bisikleta ida."
  },
  {
    "word": "insultante",
    "class": "Adjetivu",
    "meaning": "; Sin. maktolok"
  },
  {
    "word": "insultu",
    "class": "Substantivu",
    "meaning": "Liafuan ka hahalok ho dezrespeitu neʼebé ofende ema ida. Sin. lia-tolok; tatolok"
  },
  {
    "word": "intaktu - intakta",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé ho kondisaun tomak hela, kompletu ka la hetan estragu ida."
  },
  {
    "word": "integra",
    "class": "Verbu",
    "meaning": "Sai parte ka tama hodi perte-nse ba grupu, organizasaun ka nasaun ida."
  },
  {
    "word": "integrál",
    "class": "Adjetivu",
    "meaning": "Neʼebé sai ona parte im-portante ba buat ida. Ez. Desportu ohin loron parte integrál kurríkulueskola nian."
  },
  {
    "word": "integrasaun",
    "class": "Substantivu",
    "meaning": "Kondisaun neʼebé halo parte tomak iha buat ida, porezemplu organizasaun, nasaun, nst. Ez. Prosesu integrasaun Timor-Leste ba Indonézia iha 1975 la tuir povu nia hakarak."
  },
  {
    "word": "integrasionista",
    "class": "Adjetivu",
    "meaning": "1. Neʼebé hakarak ka hali'is liu ba integrasaun. 2. (istóriku) Ne'ebé hakarak tuir ka sai parte Indo-nézia nian. Substantivu Ema ida ne'ebé hali'is liu ba integrasaun."
  },
  {
    "word": "integrasionizmu",
    "class": "Substantivu",
    "meaning": "Fiar ba inte-grasaun."
  },
  {
    "word": "integridade",
    "class": "Substantivu",
    "meaning": "1.Kualidadetomak. Sin. tatomak 2. Laran-moos, onestidade."
  },
  {
    "word": "íntegru - íntegra",
    "class": "f. Adjetivu",
    "meaning": ""
  },
  {
    "word": "integrista",
    "class": "Substantivul Adjetivu",
    "meaning": "1. (Ema) neʼebé fiar iha relijiaun ida nia hun loloos. Sin. fundamentalista 2. Ema fanátiku neʼebé hakribi ema hotu neʼebé la fahe lisuk nia fiar. Ez. Integrista sira dalaruma gosta uza violénsia bainhira ema la tuir sira-nia hakarak."
  },
  {
    "word": "integrizmu",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "intelektu",
    "class": "Substantivu",
    "meaning": "Intelektu mak abilidade atu hatene no komprende hanoin no informasaun sira."
  },
  {
    "word": "intelektuál",
    "class": "Adjetivu/Substantivu",
    "meaning": "(Kona-ba) ema neʼebé soi kapasidade atu hanoin kona-ba ideia susar ka komplikadu sira. Ez. Ita presiza intelektuál barak atubele kontribui sira-nia matenek ba dezen-volvimentu nasionál."
  },
  {
    "word": "intelijente",
    "class": "Substantivu",
    "meaning": "(Neʼebé) iha kapasi-dade atu komprende no aprende buat ida ho di'ak no lailais. Sin. matenek, ulun-mamar"
  },
  {
    "word": "intelijénsia",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "intensaun",
    "class": "Substantivu",
    "meaning": "Hanoin, ideia ka planu kona-ba buat ida neʼebé ita haka-rak halo. Sin. sasinar"
  },
  {
    "word": "intensionál",
    "class": "Adjetivu",
    "meaning": "Neʼebé halo ho inten-saun, planu ka hakarak."
  },
  {
    "word": "intensivu - intensiva",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé presiza esforsu boot iha tempu badak nia laran."
  },
  {
    "word": "intensu - intensa",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé ho forsa ka kbiit boot tebes. Ez. Funu ne'e sai in-tensu no kauza destruisaun iha fatin barak."
  },
  {
    "word": "intensidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "intensifika",
    "class": "Verbu",
    "meaning": ""
  },
  {
    "word": "interesa",
    "class": "Verbu",
    "meaning": "Halo ita hakarak atu hatene barak liután kona-ba buat ruma. Sin. haletak Ez. Livru ne'e interesa hau tanba hau buka informasaun kona-ba ikan sira."
  },
  {
    "word": "interesadu - interesada",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé iha interese ba buat ruma."
  },
  {
    "word": "interesante",
    "class": "Adjetivu",
    "meaning": "Neʼebé dada ka atrai ha'u-nia interese. Sin. kletak Ez. Istória ne'e interesante tebes tanba ko'alia kona-ba tempu bainhira hau seidauk moris."
  },
  {
    "word": "interese",
    "class": "Substantivu",
    "meaning": "Buat neʼebé dada ita-nia atensaun tanba furak ka serve. Sin. laletak Verbu Sente interese kona-ba buat ruma. Sin. letak"
  },
  {
    "word": "interfere",
    "class": "Verbu",
    "meaning": "1. Mete ho buat ruma ka tama klaran. Sin. haktamak, haklaur 2. Hanetik."
  },
  {
    "word": "interferénsia",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "interiór",
    "class": "Adjetivul Substantivu",
    "meaning": "(Konaba) parte laran nian. Ez. Uma ne'e nia interiór furak lahalimar."
  },
  {
    "word": "Interjeisaun",
    "class": "Substantivu",
    "meaning": "Liafuan ida neʼebé ema uza, baibain ho lian makaʼas, hodi espresa emosaun ruma hanesan hakfo-dak, hirus ka ta'uk, n.e. Amudeus! ha-luha rai! ne'e ka? Ez. Amudeus! Labarik ne'e mane-klosan tiha ona."
  },
  {
    "word": "interkámbiu",
    "class": "Substantivu",
    "meaning": "Hahalok ka asaun atu troka malu. Nu'udar ezemplu, estu-dante hosi universidade A hala'o estájiu iha universidade B neʼebé nia estudante mós hala'o atividade ruma iha univer-sidade A."
  },
  {
    "word": "interkontinentál",
    "class": "Adjetivu",
    "meaning": "1. Neʼebé hela iha kontinente sira-nia leet. 2. Neʼebé la'o entre kontinente sira."
  },
  {
    "word": "internadu - internada",
    "class": "f. Substantivu",
    "meaning": "Ema neʼebé koloka iha fatin ida ba tempu naruk ka natoon de'it, nu'udar ezemplu iha koléjiu ka kampukonsentrasaun."
  },
  {
    "word": "internasionál",
    "class": "Adjetivu",
    "meaning": "Neʼebé entre nasaun rua ka liu."
  },
  {
    "word": "internatu",
    "class": "Substantivu",
    "meaning": "1. Eskola iha neʼebé alunu sira horik bá, la fila loroloron ba uma bainhira aula sira hotu. 2. Períodu-formasaun ba médiku ka doutór foun sira, neʼebé sira hala'o iha ospitál iha."
  },
  {
    "word": "internét",
    "class": "Substantivu",
    "meaning": "Rede globál komputa-dór nian neʼebé fó informasaun oioin no fasilidade komunikasaun nian."
  },
  {
    "word": "internu - interna",
    "class": "f. Adjetivu",
    "meaning": "Laran nian. Sin. larak Substantivu 1. Alunu neʼebé horik iha eskola laran. 2. Médiku neʼebé hala'o nia internatu iha ospitál ida."
  },
  {
    "word": "interpreta",
    "class": "Verbu",
    "meaning": "1. Fó loloos sentidu ka arti hosi buat ida, nu'udar ezemplu fraze, orasaun ka konstrusaun ida. 2. Fila ka tradús liafuan no fraze idaidak iha lian ida ba lian seluk, atu ema neʼebé la hatene lian dahuluk nee bele kom-prende. Sin. durubasa, fila lia"
  },
  {
    "word": "interpretasaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "intérprete",
    "class": "Substantivu",
    "meaning": "Emaneebeinterpreta liuliu hosi lian ida ba lian seluk. Sin. du-rubasa, fila-lia nain Ez.Durante tempu Nasaun Naklibur Sira nian iha Timór Lorosa'e, joven barak sai intérprete atu manán osan."
  },
  {
    "word": "interroga",
    "class": "Verbu",
    "meaning": "Husu barak konaba buat ida atubele hatene kazu ida. Sin. husu-litik, hakusuk Ez. Polísia sei interroga hela ema ne'e tanba nia la iha doku-mentu ofisiál ruma."
  },
  {
    "word": "interrogasaun",
    "class": "",
    "meaning": ""
  },
  {
    "word": "interrogatóriu",
    "class": "Substantivu",
    "meaning": "; Sin. hakusuk"
  },
  {
    "word": "interrogadór - interrogadora",
    "class": "Substantivu",
    "meaning": "Ema neʼebé hala'o interrogatóriu ida."
  },
  {
    "word": "interrompe",
    "class": "Verbu",
    "meaning": "1. Hapara ka hanetik derrepente. 2. Hapara ka atrapalla ema neʼebé ko'alia hela. Ez. Tanba alunu nee interrompe beibeik, mestre la konsege esplika konseitu nee."
  },
  {
    "word": "interrupsaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "interruptór",
    "class": "Substantivu",
    "meaning": "Botaun ida, baibain iha parede, neʼebé ita fila hodi loke ahi."
  },
  {
    "word": "intersesaun",
    "class": "Substantivu",
    "meaning": "Tama klaran hodi tulun. Ez. Sarani sira reza beibeik ba Maro-mak liuhosi santu sira-nia intersesaun."
  },
  {
    "word": "intervalu",
    "class": "Substantivu",
    "meaning": "1. Distánsia entre buat rua. Sin. leet 2. Tempu badak entre atitividade rua, liuliu atubele deskansa. Sin. hahotas Ez. Kursu ne'e sei too tuku 10, hafoin iha intervalu minutu 15 no hahú fali tuku 10:15."
  },
  {
    "word": "intestinu",
    "class": "Substantivu",
    "meaning": "Tubu naruk iha ema no balada sira-nia kabun laran neʼebé lori hahán hosi estómagu hodi prepara atu hali'ur tiha. Intestinu ne'e nakfahe ba laran-metan no laran-mutin (ka tee-oan)."
  },
  {
    "word": "intimidasaun",
    "class": "Substantivu",
    "meaning": "Hahalok hata'uk nian. Sin. hakdedar, hata'uk Ez. Iha tinan 1999 povu Timór ta'uk atu bá vota tanba milísia sira hala'o intimida-saun, katak sé mak vota sei mate."
  },
  {
    "word": "intimida",
    "class": "Verbu",
    "meaning": ""
  },
  {
    "word": "íntimu - íntima",
    "class": "f. Adjetivu",
    "meaning": "1. Neʼebé iha itania klamar laran. Ez. Maromak de'it mak hatene ita-ema nia hanoin íntimu. 2. Ne'ebé besik liu iha relasaun. Ez. Belun íntimu sira tenke ajuda malu bainhira ida monu ba susar."
  },
  {
    "word": "intimidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "intoksikasaun",
    "class": "Substantivu",
    "meaning": "Hahalok fó venenu nian. Sin. harason"
  },
  {
    "word": "intoleránsia",
    "class": "Substantivu",
    "meaning": "Hahalok la tolera ema, moris, fiar ka buat ida. Ez. Intol-eránsia mosu tanba ema barak hanoin kloot."
  },
  {
    "word": "intolerante",
    "class": "Adjetivu",
    "meaning": ""
  },
  {
    "word": "intriga",
    "class": "Substantivu",
    "meaning": "Planu subasubar neʼebé ema ka grupu ruma hala'o ho hanoin atu fó susar, halo aat ka hala'o hahalok ilegál ida. Sin. futu-lia"
  },
  {
    "word": "intrigante",
    "class": "Substantivu",
    "meaning": "Ema ida neʼebé gosta intriga. Sin. futuliadór"
  },
  {
    "word": "introdús",
    "class": "Verbu",
    "meaning": "1. Hatama. 2. Hatada ba dala uluk."
  },
  {
    "word": "introdutóriu - introdutória",
    "class": "f. Adjetivu",
    "meaning": ""
  },
  {
    "word": "introdusaun",
    "class": "Substantivu",
    "meaning": "1. Hahalok hatama nian. 2. Liafuan balu ka memsajen ba lee-na'in sira neʼebé imprime iha livru nia hun, lia maklokek. Ez. Livru nee nia introdusaun hato'o informasaun kona-ba oinsá hahú hakerek."
  },
  {
    "word": "intruzu - intruza",
    "class": "f. Substantivu",
    "meaning": "Ema neʼebé tama ba fatin ida, liuliu edifísiu ida, ho intensaun kriminál. Ez. Ami telefona ba polísia tanba haree intruzu ida foin tama ba ami-nia eskritóriu."
  },
  {
    "word": "inu",
    "class": "Substantivu",
    "meaning": "Ai-knananuk ka kantigu hodi hahi'i buat ka ema ruma."
  },
  {
    "word": "inundasaun",
    "class": "Substantivu",
    "meaning": "Bee neʼebé sa'e maka'as no suli ba fatin-fatin hodi halo ema bele mout. Sin. bee-taka, bee-saʼe, saserek, rai-nabeen, lalubur"
  },
  {
    "word": "inur mós inur-kain",
    "class": "Substantivu",
    "meaning": "Parte inus ka ibun balada nian neʼebé naklosu ba oin. Rai-inur katak rai neʼebé nia rohan naruk tama ba tasi laran."
  },
  {
    "word": "inus",
    "class": "Substantivu",
    "meaning": "Parte oin nian iha ibun le-ten entre matan rua neʼebé naklosu ba oin, iha kuak rua atu hodi dada no hasai iis, nune'e mós hodi hois fo'er iha inus laran."
  },
  {
    "word": "inus-kuak",
    "class": "Substantivu",
    "meaning": "Kuak rua inus nian atuhodi dada no hasai iis, no mós hodi hasai fo'er."
  },
  {
    "word": "inus-metin",
    "class": "Substantivu",
    "meaning": "Moras ida neʼebé ema hetan tanba infesaun iha knalus ka membrana inus nian halo kakorok sai manas hodi halo inus-been suli no fani."
  },
  {
    "word": "invade",
    "class": "Verbu",
    "meaning": "Tama ho beran ka violénsia. Sin. haklurit"
  },
  {
    "word": "inválidu - inválida",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé la iha vigór ka kbiit legál, nune'e la serve atu uza. Substantivu Ema neʼebé tanba tinan-tuan ona ka moras sei la bele tan hala'o serbisu ida. Ez. Golu ne'e inválidu tanba nia hatama ho liman."
  },
  {
    "word": "invazaun",
    "class": "Substantivu",
    "meaning": "Hahalok tama iha fatin ida ho beran ka violénsia. Ez. Komunidade internasionál no Kreda kondena invazaun neebé rain boot balu halo ba rain ki'ik sira."
  },
  {
    "word": "invazór - invazora",
    "class": "f. Substantivu",
    "meaning": "Ida neʼebé hala'o invazaun."
  },
  {
    "word": "inventa",
    "class": "Verbu",
    "meaning": "Hamosu planu, instrumentu ka mákina foun ida."
  },
  {
    "word": "invensaun",
    "class": "Substantivu",
    "meaning": "1. Hahalok inventa nian. 2. Buat ida ne'ebé ema inventa."
  },
  {
    "word": "inventáriu",
    "class": "Substantivu",
    "meaning": "Lista no relatóriu kona-ba ema ka empreza iha nia sasán."
  },
  {
    "word": "inventiva",
    "class": "Substantivu",
    "meaning": "Jeitu atu inventa."
  },
  {
    "word": "inventór - inventora",
    "class": "f. Substantivu",
    "meaning": "Ema neʼebé inventa buat ida."
  },
  {
    "word": "invernu",
    "class": "Substantivu",
    "meaning": "Estasaun malirin entre outonu ho primavera iha rain sira neʼebé iha klima temperadu, n.e. Portugál, Austrália parte súl, Kanadá, Japaun nst."
  },
  {
    "word": "inversu - inversa",
    "class": "f. Adjetivu",
    "meaning": "1. Neʼebé hatuur tiha ona iha sentidu hasoru naturál. 2. Sorun iha pozisaun, dire-saun, orden no efeitu. Sin. kontráriu, maksakar Substantivu Buat ida neʼebé sai sorun ba buat seluk ida."
  },
  {
    "word": "investe",
    "class": "Verbu",
    "meaning": "1. Tau osan iha projetu finan-seiru ka propriedade ida ho esperansa atu hetan lukru. 2. Fó pose ho kargu ka dignidade ida. Ez. Governu sei fó opor-tunidade ba komersiante rai-li'ur nian atu investe iha Timór."
  },
  {
    "word": "investiga",
    "class": "Verbu",
    "meaning": "Buka-hatene konaba kazu ida ho dalan sistemátiku no formál atu bele hetan lia-loos. Sin. haknokar Ez. Polísia sei investiga hela ema balu atu hatene loloos sé mak hahú distúrbiu ne'e."
  },
  {
    "word": "investigasaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "investigadór - investigadora",
    "class": "f. Substantivu",
    "meaning": "Ema neʼebé investiga ka halo investiga-saun. Sin. maknokar"
  },
  {
    "word": "investimentu",
    "class": "Substantivu",
    "meaning": "Hahalok ka efeitu investe nian."
  },
  {
    "word": "invizivel",
    "class": "Adjetivu",
    "meaning": "Neʼebé ema la bele haree-hetan tanba la mosu ka subar hela. Sin. haree-labelek"
  },
  {
    "word": "invizibilidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "invoka",
    "class": "Verbu",
    "meaning": "1. Bolu Maromak ka ema ruma nia tulun. Sin. hamulak, tota lia 2. Orasaun badak ida hanesan hamulak."
  },
  {
    "word": "invokasaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "involuntáriu - involuntária",
    "class": "f. Adjetivu",
    "meaning": "1. Ne'ebé hala'o lahó hakarak, ka lahó kontrole neon ka kakutak nian. 2. Hala'o kontra ema ida nia hakarak."
  },
  {
    "word": "invulneravel",
    "class": "Adjetivu",
    "meaning": "Neʼebé ita la bele hak-anek ka halo aat. Sin. hakanek-labelek"
  },
  {
    "word": "invulnerabilidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "iodu",
    "class": "Substantivu",
    "meaning": "Kristál metan neʼebé serve hodi prepara been kórvioleta ida neʼebé bele uza nu'udar ai-moruk antiséptiku."
  },
  {
    "word": "iogurte",
    "class": "Substantivu",
    "meaning": "Ai-han ida halo ho susu-been-uut siin ho baktéria iha laran."
  },
  {
    "word": "Iorke",
    "class": "Substantivu",
    "meaning": "Sidade ida iha rai-Ingla-terra nia balun norte."
  },
  {
    "word": "Iorke Foun mós Novaiorke",
    "class": "Substantivu",
    "meaning": "Si-dade boboot ida nakfati iha Estadu Na-kliburSira AmérikaNian nia raat nordeste."
  },
  {
    "word": "ipérbole",
    "class": "Substantivu",
    "meaning": "Ko'alia ka espresaun neʼebé ezajera liu ka haboot resin faktu sira."
  },
  {
    "word": "ipersensivel",
    "class": "(Bee-Lihun) Adjetivu",
    "meaning": "1. (Ema ka isinbalun) neʼebé sensivel liu. 2. (Ema) ne'ebé sente laran-kanek lailais."
  },
  {
    "word": "ipersensibilidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "ipnoze",
    "class": "Substantivu",
    "meaning": "Tratamentu médiku hodi hadukur ema nia kakutak."
  },
  {
    "word": "ipnótiku - ipnótika",
    "class": "f. Adjetivu",
    "meaning": ""
  },
  {
    "word": "ipnotiza",
    "class": "Verbu",
    "meaning": "Hadukur ema liuhosi ipnoze. Ez. Naok-teen balu ipnotiza ema molok atu naʼok."
  },
  {
    "word": "ipókrita",
    "class": "Adjetivu/Substantivu",
    "meaning": "(Ema) neʼebé hakfudik ka finje kualidade di'ak ida neʼebé nia afinál la soi. Sin. laran-mak-erek, falsu"
  },
  {
    "word": "ipokrizia",
    "class": "Substantivu",
    "meaning": "1. Hatudu virtude ka hahalok di'ak neʼebé loloos la iha. Ez. Moris ne'e nakonu ho ipokrizia tanba ema ko'alia oin ida no halo oin-seluk. 2. Devosaun bosok ka falsu."
  },
  {
    "word": "ipoteka",
    "class": "Substantivu",
    "meaning": "Kontratu iha neʼebé ema peñora rikusoin ruma hanesan rai ka uma hodi selu tusan."
  },
  {
    "word": "ipóteze",
    "class": "Substantivu",
    "meaning": "1. Esplikasaun ida bazeia ba evidénsia neʼebé limitadu no ita tenke hametin ho prova liután. 2. Buat ida neʼebé sei hanoin de'it, neʼebé seidauk mosu ka sai realidade. Sin. supozisaun"
  },
  {
    "word": "ipotétiku - ipotétika",
    "class": "f. Adjetivu",
    "meaning": ""
  },
  {
    "word": "ípsilon",
    "class": "Substantivu",
    "meaning": "Letra alfabetu gregu no romanu ninian, hakerek ho tadak Y (boot) ka y (ki'ik). Ípsilon la serve ba hakerek lia-tetun, maibé uza fali hodi hakerek lia-fataluku."
  },
  {
    "word": "Irabere (Mota-)",
    "class": "Substantivu",
    "meaning": "Mota iha Watu-karbau no Iliomar nia leet, neʼebé suli nafatin iha tempu bailoro."
  },
  {
    "word": "Irake (rai-)",
    "class": "Substantivu",
    "meaning": "Rain no estadu ida iha Ázia Loromonu. Nia naran uluk Mezopotámia, katak ‘rain iha mota rua nia leet’."
  },
  {
    "word": "irakianu - irakiana",
    "class": "f. Adjetivu",
    "meaning": "Rai-Irake nian; kona-ba rai-Irake. Substantivu Ema Irake."
  },
  {
    "word": "Iralalaru (Bee-Lihun)",
    "class": "Substantivu",
    "meaning": "Bee-lihun boot ida iha zona Lospalos besik Mehara."
  },
  {
    "word": "iranianu - iraniana",
    "class": "f. Adjetivu",
    "meaning": "Rai-Iraun nian; kona-ba rai-Iraun. Sin. persa Sub-stantivu Ema Iraun."
  },
  {
    "word": "Iraun (rai-)",
    "class": "Substantivu",
    "meaning": "Rain no estadu ida iha Ázia Loromonu. Pérsia maka nia naran uluk."
  },
  {
    "word": "Irlanda (rai-)",
    "class": "Substantivu",
    "meaning": "Rai-kotun ida rai-Bretaña nia sorin loromonu nian. Repú-blika Irlanda okupa rain nia nia parte boot liu."
  },
  {
    "word": "irlandés - irlandeza",
    "class": "f. Adjetivu",
    "meaning": "Rai-Irlanda nian; kona-ba rai-Irlanda. Substantivu 1. Ema Irlanda. 2. (lia-irlandés) Dalen Irlanda nian. Sin. liagaéliku"
  },
  {
    "word": "irmán",
    "class": "Substantivu",
    "meaning": "Feto la kaben neʼebé tama kongregasaun ka orden monástika ida Kreda Katólika ka Kreda Ortodoksa nian hodi fó nia moris tomak ba hala'o knaar sira neʼebé nia superiora haraik atu serbí Maromak no ema sira. Sin. madre"
  },
  {
    "word": "irmaun",
    "class": "Substantivu",
    "meaning": "1. Mane la kaben neʼebé tama kongregasaun Kreda Katólika nian hodi fó nia moris tomak ba hala'o knaar sira neʼebé nia superiór sira haraik atu serbí Maromak no ema sira. Nia baibain la simu ordenasaun na'i-lulik. 2. Semi-narista."
  },
  {
    "word": "ironia",
    "class": "Substantivu",
    "meaning": "1. Buat ida neʼebé akon-tese ho kontráriu ba buat neʼebé ita hakarak ka hein. 2. Ko'alia ho zombaria no sarkazmu, hodi finje ita la hatene ka simu buat ida ne'ebé ita loloos la gosta. Sin. lia-bones, babones"
  },
  {
    "word": "iróniku - irónika",
    "class": "f. Adjetivu",
    "meaning": "1. Ironia nian; ho ironia. 2. Ko'alia ka situasaun na-konu ho ironia. 3. Kómiku tanba hatudu ironia. Ez. Nia ema neʼebé kontra vio-lénsia maibé iróniku tebes tanba hosi kotuk nia sadik ema hodi baku malu."
  },
  {
    "word": "ironiza",
    "class": "Verbu",
    "meaning": "Ko'alia ho ironia. Sin. hak-bones"
  },
  {
    "word": "irrasionál",
    "class": "Adjetivu",
    "meaning": "Neʼebé hasoru razaun."
  },
  {
    "word": "irreál",
    "class": "Adjetivu",
    "meaning": "Neʼebé laʼós realidade, mehi de'it."
  },
  {
    "word": "irrefutavel",
    "class": "Adjetivu",
    "meaning": "Neʼebé ita la bele nega; tanba evidente ka momoos loos. Sin. nega-labelek, hatiran-labelek"
  },
  {
    "word": "irregulár",
    "class": "Adjetivu",
    "meaning": "Neʼebé la tuir regra ka norma baibain nian."
  },
  {
    "word": "irregularidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "irrekonsiliavel",
    "class": "Adjetivu",
    "meaning": "Neʼebéita la hadame. Sin. hadame-labelek"
  },
  {
    "word": "irrelevante",
    "class": "Adjetivu",
    "meaning": "Neʼebé la'ós relevante, ladún kona. Ez. Prova ida-neʼebé advo-gadu hato'o loloos irrelevante ba kazu ne'e."
  },
  {
    "word": "irrelevánsia",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "irremediavel",
    "class": "Adjetivu",
    "meaning": "Neʼebé ita la bele remedeia ka haloos. Sin. habali-labelek, haloos-labelerk"
  },
  {
    "word": "irremediabilidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "irreparavel",
    "class": "Adjetivu",
    "meaning": "Neʼebé ita la bele hadi'a. Sin. hadi’a-labelek"
  },
  {
    "word": "irreparabilidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "irresponsavel",
    "class": "Adjetivu",
    "meaning": "Neʼebé hatudu ati-tude responsavel. Sin. laresponsavel, latesak Ez. Empregadu nee bele halo aat projetu tomak ho nia hahalok irrespo-nsavel."
  },
  {
    "word": "irresponsabilidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "irrezistivel",
    "class": "Adjetivu",
    "meaning": "Neʼebé sei la bele reziste ka susar atu kontrola. Sin. satanlabelek"
  },
  {
    "word": "irriga",
    "class": "Verbu",
    "meaning": "Dada ka husik bee liuhosi kanu ka beedalan ba fatin ida hodi halo ai-horis moris ka buras. Sin. haroo"
  },
  {
    "word": "irrigasaun",
    "class": "Substantivu",
    "meaning": "; Sin. haroon"
  },
  {
    "word": "isik",
    "class": "Adjetivu",
    "meaning": "Isin nian; konaba isin. Sin. kor-porál, korpóreu"
  },
  {
    "word": "isin",
    "class": "Substantivu",
    "meaning": "1. Ai-fuan no modo nia na'an no kulit hamutuk. 2. Balada ka ema nia na'an, kulit no ruin hamutuk. 3. Buat ida nia parte laran ka importante."
  },
  {
    "word": "isin-balun",
    "class": "Substantivu",
    "meaning": "Liman ka ain. Sin. membru"
  },
  {
    "word": "isin-baruk",
    "class": "Adjetivul Substantivu",
    "meaning": "Sente isin ladún di'ak, moras uitoan."
  },
  {
    "word": "isin-di'ak",
    "class": "Adjetivu",
    "meaning": "Neʼebé la hetan moras ruma ka goza saúde di'ak. Substantivu Kondisaunlahetan moras nian, isintomak funsiona didi'ak. Sin. saúde"
  },
  {
    "word": "isin-fraku",
    "class": "Adjetivul Substantivu",
    "meaning": "(Neʼebé) la iha forsa, liuliu tanba moras ruma."
  },
  {
    "word": "isin-lais",
    "class": "Adjetivul Substantivu",
    "meaning": "(Neʼebé iha) kapasidade atu hanoin ka halo buat ida lailais liu."
  },
  {
    "word": "isin-lolon",
    "class": "Substantivu",
    "meaning": "Isin nia lolon."
  },
  {
    "word": "isin-malirin",
    "class": "Substantivu",
    "meaning": "Moras neʼebé halo ema sente malirin no nakdedar nafatin."
  },
  {
    "word": "isin-metak mós isinmetan",
    "class": "Substantivu",
    "meaning": "Parte kulit nian ne'ebé sai azúl tanba hetan tuku ruma. Sin. isin-lolon metan, baku-fatin, isinazuladu"
  },
  {
    "word": "isin-molik",
    "class": "Adjetivul Substantivu",
    "meaning": "(Neʼebé) isin-lolon la taka ka nakloke tomak; la hatais roupa ida. Sin. isin-tanan"
  },
  {
    "word": "isin-moras",
    "class": "Substantivul Adjetivu",
    "meaning": "(Kondis-aun) la iha saúde ka lakon saúde nian; sente isin-baruk loos."
  },
  {
    "word": "isin-rua",
    "class": "Substantivu/Adjetivu",
    "meaning": "(Kondisaun bainhira feto) ko'us oan iha knotak laran ba kurakuran fulan sia nia laran. Sin. ho estadu hela"
  },
  {
    "word": "isin-tanan",
    "class": "Adjetivul Substantivu",
    "meaning": "(Neʼebé) la iha hatais ruma taka isin. Sin. isin-molik"
  },
  {
    "word": "isin-todan",
    "class": "Adjetivu",
    "meaning": "Neʼebé sente katak forsa la iha atu hala'o atividade ka knaar ruma. Sin. baruk"
  },
  {
    "word": "iska",
    "class": "Substantivu",
    "meaning": "Ai-han uitoan neʼebé ema tau iha kail nia rohan ka iha lasu atubele dada no kaer ikan ka animal seluk. Sin. umpa"
  },
  {
    "word": "iskeiru",
    "class": "Substantivu",
    "meaning": "Utensíliu ki’ik atu ha-mosu ahi, bele enxe ho gás ka minarai."
  },
  {
    "word": "isní (lia-)",
    "class": "Substantivu",
    "meaning": "Dialetu liaidalaka nian neʼebé ko'alia iha subdistritu Turiskai. Ema Isní, katak makdalek lian ida-ne'e nian."
  },
  {
    "word": "ispániku - ispánika",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé nia hun iha rai-España."
  },
  {
    "word": "ispanu-amerikanu - ispanu-amerikana",
    "class": "f. Adjetivul Substantivu",
    "meaning": "(Konaba) ema Amérika neʼebé ko'alia españól ka nia bizavón sira ema ispániku."
  },
  {
    "word": "Istambúl",
    "class": "Substantivu",
    "meaning": "Sidade boot ida iha rai-Turkia. Konstantinopla maka nia naran uluk nian."
  },
  {
    "word": "isterektomia",
    "class": "Substantivu",
    "meaning": "Operasaun sirúr-jika kona-ba tesi sai feto nia oan-fatin ka úteru."
  },
  {
    "word": "isteria",
    "class": "Substantivu",
    "meaning": "1. Moras nervozu neʼebé hatudu konvulsaun ka bibimaten. 2. Kondisaun nervus no laran tuku-tuku makaʼas; pániku tan buat ida ne'ebé halo ema sente ta'uk ka laran-manas liu. Ez. Isteria kona foin-sa'e fanátiku sira bainhira ditadór mosu kedas iha sira-nia oin, halo sira hakilar no tanis hanesan ema bulak."
  },
  {
    "word": "istériku - istérika",
    "class": "f. Adjetivu",
    "meaning": "Ez. Feto nee sai istériku bainhira nia haree nia alin mate tanba karreta xoke."
  },
  {
    "word": "istmu",
    "class": "Substantivu",
    "meaning": "Rai-dilan kloot no naruk ida neʼebé tutan península ida ba rai-boot. Sin. raikain"
  },
  {
    "word": "istória",
    "class": "Substantivu",
    "meaning": "1. Ai-knanoik, liuliu kona-ba ema nia moris. Sin. kontu, aiknanoik Ez. Avón sira gosta konta istória kona-ba bibi-atan neʼebé badinas no neonna'in. 2. Haktuir kona-ba moris povu ka ema ida nian. Ez. Loron 20 fulan-Maiu sai parte istória Timor-Leste nian ida tanba iha loron ne'e ita hetan fali independénsia."
  },
  {
    "word": "istoriadór - istoriadora",
    "class": "f. Substantivu",
    "meaning": "Ema neʼebé estuda no hakerek kona-ba istória, liuliu nuʼudar serbisu profisionál."
  },
  {
    "word": "istóriku - istórika",
    "class": "f. Adjetivu",
    "meaning": "1. Istória nian, kona-ba istória. 2. Neʼebé iha importá-nsia ba istória povu ka nasaun nian. Ez. Loron 30 fulan- Setembru sai loron istóriku ida ba povu Timor-Leste."
  },
  {
    "word": "istori malu",
    "class": "Verbu",
    "meaning": "Ko'alia aat no briga to'o baku malu."
  },
  {
    "word": "istori-malu",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "ita",
    "class": "Pronome Emak",
    "meaning": "1. Ó no ha'u hamutuk. 2. Imi no ami hamutuk."
  },
  {
    "word": "Ita",
    "class": "Pronome Emak Onorífiku",
    "meaning": "Liafuan neʼebé troka Pronome ó bainhira ita hakarak hatudu respeitu ba ema ida. Pronome ne'e ita sempre hakerek ho letra i boot."
  },
  {
    "word": "Ita-Boot",
    "class": "Pronome Emak Onorífiku",
    "meaning": "Liafuan neʼebé troka Pronome ó bainhira ita hakarak hatudu respeitu boot ba ema ida. Pronome ne'e ita sempre hakerek ho letra i no b boot. Hodi hasé ema naʼinrua ka liu, ita dehan ka hakerek Ita-Boot sira hodi troka Pronome imi."
  },
  {
    "word": "Itália (rai-)",
    "class": "Substantivu",
    "meaning": "Rain no estadu ida iha Europa Súl. Nia kapitál, Roma, ho-riuluk sentru Impériu Romanu nian no ohin sei sede Kreda Katólika nian."
  },
  {
    "word": "italianu - italiana",
    "class": "f. Adjetivu",
    "meaning": "Rai-Itália nian; kona-ba rai-Índia. Substantivu 1. EmaItá-lia. 2. (lia-italianu) Dalen rai-Itália nian."
  },
  {
    "word": "itáliku - itálika",
    "class": "f. Adjetivu",
    "meaning": "Kona-ba Itália antiga. Substantivu Estilu-hakerek hato-ba ida hanesan tuirmai nee: hakerek itáliku. Sin. letrahatoba"
  },
  {
    "word": "ita-nia",
    "class": "Pronome Maksoik",
    "meaning": "Neʼebé ita mak soi. Ez. Ita-nia povu koalia dalen barak."
  },
  {
    "word": "Ita-nia",
    "class": "Pronome Maksoik",
    "meaning": "Neʼebé Ita mak soi. Ez. Hau atu karimba Itania pasaporte."
  },
  {
    "word": "ita-nian",
    "class": "Pronome Maksoik",
    "meaning": "Neʼebé ita mak soi. Maklalin ka variante nee hanesan ho ita-nia, maibé tuir Substantivu ida-neʼebé nia refere bá. Ez. Ita la presiza sira-nia osan; ita soi ita-nian."
  },
  {
    "word": "Ita-nian",
    "class": "Pronome Maksoik",
    "meaning": "Neʼebé Ita mak soi. Maklalin ka variante ne'e hanesan ho Ita-nia, maibé tuir Substantivu ida-neʼebé nia refere bá. Ez. Kaneta nee Ita-nian, Sr. Filipe?"
  },
  {
    "word": "itineráriu",
    "class": "Substantivu",
    "meaning": "Oráriu kompletu kona-ba viajen ida, neʼebé temi fatin hotu-hotu ne'ebé ita atu bá."
  },
  {
    "word": "iupi",
    "class": "Substantivu",
    "meaning": "Ema ida neʼebé moris iha família riku no sai boot ho mentali-dade materialista no maromak-laek. Li-afuan inglés ne'e (yuppie) refere beibeik ba joven sira iha rain riku sira Mundu Dahuluk nian. Ez. Timoroan sira la gosta iupi portugés sira neebé mai serbisu iha Timór no lakohi aprende lia-tetun."
  },
  {
    "word": "izentu - izenta",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé livre, katak lei ka taxa, ka kastigu sei la kona. Sin. foruk Ez. Korpu diplomátiku sira baibain hatama sasán maibé sira izentu hosi taxa importasaun nian."
  },
  {
    "word": "izensaun",
    "class": "Substantivu",
    "meaning": "; Sin. haforun"
  },
  {
    "word": "izlámiku - izlámika",
    "class": "f. Adjetivu",
    "meaning": "Izlaun nian, kona-ba fiar Izlaun."
  },
  {
    "word": "izlandés - izlandeza",
    "class": "Adjetivu",
    "meaning": "Rai-Izlándia nian, kona-ba rai- Izlándia. Substan-tivu 1. Ema Izlándia. 2. (lia-izlandés) Dalen Izlándia nian."
  },
  {
    "word": "Izlándia (rai-)",
    "class": "Substantivu",
    "meaning": "Rai-kotun boot no estadu iha Tasi Nórdiku, nakfati iha Europa nia sorin nordueste."
  },
  {
    "word": "Izlaun",
    "class": "Substantivu",
    "meaning": "Relijiaun ida, ohin loron naklekar ba Ázia no Áfrika parte boot, neʼebé Maomé mak harii iha rai- Arábia iha sékulu dahituk liutiha Kristu."
  },
  {
    "word": "izoladu - izolada",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé hela ketak ka dook tiha hosi sira seluk. Sin. haksiit"
  },
  {
    "word": "izolamentu",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "izola",
    "class": "Verbu",
    "meaning": "1. Haketak ka hadook tiha hosi ema seluk. Ez. Prizaun balu izola tiha prizoneiru sira ne'ebé siak no violentu. 2. Hadi'a materiál ruma atu manas, lian ka eletrisidade la bele liu borus."
  },
  {
    "word": "Izraél (rai-)",
    "class": "Substantivu",
    "meaning": "Estadu ida iha Loro-sa'e Klarak neʼebé okupa territóriu rai-Palestina nian no povu judeu mak ukun."
  },
  {
    "word": "izraelita",
    "class": "Adjetivu",
    "meaning": "Izraél nian, konaba rai-Izraél. Substantivu 1. Ema Izraél. 2. Ema judeu (lalika sidadaun rai-Izraél nian)."
  },
  {
    "word": "Jakarta",
    "class": "Substantivu",
    "meaning": "Sidade boot iha rai-Java Loromonu neʼebé sai kapitál Indonézia nian, sentru ba governu no komérsiu."
  },
  {
    "word": "jaketa",
    "class": "Substantivu",
    "meaning": "Faru mahar no naruk neʼebé bele uza atu tahan ema hosi ma-lirin no mós anin."
  },
  {
    "word": "Jaku",
    "class": "Substantivu",
    "meaning": "Illa ki’ikoan ida pertense ba no besik distritu Lospalos; rai neʼebé ema la horik bá maibé fatin ida ne'ebé turista sira gosta vizita."
  },
  {
    "word": "jambata",
    "class": "Substantivu",
    "meaning": "Ai-lalete boot neʼebé uza atu hakat liu mota ka rai-olat. Sin. ponte"
  },
  {
    "word": "jambua",
    "class": "Substantivu",
    "meaning": "Ai-fuan ida hanesan saburaka maibé boot liu ho laran mean ka mutin bainhira nia tasak. Naran Botániku: Citrus paradisi"
  },
  {
    "word": "Janeiru (fulan-)",
    "class": "Substantivu",
    "meaning": "Fulan dahuluk neʼebé hahú bainhira troka tinan tuan ba tinan foun."
  },
  {
    "word": "janela",
    "class": "Substantivu",
    "meaning": "1. Kuak kuadradu didin-lolon uma nian ka iha karreta nia lolon neʼebé taka ho vidru-tahan, bele loke atu simu anin, naroman ka ema bele hateke tuir. 2. Iha komputadór, janela katak fatin ho kuadradu ki'ikoan iha lidun liman loos neʼebé ema bele uza atu taka nia programa."
  },
  {
    "word": "jantár",
    "class": "Substantivu",
    "meaning": "1. Han kalan nian. 2. Festa ki'ik neʼebé hamutuk ho han-kalan. Ez. Señór Antóniu konvida ema balu ba halo jantár ho nia família tomak."
  },
  {
    "word": "Japaun, (rai-)",
    "class": "Substantivu",
    "meaning": "Rain no estadu ida iha Ázia Lorosa'e neʼebé konsege okupa Timór durante Funu Raiklaran Daruak nian hosi tinan 1942-1945."
  },
  {
    "word": "japonés - japoneza",
    "class": "f. Adjetivu",
    "meaning": "Rai-Japaun nian. Substantivu 1. Ema Japaun. 2. (lia-japonés) Lian rai- Japaun nian."
  },
  {
    "word": "jardín",
    "class": "Substantivu",
    "meaning": "1. Área rai iha uma sorin neʼebé iha ai-funan, ai-hun, no du'ut. 2. Parke ki'ik neʼebé ita hetan iha sidade. Ez. Labarik sira halimar iha jardín Ita-Na'I-Feto Fátima nian."
  },
  {
    "word": "jardín infantil",
    "class": "Substantivu",
    "meaning": "Fatin-halimar ho eskola ba prepara labarik sira atu tama eskola primáriu."
  },
  {
    "word": "jardinajen",
    "class": "Substantivu",
    "meaning": "1. Serbisu hodi kuda ai-funan no ai-hun oioin iha jardín laran. 2. Serbisu halo jardín nuʼudar profisaun. Sin. ortikultura"
  },
  {
    "word": "jardineiru - jardineira",
    "class": "f. Substantivu",
    "meaning": "Ema neʼebé tau matan ka haree jardín hanesan ninia serbisu baibain nian ka nu'udar pasatempu."
  },
  {
    "word": "jarra",
    "class": "Substantivu",
    "meaning": "Fatin atu tau ai-funan. Sin. vazu"
  },
  {
    "word": "jatu",
    "class": "Substantivu",
    "meaning": "1. Líkidumusan neʼebé sai tanba hetan presaun, hanesan mina-morin kaleen neʼebé ema rega ba isin-lolon. 2. Mákina neʼebé funsiona tanba hamanas ár hafoin husik sai hosi jatu neʼebé makaʼas tebes. 3. (aviaun-jatu) Aviaun ka kasemok neʼebé uza forsa mákina jatu nian."
  },
  {
    "word": "Java (rai-)",
    "class": "Substantivu",
    "meaning": "Rai-kotun boot ka illa iha Indonézia neʼebé nakfati iha rai-Samatra no rai-Bali nia leet."
  },
  {
    "word": "javanés - javaneza",
    "class": "f. Adjetivu",
    "meaning": "Rai-Java nian. Substantivu 1. Ema Java, Java-oan. 2. (lia-javanés) Lian rai- Java nian."
  },
  {
    "word": "jáz",
    "class": "Substantivu",
    "meaning": "Estilu múzika populár ho rítmu neʼebé maka'as no envolve im-provizasaun."
  },
  {
    "word": "jeitu",
    "class": "Substantivu",
    "meaning": "1. Matenek no abilidade neʼebé ema iha atu hala'o buat ida. 2. Tipu serbisu ka téknika ruma ne'ebé presiza kursu ka matenek espesiál."
  },
  {
    "word": "jejún",
    "class": "Substantivu",
    "meaning": "Tempu durante ne'ebé ema la han, liuliu tan motivu relijiozu ka médiku. Ez. Molok atu Páskua, sa-rani sira halo jejún iha sesta-feira sema-nasemana."
  },
  {
    "word": "jeladu - jelada",
    "class": "f. Adjetivu",
    "meaning": "Malirin tanba tau iha jeleira ka tau kahur ho jelu-fatuk. Substantivu Sorvete neʼebé ema han hodi halo laran malirin. Ez. Diak liu hemu bee jeladu bainhira loron manas maka'as."
  },
  {
    "word": "jeleira",
    "class": "Substantivu",
    "meaning": "Kaixa malirin ne'ebé liga ba eletrisidade atubele malirin nafatin hodi uza ba rai ai-han ka hemu hanesan ai-fuan, pudín, bee, naan no buat se-luseluk tan."
  },
  {
    "word": "jelu",
    "class": "Substantivu",
    "meaning": "Bee neʼebé malirin to'o nahisi hodi sai toos hanesan fatuk."
  },
  {
    "word": "jelu-fatuk",
    "class": "Substantivu",
    "meaning": "Bee neʼebé ema rai ka halo to'o malirin no toos hanesan fatuk."
  },
  {
    "word": "jenerál",
    "class": "Substantivu",
    "meaning": "Diviza iha militár nia laran neʼebé dala barakliu marka ho fitun."
  },
  {
    "word": "jeneraliza",
    "class": "Verbu",
    "meaning": "1. Halo inferénsia jerál. 2. Ko'alia sala hodi la halo distinsaun sira ne'ebé presiza. Ez. Bainhira ema ha-tete katak rai-Timór tomak maran, ema nee jeneraliza de'it, tanba loloos parte barak iha rai-Timór mós matak no buras."
  },
  {
    "word": "jeneralizasaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "jéneru",
    "class": "Substantivu",
    "meaning": "Oin ka tipu ida. Sin. espésie Ez. Iha rai-Timór iha aifuan jéneru oioin, hanesan hudi, haas, aidila, derok no seluseluk tan."
  },
  {
    "word": "jéniu",
    "class": "Substantivu",
    "meaning": "1. Jeitu di'ak tebes ka kapasidade iha buat ruma. 2. Ema ne'ebé matenek, kreativu liu ka iha tal-entu barak."
  },
  {
    "word": "jéniu-aat",
    "class": "Adjetivul Substantivu",
    "meaning": "Hirus-teen, nervozu lailais bainhira ema la tuir nia hakarak. Ez. Labarik nee iha jéniu-aat hanesan nia avó-mane."
  },
  {
    "word": "jéniu-di'ak",
    "class": "Adjetivu",
    "meaning": "Neʼebé nia hahalok di'ak no hakmatek."
  },
  {
    "word": "jenosídiu",
    "class": "Substantivu",
    "meaning": "Buka oho povu tomak ida. Ez. Ema sira neebé pratika jenosídiu iha Bóznia sei lori ba tribunál interna-sionál, maibé militár indonéziu sira neʼebé halo krime jenosídiu iha Timór la hetan kastigu ida."
  },
  {
    "word": "jentiu - jentia",
    "class": "f. Adjetivul Substantivu",
    "meaning": "1. La'ós sarani, la tuir sarani nia hanorin no hanoin, la iha fiar iha Kristu. 2. Ani-mista, molok tama kristianizmu 3. (Ema) la'ós judeu."
  },
  {
    "word": "jenuinu - jenuina",
    "class": "f. Adjetivu",
    "meaning": "Loos ka tebes, tuir buat ne'ebé iha ka mosu, tuir reali-dade loloos."
  },
  {
    "word": "jeofízika",
    "class": "Substantivu",
    "meaning": "Matenek ka siénsia kona-ba rai nia karakterístika fízika sira."
  },
  {
    "word": "jeógrafu - jeógrafa",
    "class": "f. Substantivu",
    "meaning": "Ema matenek kona-ba jeografia."
  },
  {
    "word": "jeografia",
    "class": "Substantivu",
    "meaning": "1. Matenek ka siénsia kona-ba rai nia belak, nia karakterístika fízika sira, produsaun naturál, ema, di-vizaun polítika, komérsiu no buat se-luseluk tan."
  },
  {
    "word": "jeográfiku - jeográfika",
    "class": "f. Adjetivu",
    "meaning": ""
  },
  {
    "word": "jeolojia",
    "class": "Substantivu",
    "meaning": "Matenek ka serbisu kona-ba raiisin, nia estrutura, kompozi-saun no nia mama'ek ka dezenvolvi-mentu."
  },
  {
    "word": "jeolójiku - jeolójika",
    "class": "f. Adjetivu",
    "meaning": ""
  },
  {
    "word": "jeometria",
    "class": "Substantivu",
    "meaning": "Matemátika nia sanak ida neʼebé estuda kona-ba rela-saun pontu, liña, kurva, belak no se-luseluk tan."
  },
  {
    "word": "jeradór",
    "class": "Substantivu",
    "meaning": "1. Mákina ne'ebé de'it mak bele fó sai gás, suar, eletrisidade no seluseluk tan. 2. Mákina ida ne'ebé bele fó enerjia ka eletrisidade no serve liuliu bainhira ahi mate."
  },
  {
    "word": "jerál",
    "class": "Adjetivu",
    "meaning": "1. Neʼebé hakohak ka kona parte hotu-hotu, la'ós balun de'it. Sin. universál 2. Ordináriu, baibain nian. 3. La'ós espesiál ka partikulár ida, la hali'is ba ida de'it ka lokál. Substantivu Galeria ka fatin aas iha teatru laran, hosi ne'ebé ema sira hateke ba espetákulu."
  },
  {
    "word": "jerániu (ai-)",
    "class": "Substantivu",
    "meaning": "Planta ida neʼebé fó ai-funan furak ho kór oioin. Ema sira kuda beibeik aifunan jerániu ne'e iha vazu laran."
  },
  {
    "word": "jerasaun",
    "class": "Substantivu",
    "meaning": "1. Dezenvolvimentu umakain nian hosi tempu uluk bei'ala sira to'o oras ne'e daudaun. 2. Ema lubun ho otas hanesan. Sin. dalas 3. Otas hosi dalas ida ba dalas seluk. Ez. Ema neebé oho ema seluk, sei hetan malisan hosi jerasaun ba jerasaun."
  },
  {
    "word": "jerénsia",
    "class": "Substantivu",
    "meaning": "Knaar jerente nian."
  },
  {
    "word": "jerensiál",
    "class": "Adjetivu",
    "meaning": ""
  },
  {
    "word": "jerente",
    "class": "Substantivu",
    "meaning": "Ema neʼebé hala'o emp-reza ka komérsiu ida. Sin. mala'ok"
  },
  {
    "word": "jeriatria",
    "class": "Substantivu",
    "meaning": "Sanak hosi medisina neʼebé konaba katuas no ferik sira no sira-nia moras oinoin."
  },
  {
    "word": "jeriátriku - jeriátrika",
    "class": "f. Adjetivu",
    "meaning": ""
  },
  {
    "word": "jerikán",
    "class": "Substantivu",
    "meaning": "Masa ka kaleen atu rai mina-rai, bee, gazolina ka buat seluseluk tan neʼebé líkidu."
  },
  {
    "word": "Jeruzalein",
    "class": "Substantivu",
    "meaning": "Sidade boot iha rai-Palestina, sentru antigu no naranboot ba fiar judéu, sarani no musulmanu."
  },
  {
    "word": "jestaun",
    "class": "Substantivu",
    "meaning": "Knaar hala'o empreza ida, liuliu empreza komersiál. Sin. halaon"
  },
  {
    "word": "jestu",
    "class": "Substantivu",
    "meaning": "Espresaun neʼebé ema hato'o liuhosi nia oin, isin ka liman bainhira fó sai hanoin ka emosaun ho intensaun halo maka'as ka espresa nia hanoin ba ema seluk."
  },
  {
    "word": "jestikula",
    "class": "Verbu",
    "meaning": "; Sin. balmas, hakfikur"
  },
  {
    "word": "jesu",
    "class": "Substantivu",
    "meaning": "Ligadura neʼebé ema uza atu bobar liman ka ain tohar, nakonu ho simentu mutin neʼebé sai toos atu labele bokon bainhira bee kona. Ez. Labarik nee ain tohar, tanba nee doutór sira tau jesu ba nia ain atu labele book an demais."
  },
  {
    "word": "jezuita",
    "class": "Substantivu",
    "meaning": "Membru Kompañia Jezús nian, orden katólika ida ne'ebé Inásiu de Loyola mak harii iha tinan 1534."
  },
  {
    "word": "Jezús Kristu",
    "class": "Substantivu",
    "meaning": "Maromak Nia Oan no maksoin ema sira-nian. Sarani sira, hodi hatudu respeitu boot, baibain haktemik Nia ho títulu Ita Naʼi Jezús Kristu selae Ita Na'i de'it."
  },
  {
    "word": "jigante",
    "class": "Substantivu",
    "meaning": "Ema neʼebé boot tebes la hanesan baibain. Sin. ema kloe. Ez. Bainhira David funu hasoru Goliát, hanesan mós nia funu hasoru jigante ida, maibé to'oikus David mak manán."
  },
  {
    "word": "jin",
    "class": "Substantivu",
    "meaning": "Tua-manas inglés ida, halo hosi trigu hamorin ho zimbru-musan."
  },
  {
    "word": "jinasta",
    "class": "Substantivu",
    "meaning": "Ema ida neʼebé pratika jinástika."
  },
  {
    "word": "jinástika",
    "class": "Substantivu",
    "meaning": "Kursu ezersísiu fíziku nian ba dezenvolve isin, halo nia sai toos no maka'as."
  },
  {
    "word": "jináziu",
    "class": "Substantivu",
    "meaning": "Fatin ka uma neʼebé ema uza ba jinástika ka desportu seluk."
  },
  {
    "word": "jinekolojia",
    "class": "Substantivu",
    "meaning": "Siénsia konaba moras sira feto nian."
  },
  {
    "word": "jinekolojista",
    "class": "Substantivu",
    "meaning": "Médiku ka mate-nek-na'in neʼebé estuda ka halo investi-gasaun kona-ba jinekolojia."
  },
  {
    "word": "jipe",
    "class": "Substantivu",
    "meaning": "Karreta ki'ik ida neʼebé na-kloke no iha roda haat, dala barak liu militár sira mak uza tanba nia forte no lailais maski la'o iha fatuk ka tahu nia laran."
  },
  {
    "word": "jipiñu",
    "class": "Substantivu",
    "meaning": "Karreta ida neʼebé boot no aas liu karreta baibain nian. Ez. Kar-reta governu nian ohin loron barakliu jipiñu."
  },
  {
    "word": "jirafa",
    "class": "Substantivu",
    "meaning": "Animál maksusuk ka mamíferu rai-Áfrika nian neʼebé aas, kakorok naruk no iha ain haat. Nia fulun kinur, no taka ho pontu boot barak ho kórmetan."
  },
  {
    "word": "jirasól",
    "class": "Substantivu",
    "meaning": "Ai-funan aas neʼebé iha funan-tahan boot no kinur; dala ruma ema han nia musan bainhira tuan tiha ona tanba midar hanesan fore-rai."
  },
  {
    "word": "jíria",
    "class": "Substantivu",
    "meaning": "Ko'alia ida neʼebé grupu oioin, porezemplu joven sira, militár sira ka mariñeiru sira gosta uza, ho liafuan espesiál neʼebé ema seluseluk ladún hatene. Sin. kalaun Ez. Iha joven sira nia jíria liafuan ‘manduku’ katak ‘noiva’."
  },
  {
    "word": "jís",
    "class": "Substantivu",
    "meaning": "Fatuk mutin halo hosi ahu neʼebé dala barak uza iha eskola atu hake-rek ba kuadru; iha mós jís ho kór oin-oin."
  },
  {
    "word": "joallaria",
    "class": "Substantivu",
    "meaning": "1. Knaar ka arte halo joia sira hosi fatuk-murak. 2. Fatuk-murak ka joia oioin. 3. Loja neʼebé fa'an fatuk-murak oioin."
  },
  {
    "word": "joalleiru - joalleira",
    "class": "f. Substantivu",
    "meaning": "Ema neʼebé prepara ka fa'an fatukmurak ka joallaria."
  },
  {
    "word": "jogadór - jogadora",
    "class": "f. Substantivu",
    "meaning": "Ema neʼebé pratika desportu ka jogu ruma. Ez. Jogadór-futeból hanesan futebolista ka tebebola-na'in, no jogador-basketeból hanesan basketebolista."
  },
  {
    "word": "jogu",
    "class": "Substantivu",
    "meaning": "Halimar ida."
  },
  {
    "word": "joia",
    "class": "Substantivu",
    "meaning": "Fatuk-murak ida neʼebé prepara tiha ona nu'udar enfeite."
  },
  {
    "word": "jókei",
    "class": "Substantivu",
    "meaning": "Ema neʼebé halai kuda iha kompetisaun halai-taru kuda."
  },
  {
    "word": "jornál",
    "class": "Substantivu",
    "meaning": "Publikasaun ida imprime iha surattahan belar no naruk neʼebé fó sai nafatin lia-foun oioin, artíkulu no mós publisidade. Ez. Ema neʼebé lee jornál loron-loron, sei hetan informa-saun barak."
  },
  {
    "word": "jornalista",
    "class": "Substantivu",
    "meaning": "1. Ema neʼebé nia serbisu, profisaun ka interese mak buka informasaun atu fó sai liuhosi jornál. 2. Reporter ba rádiu ka televizaun. 3. Ema neʼebé hakerek nia diáriu."
  },
  {
    "word": "jornalizmu",
    "class": "Substantivu",
    "meaning": "Kona-ba serbisu atu hakerek, edita no publika nian. Ez. Jornalizmu durante okupasaun indo-nézia nia kualidade aat lahalimar."
  },
  {
    "word": "joven",
    "class": "Substantivu",
    "meaning": "Ema neʼebé la'ós tan ona labarik maibé mós seidauk sai adultu. Sin. foin-sa’e, adolexente"
  },
  {
    "word": "judaízmu",
    "class": "Substantivu",
    "meaning": "Relijiaun povu judeu nian, neʼebé horiuluk mosu mai iha rai-Palestina no sai fiar sarani nia hun."
  },
  {
    "word": "judaiku - judaika",
    "class": "f. Adjetivu",
    "meaning": ""
  },
  {
    "word": "judeu - judia",
    "class": "f. Substantivu/Adjetivu",
    "meaning": "(Ema) neʼebé tuir judaízmu, ka pertense ba povu ebreu. Ez. Ita Na'I Jezús Kristu maksoin povu judeu nian no ita-nian mós."
  },
  {
    "word": "judikatura",
    "class": "Substantivu",
    "meaning": "Serbisu-fatin ba juis ka tesi-lia na'in sira."
  },
  {
    "word": "judisiál",
    "class": "Adjetivu",
    "meaning": "1. Kona-ba ka própriu ba ukun judisiáriu ka administrasaun justisa nian. Sin. legál 2. Kona-ba tribunál, tribunál nian."
  },
  {
    "word": "judoka",
    "class": "Substantivu",
    "meaning": "Ema neʼebé pratika ka domina desportu judu."
  },
  {
    "word": "judu",
    "class": "Substantivu",
    "meaning": "Desportu japonés ida neʼebé nia forma mai hosi ju-jitsu. Iha desportu ne'e jogadór sori an hosi mak-sakar nia atake oioin."
  },
  {
    "word": "juis",
    "class": "Substantivu",
    "meaning": "Ema neʼebé tesi lia, liuliu iha tribunál. Sin. tesi-lia naʼin"
  },
  {
    "word": "julga",
    "class": "Verbu",
    "meaning": "Tesi lia. Ez. Problema ne'e sei lori ba tribunál atu juis bele julga."
  },
  {
    "word": "julgamentu",
    "class": "Substantivu",
    "meaning": "Hakotun ka desi-zaun neʼebé halo ka hamonu ba ema bainhira lia ida lori ba tribunál. Sin. tesi-lia, lia-tesin"
  },
  {
    "word": "Jullu (fulan-)",
    "class": "Substantivu",
    "meaning": "Fulan dahituk tinan nian, tuir fulan- Juñu no uluk-fulan- Agostu."
  },
  {
    "word": "júnior",
    "class": "Adjetivu",
    "meaning": "1. Klosan liu. Adjetivul Substantivu (Iha desportu) jogadór ho tinan entre 16 no 19. Liafuan-sorun: sénior"
  },
  {
    "word": "junta",
    "class": "Substantivu",
    "meaning": "Ema-lubun neʼebéhamutuk atu halo desizaun kona-ba buat ruma. Sin. komisaun"
  },
  {
    "word": "Juñu (fulan-)",
    "class": "Substantivu",
    "meaning": "Fulan daneen tinan nian neʼebé tuir fulan-Maiu no uluk-ba fulan-Jullu."
  },
  {
    "word": "jura",
    "class": "Verbu",
    "meaning": "Hato'o liafuan ho fiar katak buat neʼebé hato'o ne'e loos no tebes. Bainhira jura ema dala barak temi Maromak, matebian ka ema lulik ruma nia naran hanesan sasin ba buat neʼebé nia hato'o."
  },
  {
    "word": "jura-falsu",
    "class": "Substantivu",
    "meaning": "Hahalokfótestemuñu loloos ka tebes iha tribunál, maski lori Maromak ka ema lulik ruma nia naran nu'udar sasin."
  },
  {
    "word": "juradu - jurada",
    "class": "f. Substantivu",
    "meaning": "1. Ema neʼebé jura tiha ona atu hakotu lia iha kazu ruma iha tribunál. 2. Ema neʼebé jura tiha ona fó sasin ba kazu iha tribunál."
  },
  {
    "word": "juramentu",
    "class": "Substantivu",
    "meaning": "Hahalok ema jura nian hodi hasa'e lia ba Maromak, santu ruma ka ema lulikna'in ruma nu'udar sasin. Ez. Bainhira feto no mane kaben iha igreja, sira rua halo juramentu atubele hela hamutuk iha susar ka diak nia laran."
  },
  {
    "word": "juri",
    "class": "Substantivu",
    "meaning": "1. Ema-lubun ida neʼebé fihir ka hili tiha ona tuir lei no halo juramentu atu hala'o ka fó desizaun ba kazu ruma iha tribunál. 2. Ema-lubun neʼebé avalia kandidatu sira iha ezame ruma, selae mataruk ka konkorrente sira iha kom-petisaun ruma."
  },
  {
    "word": "jurídiku - jurídika",
    "class": "f. Adjetivu",
    "meaning": "Kona-ba ju-dikatura ka tribunál."
  },
  {
    "word": "jurisprudénsia",
    "class": "Substantivu",
    "meaning": "Siénsia konaba lei no direitu sira."
  },
  {
    "word": "jurista",
    "class": "Substantivu",
    "meaning": "Ema peritu ka matenek loos kona-ba lei."
  },
  {
    "word": "jurus",

  {
    "word": "hana'i",
    "class": "Verbu",
    "meaning": "1. Hasé ema ida neʼebé boot ka Maromak nu'udar 'na'i'. 2. Serbí ema ida hanesan nia ita-nia na'in. 3. Hatudu respeitu ba. Sin. hamta'uk, respeita"
  },
  {
    "word": "hana'in",
    "class": "Substantivu",
    "meaning": "Hahalok hana'i nian. Sin. respeitu, onra"
  },
  {
    "word": "hanaran",
    "class": "Verbu",
    "meaning": "Fó naran ba. Ez. Ami hana-ran ami-nia oan-mane Natalísiu tanba moris iha tempu Natál nian. Substan-tivu Hahalok hanaran nian."
  },
  {
    "word": "hanaruk",
    "class": "Verbu",
    "meaning": "Halo sai naruk. Liafuan-sorun: habadak Ez. Ita tenke hanaruk tan saia ne'e tanba nia badak liu. Sub-stantivu Hahalok hanaruk nian."
  },
  {
    "word": "han-dadeer",
    "class": "Substantivu",
    "meaning": "Ai-han neʼebé ita han iha dadeer. Sin. matabixu"
  },
  {
    "word": "handór",
    "class": "Adjetivu",
    "meaning": "Neʼebé gosta han barak. Substantivu 1. Ema neʼebé han barak. 2. Ema neʼebé hakarak han di'ak de'it."
  },
  {
    "word": "hanehan mós haneha",
    "class": "Verbu",
    "meaning": "1. Uza buat ida atu tau ba buat seluk nia leten hodi halo todan. Ez. Atu halo mákina lao tenke hanehan botaun kiik ida-nee. 2. Halo opresaun ba ema, grupu ka nasaun ida hodi hasai nia liberdade. Sin. oprime, persege Ez. Rain riku sira lalika hanehan nasaun kiik sira ho tusan. Substantivu (hanehan) Hahalokhanehan nian. Sin. opresaun, persegisaun"
  },
  {
    "word": "hanek",
    "class": "Substantivu",
    "meaning": "1. Bikan halo hosi ai. 2. Serimónia animista nian neʼebé matebian nia bikan falun tiha ho biti hamutuk ho sasán seluseluk matebian nian, hafoin soe tiha."
  },
  {
    "word": "haneras",
    "class": "Verbu",
    "meaning": "Falun iha hena ka neras, liuliu kosok-oan ka labarik sira. Substantivu Hahalok haneras nian."
  },
  {
    "word": "haneruk",
    "class": "Verbu",
    "meaning": "Hamanas isin hodi tuur ka hamriik besik ahi. Ez. Iha rai-malirin, ema barak gosta haneruk ahi iha dadeer-saan. Substantivu Hahalok haneruk nian."
  },
  {
    "word": "han-fatin",
    "class": "Substantivu",
    "meaning": "1. Fatin ida hodi tau ai-han ba balada sira. 2. Kuartu neʼebé ema uza atu han bá. Sin. kehan-han Ez. Han-fatin atuhodi han, laós atuhodi toba."
  },
  {
    "word": "hani",
    "class": "Verbu",
    "meaning": "1. Kesi ho tali nia rohan. 2. (Meda) bobar ikun hale'u ai-sanak. Substantivu Sula ka lasu oin ida, halo ho tali ida, neʼebé ema uza atu kaer manu-fuik."
  },
  {
    "word": "hanini",
    "class": "Verbu",
    "meaning": "Halo sai meik ka tutun kroʼat. Sin. hameik, hakroʼat"
  },
  {
    "word": "haninin",
    "class": "Substantivu",
    "meaning": "Hahalok hanini nian."
  },
  {
    "word": "haninu",
    "class": "Verbu",
    "meaning": "1. Hateke ba sorinsorin, hodi haree saida mak akontese. 2. Hateke ba buat ruma ka ema ruma iha tempu balu nia laran. Sin. observa"
  },
  {
    "word": "haninun",
    "class": "Substantivu",
    "meaning": "Hahalok haninu nian. Sin. (2) observasaun"
  },
  {
    "word": "han-kalan",
    "class": "Substantivu",
    "meaning": "Han iha tempu kalan. Sin. jantár"
  },
  {
    "word": "han-meiudia",
    "class": "Substantivu",
    "meaning": "Hahán meiudia nian. Sin. almosu"
  },
  {
    "word": "hanoin",
    "class": "Verbu",
    "meaning": "1. Uza kakutak hodi tetu ideia ka problema ida. 2. Iha hareen ka opini-aun kona-ba buat ruma. Ez. Ha'u gosta proposta ne'e, maibé Ita-Boot hanoin oinsá loos? 3. Sente laran-susar ba ema ida. Sin. sadi'a 4. Iha ideia kona-ba ema ka buat ida neʼebé iha ka akontese tempu uluk. Sin. hanoin-hetan"
  },
  {
    "word": "hanoin-hetan",
    "class": "Verbu",
    "meaning": "Konsege hanoin buat neʼebé mosu ka akontese tiha ona; ha-noin fali buat neʼebé akontese iha tempu uluk. Ez. Katuas balu sei hanoin-hetan oinsá Japonés sira hamonu bomba iha Dili."
  },
  {
    "word": "hanoin-hi'as mós hanoin-hikas",
    "class": "Verbu",
    "meaning": "1. Sente laran-kraik kona-ba buat aat ruma neʼebé ita halo tiha ona. 2. Hakarak atu fila ba dalan loos liutiha sala. Sin. arre-pende"
  },
  {
    "word": "hanoin-kloot",
    "class": "Adjetivul Substantivu",
    "meaning": "(Men-talidade) neʼebé baibain haree buat sira hosi aspetu ka parte ida de'it. Sin. neon-taka Ez. Ema ne'e hanoinkloot hela, no kritika buat hotu ne'ebé nia bele la komprende."
  },
  {
    "word": "hanoin-laek",
    "class": "Adjetivu",
    "meaning": "Neʼebé la hanoin molok halo buat ruma no tan ne'e sala beibeik. Sin. beik"
  },
  {
    "word": "hanoin-luan",
    "class": "Adjetivul Substantivu",
    "meaning": "(Men-talidade) neʼebé baibain haree buat sira hosi aspetu ka parte hotu-hotu."
  },
  {
    "word": "hanook",
    "class": "Verbu",
    "meaning": "Halo sai nonook, bandu atu ko'alia. Ez. Aman-inan sira iha tendénsia atu hanook labarik sira bainhira labarik sira husu. Substantivu Hahalok hanook nian."
  },
  {
    "word": "hanorin",
    "class": "Verbu",
    "meaning": "Halolon ka hato'o matenek, informasaun ka jeitu ida. Ez. Mestre neebé hanorin ami lia-inglés née ema neozelandés. Substantivu 1. Hahalok hanorin nian. 2. Hanoin neʼebé fó ka hato'o ba ema ida nu'udar matenek. Sin. doutrina"
  },
  {
    "word": "hanurak",
    "class": "Verbu",
    "meaning": "1. Halo sai nurak. 2. Halo sai hanesan foun fali. Substantivu Ha-halok hanurak nian."
  },
  {
    "word": "hanu'usá",
    "class": "",
    "meaning": "haree halonu'usá"
  },
  {
    "word": "hapara",
    "class": "Verbu",
    "meaning": "1. Halo atu para, halo hamriik metin iha fatin, halo atu la bele book an tan. Ez. Naok-teen sira hapara karreta hodi tau ai-hun boot ida iha dalan. 2. Halo atu labele akontese tan. Ez. Ita tenke hapara violénsia doméstika tanba ne'e hahalok aat."
  },
  {
    "word": "haprontu",
    "class": "Verbu",
    "meaning": "Halo sai prontu. Sin. pre-para, hadi'a"
  },
  {
    "word": "haprontun",
    "class": "Substantivu",
    "meaning": "Hahalokkaefeituha-prontun nian. Sin. reparasaun, hadi'an"
  },
  {
    "word": "haraan",
    "class": "Verbu",
    "meaning": "1. Halo raan sai ka suli. 2. Lees kulit. Sin. hakanek Haraan matan katak la toba kalan tomak."
  },
  {
    "word": "harabat",
    "class": "Verbu",
    "meaning": "Tau besik malu ka rabat malu. Ez. Favór harabat tiha meza ne'e ba didin. Substantivu Hahalok harabat nian."
  },
  {
    "word": "harahun mós harahu",
    "class": "Verbu",
    "meaning": "Halo sai rahun ka ba pedasuk. Ez. Nia harahun botir nee hodi kaer no tuda ba fatuk. Sub-"
  },
  {
    "word": "Eukaristia",
    "class": "Substantivu",
    "meaning": "Sakramentu Kreda Katólika nian iha neʼebé nakfilak ba Jezús Kristu Nia futar isin no raan. Sin. ai-bubur"
  },
  {
    "word": "eukarístiku - eukarístika",
    "class": "f. Adjetivu",
    "meaning": ""
  },
  {
    "word": "euro",
    "class": "Substantivu",
    "meaning": "Osan ofisiál Uniaun Eu-ropeia (Klibur-Europa) nian."
  },
  {
    "word": "Europa, (rai-)",
    "class": "Substantivu",
    "meaning": "Kontinente boot ho nasaun barabarak, tutan ba konti-nente Ázia iha sorin lorosa'e, neʼebé Tasi Mediterráneu mak haketak hosi konti-nente Áfrika."
  },
  {
    "word": "europeu - europeia",
    "class": "f. Adjetivu",
    "meaning": "Europa nian. Ez. Komisaun Europeia nia sede iha Bruxelas. Substantivu 1. Ema Europa. Sin. malaemutin Ez. Europeu sira mosu mai iha rai-Timór ba dala uluk iha sékulu dasanaluluresin-neen nia hun."
  },
  {
    "word": "Euskadi, (rai-)",
    "class": "Substantivu",
    "meaning": "Povu basku nia rain-inan, neʼebé nakfati iha Foho-Pireneus nia sorin rua, territóriu nak-fahe ba rai-España no rai- Fransa."
  },
  {
    "word": "eutanázia",
    "class": "Substantivu",
    "meaning": "Oho, tan motivu sadi'a ka kasian nian, ema ida neʼebé moras todan no parese ona katak la bele hetan isin-di'ak filafali. Kreda Katólika hanorin katak hahalok ida-neʼe sempre krime boot, no governu barakliu trata doutór ka ema neʼebé hala’o ka enkoraja eutanázia ne'e nu'udar kriminozu."
  },
  {
    "word": "evanjéliku - evanjélika",
    "class": "f. Adjetivu",
    "meaning": "1. Evan-jellu nian. 2. (Fiar ka kreda) neʼebé bazeia ba Evanjellu maibé la rekoñese autoridade Kreda Katólika ka Kreda Ortodoksa ninian. Sin. protestante"
  },
  {
    "word": "evanjelista",
    "class": "Substantivu",
    "meaning": "Ema neʼebé hakerek evanjellu, autór evanjellu nian."
  },
  {
    "word": "evanjeliza",
    "class": "Verbu",
    "meaning": "1. Hanorin kona-ba Evan-jellu. 2. Konverte ba fiar sarani."
  },
  {
    "word": "evanjelizasaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "evanjellu",
    "class": "Substantivu",
    "meaning": "1.LivruihaTestamentu Foun ne'ebé haktuir kona-ba Jezús Kristu Nia moris no hanorin sira. Iha evanjellu haat, maka Saun Mateus, Saun Markus, Saun Lukas no Saun Juaun ninian. 2. (Evanjellu) Hanorin relijiozu, liuliu kona-ba Ita Na'i Jezús Kristu no fiar sarani."
  },
  {
    "word": "evapora",
    "class": "Verbu",
    "meaning": "Hasai suar ka gás, liuliu bee neʼebé ema nono hela ka bee-udan neʼebé loro nia manas hamaran hela. Sin. nasuar"
  },
  {
    "word": "evaporasaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "eventu",
    "class": "Substantivu",
    "meaning": "Buat neʼebé mosu ka akontese. Sin. akontesimentu, mamosuk"
  },
  {
    "word": "eventuál",
    "class": "Adjetivu",
    "meaning": "Neʼebé bele akontese. Sin. belek, posivel"
  },
  {
    "word": "eventualmente",
    "class": "Advérbiu",
    "meaning": ""
  },
  {
    "word": "Evereste, (Foho-)",
    "class": "Substantivu",
    "meaning": "Foho ida neʼebé nia tutun aas liu hotu iha kadoek Himalaia ne'ebé haketak rai-Nepál no rai-Tibete. Ez. Mane neozelandés ida, naran Sir Edmund Hillary, mak ema dahuluk ne'ebé sae ba Foho-Evereste nia tutun, iha tinan 1953."
  },
  {
    "word": "evidente",
    "class": "Adjetivu",
    "meaning": "1.Neʼebémosubaemahotu; neʼebé ema hotu bele haree. Sin. malo-rek 2. Lasusar atu haree ka komprende."
  },
  {
    "word": "evidénsia",
    "class": "Advérbiu",
    "meaning": ""
  },
  {
    "word": "evita",
    "class": "Substantivu",
    "meaning": "1. Sees hosi (buat ka ema ruma). Ez. Ita tenke evita fuma tanba bele halo ita moras tan nikotina neʼebé iha sigarru. 2. Hadook ka sees hosi (buat aat). Sin. hasees Ez. Ema katuas sira bele hasees moras barak hodi halo eserzísiu fiziku ruma loron-loron, pore-zemplu bá pasiar."
  },
  {
    "word": "evitasaun",
    "class": "Substantivu",
    "meaning": "; Sin. sasees"
  },
  {
    "word": "evitavel",
    "class": "Adjetivu",
    "meaning": "Neʼebé sei bele sees hosi ka hasees. Sin. hasees-belek Ez. Moras-kankru evitavel se ita la fuma sigarru."
  },
  {
    "word": "evolui",
    "class": "Verbu",
    "meaning": "Nakfila ka muda an neineik hodi sai forma seluk ida. Ez. Lia-latín evolui iha tinan rihun ida nia laran hodi nakfila ba liaportugés."
  },
  {
    "word": "evolusaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "exelénsia",
    "class": "Substantivu",
    "meaning": "1. Kualidade exelente ka kapás liu. 2. Títulu neʼebé ita fó ba ema importante. Ez. Exelénsia Sr. Prezi-dente sei hato'o liafuan ruma ba estu-dante sira."
  },
  {
    "word": "exelente",
    "class": "Adjetivu",
    "meaning": "Neʼebé di’ak tebetebes ka kmanek, liuliu kona-ba kualidade. Sin. kmanek-ba'in Ez. Nia estuda makaas, nia rezultadu mós exelente hodi halo aman-inan haksolok liu."
  },
  {
    "word": "exesaun",
    "class": "Substantivu",
    "meaning": "Ema ka buat ruma neʼebé la inklui iha hahesuk ka regra jerál ruma. Ez. Ema hotu tenke selu taxa, maibé alfándega sei fó exesaun ba diplomata sira."
  },
  {
    "word": "exesionál",
    "class": "Adjetivu",
    "meaning": ""
  },
  {
    "word": "exetu",
    "class": "Prepozisaun",
    "meaning": "1. La inklui, la sura hotu, la kona. 2. Maibé la’ós... Ez. Ema hotu selu taxa exetu diplomata sira. Ez., Abreviatura = ezemplu"
  },
  {
    "word": "ezajera",
    "class": "Verbu",
    "meaning": "1. Trata ka haree buat ruma di'ak, aat ka boot liu duké realidade ha-tudu, liuliu bainhira ko'alia ka hakerek. Sin. haboot resik 2. (Ema) neʼebé ha-noin sabraut tanba la tetu ka sukat nu'udar presiza."
  },
  {
    "word": "ezajeru",
    "class": "Substantivu",
    "meaning": "Ez. Hau la fiar Ameu tanba buat neebé nia dehan ezajeru de'it."
  },
  {
    "word": "ezajeradu - ezajerada",
    "class": "Adjetivu",
    "meaning": ""
  },
  {
    "word": "ezame",
    "class": "Substantivu",
    "meaning": "1. Hahalok ezamina nian. Sin. lalehat 2. Prova ba estudante sira iha eskola ka universidade."
  },
  {
    "word": "ezamina",
    "class": "Verbu",
    "meaning": "Fihir kleur buat ka ema ida atu tetu nia kualidade. Sin. lehat"
  },
  {
    "word": "ezaminadór - ezaminadora",
    "class": "f. Substantivu",
    "meaning": "Ema neʼebé ezamina. Sin. maklehat"
  },
  {
    "word": "ezaminandu - ezaminanda",
    "class": "f. Substantivu",
    "meaning": "Ema neʼebé atu tuir ezame."
  },
  {
    "word": "ezatidaun",
    "class": "Substantivu",
    "meaning": "Kondisaun loloos nian. Sin. loloos. Ez. Bainhira membru polísia nian ida aprende tiru alvu, ezati-daun importante liu atu hili nia sai polí-sia espesiál."
  },
  {
    "word": "ezatu - ezata",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé loos liu, la iha sala ida. Sin. loloos"
  },
  {
    "word": "ezatamente",
    "class": "Advérbiu",
    "meaning": ""
  },
  {
    "word": "ezaustaun",
    "class": "Verbu",
    "meaning": "1. Hahalok ka kondisaun nahas nian. Sin. nanahas 2. Kondisaun kole todan nian."
  },
  {
    "word": "ezbosu",
    "class": "Substantivu",
    "meaning": "1. Hatuin ka dezeñu dahuluk ba knaar ka projetu ruma. 2. Planu jerál ba projetu foun."
  },
  {
    "word": "ezekuta",
    "class": "Verbu",
    "meaning": "1. Hala'o buat neʼebé ulun-boot haruta ita atu halo. Ez. Ezekuta governadór nia orden sira maka papél polisia nian. 2. Oho ema ida neʼebé simu kastigu-mate hosi tribunál."
  },
  {
    "word": "ezekusaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "ezekutivu - ezekutiva",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé ezekuta ka halaʼo. Substantivu Emaneʼebé hesi ka dirije empreza boot ida ho pat-raun ka properietáriu nia naran."
  },
  {
    "word": "ezemplár",
    "class": "Substantivu",
    "meaning": "1. Modelu atu halo tuir. Sin. banati 2. Kópia ka reprodu-saun hosi obra orijinál ida, liuliu livru. Ez. Estudante finalista presiza hatama teze ezemplár lima ba Universidade Na-cional. Adjetivu Neʼebé hanesan ezemplu ba ema hotu tuir; kapás, kmanek."
  },
  {
    "word": "ezemplu",
    "class": "Substantivu",
    "meaning": "1. Buat ka ema ida neʼebé reprezenta grupu tomak; membru típiku hosi grupu. 2. Modelu atu halo tuir. Sin. banati Espresaun nu'udar ezemplu ita atu fó ezemplu kona-ba buat ruma neʼebé Ita ko'alia ka temi bá atu halo ideia ida klaru liu."
  },
  {
    "word": "ezerse",
    "class": "Verbu",
    "meaning": "1. Pratika ka hala'o profisaun ruma. 2. Hala'o direitu no devér neʼebé iha. Ez. Sidadaun tomak ezerse nia direitu politiku hodi tuir eleisaun."
  },
  {
    "word": "ezersísiu",
    "class": "Substantivu",
    "meaning": "1. Haka'as an ka esforsu partikulár ida atubele dezenvolve ka-pasidade ruma. Ez. Hanesan atleta sira halo ezersisiu fíziku barak hodi habokar sirania isin, estudante sira tenke halo ezersisiu mentál oioin atu loke sira-nia neon no haburas sira-nia kakutak. 2. Programa-treinu ba isin-lolon."
  },
  {
    "word": "ezérsitu",
    "class": "Substantivu",
    "meaning": "Forsa militár estadu ka nasaun ida nian. Sin. tropa-laken Ez. F-FDTL mak ezérsitu RDTL nian."
  },
  {
    "word": "ezgrima",
    "class": "Substantivu",
    "meaning": "Desportu hakfaik malu ka funu ho surik nian."
  },
  {
    "word": "ezgrimista",
    "class": "Substantivu",
    "meaning": "Ema neʼebé halo de-sportu ezgrima."
  },
  {
    "word": "ezije",
    "class": "Verbu",
    "meaning": "Husu maka'as atu ema bele tuir ita-nia hakarak ka atu ita bele hetan buat ne'ebé ita husu. Sin. sisi Ez. Estu-dante sira ezije atu reitór-universidade hatún propina."
  },
  {
    "word": "ezijente",
    "class": "Adjetivu",
    "meaning": "Neʼebé ezije. Sin. mak-sisik, sisidór (pejorativu)"
  },
  {
    "word": "ezijénsia",
    "class": "Substantivu",
    "meaning": "1.Hahalok ezije nian. Sin. sasisik 2. Buat neʼebé ema ezije. Ez. Oras ne'e reitoria sei tetu hela estudante sirania ezijénsia."
  },
  {
    "word": "ezila",
    "class": "Verbu",
    "meaning": "Duni sai (ema) hosi nia rain hodi obriga nia atu horik iha rain seluk. Sin. desterra Ez. Iha otas koloniál, gov-ernu portugés ezila disidente politiku barak mai Timór."
  },
  {
    "word": "eziladu - ezilada",
    "class": "f. Adjetivul Substantivu",
    "meaning": "(Ema) neʼebé hetan kastigu ezíliu nian."
  },
  {
    "word": "ezíliu",
    "class": "Substantivu",
    "meaning": "Kastigu konaba duni sai (ema) hosi nia rain hodi obriga nia atu horik iha rain seluk. Sin. desterru"
  },
  {
    "word": "eziste",
    "class": "Verbu",
    "meaning": "Iha duni, sai ona realidade, la'ós mehi de'it. Ez. Ita ema hatene liuhosi ita-nia konxiénsia no fiar katak Maromak eziste."
  },
  {
    "word": "ezisténsia",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "ezistente",
    "class": "Adjetivu",
    "meaning": ""
  },
  {
    "word": "ezita",
    "class": "Verbu",
    "meaning": "Hanoin ka hakarak neʼebé atu halo ka la halo. Sin. laran-rua, tataba Ez. Estudante sira keta ezita husu nia mestre bainhira sira la hatene iha klase."
  },
  {
    "word": "ezitasaun",
    "class": "Substantivu",
    "meaning": ";Sin.tataban, laran-rua"
  },
  {
    "word": "ezitante",
    "class": "Substantivu",
    "meaning": "; Sin. tatabak, laran-ruak"
  },
  {
    "word": "ézitu",
    "class": "Substantivu",
    "meaning": "Rezultadu ka fuan di'ak hosi buat neʼebé ita halo. Sin. susesu"
  },
  {
    "word": "ezmeralda",
    "class": "Substantivu",
    "meaning": "Fatuk-murak kór-matak nabilan."
  },
  {
    "word": "ezmola",
    "class": "Substantivu",
    "meaning": "Saugati ka osan neʼebé ema laran-luak fó ba ema kiak, selae ba kreda. Ez. Aman-inan hanorin labarik sira atu fó ezmola bainhira sira sei kiik. Verbu Fó ezmola (ba)."
  },
  {
    "word": "ezmola-na'in",
    "class": "Substantivu",
    "meaning": "Ema neʼebé husu ezmola."
  },
  {
    "word": "ézodu",
    "class": "Substantivu",
    "meaning": "1. Hahalok ema bara-barak ka populasaun tomak sai tiha hosi nia rain, baibain tan susar boot ruma. 2. (Ézodu) Livru iha Testamentu Tuan Bíblia nian neʼebé haktuir kona-ba povu Izraél sai hosi rai-Ejitu. Ez. Ézodu boot ida ba Kupaun bainhira militár indonéziu sira hata'uk Timoroan sira liutiha inde-pendentista sira manán tiha referendu iha fulan-Setembru tinan 1999."
  },
  {
    "word": "ezófagu",
    "class": "Substantivu",
    "meaning": "Talin iha kakorok laran neʼebé lori hahán neʼebé ita tolan tun ba kabunlaran. Sin. kakoroktalin, tatolan"
  },
  {
    "word": "ezorsista",
    "class": "Substantivu",
    "meaning": "1.Na'i-lulikneʼebéhalao ezorsizmu. 2. (Iha Kreda Katólika tradi-sionál) orden menór sira ida, ne'ebé seminarista simu molok sai subdiákonu."
  },
  {
    "word": "ezorsizmu",
    "class": "Substantivu",
    "meaning": "Kanaʼar ka serimónia Kreda Katólika neʼebé amlulik ida, hetan tiha lisensa hosi ambispu, reza atu duni sai diabu hosi ema ida nia isin."
  },
  {
    "word": "ezótiku - ezótika",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé oioin no la hanesan baibain, liuliu buat furak hosi tasi-balun. Ez. Se vizita jardín zo-olójiku iha kapitál, ita bele haree balada ezótiku oioin hanesan elefante, jirafa, babirusa no kangurú."
  },
  {
    "word": "ezotizmu",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "faak",
    "class": "Adjetivul Substantivu",
    "meaning": "(Ema) neʼebé ladún aprende tanba susar atu kom-prende. Sin. beik Ez. Labarik ne'e faak nafatin maski hau hanorin nia filafila."
  },
  {
    "word": "fa'an",
    "class": "Verbu",
    "meaning": "Fó buat ruma hodi simu fali osan; husik ema ida simu buat ruma neʼebé nia selu ho osan. Fa'an matan katak lakon tempu hodi haree buat neʼebé akontese, ka liu bá liu mai atu halo haksolok de'it."
  },
  {
    "word": "fabrika",
    "class": "Verbu",
    "meaning": "Prodús ka halo sasán ho mákina ruma. Ez. Kompañia Uma-Roofing fabrika zinku ba uma-kakuluk."
  },
  {
    "word": "fábrika",
    "class": "Substantivu",
    "meaning": "1. Uma ka uma-lubun iha neʼebé ema sira halo sasán barak atu fa'an. 2. Hahalok fabrika ka halo buat ruma. Ez. Governu tenke loke fábrika semente iha Timór atu nunee nia folin bele baratu."
  },
  {
    "word": "fabrikante",
    "class": "Substantivu",
    "meaning": "Ema neʼebé fabrika ka prodús sasán, liuliu iha fábrika."
  },
  {
    "word": "fadista",
    "class": "Substantivu",
    "meaning": "Ema ida neʼebé kanta fadu. Sin. mananuk-fadu"
  },
  {
    "word": "fadu",
    "class": "Substantivu",
    "meaning": "Kantiga triste ida neʼebé ema portugés sira gosta hananu ho gitarra. Iha fadu oin rua: Lizboa nian no Koímbra nian."
  },
  {
    "word": "fafa'an",
    "class": "Substantivu",
    "meaning": "Hahalok ka atividade fa'an nian."
  },
  {
    "word": "fafahek",
    "class": "Substantivu",
    "meaning": "Hahalok fahe nian."
  },
  {
    "word": "fafanik",
    "class": "Substantivu",
    "meaning": "Hahalok ka moras fani beibeik."
  },
  {
    "word": "fafasek",
    "class": "Substantivu",
    "meaning": "Hahalok fase nian."
  },
  {
    "word": "fafekit",
    "class": "Substantivu",
    "meaning": "Hahalok fekit nian."
  },
  {
    "word": "fafiruk",
    "class": "Substantivu",
    "meaning": "Tali-matan kesi ba ai badak ida neʼebé serve atu firu ka tuda fatuk, liuliu atu oho manu-fuik. Sin. tali-firun"
  },
  {
    "word": "fafo'at",
    "class": "Substantivu",
    "meaning": "Tali neʼebé nia rohan iha fukun no baibain ema uza atu kaer ka kesi balada. Sin. lasu"
  },
  {
    "word": "fafokek",
    "class": "Substantivu",
    "meaning": "Hahalok foke nian."
  },
  {
    "word": "faforek",
    "class": "Substantivu",
    "meaning": "Hahalok fore nian."
  },
  {
    "word": "fafu'ik",
    "class": "Substantivu",
    "meaning": "1. Hahalok toka kafu'i ka flauta. 2. Flauta tradisionál hosi au neʼebé baibain bibiatan sira huu. Sin. kafu'i"
  },
  {
    "word": "fafulu",
    "class": "Substantivu",
    "meaning": "Au neʼebé lotuk maibé toos; au naruk neʼebé ema uza nu'udar kilat atubele hatama nia oan tuir kuak hodi huu bainhira kasa balada."
  },
  {
    "word": "fafurak",
    "class": "Substantivu",
    "meaning": "1. Kualidade furak. Sin. beleza 2. Gostu, sente (ai-han nian)."
  },
  {
    "word": "faha",
    "class": "Verbu",
    "meaning": "Ko’us iha liman laran ka iha hitin. Sin. hako'us."
  },
  {
    "word": "fahe",
    "class": "Verbu",
    "meaning": "1. Haketak tiha buat ida ba parte rua ka liu. Ez. Jezús fahe paun no tua ba Nia eskolante sira bainhira han-kalan ikus nian. 2. Hadook tiha ema ka ani-mál neʼebé baibain hamutuk iha grupu ka família. Ez. Funu maka fahe Timoroan sira hodi halo balun hela iha nasaun seluk."
  },
  {
    "word": "fahi",
    "class": "Substantivu",
    "meaning": "Balada maksusuk ain- haat, ikun nakdulas neʼebé nia isin fó mina barak; balada neʼebé baibain Timoroan sira hakiak."
  },
  {
    "word": "fahi-aman",
    "class": "Substantivu",
    "meaning": "Fahi ho seksu aman."
  },
  {
    "word": "fahi-inan",
    "class": "Substantivu",
    "meaning": "1. Fahi ho seksu inan. 2. (kolokiál) Feto neʼebé imorál. Sin. fetoaat"
  },
  {
    "word": "fahi-luhan",
    "class": "Substantivu",
    "meaning": "Fatin neʼebé ema uza atu hakiak fahi ka tau fahi."
  },
  {
    "word": "fahi-mina mós minafahi",
    "class": "Substantivu",
    "meaning": "Mina neʼebé mai hosi na'an-fahi."
  },
  {
    "word": "fahi-oan",
    "class": "Substantivu",
    "meaning": "Fahi nia oan, bele aman ka inan."
  },
  {
    "word": "faho",
    "class": "Verbu",
    "meaning": "Hamoos rai hodi fokit du'ut. Sin. hafaho"
  },
  {
    "word": "fai",
    "class": "Verbu",
    "meaning": "1. Tidin ho ai ka besi ida atu halo sai rahun ka toos. Ez. Feto sira fai hare hodi hananu. 2. Hatama buat ida neʼebé nia tutun kro'at ba kuak ka buat mamar ida. Sin. sona Ez. Nia kadi tiha tudik ne'e, hafoin fai ba karau nẻ'e nia kabun."
  },
  {
    "word": "fai-malu",
    "class": "Substantivu",
    "meaning": "1. Hahalok fai malu nian, katak buat rua fai oin hasoru malu. Sin. xoke Ez. Fai-malu entre karreta rua horisehik halo ema naʼin-rua mate iha fatin. 2. Buat kro’at rua neʼebé ema kaer hodi fai hasoru malu, porezemplu tudik ka diman."
  },
  {
    "word": "faixa",
    "class": "Substantivu",
    "meaning": "1. Rai, parte ka pedasuk ida neʼebé naruk. Sin. foit 2. Hena ida neʼebé ema kesi hale'u kabun ka isin. 3. Hena neʼebé ita uza atu liga hale'u ruin sira neʼebé naksalak. Sin. ligadura"
  },
  {
    "word": "fakar",
    "class": "Verbu",
    "meaning": "Husik been ka líkidu monu ka sulibarai, porezemplu bee, tinta, raan nst. Fakar osan katak gasta osan arbiru de'it."
  },
  {
    "word": "faks mós faksímile",
    "class": "Substantivu",
    "meaning": "Mákina ida neʼebé ema uza ho liña no númeru hanesan telefone nian atu simu no haruka dokumentu ida hosi ka ba fatin seluk; baibain dokumentu neʼebé tama sei imprime iha surat-tahan neʼebé tau iha mákina ne'e nia laran."
  },
  {
    "word": "faksaun",
    "class": "Substantivu",
    "meaning": "Ema-lubun ho motivu polítiku ruma. Ez. Faksaun komunista iha partidu sosialista nia laran buka atu halo governu hakbesik liu ba rai-Xina."
  },
  {
    "word": "faktu",
    "class": "Substantivu",
    "meaning": "Informasaun neʼebé loloos de'it; buat ida neʼebé mosu tiha duni, katak tuir realidade. Ez. Baleia moris iha tasi ne'e faktu ida, laós istória bosok ida."
  },
  {
    "word": "fakuldade",
    "class": "Substantivu",
    "meaning": "1. Kbiit ka jeitu atu halo, sente ka hanoin. Ez. Ferik sira lakon fakuldade razaun nian, sai filafali hanesan kosok-oan. 2. Katesik ka seksaun iha universidade nia laran neʼebé espesializa iha aprende ka hanorin ruma, no nakfahe ba departamentu oioin. Ez. Governu hanoin atu loke fakuldade-medisina iha Universidade Nasionál. 3. Pesoál neʼebé hanorin iha universidade ruma. Ez. Fakuldade sira sei hala'o enkontru ida kona-ba metodolojia hanorin nian."
  },
  {
    "word": "fakultativu",
    "class": "Adjetivu",
    "meaning": "Neʼebé bele hili. Sin. hili-belek; Liafuan sorun obrigatóriu, hili-labelek Ez. Matéria ‘Morál no Étika sei trata nu'udar obrigatóriu maibé Polítika no Matemátika nu'udar fakul-tativu de'it."
  },
  {
    "word": "falabaratizmu",
    "class": "Substantivu",
    "meaning": "Hahalok ema falabaratu nian; halo beibeik promesa mamuk."
  },
  {
    "word": "falabaratu mós koʼalia-baratu",
    "class": "Substantivu",
    "meaning": "Ema neʼebé ko'alia de'it, promete barak maibé la halo buat ida."
  },
  {
    "word": "falénsia",
    "class": "Substantivu",
    "meaning": "Kondisaun bainhira ema ka komérsiu ida osanlaek, la bele fila liman ona. Sin. bankarrota"
  },
  {
    "word": "fali",
    "class": "Advérbiu",
    "meaning": "1. Dala ida tan. Ez. “Ha'u sei harii fali uma nẻe iha loron tolu\", Jezús dehan. 2. Fila bá; fila mai. Ez. Kristu sei mai fali iha loron ikus. 3. Pelukon-tráriu, maibé: ita uza liafuan ne'e hodi temi kona-ba hahalok ruma neʼebé ita la hein ka halo ita hakfodak. Ez. Mateus sempre husu osan, maibé nia fakar fali osan tomak neʼebé nia simu."
  },
  {
    "word": "falidu - falida",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé osan-laek hela tan falénsia (tan bankarrota)."
  },
  {
    "word": "falisá",
    "class": "Konjunsaun",
    "meaning": "Tan, tanba, enkuantu, komu. Ez. Falisá nia la iha pasaporte, nia la bele halo viajen ba rai-li'ur."
  },
  {
    "word": "Falkland (Nusar-, rai-) mós Falklandia",
    "class": "Substantivu",
    "meaning": "Nusa-lubun ki'ik ida iha Tasi Atlántiku Súl, besik rai- Arjentina. Sin. Malvinas"
  },
  {
    "word": "falklandés - falklandeza",
    "class": "f. Adjetivu",
    "meaning": "Rai-Falkland nian. Substantivu Ema rai-Falkland."
  },
  {
    "word": "falla",
    "class": "Verbu",
    "meaning": "La hetan susesu, la konsege. Sin. suri Ez. Jogadór Jarde falla penaltu ida bainhira ekipa Sporting joga hasoru Benfica."
  },
  {
    "word": "falsáriu – falsária",
    "class": "f. Substantivu",
    "meaning": "Ema neʼebé halodokumentu, osan, pinturanst. mesak falsu de'it."
  },
  {
    "word": "falsifika",
    "class": "Verbu",
    "meaning": "Halo sai falsu. Sin. hafalsu"
  },
  {
    "word": "falsifikasaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "falsu",
    "class": "Adjetivu",
    "meaning": "La'ós loos, laloos, bosok."
  },
  {
    "word": "falsidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "falta",
    "class": "Verbu",
    "meaning": "Kuran, la iha. Sin. mukit Ez. Ami falta matéria kona-ba rezisténsia hosi tinan 1975 to'o 1999. Substantivu 1. Kondisaun kuran ka la iha. Sin. mukit Ez. Tanba falta ai-han, labarik sira moras no mate. 2. (Kondisaun) la mosu. Ez. Estudante neʼebé iha falta barak la bele tuir ezame. 3. Sala neʼebé hala'o iha atividade ruma. Sin. haktulak Ez. Tanba falta ne'ebé guardarede halo, árbitru fó penaltu ida."
  },
  {
    "word": "faluk",
    "class": "Adjetivu",
    "meaning": "Neʼebé la'en ka feen mate hela tiha. Feto-faluk katak feto ka feen ida neʼebé mak nia la'en mate hela nia."
  },
  {
    "word": "falun",
    "class": "Substantivu",
    "meaning": "Pakote ka buat ida neʼebé tau iha kaixa eh plástiku nia laran. Verbu Taka buat ruma ho surat-tahan, plástiku ka hena. Ez. Keta haluha falun tiha prenda ne'e molok bá festa."
  },
  {
    "word": "falur, (manu-)",
    "class": "Substantivu",
    "meaning": "Manu-fuik espésie ida ne'ebé iha fulun malahuk. Sin. pombu"
  },
  {
    "word": "família",
    "class": "Substantivu",
    "meaning": "1. Grupu hosi emaneʼebé iha fafutuk ka relasaun raan hanesan aman-inan no oan sira. 2. Ema sira neʼebé sei iha relasaun raan ho ita maski la'ós hosi aman-inan ida, maibé sei parente."
  },
  {
    "word": "familiár",
    "class": "Adjetivu",
    "meaning": "Kona-ba família, família nian. Ez. Tan nẻe problema familiár, ema lalika mete hotu. Substantivu Maluk; ida neʼebé sei iha relasaun raan ka parentesku."
  },
  {
    "word": "fanátiku - fanátika",
    "class": "f. Adjetivul Substantivu",
    "meaning": "(Ema) neʼebé maka’as liu iha ninia apoiu ba kauza ida, to'o hakribi ema seluseluk neʼebé la hanoin hanesan. 2. Entuziazmu ka laran-manas ezajeradu ba atividade partikulár ruma."
  },
  {
    "word": "fanatizmu",
    "class": "Substantivu",
    "meaning": "Hahalok ka atitude ema fanátiku ninian. Ez. Fanatizmu ba relijiaun ne'ebé ita tuir bele hamosu fundamentalizmu."
  },
  {
    "word": "fani",
    "class": "Verbu",
    "meaning": "Hasai anin ka ár hosi inus laha-karak no derrepente de'it, baibain mós ho tarutu maka'as."
  },
  {
    "word": "fanin",
    "class": "Substantivu",
    "meaning": "Fani dala ida."
  },
  {
    "word": "fantástiku – fantástika",
    "class": "f. Adjetivu",
    "meaning": "1. Neʼebé halo ema susar atu fiar tanba mehi ka imajináriu de'it. 2. Ne'ebé di'ak tebes no fó solok boot. Ez. Jogu horisehik fantástiku duni tanba jogadór mesak diak no matenek. 3. Neʼebé estrema-mente boot iha kuantidade ka forma. Ez. Nia saláriu fulafulan fantástiku tebes tanba nia bele sosa-kotu karreta ida."
  },
  {
    "word": "fantazia",
    "class": "Substantivu",
    "meaning": "Istória ka situasaun ida neʼebé mosu hanesan mehi iha ema ida nia imajinasaun. Ez. Ninia fantazia halo nia ida-idak hamnasa hanesan ema bulak."
  },
  {
    "word": "fanun",
    "class": "Verbu",
    "meaning": "1. Halo ema hadeer tiha, liuliu book ka bolu atu hadeer. 2. Halo hamriik ka hamoris buat ida neʼebé toba ka matek hela."
  },
  {
    "word": "farda",
    "class": "Substantivu",
    "meaning": "Roupa ka hatais neʼebé hanesan de'it iha grupu, instituisaun ka organizasaun ida nia laran, porezemplu farda militár nian. Sin. uniforme"
  },
  {
    "word": "fariña",
    "class": "Substantivu",
    "meaning": "Uut hosi trigu nia isin, neʼebé serve atu halo paun."
  },
  {
    "word": "farmaseutiku - farmaseutika",
    "class": "f. Adjetivu",
    "meaning": "Kona-bafarmásia, farmásianian; kona-ba ai-moruk komersiál. Substantivu Ema neʼebé prepara ka fa'an aimoruk, liuliu ai-moruk komersiál."
  },
  {
    "word": "farmásia",
    "class": "Substantivu",
    "meaning": "1. Knaar prepara ai-moruk, liuliu ai-moruk komersiál. 2. Fatin iha neʼebé ema fa'an ai-moruk."
  },
  {
    "word": "faról",
    "class": "Substantivu",
    "meaning": "Uma kabuar no aas hanesan torre iha tasi-ibun neʼebé iha ahi-oan iha nia tutun atubele hatudu dalan ka fó sinál ba ró neʼebé atu tama iha ponte-kais. Bairru ida Dili nian, iha tasi-ibun, iha mós naran Faról."
  },
  {
    "word": "farolín",
    "class": "Substantivu",
    "meaning": "Ahi-oan karreta nian, liuliu ahioan travaun nian, iha karreta kotuk."
  },
  {
    "word": "farrapu",
    "class": "Substantivu",
    "meaning": "1. Hena aat ida neʼebé uza atu hamoos ka kose sasán. Sin. hena-aat 2. Roupa aat ne'ebé ema kiak ida hatais."
  },
  {
    "word": "faru",
    "class": "Substantivu",
    "meaning": "Hatais neʼebé ema uza atu takaisinlolon parteletennian. Sin. kamiza"
  },
  {
    "word": "faru-liman",
    "class": "Substantivu",
    "meaning": "Parte ida hosi hena-hatais ka kamiza neʼebé taka liman."
  },
  {
    "word": "faru-manas",
    "class": "Substantivu",
    "meaning": "Roupa mahar parte isin leten nian neʼebé hatais liuliu atu tahan malirin. fase Verbu 1. Hamoos buat ruma ho hena no sabaun, xampó, nst. 2. Hamoos isin ho sabaun no bee."
  },
  {
    "word": "fasen",
    "class": "Substantivu",
    "meaning": "Hahalok fase dala ida. Adjetivu Neʼebé ema fase tiha ona."
  },
  {
    "word": "fasil",
    "class": "Adjetivu",
    "meaning": "Neʼebé hala'o lasusar; neʼebé ema bele halo lasusar."
  },
  {
    "word": "fasilidade",
    "class": "Substantivu",
    "meaning": "Uma, ekipamentu ka servisu ruma neʼebé fó ba ita atu hala'o atividade partikulár ida."
  },
  {
    "word": "fasilita",
    "class": "Verbu",
    "meaning": "1. Halo sai fasil, loke dalan ba atividade ruma. Sin. habele Ez. Osan nẻ'e hosi rai- Japaun sei fasilita aminia pro-grama foun. 2. Fó ka prepara buat ruma atu ema bele hala'o atividade partikulár ida. Sin. hafó Ez. Governu fasilita eskola sira ho biblioteka diak ida atu estudante sira bele lee."
  },
  {
    "word": "fasilitasaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "fatál",
    "class": "Adjetivu",
    "meaning": "1. Neʼebé halo ema mate, liuliu asidente. 2. Neʼebé iha rezultadu aat, neʼebé fó rahun-aat. Ez. Nia halo sala fatál ida tanba hamonu avansadu ekipa adversáriu nian iha área penaltu."
  },
  {
    "word": "fatalidade",
    "class": "Substantivu",
    "meaning": "Mate neʼebé akontese tanba asidente ka violénsia ruma."
  },
  {
    "word": "fatalista",
    "class": "Substantivu/Adjetivu",
    "meaning": "(Ema) neʼebé fiar ba rahun ka sorte de'it, la fiar ka ladún fiar katak Na'i Maromak mak ukun no hala'o ita-ema nia moris."
  },
  {
    "word": "fatalizmu",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "fataluku, (lia-)",
    "class": "Substantivu",
    "meaning": "Lian ida hosi sira haat dalen papua sira (hamutuk ho makasae, makalero, bunak) neʼebé ema sira ko'alia iha rai- Lospalos."
  },
  {
    "word": "Fátima",
    "class": "Substantivu",
    "meaning": "Fatin peregrinasaun iha rai- Portugál iha ne'ebé Ita Na'i-Feto Maria Santísima mosu tiha ba labarik naʼin-tolu iha tinan 1917. Ita baibain fó ba Maromak Nia Inan títulu Ita- Na'i Feto Fátima Nian ka Nossa Senhora de Fátima (ho liaportugés)."
  },
  {
    "word": "fatin",
    "class": "Substantivu",
    "meaning": "1. Rai, área, leet ka hariin ruma. 2. Tatuur ka pozisaun ida neʼebé buat ka buat ruma hela. 3. Kadeira neʼebé fó ba ema ida, liuliu iha teatru, sinema, sala ka uma-kreda. 4. Ema nia tatuur ka pozisaun iha instituisaun ruma nia laran."
  },
  {
    "word": "fatór",
    "class": "Substantivu",
    "meaning": "1. Buat neʼebé bele hamosu situasaun ida; buat neʼebé bele hamkona ka afeta rezultadu ida. Ez. Rai-rahun mak fatór boot ida ba ema moras mehar. 2. wordu ida-ida multiplikasaun nian (iha matemátika)"
  },
  {
    "word": "fatu-makaku",
    "class": "Substantivu",
    "meaning": "Hena-tahanmesak ida neʼebé ema hatais atu proteje nia ropa sira seluk bainhira serbisu; baibain hatais iha roupa sira seluk nia leten."
  },
  {
    "word": "fatu-pár",
    "class": "Substantivu",
    "meaning": "Hatais neʼebé faru ho kalsa ka saia pár."
  },
  {
    "word": "fatudebañu",
    "class": "Substantivu",
    "meaning": "Roupa laran nian neʼebé feto sira hatais hanesan kalsa badak bainhira hariis. Sin. fatu-hariis"
  },
  {
    "word": "fatuk",
    "class": "Substantivu",
    "meaning": "Isintoosnomaharneʼebéiha rai no bele uza bahariiuma no sasán seluk."
  },
  {
    "word": "fatuk-biru",
    "class": "Substantivu",
    "meaning": "Fatuk kórazúl naku-kun ida (sulfatu riti nian) neʼebé ema sira uza hodi halo birun."
  },
  {
    "word": "fatuk-inan",
    "class": "Substantivu",
    "meaning": "1. Fatuk boot mesak ida. 2. Fatuk ida uluk neʼebé ema hatuur iha rai bainhira hahú harii uma ida."
  },
  {
    "word": "fatuk-kuak",
    "class": "Substantivu",
    "meaning": "Kuak boot iha rai-lolon ka iha rai okos."
  },
  {
    "word": "Fatumean",
    "class": "Substantivu",
    "meaning": "Subdistritu ida iha distritu Suai."
  },
  {
    "word": "fatura",
    "class": "Substantivu",
    "meaning": "1. Nota konaba valór ka folin hosi sasán sira neʼebé ita fa'an ka sosa. 2. Surat neʼebé obriga ema atu selu buat ruma neʼebé foin sosa. Verbu Halo nota kona-ba sasán neʼebé ita fa'an."
  },
  {
    "word": "fau, (ai-)",
    "class": "Substantivu",
    "meaning": "Ai-hun badak neʼebé fó ai-fuan boot. Naran-Botániku: Hibiscus, tiliaceus"
  },
  {
    "word": "fauna",
    "class": "Substantivu",
    "meaning": "Balada ka animál hotu-hotu neʼebé moris iha rejiaun ida ka iha otas ida. Sin. balada-libur"
  },
  {
    "word": "favór",
    "class": "Substantivu",
    "meaning": "1. Buat neʼebé ita halo atu tulun ema seluk, hahalok maktulun. Ez. Bele halo favór ida foti hela pasta ne'e? 2. Atitude hali'is ba ema ruma, ka ba buat ruma."
  },
  {
    "word": "favoravel",
    "class": "Adjetivu",
    "meaning": "Neʼebé bele tulun ka fó kadi'ak ka benefísiu ho dalan ruma. Ez. Prezidente nia prezensa sai favoravel tebes tanba bele halo ema hotu hakmatek."
  },
  {
    "word": "favorese",
    "class": "Verbu",
    "meaning": "1. Trata ho favór. 2. Fó preferénsia ba ema ka buat ida; gosta liu ka trata di'ak liu ema ka buat seluk. Sin. hali'is ba Ez. Sira favorese serbisug-rupu atubele hotu lailais."
  },
  {
    "word": "favoritizmu",
    "class": "Substantivu",
    "meaning": "Hahalok hali'is ba ema ida ho modu injustu. Ez. Andreia hananu furak liu maibé Marta mak manán prémiu tan favoritizmu."
  },
  {
    "word": "favoritu - favorita",
    "class": "f. Adjetivul Substantivu",
    "meaning": "1. Ema ka buat neʼebé Ita gosta liu. 2. Animál ka ema neʼebé ita espera atu manán iha halai-taru ka kompetisaun ida. Ez. Tinan ida-nee ekipa Portugál nian maka favoritu iha Kopa Europa."
  },
  {
    "word": "faxina",
    "class": "Verbu",
    "meaning": "Manán ema nia atensaun, in-terese ka domin ho ita-nia kualidade ruma, n.e. isin-furak, intelijénsia, ko'aliakómikunst. Sin. habanit, enkanta"
  },
  {
    "word": "faxinante",
    "class": "Adjetivu",
    "meaning": "1. Neʼebé enkanta ka dada ema nia fuan. Sin. mabanit, enkantadór 2. Neʼebé furak atumate, hanesan iha mehi de'it."
  },
  {
    "word": "faxíniu",
    "class": "Substantivu",
    "meaning": "Hahalok habanit nian. Sin. habanit, enkantu"
  },
  {
    "word": "faxista",
    "class": "Adjetivu",
    "meaning": "Kona-ba faxizmu, faxizmu nian. Substantivu Ema neʼebé tuir ka fiar ba faxizmu."
  },
  {
    "word": "faxizmu",
    "class": "Substantivu",
    "meaning": "1. Rejime polítiku, na-sionalista no autoritáriu neʼebé Benito Mussolini mak harii iha Itália (1922-1945). 2. Kualkér rejime polítiku neʼebé nasionalista no autoritáriu demais."
  },
  {
    "word": "faze",
    "class": "Substantivu",
    "meaning": "Hakat ka períodu partikulár ida iha buat ida nia dezenvolvimentu. Ez. Bainhira Timoroan sira manán tiha iha referendu 1999, faze tuirmai mak halo konstituisaun no forma governu tranzitóriu."
  },
  {
    "word": "fazenda",
    "class": "Substantivu",
    "meaning": "1. Natar ka plantasaun luan no boot. Sin. prédiu 2. Hena."
  },
  {
    "word": "febre",
    "class": "Substantivu",
    "meaning": "Moras neʼebé organizmu ruma hamosu hodi halo temperatura isin nian atu sa'e no pulsu atu la'o lais liu. Sin. isinmanas, isin-malirin"
  },
  {
    "word": "febredufenu mós febredusfenus",
    "class": "Substan-tivu",
    "meaning": "Moras alérjiku neʼebé halo ema fani beibeik."
  },
  {
    "word": "federál",
    "class": "Adjetivu",
    "meaning": "Kona-ba sistema polítiku ida ho governu sentrál neʼebé kontrola estadu sira grupu ida, maibé estadu ida-idak soi nia podér no autoridade rasik. Ez. Estadu Naklibur Sira Amérika Nian tuir sistema governu federálho estadu hamutuk limanulu."
  },
  {
    "word": "federalizmu",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "federalista",
    "class": "Adjetivul Substantivu",
    "meaning": ""
  },
  {
    "word": "federasaun",
    "class": "Substantivu",
    "meaning": "Aliansa entre povu rua ka liu. Sin. klibur, asosiasaun"
  },
  {
    "word": "Federasaun Rusa",
    "class": "Substantivu",
    "meaning": "Hahidak polítiku ida, neʼebé hakohak rai-Rúsia tomak hamutuk ho rejiaun autónomu oioin Europa no Ázia nian ho popula-saun la'ós rusu."
  },
  {
    "word": "feen",
    "class": "Substantivu",
    "meaning": "Feto neʼebé mane ida kaben ho ka hola nu'udar nia kaben."
  },
  {
    "word": "fehan",
    "class": "Substantivu",
    "meaning": "Rai-tetuk luan. Ita fó mós naran própriu Fehan ba zona tasi-mane iha rai- Timór Lorosa'e."
  },
  {
    "word": "fehuk",
    "class": "Substantivu",
    "meaning": "1. Modo ida ho isin mutin, mean ka malahuk neʼebé moris iha rai laran. 2. (kolokiál) Ema neʼebé beik ka la hatene buat ida."
  },
  {
    "word": "fehuk-midar",
    "class": "Substantivu",
    "meaning": "Fehuk neʼebé nia isin midar; baibain ema da'an ka sona ho mina."
  },
  {
    "word": "fehuk-ropa",
    "class": "Substantivu",
    "meaning": "Fehuk ida ho isin mutin ne'ebé horiuluk moris de'it iha rai-Amérika Súl maibé ohin loron kultiva iha mundu tomak."

    "class": "f. Adjetivu",
    "meaning": ""
  },
  {
    "word": "ipnotiza",
    "class": "Verbu",
    "meaning": "Hadukur ema liuhosi ipnoze. Ez. Naok-teen balu ipnotiza ema molok atu naʼok."
  },
  {
    "word": "ipókrita",
    "class": "Adjetivu/Substantivu",
    "meaning": "(Ema) neʼebé hakfudik ka finje kualidade di'ak ida neʼebé nia afinál la soi. Sin. laran-mak-erek, falsu"
  },
  {
    "word": "ipokrizia",
    "class": "Substantivu",
    "meaning": "1. Hatudu virtude ka hahalok di'ak neʼebé loloos la iha. Ez. Moris ne'e nakonu ho ipokrizia tanba ema ko'alia oin ida no halo oin-seluk. 2. Devosaun bosok ka falsu."
  },
  {
    "word": "ipoteka",
    "class": "Substantivu",
    "meaning": "Kontratu iha neʼebé ema peñora rikusoin ruma hanesan rai ka uma hodi selu tusan."
  },
  {
    "word": "ipóteze",
    "class": "Substantivu",
    "meaning": "1. Esplikasaun ida bazeia ba evidénsia neʼebé limitadu no ita tenke hametin ho prova liután. 2. Buat ida neʼebé sei hanoin de'it, neʼebé seidauk mosu ka sai realidade. Sin. supozisaun"
  },
  {
    "word": "ipotétiku - ipotétika",
    "class": "f. Adjetivu",
    "meaning": ""
  },
  {
    "word": "ípsilon",
    "class": "Substantivu",
    "meaning": "Letra alfabetu gregu no romanu ninian, hakerek ho tadak Y (boot) ka y (ki'ik). Ípsilon la serve ba hakerek lia-tetun, maibé uza fali hodi hakerek lia-fataluku."
  },
  {
    "word": "Irabere (Mota-)",
    "class": "Substantivu",
    "meaning": "Mota iha Watu-karbau no Iliomar nia leet, neʼebé suli nafatin iha tempu bailoro."
  },
  {
    "word": "Irake (rai-)",
    "class": "Substantivu",
    "meaning": "Rain no estadu ida iha Ázia Loromonu. Nia naran uluk Mezopotámia, katak ‘rain iha mota rua nia leet’."
  },
  {
    "word": "irakianu - irakiana",
    "class": "f. Adjetivu",
    "meaning": "Rai-Irake nian; kona-ba rai-Irake. Substantivu Ema Irake."
  },
  {
    "word": "Iralalaru (Bee-Lihun)",
    "class": "Substantivu",
    "meaning": "Bee-lihun boot ida iha zona Lospalos besik Mehara."
  },
  {
    "word": "iranianu - iraniana",
    "class": "f. Adjetivu",
    "meaning": "Rai-Iraun nian; kona-ba rai-Iraun. Sin. persa Sub-stantivu Ema Iraun."
  },
  {
    "word": "Iraun (rai-)",
    "class": "Substantivu",
    "meaning": "Rain no estadu ida iha Ázia Loromonu. Pérsia maka nia naran uluk."
  },
  {
    "word": "Irlanda (rai-)",
    "class": "Substantivu",
    "meaning": "Rai-kotun ida rai-Bretaña nia sorin loromonu nian. Repú-blika Irlanda okupa rain nia nia parte boot liu."
  },
  {
    "word": "irlandés - irlandeza",
    "class": "f. Adjetivu",
    "meaning": "Rai-Irlanda nian; kona-ba rai-Irlanda. Substantivu 1. Ema Irlanda. 2. (lia-irlandés) Dalen Irlanda nian. Sin. liagaéliku"
  },
  {
    "word": "irmán",
    "class": "Substantivu",
    "meaning": "Feto la kaben neʼebé tama kongregasaun ka orden monástika ida Kreda Katólika ka Kreda Ortodoksa nian hodi fó nia moris tomak ba hala'o knaar sira neʼebé nia superiora haraik atu serbí Maromak no ema sira. Sin. madre"
  },
  {
    "word": "irmaun",
    "class": "Substantivu",
    "meaning": "1. Mane la kaben neʼebé tama kongregasaun Kreda Katólika nian hodi fó nia moris tomak ba hala'o knaar sira neʼebé nia superiór sira haraik atu serbí Maromak no ema sira. Nia baibain la simu ordenasaun na'i-lulik. 2. Semi-narista."
  },
  {
    "word": "ironia",
    "class": "Substantivu",
    "meaning": "1. Buat ida neʼebé akon-tese ho kontráriu ba buat neʼebé ita hakarak ka hein. 2. Ko'alia ho zombaria no sarkazmu, hodi finje ita la hatene ka simu buat ida ne'ebé ita loloos la gosta. Sin. lia-bones, babones"
  },
  {
    "word": "iróniku - irónika",
    "class": "f. Adjetivu",
    "meaning": "1. Ironia nian; ho ironia. 2. Ko'alia ka situasaun na-konu ho ironia. 3. Kómiku tanba hatudu ironia. Ez. Nia ema neʼebé kontra vio-lénsia maibé iróniku tebes tanba hosi kotuk nia sadik ema hodi baku malu."
  },
  {
    "word": "ironiza",
    "class": "Verbu",
    "meaning": "Ko'alia ho ironia. Sin. hak-bones"
  },
  {
    "word": "irrasionál",
    "class": "Adjetivu",
    "meaning": "Neʼebé hasoru razaun."
  },
  {
    "word": "irreál",
    "class": "Adjetivu",
    "meaning": "Neʼebé laʼós realidade, mehi de'it."
  },
  {
    "word": "irrefutavel",
    "class": "Adjetivu",
    "meaning": "Neʼebé ita la bele nega; tanba evidente ka momoos loos. Sin. nega-labelek, hatiran-labelek"
  },
  {
    "word": "irregulár",
    "class": "Adjetivu",
    "meaning": "Neʼebé la tuir regra ka norma baibain nian."
  },
  {
    "word": "irregularidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "irrekonsiliavel",
    "class": "Adjetivu",
    "meaning": "Neʼebéita la hadame. Sin. hadame-labelek"
  },
  {
    "word": "irrelevante",
    "class": "Adjetivu",
    "meaning": "Neʼebé la'ós relevante, ladún kona. Ez. Prova ida-neʼebé advo-gadu hato'o loloos irrelevante ba kazu ne'e."
  },
  {
    "word": "irrelevánsia",
    "class": "Substantivu",

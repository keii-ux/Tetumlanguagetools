    "word": "noiva",
    "class": "Substantivu",
    "meaning": "Feto-klosan neʼebé prepara an atu kaben tanba mane ida husu ka prenda tiha ona."
  },
  {
    "word": "noivadu",
    "class": "Substantivu",
    "meaning": "Noivu na'inrua nia kompromisu atu harii umakain."
  },
  {
    "word": "noivu",
    "class": "Substantivu",
    "meaning": "Mane-klosan neʼebé prepara an atu kaben, no hala'o tiha ona prenda ho feto ruma."
  },
  {
    "word": "nokaute",
    "class": "Substantivu",
    "meaning": "Bainhira boksista ida monu ba rai tanba hetan tuku hosi nia adversáriu, no nune'e lakon kombate."
  },
  {
    "word": "nómada",
    "class": "Substantivu",
    "meaning": "Ema ida neʼebé lemo rai nu'udar nia moris baibain nian. Sin. maklemok"
  },
  {
    "word": "nomeadamente",
    "class": "Advérbiu",
    "meaning": "Liafuan neʼebé uza atu hato'o informasaun seluk tan ho detalle; mak hanesan. Ez. Prezidente sei hala'o vizita ida ba liur, nomeadamente ba rai- Xina no rai-Japaun."
  },
  {
    "word": "nominál",
    "class": "Adjetivu",
    "meaning": "Ho naran de'it, la tuir loloos. Ez. Katóliku nominál sira hanaran an katóliku maibé nunka bá rona misa."
  },
  {
    "word": "nona (ai-)",
    "class": "Substantivu",
    "meaning": "Ai-horis ida neʼebé fó fuan ho isin mutin no musan metan, liuliu iha tempu-udan. / 1. Feto-raan, liuliu Xinaoan. 2. Fetolurón ka kamarua."
  },
  {
    "word": "nono",
    "class": "Verbu",
    "meaning": "Hamanas bee ka líkidu ruma to'o nakali."

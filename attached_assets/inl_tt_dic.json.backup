      "word": "gastu,",
      "class": "Substantivu",
      "meaning": "Osan neʼebé gasta hodi selu buat ruma."
    },
    {
      "word": "gatillu,",
      "class": "Substantivu",
      "meaning": "Pesa ki'ikoan iha kilat hanesan xave neʼebé ita buti ka dada atu tiru ka halo kilat tarutu. Sin. karleti."
    },
    {
      "word": "gaveta,",
      "class": "Substantivu",
      "meaning": "Kaixa tetuk ida neʼebé parte hosi armáriu ka meza; ema bele loke ka dudu tama atu tau sasán iha laran."
    },
    {
      "word": "gaze,",
      "class": "Substantivu",
      "meaning": "Hena mihis no transparente."
    },
    {
      "word": "gazeia,",
      "class": "Verbu",
      "meaning": "Oho ho gás."
    },
    {
      "word": "gazela,",
      "class": "Substantivu",
      "meaning": "Animál afrikanu no aziátiku ida neʼebé
    "meaning": "Kakorok nian, tatolan nian, liuliu lian ka tarutu."

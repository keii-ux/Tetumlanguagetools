[
    {
      "word": "á,",
      "class": "Substantivu",
      "meaning": "Letra A nia naran."
    },
    {
      "word": "aas,",
      "class": "Adjetivu | Substantivu",
      "meaning": "(Neʼebé ho) distánsia boot hosi rai ba leten."
    },
    {
      "word": "abade - abadesa, f.",
      "class": "Substantivu",
      "meaning": "Padre superiór ka ulun-boot mosteiru nian."
    },
    {
      "word": "abadia,",
      "class": "Substantivu",
      "meaning": "1. Mosteiru ida neʼebé abade mak ukun. 2. Konventu ida neʼebé abadesa mak ukun."
    },
    {
      "word": "abakate,",
      "class": "Substantivu",
      "meaning": "Ai-fuan ida ho forma hanesan telun (hanesan mantolun boot) ho kulit kór-matak; nia isin mós kór-matak, mamar no iha mina barak."
    },
    {
      "word": "aban,",
      "class": "Advérbiu",
      "meaning": "Loron ida-neʼebé tuir ohin no uluk ba bainrua."
    },
    {
      "word": "aban bainrua,",
      "class": "Substantivu",
      "meaning": "Tempu oin mai. Sin. futuru. Nota: Espresaun 'aban bainrua' (loron ida-neʼebé tuir bainrua) ita baibain hakerek lahó ifen."
    },
    {
      "word": "abdomen,",
      "class": "Substantivu",
      "meaning": "Parte isin nian neʼebé hakohak kabun no órgaun sira ne'ebé hale'u nia. Sin. kabun-belar."
    },
    {
      "word": "abdominál,",
      "class": "Adjetivu",
      "meaning": "Kona-ba abdomen."
    },
    {
      "word": "abdominais,",
      "class": "Substantivu",
      "meaning": "Ezersísiu fíziku sira atu hatoos múskulu sira abdomen nian."
    },
    {
      "word": "abertu - aberta, f.",
      "class": "Adjetivu",
      "meaning": "(Ema) neʼebé prontu atu loke nia neon ba ideia ka buat foun. Sin. neon-nakloke."
    },
    {
      "word": "abertura,",
      "class": "Substantivu",
      "meaning": "1. Atitude neʼebé simu lailais ideia ka buat foun. 2. Serimónia ofisiál hodi loke espozisaun, serbisu-fatin, instituisaun ka empreza foun."
    },
    {
      "word": "abesé,",
      "class": "Substantivu",
      "meaning": "1. Letra ka sinál-hakerek sira neʼebé ema uza hodi hakerek dalen ida. Sin. alfabetu. 2. Matenek báziku."
    },
    {
      "word": "abesedáriu,",
      "class": "Substantivu",
      "meaning": "Kartilla ka livru-eskola hodi hanorin labarik sira atu lee no hakerek."
    },
    {
      "word": "abii,",
      "class": "Substantivu",
      "meaning": "Títulu hodi hasé feto otas-boot, liuliu ba biin. Ez. Ita bá ona, abii, tanba rai atu kalan ona!"
    },
    {
      "word": "abilidade,",
      "class": "Substantivu",
      "meaning": "Kapasidade atu halo buat ruma."
    },
    {
      "word": "abilita,",
      "class": "Verbu",
      "meaning": "Fó kapasidade. Sin. habele, kapasita."
    },
    {
      "word": "abilitasaun,",
      "class": "Substantivu",
      "meaning": "1. Hahalok fó kapasidade nian. 2. Surat ofisiál neʼebé hatudu ema ida nia kapasidade ba serbisu ruma. Sin. kualifikasaun."
    },
    {
      "word": "ábitu,",
      "class": "Substantivu",
      "meaning": "Monje, madre ka padre nia farda ka hatais baibain nian."
    },
    {
      "word": "abó,",
      "class": "Substantivu",
      "meaning": "haree avó."
    },
    {
      "word": "abonu-família,",
      "class": "Substantivu",
      "meaning": "Osan neʼebé governu ka instituisaun haraik ba nia funsionáriu ka eis-funsionáriu atubele uza ba nia família. Osan ne'e ketak fali hosi nia saláriu neʼebé nia simu fulan-fulan. Ez. Eis-funsionáriu portugés nian oras ne'e simu sira-nia abonu família."
    },
    {
      "word": "aboríjene,",
      "class": "Substantivu",
      "meaning": "1. Ema kahorik ka rai-na'in. 2. Ema kahorik rai-Austrália nian."
    },
    {
      "word": "abortadór - abortadeira, f.",
      "class": "Substantivu",
      "meaning": "Kriminozu ida neʼebé simu osan hodi oho labarik iha oan-fatin inan nian."
    },
    {
      "word": "abortu,",
      "class": "Substantivu",
      "meaning": "Krime oho labarik iha oan-fatin inan nian. Abortu naturál katak hamonu oan neʼebé seidauk moris tanba moras ka asidente ruma; kaukau ka ka'an-fuan mate iha oan-fatin seidauk to'o loron. Sin. hamonu-oan."
    },
    {
      "word": "abou,",
      "class": "Substantivu",
      "meaning": "Títulu hodi hasé mane otas-boot, liuliu ba maun. Ez. Abou, di'ak ka lae?"
    },
    {
      "word": "abrelata,",
      "class": "Substantivu",
      "meaning": "Instrumentu ida neʼebé uza hodi loke lata."
    },
    {
      "word": "abreviatura,",
      "class": "Substantivu",
      "meaning": "Forma badak hosi liafuan ida, porezemplu Sr. = Señór, nst. = no seluseluk tan, n.e. = nuʼudar ezemplu, Sin. = sinónimu. Sin. lia-hadabak."
    },
    {
      "word": "abridór,",
      "class": "Substantivu",
      "meaning": "Instrumentu ida neʼebé ita uza hodi ka'it ba botir nia taka atubele loke sai."
    },
    {
      "word": "Abríl (fulan-),",
      "class": "Substantivu",
      "meaning": "Fulan dahaat tinan ida nian neʼebé tuir fulan-Marsu no uluk ba fulan-Maiu."
    },
    {
      "word": "absolutamente,",
      "class": "Advérbiu",
      "meaning": "1. Tebetebes duni. Ez. Hakotun ida-ne'e absolutamente injustu! 2. La bele iha dúvida ida. Ez. Ami la bele dehan absolutamente katak Prezidente sei la simu Ita-Boot aban."
    },
    {
      "word": "absolutu - absoluta, f.",
      "class": "Adjetivu",
      "meaning": "1. Neʼebé kompletu no tomak, nu'udar ezemplu ba direitu no podér. 2. Neʼebé la iha kladik ka limite ida. Sin. kladik-laek. Ez. Iha sistema-ukun autokrátiku, liurai soi podér absolutu no nia lalika fó ulun ba parlamentu ka povu nia hakarak."
    },
    {
      "word": "absolve,",
      "class": "Verbu",
      "meaning": "1. (Juís) hesuk ka deklara iha tribunál laran katak ema duun ida la iha sala. Ez. Tribunál absolve tiha ema ne'e hosi daduun sira hotu; tanba ne'e la bele hadadúr nia. 2. (Amlulik) hesuk ka deklara iha konfesionál laran katak ema penitente nia sala kasu ka halakon tiha ona."
    },
    {
      "word": "absolvisaun,",
      "class": "Substantivu",
      "meaning": "Hahalok absolve nian."
    },
    {
      "word": "absorve,",
      "class": "Verbu",
      "meaning": "1. (Substánsia ida) simu been ruma hanesan hemu ka susu tiha. Sin. haktolan. 2. (Figuradu) Simu ka tolan influénsia ruma. 3. Hamate lian ka xoke ida."
    },
    {
      "word": "absorsaun,",
      "class": "Substantivu",
      "meaning": "Hahalok absorve nian."
    },
    {
      "word": "abstinensia,",
      "class": "Substantivu",
      "meaning": "La han ai-han partikulár ida, baibain ba motivu relijiozu, hanesan sarani sira neʼebé la han na'an iha loron-sesta. Sin. luli han na'an."
    },
    {
      "word": "abuabu,",
      "class": "Substantivu | Adjetivu",
      "meaning": "Substantivu: Bee-musan ki'ik liu iha anin neʼebé dala ruma halo ema susar atu haree, liuliu iha fatin aas bainhira malirin liu, molok udan ka depois de udan. Ez. Karreta sira susar atu halai maka'as tanba abuabu taka rai. Adjetivu: Kór neʼebé atu mutin maibé nakukun uitoan. Sin. malahuk, sinzentu."
    },
    {
      "word": "abundánsia,",
      "class": "Substantivu",
      "meaning": "Kualidade ka kondisaun ne'ebé buras. Sin. baburas."
    },
    {
      "word": "abut,",
      "class": "Substantivu",
      "meaning": "1. Parte ai-horis nian neʼebé iha rai laran, ida neʼebé simu ai-han no bee hosi rai atu ai ne'e bele moris. 2. Ema ka família nia hun ka bei'ala sira. 3. Problema ida nia hun ka kauza."
    },
    {
      "word": "abuza,",
      "class": "Verbu",
      "meaning": "Uza sala, liuliu direitu ka podér neʼebé nia iha, nu'udar ezemplu podér neʼebé povu fó ba ministru no funsionáriu sira. Ez. Governu abuza podér neʼebé povu fó ba nia bainhira uza fasilidade sira arbiru de'it."
    },
    {
      "word": "abuzu,",
      "class": "Substantivu",
      "meaning": "Hahalok abuza nian."
    },
    {
      "word": "adapta,",
      "class": "Verbu",
      "meaning": "Halo atu sai natoon ba buat ruma. Sin. hadaran. Ez. Ita bele adapta livru inglés ne'e ba eskola Timór hodi tradús balu de'it."
    },
    {
      "word": "adaptasaun,",
      "class": "Substantivu",
      "meaning": "Hahalok adapta nian."
    },
    {
      "word": "adaptavel,",
      "class": "Adjetivu",
      "meaning": "Neʼebé ita bele adapta."
    },
    {
      "word": "adeptu - adepta, f.",
      "class": "Substantivu",
      "meaning": "1. Ema ida neʼebé tuir ema boot ruma. 2. Ema ida neʼebé gosta tebetebes hateke ba desportu ruma."
    },
    {
      "word": "aderente,",
      "class": "Substantivu",
      "meaning": "Ema neʼebé tuir ka fó an ba kauza ka partidu ruma. Sin. maktuir."
    },
    {
      "word": "adeus,",
      "class": "Interjeisaun",
      "meaning": "Liafuan neʼebé ema uza atu despede ka husik hela ema ka fatin ruma hodi bá fatin seluk."
    },
    {
      "word": "adezivu - adeziva, f.",
      "class": "Adjetivu | Substantivu",
      "meaning": "Adjetivu: Neʼebé belit. Sin. makbelit. Substantivu: Plástiku-tahan ida ho imajen ka hakerek neʼebé ema sira gosta taka ba janela ka karreta."
    },
    {
      "word": "adia,",
      "class": "Verbu",
      "meaning": "Tau ba loron seluk. Sin. haloron."
    },
    {
      "word": "adiamentu,",
      "class": "Substantivu",
      "meaning": "Hahalok adia nian."
    },
    {
      "word": "adianta,",
      "class": "Verbu",
      "meaning": "(Relójiu) la'o lailais."
    },
    {
      "word": "adisaun,",
      "class": "Substantivu",
      "meaning": "1. Buat ida tan neʼebé ita tau. Sin. tau-tan. 2. Hahalok sura númeru hotu-hotu."
    },
    {
      "word": "adisiona,",
      "class": "Verbu",
      "meaning": "Halo adisaun, sura númeru hotu-hotu."
    },
    {
      "word": "Adjetivu,",
      "class": "Substantivu",
      "meaning": "Liafuan neʼebé hato'o Substantivu ka naran ida nia kondisaun ka estadu, nu'udar ezemplu, furak, mean, aas, manas, nst."
    },
    {
      "word": "adjetivál,",
      "class": "Adjetivu",
      "meaning": "Kona-ba adjetivu."
    },
    {
      "word": "administra,",
      "class": "Verbu",
      "meaning": "Ukun no organiza instituisaun ida, n.e. governu, ministériu, empreza, dioseze nst."
    },
    {
      "word": "administradór - administradora, f.",
      "class": "Substantivu",
      "meaning": "Ema ida neʼebé administra."
    },
    {
      "word": "administrasaun,",
      "class": "Substantivu",
      "meaning": "1. Knaar administra nian. 2. Ema-lubun neʼebé administra."
    },
    {
      "word": "admira,",
      "class": "Verbu",
      "meaning": "1. Sai hakfodak tanba buat labaibain ida. Ez. Ami admira tebetebes bainhira rona kona-ba ne'e. 2. Soi laran-hakfodak no respeitu ba ema ka buat ida tanba ninia kualidade kapás ruma; foti matan ba. Ez. Ha'u admira ema ne'e nia matenek."
    },
    {
      "word": "admirasaun,",
      "class": "Substantivu",
      "meaning": "Hahalok admira nian."
    },
    {
      "word": "admiradu - admirada, f.",
      "class": "Adjetivu",
      "meaning": "Neʼebé sente admirasaun."
    },
    {
      "word": "admiravel,",
      "class": "Adjetivu",
      "meaning": "1. Neʼebé halo ema admira. 2. Neʼebé kmanek ka kapás loos."
    },
    {
      "word": "admite,",
      "class": "Verbu",
      "meaning": "Simu faktu ka posibilidade ruma. Ez. Ita la bele admite argumentu beik hanesan ne'e."
    },
    {
      "word": "admisaun,",
      "class": "Substantivu",
      "meaning": "Hahalok admite ka simu nian."
    },
    {
      "word": "adolexente,",
      "class": "Adjetivu | Substantivu",
      "meaning": "(Kona-ba) ema neʼebé la'ós tan ona labarik maibé mós seidauk sai adultu. Sin. foin-sa'e, joven."
    },
    {
      "word": "adolexénsia,",
      "class": "Substantivu",
      "meaning": "Períodu moris nian entre labarik no adultu. Sin. foin-sa'e."
    },
    {
      "word": "adora,",
      "class": "Verbu",
      "meaning": "1. Hana'i ho laran tomak buat ruma, liuliu lulik. 2. Hana'i ho laran tomak ema ka klamar ruma, liuliu maromak ida ka Na'i Maromak. Ez. Iha relijiaun sarani, ita adora Na'i Maromak de'it; anju no santu sira ita hana'i fali. 3. (Figuradu) Gosta tebetebes."
    },
    {
      "word": "adoravel,",
      "class": "Adjetivu",
      "meaning": "Neʼebé ita bele adora. Sin. adora-bele."
    },
    {
      "word": "adriátiku - adriátika, f.",
      "class": "Adjetivu",
      "meaning": "Kona-ba Tasi Adriátiku, tasi-sikun boot ida iha rai-Itália, rai-Kroásia no rai-Albánia sira-nia leet."
    },
    {
      "word": "adubu,",
      "class": "Substantivu",
      "meaning": "Balada-teen ka manu-teen neʼebé to'os-na'in sira uza hodi habokur rai."
    },
    {
      "word": "adultériu,",
      "class": "Substantivu",
      "meaning": "Relasaun seksuál entre ema kaben-na'in ida no ema seluk neʼebé la'ós nia la'en ka feen."
    },
    {
      "word": "adúlteru - adúltera, f.",
      "class": "Substantivu",
      "meaning": "Ema neʼebé halo adultériu."
    },
    {
      "word": "Adventu,",
      "class": "Substantivu",
      "meaning": "Semana haat molok atu tama Natál iha kalendáriu Kreda nian. Ez. Iha tempu Adventu, Ita tenke buka atu husu perdaun ba malu hodi prepara ba festa boot Natál."
    },
    {
      "word": "advérbiu,",
      "class": "Substantivu",
      "meaning": "Liafuan ida neʼebé aumenta informasaun ruma kona-ba verbu, adjetivu ka advérbiu seluk hodi hato'o oinsá, bainhira no iha-ne'ebé maka buat ruma akontese. Ez. Iha fraze 'Sira la'o neineik', liafuan 'neineik' mak advérbiu."
    },
    {
      "word": "adverbiál,",
      "class": "Adjetivu",
      "meaning": "Kona-ba advérbiu."
    },
    {
      "word": "adversáriu - adversária, f.",
      "class": "Substantivu",
      "meaning": "Ema neʼebé sakar hasoru ita. Sin. maksakar."
    },
    {
      "word": "advogadu - advogada, f.",
      "class": "Substantivu",
      "meaning": "Ema neʼebé iha kualifikasaun atu fó konsellu ba ema sira kona-ba lei, ka atu reprezenta ema, liuliu mahalok-sala ka akuzadu, iha tribunál."
    },
    {
      "word": "aéreu - aérea, f.",
      "class": "Adjetivu",
      "meaning": "Anin nian, kona-ba anin."
    },
    {
      "word": "aeroportu,",
      "class": "Substantivu",
      "meaning": "Aviaun tun-fatin besik sidade, neʼebé iha fatin luan no soi fasilidade barak."
    },
    {
      "word": "Afeganistaun,",
      "class": "Substantivu",
      "meaning": "Rai no estadu ida iha Ázia Loromonu."
    },
    {
      "word": "afegaun - afegã, f.",
      "class": "Adjetivu | Substantivu",
      "meaning": "Adjetivu: Rai-Afeganistaun nian. Substantivu: Ema Afeganistaun."
    },
    {
      "word": "afeisaun,",
      "class": "Substantivu",
      "meaning": "Sentimentu ka hahalok domin nian, liuliu ba ema seluk neʼebé ita gosta. Sin. laran-maluk, kariñu."
    },
    {
      "word": "afetuozu - afetuoza, f.",
      "class": "Adjetivu",
      "meaning": "Ne'ebé hatudu afeisaun ka kariñu. Sin. laran-di'ak."
    },
    {
      "word": "afeta,",
      "class": "Verbu",
      "meaning": "Influensia ka muda ema ka buat ruma. Sin. hamkona, influensia. Ez. Funu ne'e afeta ema barak nia moris, balu sai bulak tanba lakon maluk no rikusoin."
    },
    {
      "word": "afiadór,",
      "class": "Substantivu",
      "meaning": "Aparellu ida hodi hakro'at lapis ho lámina iha laran neʼebé kadi lapis nia fatuk bainhira ita dulas lapis nia kain."
    },
    {
      "word": "afian,",
      "class": "Substantivu",
      "meaning": "Ai-fuan papoila nia been, neʼebé ema uza nu'udar droga narkótiku. Sin. ópiu."
    },
    {
      "word": "afinál,",
      "class": "Advérbiu",
      "meaning": "La hanesan ho buat neʼebé hanoin. Ez. Vestidu ne'e afinál la serve ba ó."
    },
    {
      "word": "Áfrika (rai-),",
      "class": "Substantivu",
      "meaning": "Kontinente boot ida neʼebé tasi tolu hale'u, maka: Tasi Mediterráneu, Tasi-Boot Atlántiku no Tasi-Boot Índiku."
    },
    {
      "word": "afrikander,",
      "class": "Substantivu | Adjetivu",
      "meaning": "1. (Kona-ba) ema kulit-mutin ho bei'ala olandés neʼebé mahorik rai-Áfrika Súl nian. 2. (Lia-afrikander) Variedade hosi dalen olandés neʼebé koʼalia iha rai-Áfrika Súl."
    },
    {
      "word": "afrikanu - afrikana, f.",
      "class": "Adjetivu | Substantivu",
      "meaning": "Adjetivu: Rai-Áfrika nian. Substantivu: Ema Áfrika."
    },
    {
      "word": "afta,",
      "class": "Substantivu",
      "meaning": "Úlsera neʼebé mosu iha ema nia ibun laran, hanesan kanek ki'ikoan ida."
    },
    {
      "word": "agá,",
      "class": "Substantivu",
      "meaning": "Letra H nia naran. Sin. há."
    },
    {
      "word": "agnóstiku - agnóstika, f.",
      "class": "Substantivu | Adjetivu",
      "meaning": "(Kona-ba) ema neʼebé, maski la nega katak Maromak iha, la fiar ba revelasaun ida-neʼebé ita ema simu hosi Maromak liuhosi profeta, apóstolu no evanjelista sira, no tanba ne'e lakohi halo tuir Kreda nia hanorin ka fó ulun ba nia ukun."
    },
    {
      "word": "agnostisizmu,",
      "class": "Substantivu",
      "meaning": "Doutrina ka fiar agnóstiku nian."
    },
    {
      "word": "agora,",
      "class": "Advérbiu",
      "meaning": "Iha tempu ne'e duni. Sin. oras ne'e. Ez. Oras hira ona agora? Agora tuku tolu."
    },
    {
      "word": "Agostu (fulan-),",
      "class": "Substantivu",
      "meaning": "Fulan daualuk tinan nian, neʼebé uluk ba fulan-Setembru no tuir fulan-Jullu."
    },
    {
      "word": "agradese,",
      "class": "Verbu",
      "meaning": "Hatudu ita-nia laran-haksolok tanba favór ruma neʼebé ita simu; rekoñese ema seluk nia hahalok di'ak mai ita. Sin. fó neon. Ez. Ita agradese Na'i Maromak ne'ebé fó grasa barak mai ita."
    },
    {
      "word": "agradesidu - agradesida, f.",
      "class": "Adjetivu",
      "meaning": "Neʼebé hatene agradese, neʼebé hatudu rekoñesimentu, gratidaun, obrigadu. Sin. gratu, fó-neon."
    },
    {
      "word": "agradesimentu,",
      "class": "Substantivu",
      "meaning": "Hahalok agradese nian. Sin. gratidaun."
    },
    {
      "word": "agresaun,",
      "class": "Substantivu",
      "meaning": "1. Violénsia fízika hasoru ema ka rain ida. Sin. atake, ratan. 2. Atitude ka sentimentu funu nian."
    },
    {
      "word": "agresivu - agresiva, f.",
      "class": "Adjetivu",
      "meaning": "1. Neʼebé hali'is ba violénsia. 2. Neʼebé uza forsa demais."
    },
    {
      "word": "agresividade,",
      "class": "Substantivu",
      "meaning": "Kualidade ka hahalok ne'ebé agresivu."
    },
    {
      "word": "agresór - agresora, f.",
      "class": "Substantivu",
      "meaning": "Ema neʼebé ataka. Sin. makratan, atakante, asaltante."
    },
    {
      "word": "agriaun,",
      "class": "Substantivu",
      "meaning": "Modo ne'ebé moris iha bee laran, dala barak ema uza ba halo salada. Te'in ka fila halo modo ba han."
    },
    {
      "word": "agrikultór - agrikultora, f.",
      "class": "Substantivu",
      "meaning": "Ema neʼebé serbisu halo to'os ka halai natar. Sin. to'os-na'in."
    },
    {
      "word": "agrikultura,",
      "class": "Substantivu",
      "meaning": "1. To'os no natar. Sin. kuda-rai. 2. Matenek ka siénsia kona-ba kuda rai."
    },
    {
      "word": "agríkola,",
      "class": "Adjetivu",
      "meaning": "Kona-ba agrikultura."
    },
    {
      "word": "agronomia,",
      "class": "Substantivu",
      "meaning": "Siénsia agrikultura nian."
    },
    {
      "word": "agrónomu - agrónoma, f.",
      "class": "Substantivu",
      "meaning": "Ema matenek agronomia."
    },
    {
      "word": "aguarrás,",
      "class": "Substantivu",
      "meaning": "Líkidu neʼebé utiliza ba hamoos tinta ka vernís."
    },
    {
      "word": "aguenta,",
      "class": "Verbu",
      "meaning": "Tolera ka tahan ho buat todan ka xatu ruma. Sin. suporta, atura. Ez. Enfermeiru ne'ebé bali ain kanek dehan ba ema moras ne'e: “Aguenta, eh!”"
    },
    {
      "word": "ahan,",
      "class": "Substantivu",
      "meaning": "Koto-moruk."
    },
    {
      "word": "ahi,",
      "class": "Substantivu",
      "meaning": "1. Lakan manas kinur neʼebé mosu bainhira ita sunu buat ruma. 2. Enerjia, eletrisidade."
    },
    {
      "word": "ahi-adas,",
      "class": "Substantivu",
      "meaning": "Ular ida neʼebé nabilan iha rai-nakukun."
    },
    {
      "word": "ahi-funan,",
      "class": "Substantivu",
      "meaning": "1. Ahi nia roman neʼebé sai hosi ahi mai hanesan fitun. Ez. Bainhira soldadór sira solda besi, ahi-funan haksoit sai barak loos. 2. Moras ida neʼebé kona ema nia kulit."
    },
    {
      "word": "ahi-kadesan,",
      "class": "Substantivu",
      "meaning": "Ai nia resin bainhira ahi han tiha ona. Sin. ahi-uuk, ahi-rahun."
    },
    {
      "word": "ahi-klaak,",
      "class": "Substantivu",
      "meaning": "Ai-rohan neʼebé metan hotu ona maibé ahi han sei hela, seidauk mohu hanesan ahi-laten."
    },
    {
      "word": "ahi-kose,",
      "class": "Substantivu",
      "meaning": "Ai-kesak ida ho fósforu ka substánsia lakan-bele seluk iha nia rohan, neʼebé sai lakan bainhira ita kose tiha ba kaixa ka knuuk nia lolon-sorin neʼebé iha kilat-rahun."
    },
    {
      "word": "ahi-lakan,",
      "class": "Substantivu",
      "meaning": "Roman manas kinur neʼebé sai hosi ahi; gás haree-bele."
    },
    {
      "word": "ahi-laten,",
      "class": "Substantivu",
      "meaning": "Ai-rohan neʼebé ahi han tiha ona no metan hotu."
    },
    {
      "word": "ahi-masa,",
      "class": "Substantivu",
      "meaning": "Ai ida neʼebé ita sunu nia rohan atu fó naroman."
    },
    {
      "word": "ahi-matan,",
      "class": "Substantivu",
      "meaning": "Fatin tau ahi nian hodi te'in ka hamanas kuartu. Sin. fornu."
    },
    {
      "word": "ahi-oan,",
      "class": "Substantivu",
      "meaning": "Aparellu ida ho lilin ka mina-rai neʼebé ita sunu atu fó naroman. Sin. lampiun."
    },
    {
      "word": "ahi-rahun,",
      "class": "Substantivu",
      "meaning": "Ai nia resin bainhira ahi han tiha ona. Sin. ahi-kadesan, ahi-uuk."
    },
    {
      "word": "ahi-suar,",
      "class": "Substantivu",
      "meaning": "Musan ki'ikoan no merin hanesan kalohan neʼebé sa'e hosi ahi."
    },
    {
      "word": "ahi-uuk,",
      "class": "Substantivu",
      "meaning": "Ai nia resin bainhira ahi han tiha ona. Sin. ahi-kadesan, ahi-rahun."
    },
    {
      "word": "ahu,",
      "class": "Substantivu",
      "meaning": "Korál nia uuk neʼebé ema uza nu'udar fertilizante, atu halo simentu no mós atu mama hodi bua malu."
    },
    {
      "word": "ahuk,",
      "class": "Substantivu",
      "meaning": "Kuak naruk no kle'an neʼebé to'os-na'in halo iha rai atu soe fini ba laran."
    },
    {
      "word": "ahu-ruin,",
      "class": "Substantivu",
      "meaning": "Animál tasi nian ne'ebé isin-ruin maka forma korál. Sin. korál."
    },
    {
      "word": "ai,",
      "class": "Interjeisaun",
      "meaning": "Hakilar hakfodak ka moras nian."
    },
    {
      "word": "ai-ameixeira,",
      "class": "Substantivu",
      "meaning": "Ai-hun espésie ida neʼebé fó fuan ameixa."
    },
    {
      "word": "ai-amendoeira,",
      "class": "Substantivu",
      "meaning": "Ai-hun espésie ida neʼebé fó amêndua."
    },
    {
      "word": "ai-ata,",
      "class": "Substantivu",
      "meaning": "Ai-fuan espésie ida neʼebé kabuar ho kulit tarak no sabór midar furak. Ai-ata nona = ai-nona."
    },
    {
      "word": "ai-aveleira,",
      "class": "Substantivu",
      "meaning": "Ai-hun espésie ida neʼebé fó fuan avelã."
    },
    {
      "word": "ai-babonuk,",
      "class": "Substantivu",
      "meaning": "Ai-hun espésie ida ho lolon boot kabuar. Naran-Botániku: Lagenaria siceraria."
    },
    {
      "word": "ai-balun,",
      "class": "Substantivu",
      "meaning": "1. Mala neʼebé halo hosi ai; uluk ema uza ai-balun hodi haloot roupa ka sasán. 2. Ai-balun hodi haloot mate molok lori ba hakoi. Sin. kaixaun."
    },
    {
      "word": "ai-baria,",
      "class": "Substantivu",
      "meaning": "Ai-nanik oin ida neʼebé fó fuan han-bele hanesan pepinu."
    },
    {
      "word": "ai-been,",
      "class": "Substantivu",
      "meaning": "1. Been neʼebé iha ai nia laran. 2. Been ida neʼebé ema uza hodi hakerek, pinta ka hakór. Sin. tinta."
    },
    {
      "word": "ai-bubur,",
      "class": "Substantivu",
      "meaning": "Ai-hun ne'ebé fó fuan boot, nia isin hanesan paun bainhira tunu."
    },
    {
      "word": "ai-daak,",
      "class": "Substantivu",
      "meaning": "Ai ida ho sanak barak, tahan toos no buras tebetebes, neʼebé nia kulit serve ba tempra tua-mutin no nia tahan uza hodi tamun xourisu. Naran-Botániku: Schleichera oleosa."
    },
    {
      "word": "ai-diik,",
      "class": "Substantivu",
      "meaning": "Ai ida ho lolon tarak, no funan kór-mean neʼebé manu-fuik, liuliu kako'a, gosta tebetebes susu. Naran-Botániku: Erythrina."
    },
    {
      "word": "ai-dila,",
      "class": "Substantivu",
      "meaning": "Ai-hun ida hanesan akadiru neʼebé fó fuan boot kór-kinur ho isin midar no been barak. Naran-Botániku: Carica papaya."
    },
    {
      "word": "ai-dila-fatuk,",
      "class": "Substantivu",
      "meaning": "Ai-hun ida ho ai-tarak neʼebé fó fuan hanesan sabraka. Naran-Botániku: Aegle marmelos."
    },
    {
      "word": "ai-dona,",
      "class": "Substantivu",
      "meaning": "Ai neʼebé ita kaer iha ita-nia liman atu haboon ka baku ema ka balada."
    },
    {
      "word": "ai-dudun,",
      "class": "Substantivu",
      "meaning": "Tesidu mamar iha ai-lolon nia laran."
    },
    {
      "word": "ai-duir,",
      "class": "Substantivu",
      "meaning": "Silindru halo hosi ai ho kaer-fatin iha sorin-sorin, neʼebé serve atu halo kabeer masa. Sin. rolu pasteleiru."
    },
    {
      "word": "ai-farina,",
      "class": "Substantivu",
      "meaning": "Ai-han ida neʼebé nia isin naruk moris iha rai okos, no nia tahan serve atu halo modo."
    },
    {
      "word": "ai-fuan,",
      "class": "Substantivu",
      "meaning": "Produtu ai-hun nian, baibain kabuar, ho been no musan iha laran."
    },
    {
      "word": "ai-fukar,",
      "class": "Substantivu",
      "meaning": "Buat sira hanesan masin, pimenta, du'ut-morin, liis, nst. neʼebé tau ba hahán atubele halo morin, midar ka iha gostu. Sin. tempra, temperu."
    },
    {
      "word": "ai-habit,",
      "class": "Substantivu",
      "meaning": "Ai rua kesi hamutuk neʼebé ita bele uza hodi habit sasán."
    },
    {
      "word": "ai-hahoris,",
      "class": "Substantivu",
      "meaning": "Ai-horis ki'ikoan ida neʼebé foin moris hosi fini."
    },
    {
      "word": "ai-hali,",
      "class": "Substantivu",
      "meaning": "Ai-hun ida neʼebé iha lolon boot tebetebes ho abut barak sai, tahan barak, no mós fuan neʼebé manu-fuik no niki gosta han. Ai-hali ne'e parazita, katak bele moris iha ai seluk nia leten. Naran-Botániku: Ficus urostigma."
    },
    {
      "word": "ai-han,",
      "class": "Substantivu",
      "meaning": "Ai-fuan, modo ka na'an ne'ebé ema no balada sira bele han, neʼebé sira-nia isin presiza atubele moris badadaun no hetan saúde. Sin. hahán, alimentu."
    },
    {
      "word": "ai-horis,",
      "class": "Substantivu",
      "meaning": "Buat moris ida neʼebé hahú hosi fini kuda iha rai; fini ne'e, naboot hodi hahoris abut, kain, sanak no tahan. Ai-horis balu fó mós fuan. Sin. planta."
    },
    {
      "word": "ai-hun,",
      "class": "Substantivu",
      "meaning": "1. Ai-horis boot nia parte kraik. 2. Fatin neʼebé ema hela ka toba bá. Sin. hakmahan-fatin."
    },
    {
      "word": "ai-kabelak,",
      "class": "Substantivu",
      "meaning": "Ai tetuk no luan ida, baibain kuadrradu ka retángulu, neʼebé ema kadoda hodi halo uma ka movel ruma."
    },
    {
      "word": "ai-kadiru,",
      "class": "Substantivu",
      "meaning": "haree akadiru."
    },
    {
      "word": "ai-kakeu,",
      "class": "Substantivu",
      "meaning": "haree kakeu."
    },
    {
      "word": "ai-kakokur,",
      "class": "Substantivu",
      "meaning": "Besi-riin latár ida iha eskada nian neʼebé ema kaer hodi sa'e ka tun atu labele monu. Sin. korrimaun."
    },
    {
      "word": "ai-kala,",
      "class": "Substantivu",
      "meaning": "Ai-hun ida ho ai-funan mutin neʼebé ema bele han. Sin. ai-turi. Naran-Botániku: Sesbania grandiflora."
    },
    {
      "word": "ai-kalesi,",
      "class": "Substantivu",
      "meaning": "haree kalesi."
    },
    {
      "word": "ai-kameli,",
      "class": "Substantivu",
      "meaning": "haree kameli."
    },
    {
      "word": "ai-kamii,",
      "class": "Substantivu",
      "meaning": "haree kamii."
    },
    {
      "word": "ai-kasi,",
      "class": "Substantivu",
      "meaning": "Ai-hun espésie ida neʼebé nia tahan hanesan ai-samatuku fuik nian, maibé ninia funan mean. Naran-Botániku: Acacia."
    },
    {
      "word": "ai-kesak,",
      "class": "Substantivu",
      "meaning": "Ai-rohan ki'ik ida ko'a halo lotuk no naruk, hodi sukit nehan. Sin. palitu, ai-sukit-nehan."
    },
    {
      "word": "ai-kladik,",
      "class": "Substantivu",
      "meaning": "Ai-lolon boot no naruk neʼebé ema tesi tiha ona hodi hasai nia sanak sira. Sin. ai-knotak."
    },
    {
      "word": "ai-knaar,",
      "class": "Substantivu",
      "meaning": "Instrumentu ida neʼebé halo hosi kesak, tua-metan kulit ka plástiku neʼebé uza hodi dasa ai-tahan maran ka fo'er iha rai."
    },
    {
      "word": "ai-knanoik,",
      "class": "Substantivu",
      "meaning": "Haktuir ida neʼebé ema inventa ka konta ba ema seluk, liuliu haktuir tradisionál. Sin. istória, kontu."
    },
    {
      "word": "ai-knotak,",
      "class": "Substantivu",
      "meaning": "Ai-lolon boot no naruk neʼebé ema tesi tiha ona hodi hasai nia sanak sira. Sin. ai-kladik."
    },
    {
      "word": "ai-kulit,",
      "class": "Substantivu",
      "meaning": "Kulit neʼebé taka ai nia isin."
    },
    {
      "word": "ai-kusan,",
      "class": "Substantivu",
      "meaning": "Ai ida neʼebé ema prega ka hedi odamatan, meza ka janela envezde pregu ka besi-kusan."
    },
    {
      "word": "ai-laknabit,",
      "class": "Substantivu",
      "meaning": "Instrumentu ki'ik ida ho hasan metál no kaer-fatin rua neʼebé serve ba ku'u hodi foti buat ki'ik sira neʼebé metin hela. Sin. besi-laknabit, ai-kaku'uk, pinsa."
    },
    {
      "word": "ai-laran,",
      "class": "Substantivu",
      "meaning": "1. Fatin luan boot ida ho ai-hun barak moris hamutuk. Ez. Baibain nakukun uitoan iha ai-laran tanba ai-leten sira satan loro-naroman. 2. Zona neʼebé la iha mahorik. Sin. interiór, foho."
    },
    {
      "word": "ai-lele,",
      "class": "Substantivu",
      "meaning": "Ai-hun espésie ida neʼebé fó fuan ho materiál hanesan kabas iha laran. Naran-Botániku: Ceiba pentandra."
    },
    {
      "word": "ai-leten,",
      "class": "Substantivu",
      "meaning": "Ai-hun nia parte leten nian."
    },
    {
      "word": "ai-lia,",
      "class": "Substantivu",
      "meaning": "Ai-abut ida ho sente morin no manas uitoan neʼebé uza atu tempra hahán no mós atu prepara ai-moruk oioin. Naran-Botániku: Zingiber."
    },
    {
      "word": "ai-lolon,",
      "class": "Substantivu",
      "meaning": "Parte ai-hun nian entre ai-abut no ai-sorun. Ez. Nehek iha ai-lolon barak loos."
    },
    {
      "word": "ai-manas,",
      "class": "Substantivu",
      "meaning": "1. Ai-horis ida neʼebé moris mesak ka ema kuda iha kanteiru, fuan lotuk naruk, sente manas bainhira ita tau ba ibun, no kahur ho masin, liis, nst. hodi halo budu. 2. Budu halo ho ai-manas."
    },
    {
      "word": "ai-maran,",
      "class": "Substantivu",
      "meaning": "Ai-sanak neʼebé maran ona no ema hili atu sunu. Sin. ai-mate."
    },
    {
      "word": "ai-metin,",
      "class": "Substantivu",
      "meaning": "Kualkér ai-horis ida neʼebé kraik no nia tahan barak nia merin."
    },
    {
      "word": "ai-morin,",
      "class": "Substantivu",
      "meaning": "Ai-hun espésie ida ne'ebé nia ai morin tebetebes no folin-boot. Ai-hun furak ne'e uluk moris barak iha distritu Same, Lospalos, Suai no Bobonaru. Sin. kameli, ai-kameli. Naran-Botániku: Santalum."
    },
    {
      "word": "ai-moruk,",
      "class": "Substantivu",
      "meaning": "Substánsia kímika neʼebé ema hemu hodi kura nia moras. Sin. medikamentu."
    },
    {
      "word": "ain,",
      "class": "Substantivu",
      "meaning": "1. Isin-balun kraik nian neʼebé tulun ema ka animál atu hamriik no la'o. 2. Buat ida nia tatanek ka suporte ho forma ain nian. Ez. Meza nia ain ida tohar hela."
    },
    {
      "word": "ain-aat,",
      "class": "Adjetivu",
      "meaning": "Neʼebé presiza ho ai-tonka atubele la'o. Sin. kude'ik."
    },
    {
      "word": "ai-nanik,",
      "class": "Substantivu",
      "meaning": "Ai-horis ida neʼebé sa'e dolar tuir ai, rai ka fatuk leten. Sin. ai-talik."
    },
    {
      "word": "Ainaru,",
      "class": "Substantivu",
      "meaning": "Vila no munisípiu ida iha tasimane besik Same no Maubisse."
    },
    {
      "word": "ain-badak,",
      "class": "Adjetivu",
      "meaning": "Neʼebé nia estatura badak. Liafuan-sorun: ain-aas; Sin. mautuuk (m.), buituuk (f.)."
    },
    {
      "word": "ain-bisa,",
      "class": "Substantivu",
      "meaning": "Sente katar maka'as iha ain laran neʼebé halo susar atu la'o, liuliu bainhira ita kleur ona la book ain ne'e. Sin. ain-kabisan, ain-naknei, bisa-han."
    },
    {
      "word": "ain-fatin,",
      "class": "Substantivu",
      "meaning": "1. Forma hanesan lalatak neʼebé ain husik hela iha rai bainhira sama no foti fali. Sin. pegada. 2. (Arti tuan) Ida neʼebé ema hatais ka tau ba ain atubele proteje hosi objetu kro'at sira. Sin. sapatu."
    },
    {
      "word": "ain-kabisan,",
      "class": "Substantivu",
      "meaning": "Sente katar maka'as iha ain laran neʼebé halo susar atu la'o, liuliu bainhira ita kleur ona la book ain ne'e. Sin. ain-bisa, ain-naknei."
    },
    {
      "word": "ain-kelen,",
      "class": "Substantivu",
      "meaning": "Parte ain entre ain-tuur no ain-tuban."
    },
    {
      "word": "ain-kloor,",
      "class": "Substantivu",
      "meaning": "Ain-tuur nia kotuk-laran."
    },
    {
      "word": "ai-knotak,",
      "class": "Substantivu",
      "meaning": "Ai-pedasuk boot no naruk neʼebé tesi ka monu latan hela iha rai."
    },
    {
      "word": "ain-kukun,",
      "class": "Substantivu",
      "meaning": "Tahan mihis toos iha ema ka balada nia ain-fuan tutun."
    },
    {
      "word": "ain-liras,",
      "class": "Substantivu",
      "meaning": "Fukun kabuar ida neʼebé tutan ain-lulun ba ain-tanen li'ur. Sin. ain-tuban."
    },
    {
      "word": "ain-motur,",
      "class": "Substantivu",
      "meaning": "Moras ida neʼebé halo ema nia ain bubu sai boot liu ain normál. Sin. ain-potis, elefantíaze."
    },
    {
      "word": "ain-naknei,",
      "class": "Substantivu",
      "meaning": "Sente katar maka'as iha ain laran neʼebé halo susar atu la'o, liuliu bainhira ita kleur ona la book ain ne'e. Sin. ain-kabisan, ain-bisa."
    },
    {
      "word": "ai-nona,",
      "class": "Substantivu",
      "meaning": "Ai-horis ida neʼebé fó fuan ho isin mutin no musan metan, liuliu iha tempu-udan. Sin. nona, ai-ata nona."
    },
    {
      "word": "ain-potis,",
      "class": "Substantivu",
      "meaning": "Moras ida neʼebé halo ema nia ain bubu sai boot liu ain normál. Sin. ain-motur, elefantíaze."
    },
    {
      "word": "ain-tanan,",
      "class": "Adjetivu",
      "meaning": "Neʼebé la hatais sapatu ka xinelus."
    },
    {
      "word": "ain-tuban,",
      "class": "Substantivu",
      "meaning": "Fukun kabuar ida neʼebé tutan ain-lulun ba ain-tanen li'ur. Sin. ain-liras."
    },
    {
      "word": "ain-tuur,",
      "class": "Substantivu",
      "meaning": "Fukun iha ain iha kidan no ain-tuban nia leet, iha ain-kloor nia kotuk. Ita hakle'uk ita-nia ain-tuur atubele hakne'ak ka tuku tuur."
    },
    {
      "word": "ai-oan,",
      "class": "Substantivu",
      "meaning": "Ai-musan neʼebé monu ba rai nakfera moris sai fali ai-horis ki'ikoan."
    },
    {
      "word": "aipu,",
      "class": "Substantivu",
      "meaning": "Tipu salsa ho kain luan no naruk neʼebé ema kuda hodi uza nu'udar temperu oin ida. Sin. salsa-boot, salsa manu-kelen."
    },
    {
      "word": "ai-rahun,",
      "class": "Substantivu",
      "meaning": "Ai neʼebé lahuk ona ka ita kadoda nia uut barak."
    },
    {
      "word": "ai-raruut,",
      "class": "Substantivu",
      "meaning": "Ai-horis ida ho abut neʼebé fó bare han-bele hanesan ai-farina. Sin. labuta. Naran-Botániku: Maranta arundinacea."
    },
    {
      "word": "ai-riin,",
      "class": "Substantivu",
      "meaning": "1. Ai-lolon ida neʼebé ema hanuda iha rai hodi hamriik. 2. Ai-lolon neʼebé tane hariin ruma hanesan uma-kakuluk."
    },
    {
      "word": "ai-saar,",
      "class": "Substantivu",
      "meaning": "Instrumentu neʼebé halo hosi kesak, tua-metan kulit ka plástiku neʼebé uza atu hodi dasa rai."
    },
    {
      "word": "ai-sanak,",
      "class": "Substantivu",
      "meaning": "Kain neʼebé moris sai hosi ai-lolon ka ai-sorun neʼebé tahan sira kaer bá."
    },
    {
      "word": "ai-sasiik,",
      "class": "Substantivu",
      "meaning": "Jogu ida kona-ba hanoin to'ok buat neʼebé ita la hatene maibé ema seluk ruma mak hatene. Ez. Manu mantolun dala ida tolun barak loos. Katak ró lian dala ida iha tasi-ibun hatún ema barak loos."
    },
    {
      "word": "aisberge,",
      "class": "Substantivu",
      "meaning": "Foho-jelu ida neʼebé namlele iha tasi."
    },
    {
      "word": "ai-selat,",
      "class": "Substantivu",
      "meaning": "Buat ida ne'ebé ita hatama ka sokar ba fatin kloot ida. Sin. ai-seti, kalsu."
    },
    {
      "word": "ai-seti,",
      "class": "Substantivu",
      "meaning": "Buat ida neʼebé ita hatama ka sokar ba fatin kloot ida. Sin. ai-selat, kalsu."
    },
    {
      "word": "ai-suak,",
      "class": "Substantivu",
      "meaning": "Besi ida ne'ebé meik iha nia tutun ne'ebé ema kaer hodi ke'e rai, liuliu atu ke'e fehuk, ai-farina ka talas."
    },
    {
      "word": "ai-sukit-nehan,",
      "class": "Substantivu",
      "meaning": "Ai-rohan ki'ik ida ko'a halo lotuk no naruk, hodi sukit nehan. Sin. palitu, ai-kesak."
    },
    {
      "word": "ai-suku,",
      "class": "Substantivu",
      "meaning": "1. Instrumentu ho rohan meik tolu ka haat neʼebé ema uza atu suku hodi foti ai-han ka sasán seluk. Sin. garfu. 2. Ai-hun aas ida neʼebé fó ai-funan kinur neʼebé bukáe. Sin. ai-lalima. Naran-Botániku: Cassia fistula."
    },
    {
      "word": "ai-sulu,",
      "class": "Substantivu",
      "meaning": "Ai ida neʼebé ita sunu nia rohan atu fó naroman. Sin. sasulu, ahi-masa."
    },
    {
      "word": "ai-tahan,",
      "class": "Substantivu",
      "meaning": "1. Parte matak no tetuk ai nian, neʼebé moris sai hosi sanak. 2. Modo-tahan. 3. Ema ida nia hahalok ka modun oinsá nia hato'o ba ema sira. Sin. maneira. Ez. Ema ne'e nia ai-tahan aat, tanba ne'e mak ami la konvida nia ba festa."
    },
    {
      "word": "ai-tali,",
      "class": "Substantivu",
      "meaning": "Ai-hun espésie ida neʼebé fó bebak atu halo uma nst. Naran-Botániku: Corypha utan."
    },
    {
      "word": "ai-talik,",
      "class": "Substantivu",
      "meaning": "Ai-horis ida ne'ebé sa'e dolar tuir ai, rai ka fatuk leten. Sin. ai-nanik."
    },
    {
      "word": "ai-tara,",
      "class": "Substantivu",
      "meaning": "Fatin ida ho aparellu hodi tara kondenadu ida to'o mate. Sin. patíbulu."
    },
    {
      "word": "ai-tarak,",
      "class": "Substantivu",
      "meaning": "Pontu meik neʼebé moris iha ai-kain balu, n.e., ai-look no ai-funan roza, no bele sona ita-nia ain, liman ka isin hodi halo kanek."
    },
    {
      "word": "ai-tato'an,",
      "class": "Substantivu",
      "meaning": "Ai-tonka, baibain rua, neʼebé ema ain-aat kaer iha kalilin hodi tulun nia la'o. Sin. muleta."
    },
    {
      "word": "Aití,",
      "class": "Substantivu",
      "meaning": "haree Haití."
    },
    {
      "word": "aitianu,",
      "class": "Substantivu | Adjetivu",
      "meaning": "haree haitianu."
    },
    {
      "word": "ai-tonka,",
      "class": "Substantivu",
      "meaning": "Ai naruk no metin neʼebé katuas-ferik ka ema moras kaer no sadere bá atubele la'o ka sa'e rai-lolon."
    },
    {
      "word": "ai-tubun,",
      "class": "Substantivu",
      "meaning": "Ai-delun kabuar no metin ida neʼebé moris iha ai-sanak ka kain nia rohan no kleur-kleur loke hodi sai funan. Sin. ai-tubuk."
    },
    {
      "word": "ai-turi,",
      "class": "Substantivu",
      "meaning": "haree turi."
    },
    {
      "word": "ai-tutun,",
      "class": "Substantivu",
      "meaning": "Ai nia pontu leten liu."
    },
    {
      "word": "ajénsia,",
      "class": "Substantivu",
      "meaning": "Empreza ka governu nia sanak ida ne'ebé oferese servisu oioin ba públiku, n.e., trata billete ba viajen, fó karta-kondusaun, surat ka lisensa oioin."
    },
    {
      "word": "ajente,",
      "class": "Substantivu",
      "meaning": "Ema ida neʼebé trata asuntu ka halo kontratu ho empreza ka organizasaun ruma nia naran. Ajente sekretu ne'e mauhuu ka espiaun."
    },
    {
      "word": "ajuda,",
      "class": "Verbu | Substantivu",
      "meaning": "Verbu: Halo buat ruma neʼebé halo kmaan ema seluk nia nahan ka knaar, ka hasai nia hosi susar ka laran-rua. Substantivu: Hahalok ajuda nian. Sin. tulun. Ez. Ha'u la komprende liafuan ida-ne'e. Bele ajuda ha'u?"
    },
    {
      "word": "ajudadór,",
      "class": "Adjetivu | Substantivu",
      "meaning": "(Ema) neʼebé gosta fó ajuda."
    },
    {
      "word": "ajuda-na'in,",
      "class": "Substantivu",
      "meaning": "Ema neʼebé ajuda. Sin. maktulun, ajudante."
    },
    {
      "word": "ajudante,",
      "class": "Substantivu",
      "meaning": "1. Ema neʼebé ajuda. Sin. maktulun, ajuda-na'in. 2. Ema-mane neʼebé serbí amlulik iha altár bainhira nia reza misa."
    },
    {
      "word": "ajusta,",
      "class": "Verbu",
      "meaning": "Muda ka hadi'a uitoan buat ruma atu halo sai natoon ba buat seluk."
    },
    {
      "word": "ajuste,",
      "class": "Substantivu",
      "meaning": "Hahalok ajusta nian."
    },
    {
      "word": "akaba,",
      "class": "Verbu | Substantivu",
      "meaning": "Remata, halo hotu, liuliu estudu sira."
    },
    {
      "word": "akadémia,",
      "class": "Substantivu",
      "meaning": "1. Eskola aas ka koléjiu neʼebé baibain espesializa iha dixiplina ida de'it, ka fó formasaun ba karreira ida. Ez. Iha sidade boot ne'e iha akadémia oioin: múzika nian, dansa nian, dezeñu nian no polísia nian. 2. Sosiedade sientífika, literária ka artístika neʼebé fó sai publikasaun oioin. Sin. institutu."
    },
    {
      "word": "akadémiku - akadémika, f.",
      "class": "Adjetivu | Substantivu",
      "meaning": "Adjetivu: 1. Akadémia nian. 2. Universidade nian. 3. Kona-ba hakbiit sientífiku ka peskiza neʼebé ema hala'o iha universidade. Substantivu: Ema eskola-boot neʼebé hanorin no hala'o peskiza oioin iha akadémia ka universidade."
    },
    {
      "word": "akadiru,",
      "class": "Substantivu",
      "meaning": "Tali-hun espésie ida ho uzu barak: ho ninia ai ema sira halo uma, mobília, instrumentu muzikál, biti, ta'an, xapeu, surat-tahan nst. Ninia been ema bele hemu ka uza atu halo tua. Naran-Botániku: Borassus flabellifer. Sin. ai-kadiru."
    },
    {
      "word": "akar,",
      "class": "Substantivu",
      "meaning": "Ai-tali ka ai-rumbia nia isin neʼebé baibain ema taa atubele fase no han."
    },
    {
      "word": "ákaru,",
      "class": "Substantivu",
      "meaning": "Kutun ka insetu melek ida hanesan katuma ki'ikoan neʼebé ita la bele haree-hetan; nia subar iha hatais, kapote no kolxaun hodi halo ema me'ar no matan-been suli."
    },
    {
      "word": "akarisida,",
      "class": "Substantivu",
      "meaning": "Ai-moruk atu oho ákaru; baibain iha kaleen laran atu rega ba roupa ka kolxaun."
    },
    {
      "word": "akesedór,",
      "class": "Substantivu",
      "meaning": "Aparellu ida neʼebé hamanas uma-laran bainhira rai-malirin. Sin. mahanas."
    },
    {
      "word": "akesimentu,",
      "class": "Substantivu",
      "meaning": "Hahalok hamanas nian; ezersísiu isin-manas nian."
    },
    {
      "word": "akólitu,",
      "class": "Substantivu",
      "meaning": "1. Ajudante misa nian. 2. Orden menór iha ritu romanu tradisionál, neʼebé seminarista simu molok sai subdiákonu. 3. (Figuradu) Ema ne'ebé tuir ema boot ruma hanesan nia atan. Sin. maktuir, lakaiu."
    },
    {
      "word": "akompaña,",
      "class": "Verbu",
      "meaning": "La'o ho, la'o tuir. Sin. hamaluk."
    },
    {
      "word": "akonsella,",
      "class": "Verbu",
      "meaning": "Fó konsellu. Sin. hakno'i."
    },
    {
      "word": "akonsellamentu,",
      "class": "Substantivu",
      "meaning": "Hahalok akonsella nian."
    },
    {
      "word": "akonselladór - akonselladora, f.",
      "class": "Substantivu",
      "meaning": "Ema neʼebé fó konsellu, mós nu'udar nia serbisu baibain nian."
    },
    {
      "word": "akontese,",
      "class": "Verbu",
      "meaning": "Mosu kedas; mosu derrepente. Sin. mosu, susede. Ez. Akontese asidente karreta fakar ema iha subaun semana kotuk; mate naʼin-rua, kanek barak bá ospitál."
    },
    {
      "word": "akontesimentu,",
      "class": "Substantivu",
      "meaning": "Hahalok ne'ebé akontese. Sin. mamosuk, eventu."
    },
    {
      "word": "akorde,",
      "class": "Substantivu",
      "meaning": "Grupu nota muzikál neʼebé ema toka hamutuk, ka koru hananu hamutuk."
    },
    {
      "word": "akordeon,",
      "class": "Substantivu",
      "meaning": "Instrumentu múzika lori-bele ida ho tekladu no botaun oioin."
    },
    {
      "word": "akordeonista,",
      "class": "Substantivu",
      "meaning": "Ema neʼebé toka akordeon. Sin. tokadór-akordeon, maktoka-akordeon."
    },
    {
      "word": "akordu,",
      "class": "Substantivu",
      "meaning": "Hahalok hatán malu, dehan nune'e kona-ba buat ruma. Sin. lia-kotun. Ez. Iha akordu ida entre Timór no Indonézia kona-ba fronteira."
    },
    {
      "word": "akríliku,",
      "class": "Substantivu | Adjetivu",
      "meaning": "(Neʼebé halo hosi) fulun sintétiku ka artifisiál ida neʼebé bele troka bibi-fulun hodi halo faru-manas nst."
    },
    {
      "word": "akrobasia,",
      "class": "Substantivu",
      "meaning": "Jogu jinástiku oioin neʼebé ema sira halo iha sirku laran hodi habrani públiku."
    },
    {
      "word": "akrobátiku - akrobátika, f.",
      "class": "Adjetivu",
      "meaning": "Kona-ba akrobasia."
    },
    {
      "word": "akrobata,",
      "class": "Substantivu | Adjetivu",
      "meaning": "Ema ida neʼebé halo akrobasia."
    },
    {
      "word": "akuáriu,",
      "class": "Substantivu",
      "meaning": "Tanke halo hosi vidru hodi rai ikan sira, liuliu ikan furak sira neʼebé ema gosta hateke bá."
    },
    {
      "word": "akumulasaun,",
      "class": "Substantivu",
      "meaning": "Hahalok habou nian. Sin. habou."
    },
    {
      "word": "akupuntura,",
      "class": "Substantivu",
      "meaning": "Babalik ka tratamentu médiku iha neʼebé ema kura moras hodi hatama da'un mihis uitoan ba pasiente nia kulit. Ez. Lalika tauk akupuntura, tanba babalik ne'e moras-laek."
    },
    {
      "word": "akupunturista,",
      "class": "Substantivu",
      "meaning": "Ema ne'ebé halo akupuntura."
    },
    {
      "word": "akústika,",
      "class": "Substantivu",
      "meaning": "Estrutura kuartu ida nian, neʼebé bele haboot ka haki'ik son sira neʼebé ita rona iha laran."
    },
    {
      "word": "akústiku - akústika, f.",
      "class": "Adjetivu",
      "meaning": "Kona-ba son ka rona."
    },
    {
      "word": "akuza,",
      "class": "Verbu",
      "meaning": "Dehan, lahó prova metin, katak ema ida halo sala ka hahalok aat ruma. Sin. duu."
    },
    {
      "word": "akuzadór - akuzadora, f.",
      "class": "Substantivu",
      "meaning": "Ema neʼebé akuza. Sin. makduu."
    },
    {
      "word": "akuzadu - akuzada, f.",
      "class": "Adjetivu | Substantivu",
      "meaning": "(Ema) neʼebé hetan akuzasaun ka duun. Sin. ema duun."
    },
    {
      "word": "akuzasaun,",
      "class": "Substantivu",
      "meaning": "Hahalok akuza nian. Sin. duun."
    },
    {
      "word": "akuzatóriu - akuzatória, f.",
      "class": "Adjetivu",
      "meaning": "Neʼebé akuza. Sin. makduu."
    },
    {
      "word": "alarmante,",
      "class": "Adjetivu",
      "meaning": "Neʼebé halo ita laran-ta'uk ka nakdedar kona-ba perigu ruma."
    },
    {
      "word": "alarme,",
      "class": "Substantivu",
      "meaning": "1. Sinál atu fó-hatene katak perigu ruma besik mai ona. Sin. tuhin. Ez. Ohin loron iha alarme eletróniku oin barak. 2. Laran-ta'uk ka nakdedar kona-ba perigu ruma."
    },
    {
      "word": "alarma,",
      "class": "Verbu",
      "meaning": "Hamosu alarme; halo ema laran-ta'uk."
    },
    {
      "word": "Alas,",
      "class": "Substantivu",
      "meaning": "Postu administrativu ida iha munisípiu Manufahi nian."
    },
    {
      "word": "albanés - albaneza, f.",
      "class": "Adjetivu | Substantivu",
      "meaning": "Adjetivu: Rai-Albánia nian. Substantivu: 1. Ema Albánia. 2. (Lia-albanés) Dalen rai-Albánia no rai-Kozovu nian."
    },
    {
      "word": "Albánia (rai-),",
      "class": "Substantivu",
      "meaning": "Rain no estadu ki'ik iha Europa Lorosa'e."
    },
    {
      "word": "albinu - albina, f.",
      "class": "Substantivu",
      "meaning": "Ema neʼebé moris kedas ho kulit mutin no matan-fuan mean, nu'udar defeitu jenétiku. Sin. rai-na'in (kolokializmu)."
    },
    {
      "word": "albinizmu,",
      "class": "Substantivu",
      "meaning": "Defeitu jenétiku ne'ebé halo isin-kulit la iha pigmentasaun."
    },
    {
      "word": "albumina,",
      "class": "Substantivu",
      "meaning": "Parte mutin iha mantolun nia laran. Sin. mantolun-mutin."
    },
    {
      "word": "albun,",
      "class": "Substantivu",
      "meaning": "Livru boot ida atu tau fotografia, selu ka rekorte sira neʼebé ita hakarak rai."
    },
    {
      "word": "alega,",
      "class": "Verbu",
      "meaning": "Duu ka akuza lahó prova metin ida. Sin. haduu."
    },
    {
      "word": "alegasaun,",
      "class": "Substantivu",
      "meaning": "Hahalok alega nian. Sin. haduun."
    },
    {
      "word": "alegoria,",
      "class": "Substantivu",
      "meaning": "Istória ida iha neʼebé personajen no mamosuk sira reprezenta ema no faktu sira neʼebé hakerek-na'in hakarak subar."
    },
    {
      "word": "alegóriku - alegórika, f.",
      "class": "Adjetivu",
      "meaning": "Kona-ba alegoria."
    },
    {
      "word": "alegre,",
      "class": "Adjetivu",
      "meaning": "Neʼebé rame tanba solok ka satisfasaun ruma."
    },
    {
      "word": "alegria,",
      "class": "Substantivu",
      "meaning": "Sentimentu kontente ka haksolok nian. Ez. Iha alegria bainhira ema hotu rona katak Timór hetan nia independénsia."
    },
    {
      "word": "aleijadu - aleijada, f.",
      "class": "Adjetivu",
      "meaning": "Neʼebé iha defeitu fíziku ruma hanesan matan-aat, liman-kle'uk ka ain-kude'ik, liuliu hori ki'ik kedas. Sin. burun."
    },
    {
      "word": "aleijaun,",
      "class": "Substantivu",
      "meaning": "Defeitu fíziku. Sin. baburun."
    },
    {
      "word": "aleluia,",
      "class": "Substantivu",
      "meaning": "Kantu litúrjiku ida neʼebé katak “Hahi'i Na'i Maromak bá”."
    },
    {
      "word": "Alemaña (rai-),",
      "class": "Substantivu",
      "meaning": "Rain no estadu boot iha Europa Klaran."
    },
    {
      "word": "alemaun - alemá, f.",
      "class": "Adjetivu | Substantivu",
      "meaning": "Adjetivu: Rai-Alemaña nian. Substantivu: 1. Ema Alemaña. 2. (Lia-alemaun) Dalen rai-Alemaña nian, neʼebé lian ofisiál mós iha rai-Áustria, rai-Suisa no rai-Luxemburgu."
    },
    {
      "word": "alerjia,",
      "class": "Substantivu",
      "meaning": "Reasaun aat ka moras neʼebé mosu kedas bainhira ita han ai-han ruma, horon ai-funan balu, ka bainhira balada ka insetu ruma tata ita."
    },
    {
      "word": "alérjiku - alérjika, f.",
      "class": "Adjetivu",
      "meaning": "Ne'ebé iha alerjia ka kauza alerjia."
    },
    {
      "word": "alfabetiza,",
      "class": "Verbu",
      "meaning": "Hanorin atu lee no hakerek."
    },
    {
      "word": "alfabetizasaun,",
      "class": "Substantivu",
      "meaning": "Hahalok alfabetiza nian. Sin. literasia."
    },
    {
      "word": "alfabetizadu - alfabetizada, f.",
      "class": "Adjetivu",
      "meaning": "Neʼebé aprende tiha ona lee no hakerek."
    },
    {
      "word": "alfabetu,",
      "class": "Substantivu",
      "meaning": "Letra ka sinál-hakerek sira neʼebé ema uza hodi hakerek dalen ida. Sin. abesé. Ez. Labarik sira hatene ona alfabetu hosi letra A to'o Z."
    },
    {
      "word": "alfabétiku - alfabétika, f.",
      "class": "Adjetivu",
      "meaning": "Tuir órden alfabetu nian."
    },
    {
      "word": "alfaiate,",
      "class": "Substantivu",
      "meaning": "Ema-mane neʼebé manán moris ho suku roupa ba ema sira hatais. Sin. badain-faru, badain-suku."
    },
    {
      "word": "alfándega,",
      "class": "Substantivu",
      "meaning": "Repartisaun fiskál governu nian iha ponte-kais ka aeroportu neʼebé fihir sasán sira neʼebé ema sira hatama ba rain ida hodi fa'an."
    },
    {
      "word": "alfandegáriu - alfandegária, f.",
      "class": "Adjetivu",
      "meaning": "Kona-ba alfándega."
    },
    {
      "word": "alfase,",
      "class": "Substantivu",
      "meaning": "Modo-tahan ida neʼebé uza liuliu halo salada."
    },
    {
      "word": "alfazema,",
      "class": "Substantivu",
      "meaning": "Ai-horis ida neʼebé fó funan kór violeta no morin tebetebes. Iha mina-morin oioin halo hosi alfazema-funan. Naran-Botániku: Lavandula."
    },
    {
      "word": "alferes,",
      "class": "Substantivu",
      "meaning": "Postu ida iha ezérsitu, neʼebé uluk ba tenente no tuir aspirante."
    },
    {
      "word": "alfinete,",
      "class": "Substantivu",
      "meaning": "Arame-oan ida silu-kle'uk ho tilun atu haka'it metin faru, liuliu kabaia, bainhira hakarak sai ba fatin ruma."
    },
    {

      "word": "erudisaun,",
      "class": "Substantivu",
      "meaning": "Matenek-boot kona-ba dixiplina ruma."
    },
    {
      "word": "eruditu, -a f.",
      "class": "Adjetivu",
      "meaning": "Neʼebé hatene barak no kle'an tanba halo tiha ona estudu barak, liuliu iha universidade. Sin. eskola-boot, matenek-boot."
    },
    {
      "word": "ervilla,",
      "class": "Substantivu",
      "meaning": "Ai-horis han-belek ida hanesan ai-turi neʼebé fó kakun ho musan ki'ik latar ida iha laran."
    },
    {
      "word": "ese,",
      "class": "Substantivu",
      "meaning": "Letra 'S, s' nia naran."
    },
    {
      "word": "esénsia,",
      "class": "Substantivu",
      "meaning": "1. Buat ida nia nun, parte importante liu. Ez. Problema ida-ne'e nia esénsia mak ema tenke rona malu atu la bele mosu konfuzaun. 2. Mina hosi ai-fuan ka modo, neʼebé uza atu hafurak hahán ka atu halo mina-morin ka ai-moruk."
    },
    {
      "word": "esensiál,",
      "class": "Adjetivu",
      "meaning": "1. Hun nian. Sin. báziku, fundamentál. 2. Neʼebé presiza tebes duni. Ez. Bee esensiál ba ita ema nia moris."
    },
    {
      "word": "esfera,",
      "class": "Substantivu",
      "meaning": "1. Forma ka hahúk jeométriku hanesan bola, neʼebé nia pontu li'ur hotu-hotu dook hanesan hosi nia klaran. 2. Espasu ka leet luan iha lalehan, neʼebé ema sira haree hanesan le'un ka sírkulu boot ida. 3. Área ba atividade ruma. Ez. Madre Júlia kleur ona serbisu iha esfera katekeze nian."
    },
    {
      "word": "esfériku, -a f.",
      "class": "Adjetivu",
      "meaning": "Ne'ebé iha forma esfera nian."
    },
    {
      "word": "esforsu,",
      "class": "Substantivu",
      "meaning": "1. Kbiit isin ka neon nian neʼebé presiza atu halo buat ruma, liuliu buat susar. 2. Hahalok tenta atu halo buat ruma. Ez. Ha'u-nia esforsu atu nani to'o iha rohan ne'ebá halo ha'u kole lahalimar."
    },
    {
      "word": "eskada,",
      "class": "Substantivu",
      "meaning": "1. Besi ho ai-riin rua naruk ho ai-riin ki'ik barak tutan sira atu ema bele sa'e ba uma-kakuluk ka ai-leten. Sin. odan. 2. Sama-fatin hada malu, halo hosi fatuk, bloku ka simentu neʼebé ema sama hodi sa'e ba leten."
    },
    {
      "word": "eskadaria,",
      "class": "Substantivu",
      "meaning": "Eskada-lubun rua ka liu hamutuk, ho teten ka patamár neʼebé tutan sira."
    },
    {
      "word": "eskada-teten,",
      "class": "Substantivu",
      "meaning": "Sama-fatin iha eskada-lubun nia leten iha odamatan nia oin ka serve ba ema neʼebé sa'e ka tun deskansa bá. Sin. patamár."
    },
    {
      "word": "eskala,",
      "class": "Substantivu",
      "meaning": "1. Nivel ka sasukat atu sukát sasán nia boot. 2. Fatin ida iha neʼebé ró-ahi ka aviaun para tempu uitoan."
    },
    {
      "word": "eskandaliza,",
      "class": "Verbu",
      "meaning": "Hahalok ne'ebé hamosu situasaun ida neʼebé halo ema hakfodak no lakon morál, liuliu bainhira ema boot hamoe komunidade ho hahalok aat neʼebé ema ida la hein."
    },
    {
      "word": "eskandalozu, -a f.",
      "class": "Adjetivu",
      "meaning": "Neʼebé eskandaliza ka fó eskándalu. Ez. Korrupsaun iha ministériu sira buat eskandalozu tebetebes."
    },
    {
      


"word": "fuza,",
      "class": "Substantivu",
      "meaning": "Nota muzikál neʼebé vale semínima ida ka ualu, ka semikolxeia balun ida. Nia tadak maka ne'e: 𝅘𝅥𝅰"
    },
    {
      "word": "fuzivel,",
      "class": "Substantivu",
      "meaning": "Fiu metáliku neʼebé aplika ba sirkuitu elétriku atu teri netik ka interrompe sirkuitu ne'e bainhira intensidade korrente nian sai maka'as demais."
    },
    {
      "word": "gaba,",
      "class": "Verbu",
      "meaning": "1. Hahi'i ema ida tanba buat di'ak ne'ebé nia halo. Ez. Bainhira André hatama tiha golu, ema hotu gaba nia. 2. Ko'alia furak hodi ezajera kona-ba ema ida nia kualidade di'ak sira atu hasolok ka hamaus nia. Sin. foti."
    },
    {
      "word": "gaba an,",
      "class": "Verbu",
      "meaning": "Ko'alia hodi foti nia an. Ez. Malandru ne'e gaba an, hafoin tuku tiha nia maluk ida seluk to'o inus raan."
    },
    {
      "word": "gaba-an, mós gabasola,",
      "class": "Adjetivu, Substantivu",
      "meaning": "Adjetivu: Neʼebé gosta foti an ka hahi'i an. Ez. Ha'u la gosta ema ne'ebé gabasola tanba dala barakliu sira bosok-teen. Substantivu: Hahalok foti an nian."
    },
    {
      "word": "Gabaun, (rai-),",
      "class": "Substantivu",
      "meaning": "Rain no estadu ida iha Áfrika Sentrál."
    },
    {
      "word": "gabonés, -eza f.",
      "class": "Adjetivu, Substantivu",
      "meaning": "Adjetivu: Rai-Gabaun nian. Substantivu: Ema Gabaun."
    },
    {
      "word": "gabardina,",
      "class": "Substantivu",
      "meaning": "Kazaku ida neʼebé ema hatais atu proteje ka satan nia an hosi udan."
    },
    {
      "word": "gaéliku,",
      "class": "Substantivu, Adjetivu",
      "meaning": "Substantivu: (lia-gaéliku) Dalen séltiku neʼebé iha variedade rua, rai-Eskósia nian no rai-Irlanda nian. Adjetivu: Lia-gaéliku nian."
    },
    {
      "word": "gaiola,",
      "class": "Substantivu",
      "meaning": "Fatin ki'ik ida halo hosi rede, kaixa ka au neʼebé uza atu rai manu ka animál fuik iha laran, hanesan loriku, kakatua, lakateu, leki, nst."
    },
    {
      "word": "gaita, mós gaita-de-boka,",
      "class": "Substantivu",
      "meaning": "Instrumentu múzika ida neʼebé uza iis ibun nian atu halo tarutu ka toka. Sin. gaita-de-boka."
    },
    {
      "word": "galáksia,",
      "class": "Substantivu",
      "meaning": "Konstelasaun ka fitun-lubun barak ne'ebé hakrobuk hamutuk. Sin. fitun-libur."
    },
    {
      "word": "galaun,",
      "class": "Substantivu",
      "meaning": "1. Hena pedasuk ida neʼebé uza atu halo dekorasaun ba kortina, nst. 2. Faixa hena-funan neʼebé uza nu'udar sinál ba ema nia postu iha sistema militár."
    },
    {
      "word": "galegu, -a f.",
      "class": "Adjetivu, Substantivu",
      "meaning": "Adjetivu: Rai-Galiza nian. Substantivu: 1. Ema Galiza. 2. (lia-galegu) Dalen rai-Galiza nian, neʼebé lia-portugés nia variedade ida."
    },
    {
      "word": "Gales, (rai-),",
      "class": "Substantivu",
      "meaning": "Rain ida iha Reinu Naklibur Bretaña Boot nia parte loromonu."
    },
    {
      "word": "galés, -eza f.",
      "class": "Adjetivu, Substantivu",
      "meaning": "Adjetivu: Rai-Gales nian. Substantivu: 1. Ema Gales. 2. (lia-galés) Dalen séltiku rai-Gales nian."
    },
    {
      "word": "Gália, (rai-),",
      "class": "Substantivu",
      "meaning": "Rejiaun tuan iha rai-Europa neʼebé nia área maizumenus hanesan ho rai-Fransa no rai-Béljika ohin nian. Iha otas antigu, Gália nasaun séltika ida, maibé hafoin, tanba funu oioin, sai parte impériu romanu nian, no lia-latín mós tama."
    },
    {
      "word": "Galileia, (rai-),",
      "class": "Substantivu",
      "meaning": "Rejiaun iha parte norte rai-Palestina nian, iha neʼebé Na'i Jezús moris no la'o haklaken Nia hanorin."
    },
    {
      "word": "galileu, -a f.",
      "class": "Adjetivu, Substantivu",
      "meaning": "Adjetivu: Rai-Galileia nian. Substantivu: Ema Galileia."
    },
    {
      "word": "galisizmu,",
      "class": "Substantivu",
      "meaning": "Liafuan ka espresaun ida neʼebé nia hun iha lia-fransés, n.e. biberón, balansé, glasé, xapeu, xantajen."
    },
    {
      "word": "Galiza, (rai-),",
      "class": "Substantivu",
      "meaning": "Rejiaun ida iha España norueste, besik rai-Portugál ho lian no kultura hanesan Portugál nian."

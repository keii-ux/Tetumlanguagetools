  {
    "word": "normalidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "normaliza",
    "class": "Verbu",
    "meaning": "Halo atu sai normál. Ez. Ita sei normaliza itania relasaun ho viziñu sira atubele serbisu lisuk."
  },
  {
    "word": "normalizasaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "norte",
    "class": "Substantivu|Adjetivu",
    "meaning": "Diresaunkahalo-lon loro-matan nian iha meiudia loloos. Bainhira ita hateke ba lorosa'e, norte mak ida neʼebé iha ita-nia liman karuk. Sin. rae, tasi-feto Liafuan-sorun: súl, loor, tasi-mane"
  },
  {
    "word": "norteamerikanu - norteamerikana, f.",
    "class": "Adjetivul Substantivu",
    "meaning": "(Ema ka mahorik) hosi rai- Amérika parte norte nian, katak Kanadá, EstaduNaklibur Sira, Méksiku no nasaun ki'ikoan sira Amérika Klarak no Tasi Antillas ninian."
  },
  {
    "word": "nortekoreanu - nortekoreana, f.",
    "class": "Adjetivu",
    "meaning": "Rai-Koreia Norte nian, hosi Koreia Norte. Substantivu Ema Koreia Norte."
  },
  {
    "word": "Noruega (rai-)",
    "class": "Substantivu",
    "meaning": "Nasaun ida iha parte norte kontinente Europa nian."
  },
  {
    "word": "noruegés - noruegeza, f.",
    "class": "Adjetivu",
    "meaning": "Rai-Norueganian. Substantivu Ema, mahorik ka lian rai-Noruega nian."
  },
  {
    "word": "norueste",
    "class": "Adjetivul Substantivu",
    "meaning": "(Kona-ba) diresaun ka pontu iha norte no loromonu (oeste) nia leet."
  },
  {
    "word": "nosaun",
    "class": "Substantivu",
    "meaning": "Ideia, hanoin (liuliu pesoál) kona-babuatruma. Sin. neonfuan"
  },
  {
    "word": "nostaljia",
    "class": "Substantivu",
    "meaning": "Laran-todan tan tempu neʼebé muda tiha ona, selae tan fatin ka ema neʼebé ita husik tiha no dook hela ona. Sin. saudades, saián Ez. Ita-nia nostaljia ba eskola-liseu halo ita hakarak fila ba tempu uluk ita sei klosan."
  },
  {
    "word": "nostáljiku - nostáljika",
    "class": "Adjetivu",
    "meaning": ""
  },
  {
    "word": "nota",
    "class": "Substantivu",
    "meaning": "1. Surat badak ida kona-ba asuntu ruma hosi ema ida. Ez. Señór Ministru fó nota ida ba nia sekretáriu kona-ba nia bainaka ne'ebé sei mai. 2. Informasaun ida neʼebé ema hakerek atulabelehaluhatiha, n.e. notasiraneʼebé estudante hakerek natoon rona profesór nia esplikasaun. Ez. Estudante labele tuur de'it iha klase, maibé tenke halo nota atubele lee filafali iha uma. 3. Rezultadu hosi estudu neʼebé estudante sira hetan bainhira hala'o tiha ezame. Ez. Tanba Jaime nia nota aat, nia la bele pasa ezame finál tinan idanée. 4. Surat-tahan-osan. 5. Sinál-múzika. Verbu 1. Haree-hetan, repara, observa; hatene kedas. 2. Halo nota, hasai nota."
  },
  {
    "word": "notáriu",
    "class": "Substantivu",
    "meaning": "Ema profisionál neʼebé prepara no rejista surat legál oioin, nu'udar ezemplu konaba fa'an no sosa uma, no kontratu seluseluk."
  },
  {
    "word": "notariál",
    "class": "Adjetivu",
    "meaning": ""
  },
  {
    "word": "notavel",
    "class": "Adjetivu",
    "meaning": "1. Neʼebé dada ita-nia atensaun. 2. Importante. Sin. naklalir, Substantivu. Emaimportante, emanaran-boot."
  },
  {
    "word": "notifika",
    "class": "Verbu",
    "meaning": "Hato'o buat ruma ba ema seluk ofisialmente no formalmente; fóhanoinatulabelehaluha. Sin. fó-hatene Ez. EDTL notifika konsumidór hotu-hotu kona-ba bainhira maka selu eletrisidade."
  },
  {
    "word": "notifikasaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "notísia",
    "class": "Substantivu",
    "meaning": "Lia-foun ida."
  },
  {
    "word": "notísias",
    "class": "Substantivu",
    "meaning": "Lia-foun sira, bele mós iha rádiu ka televizaun."
  },
  {
    "word": "notisiáriu",
    "class": "Substantivu",
    "meaning": "Informasaun ka programalia-founliuhosirádiukatelevizaun. Ez. Hau sei rona notisiáriu tuku neen nian atu hatene saida mak akontese horiohin iha Dili."
  },
  {
    "word": "noturnu - noturna, f.",
    "class": "Adjetivu",
    "meaning": "Kalan nian. Sin. kalak Substantivu. 1. (noturnu) Haheker ka kompozisaun muzikál triste uitoan. 2. (noturnu) Parte Ofísiu Divinu neʼebé amlulik no madre sira reza iha kalan."
  },
  {
    "word": "Novaiorke",
    "class": "null",
    "meaning": "haree Iorke Foun"
  },
  {
    "word": "novatu - novata, f.",
    "class": "Substantivu",
    "meaning": "Ema neʼebé sei foun hela no seidauk iha esperiénsia natoon. Sin. novisu, kalouru"
  },
  {
    "word": "novela",
    "class": "Substantivu",
    "meaning": "Istória badak ida kona-ba ema no akontesimentu sira neʼebé imajináriu."
  },
  {
    "word": "Novembru (fulan-)",
    "class": "Substantivu",
    "meaning": "Fulan dasanulu-resin-idaknianneʼebétuirfulanOutubru no uluk-ba fulan-Dezembru. Fulan- Novembru iha loron tolunulu."
  },
  {
    "word": "novena",
    "class": "Substantivu",
    "meaning": "Orasaun sira neʼebé sarani katóliku sira halo iha loron sia nia laran, atu husu tulun ba Maromak, Na'i-Feto Maria, ka santu seluseluk. Ez. Molok ezame finál, Lola halo novena loron ba Na'i-Feto Maria."
  },
  {
    "word": "novidade",
    "class": "Substantivu",
    "meaning": "1. Informasaun foun no interesante ruma neʼebé rona ka simu hosi ema ida. Sin. lia-foun 2. Buat foun."
  },
  {
    "word": "novisu - novisa, f.",
    "class": "Substantivu",
    "meaning": "1. Ema neʼebé prepara nia an atu sai amlulik, irmaun ka madre, ho hela iha konventu ka mosteiru. 2. Ema neʼebé sei foun hela no seidauk iha esperiénsia natoon. Sin. novisu, kalouru"
  },
  {
    "word": "novisiadu",
    "class": "Substantivu",
    "meaning": "Períodu iha neʼebé mane no feto sira neʼebé prepara an atu sai amlulik, irmaun ka madre."
  },
  {
    "word": "nst.",
    "class": "Abreviatura",
    "meaning": "= no seluseluk tan"
  },
  {
    "word": "nuka",
    "class": "Substantivu",
    "meaning": "Moras ho musamusan tasak no dodok; mós ida neʼebé kona parte lasan-fuan ka vajina tanba fo'er, liuliu tanba ema hetan relasaun seksuál arbiru de'it. Sin. sífilis"
  },
  {
    "word": "nukleár",
    "class": "Adjetivu",
    "meaning": "1. Núkleu nian ka klaran nian. 2. Kona-ba enerjia ne'ebé mosu bainhira átomu sira nakfahe. Ez. Ema hotu-hotu tauk ona funu nukleár."
  },
  {
    "word": "núkleu",
    "class": "Substantivu",
    "meaning": "1. Buat ida nia parte klarak ka sentrál, baibain ki'ikoan; buat ida nia hun. 2. Sélula nia parte klarak, neʼebé kontrola ninia nabokar no reprodusaun. 3. Átomu ida nia parte klarak."
  },
  {
    "word": "nulit",
    "class": "VerbulAdjetivu",
    "meaning": "(Neʼebé) belit."
  },
  {
    "word": "númeru",
    "class": "Substantivu",
    "meaning": "1. Liafuan ka símbolu neʼebé uza atu sura ka kalkula. 2. Edisaun hosi revista neʼebé fó sai kadavés, baibain tinan-tinan."
  },
  {
    "word": "numériku - numérika, f.",
    "class": "Adjetivu",
    "meaning": "numerasaun Substantivu Númeru hotuhotu iha livru ka buat seluk nia laran. Ez. Livru ida-ne'e iha numerasaun sala, katak númeru-pájina sira la tuir malu."
  },
  {
    "word": "nune'e, (mai hosi nu'u ne'e)",
    "class": "Advérbiu",
    "meaning": "1. Tanba ne'e, tan ne'e. Sin. nuneʼe. Ez. Ema balun iha kapasidade liu, nunẻ'e xefe sei selu diak sira. 2. Ho dalan ne'e, ho maneira neʼe. Ez. Nia tebe bola nune'e."
  },
  {
    "word": "nune'e ka?",
    "class": "Forma",
    "meaning": "(mós ne'e ka?) Forma ida uza atu klarifika ka husu atu repete; bele mós uza atu hatudu laranhakfodak ba buat ne'ebé ita rona."
  },
  {
    "word": "nune'e duni",
    "class": "Advérbiu",
    "meaning": "Sin, loos duni, tebes duni."
  },
  {
    "word": "nune'etiha",
    "class": "Advérbiu",
    "meaning": "Liafuan ida be uza atu hatudu konkluzaun ba hahalok neʼebé foin hatete sai bá. Sin. ne'ebe, portantu Ez. Sira haksesuk malu namanas loos to'o hirus malu. Nuneetiha sira buka malu fali hodi hadame malu."
  },
  {
    "word": "nunka",
    "class": "Advérbiu",
    "meaning": "1. La mosu iha tempu pasadu (liubá), seidauk mosu; 2. Mosu iha tempu prezente (daudaun); 3. la bele mosu iha tempu futuru/oinmai. Ez. Hau nunka hemu tua-manas, tanba halo ha'u-nia ulun moras todan."
  },
  {
    "word": "nunubete mós nununbete",
    "class": "Substantivu",
    "meaning": "1. Besi metál neʼebé serve atu kaer metin objetu oioin. Sin. tornu mekániku 2. Besi-kakatua."
  },
  {
    "word": "nunun",
    "class": "Substantivu",
    "meaning": "1. Ibun tomak, hamutuk ho ibun-kulit. 2. Ibun-kulit de'it."
  },
  {
    "word": "nunun-rahun",
    "class": "Substantivu",
    "meaning": "Fulunneʼebémoris iha ibun kraik."
  },
  {
    "word": "nurak",
    "class": "Adjetivu",
    "meaning": "1. Neʼebé seidauk moris naruk no seidauk boot. 2. (Feto) neʼebé foin ko'us, ka foin tuur ahi. 3. Neʼebé seidauk tasak. 4. Ho kór naroman, n.e. kinur nurak."
  },
  {
    "word": "nusa",
    "class": "Substantivu",
    "meaning": "Rai baluk ida neʼebé tasi hale'u. Sin. rai-kotun, illa Ez. NusaAtaúru hela iha parte norte sidade Dili."
  },
  {
    "word": "nusa-kadoek",
    "class": "Substantivu",
    "meaning": "Illa ka nusa barak rabat malu hodi forma latar ka liña ida; nusa-lubun ka arkipélagu naruk. Ez. Nusa-kadoek Nautónia nian hakohak rai-kotun hotu-hotu ne'ebé nakfati iha rai- Kisar no rai-Kei nia leet."
  },
  {
    "word": "nusa-lubun",
    "class": "Substantivu",
    "meaning": "Nusa ka raikotun lubun ida. Sin. arkipélagu Ez. Rai-Timór halo parte Nusa-Lubun Malaiu."
  },
  {
    "word": "nusa-oan",
    "class": "Substantivu",
    "meaning": "Nusa ki'ik, rai-kotun ki'ik. Ez. Rai-Jaku nusa-oan ida iha lorosa'e, besik Tutuala."
  },
  {
    "word": "nusar",
    "class": "Substantivu",
    "meaning": "Nusa ka raikotun rua ka liu. Plurál tuan neʼebé uza iha naran jeográfikuoioin, n.e. Nusar Banda, Nusar Kei, Nusar Asores. / (Verbu): haree nahusar"
  },
  {
    "word": "Nusar-Virjen",
    "class": "Substantivu",
    "meaning": "Nusar-lubun ida iha Tasi-Antillas neʼebé nakfahe ba estadu rua, Nusar- Virjen Britániku no Nusar-Virjen Amerikanu."
  },
  {
    "word": "nutrimentu",
    "class": "Substantivu",
    "meaning": "Ai-han neʼebé itania isin presiza atubele moris no hetan isin-di'ak nafatin. Sin. hahán Ez. Labarik sira presiza nutrimentu diak atubele hetan forsa."
  },
  {
    "word": "nutrisaun",
    "class": "Substantivu",
    "meaning": "Fó ai-han hodi tulun labarik ka ema atu nabokar no hetan isin-di'ak nafatin. Sin. fó-han Ez. Nutrisaun di'ak importante tebes ba labarik sira-nia kakutak."
  },
  {
    "word": "nutrisionista",
    "class": "Substantivu",
    "meaning": "Ema neʼebé nia matenekkona-banutrisaunnofókonsellu ba ema konaba hahán."
  },
  {
    "word": "nutritivu - nutritiva",
    "class": "Adjetivu",
    "meaning": "(Ai-han) neʼebé fó isin-di'ak no forsa. Ez. Aman-inan presiza prepara ai-han nutritivu ba sira-nia bebé atu nia bele hetan isin di'ak no forte."
  },
  {
    "word": "nuu",
    "class": "Substantivu",
    "meaning": "Ai-horis neʼebé dala barak iha hun aas no fuan boot kabuar neʼebé iha isin mutin no nia been midar hanesan masinmidar. Nia kulit-laran toos, no kulit-li'ur mamar. Ninia tahan bele uza atu halo umakakuluk ka didin; nia tahan nurak ka nia dikin uza atu homan katupa."
  },
  {
    "word": "nu'un mós nu'u",
    "class": "Substantivu",
    "meaning": "Maneira, modu, dalan. Liafuan ne'e la uza ona iha tetunprasa; ita hetan tiha iha de'it liafuan katetek nune'e 'ho maneira ne'e'."
  },
  {
    "word": "nuu-been",
    "class": "Substantivu",
    "meaning": "Nuu nia been neʼebé ema ka animál bele hemu."
  },
  {
    "word": "nu'udar",
    "class": "Prepozisaun",
    "meaning": "Ho maneira, hanesan. Ez. Nuʼudar Ita-nia advogadu, hau rekomenda atu Ita foti prosesu hasoru ema nee. Konjunsaun 1. Ho dalan neʼebé hanesan. Ez. Nia halo mai hau nuudar nia halo ba ema seluk. 2. Tan, komu, bainhira. Ez. Nuʼudar nia sei kiʼikoan, nia la bele kaer karreta."
  },
  {
    "word": "nuu-funit",
    "class": "Substantivu",
    "meaning": "Nuu nia isin neʼebé hamaran tiha ona atubele uza hodi halo buat seluk, nu'udar ezemplu sabaun."
  },
  {
    "word": "nuu-koir",
    "class": "Substantivu",
    "meaning": "Instrumentu ho forma oioin halo ho besi ka kaleen neʼebé ema uza atu koir nuu nia isin."
  },
  {
    "word": "nu'usá?",
    "class": "Advérbiu",
    "meaning": "Liafuan neʼebé ita uza hodi husu kona-ba buat ruma nia kualidade, kondisaun ka lalaʼok. Ez. Sira-nia uma nu'usá?"
  },
  {
    "word": "nuu-tasi",
    "class": "Substantivu",
    "meaning": "Ai espésie ida neʼebé moris besik tasi. Ninia forma hanesan mós nuu. Naran-botániku: Barringtonia asiatica"
  },
  {
    "word": "ó¹",
    "class": "Substantivu",
    "meaning": "Naran letra O nian."
  },
  {
    "word": "ó²",
    "class": "Pronome",
    "meaning": "Emak Liafuan neʼebé ita uza hodi hasé membru família nian, belun, labarik ka balada ida hamutuk ho nia naran-sarani ka hodi troka nia fatin. Ez. Ó bele ajuda hau, André?"
  },
  {
    "word": "ó-nia",
    "class": "Pronome",
    "meaning": "Maksoik Neʼebé ó mak soi."
  },
  {
    "word": "ó-nian",
    "class": "Pronome",
    "meaning": "Maksoik Neʼebé ó mak soi. Maklalin ka variante ne'e hanesan ho ó-nia, maibé tuir Substantivu ida-neʼebé nia refere bá. Ez. Hau la hatene haunia disionáriu iha neebé. Ha'u bele uza ó-nian?"
  },
  {
    "word": "oan",
    "class": "Substantivu",
    "meaning": "1. Ema neʼebé ema feto no mane hahoris. 2. Animál neʼebé baladainan no baladaaman hahoa."
  },
  {
    "word": "oan-boot",
    "class": "Substantivu",
    "meaning": "Oan moris uluk."
  },
  {
    "word": "oan-danin",
    "class": "Substantivu",
    "meaning": "Labarik neʼebé nia aman-inan rasik mate tiha ona no ema seluk mak hakiak nia. Sin. oan-fudin"
  },
  {
    "word": "oan-fatin",
    "class": "Substantivu",
    "meaning": "Parte iha inan nia isin iha-neʼebé bebé dezenvolve ka boot molok inan tuur ahi. Sin. úteru"
  },
  {
    "word": "oan-feto",
    "class": "Substantivu",
    "meaning": "Oanhoseksufemininu."
  },
  {
    "word": "oan-fudin",
    "class": "Substantivu",
    "meaning": "Labarik neʼebé nia aman-inan rasik mate tiha ona no ema seluk mak hakiak nia. Sin. oan-danin"
  },
  {
    "word": "oan-kaduak",
    "class": "Substantivu",
    "meaning": "Ema na'inrua neʼebé moris mai hamutuk hosi inan ida de'it."
  },
  {
    "word": "oan-kamrua",
    "class": "Substantivu",
    "meaning": "Maun-alin neʼebé iha inan hanesan maibé aman lahanesan."
  },
  {
    "word": "oan-kanura",
    "class": "Substantivu",
    "meaning": "Maun-alin neʼebé iha aman hanesan maibé inan lahanesan."
  },
  {
    "word": "oan-katoluk",
    "class": "Substantivu",
    "meaning": "Ema na'intolu neʼebé moris mai hamutuk hosi inan ida de'it."
  },
  {
    "word": "oan-kiak",
    "class": "Substantivu",
    "meaning": "Labarik ida neʼebé nia aman-inan mate tiha ona. Ez. Funu 1975 halo oankiakbarak tanbaamaninan barak mate."
  },
  {
    "word": "oan-laek",
    "class": "Adjetivu",
    "meaning": "Ema ka kabenna'in neʼebé la iha oan."
  },
  {
    "word": "oan-mane",
    "class": "Substantivu",
    "meaning": "Oan ho seksu maskulinu."
  },
  {
    "word": "oan-monun",
    "class": "Substantivu",
    "meaning": "Kaan-fuan ka kaukau neʼebé mate ona iha, no sai hosi170 oan-fatin."
  },
  {
    "word": "oan-na'in",
    "class": "Adjetivu",
    "meaning": "Neʼebé bele hetan oan. Substantivu 1. Kapasidade atu hetan oan. 2. Ema neʼebé iha oan."
  },
  {
    "word": "oan-oan",
    "class": "Adjetivu",
    "meaning": "Neʼebé ki'ik tebetebes. Sin. kiki'ik, kiʼikoan, melek"
  },
  {
    "word": "oan-nurak",
    "class": "Adjetivu",
    "meaning": "(Labarik) ne'ebé sei otas-ki'iktebetebes. Sin. bebé, oan-kosok"
  },
  {
    "word": "oan-sarani",
    "class": "Substantivu",
    "meaning": "Emakalabarikneʼebé simu batizmu no iha ema boot ka adultu ida (aman-sarani ka inansarani) neʼebé hola konta nia edukasaun nu'udar kristaun."
  },
  {
    "word": "oazis",
    "class": "Substantivu",
    "meaning": "Fatin ida iha rai-fuik maran ho bee moos no ai-hun."
  },
  {
    "word": "obediénsia",
    "class": "Substantivu",
    "meaning": "Hahalok hodi rona no halo tuir buat neʼebé hato'o ba ema ruma atu halaʼo. Sin. halo-tuir Ez. Amlulik sira hatudu sira-nia obediénsia hodi rona sira-nia superiór."
  },
  {
    "word": "obediente",
    "class": "Adjetivu",
    "meaning": "Neʼebéhatuduobediénsia. Sin. halotuir"
  },
  {
    "word": "objetiva",
    "class": "Substantivu",
    "meaning": "Lente ka vidru ida iha mákina fotográfika ka teleskópiu neʼebé ajuda ita haree ba dook no moos liu."
  },
  {
    "word": "obezu - obeza, f.",
    "class": "Adjetivu",
    "meaning": "Neʼebé isinbokur lahalimar, neʼebé bokur liu normál."
  },
  {
    "word": "obezidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "objetivu - objetiva, f.",
    "class": "Adjetivu",
    "meaning": "1. Neʼebé loos, tuir realidade. Sin. reál 2. Neʼebé la hali'is ba partidu ka grupu ida de'it, la hatudu parsialidade. Sin. ekuánime Substantivu (objetivu) Situasaun idaneʼebé ita hakarak to'o bá, ka buat idaneʼebé ita hakarak hetan. Sin. alvu, kasinar, meta"
  },
  {
    "word": "objetu",
    "class": "Substantivu",
    "meaning": "Buat sólidu ruma neʼebé ita bele kaer ka haree. Ez. Ami haree objetu ida hosi dook iha kalohan, dala ruma aviaun ida."
  },
  {
    "word": "obra",
    "class": "Substantivu",
    "meaning": "1. Tarefa ka knaar ida. 2. Serbisu arte nian ida. Ez. Halo estátua fununa'in sira-nian nee obra boot ida."
  },
  {
    "word": "obraprima",
    "class": "Substantivu",
    "meaning": "Pesa-arte neʼebé ninia kualidade furak no di'ak. Ez. Tuir ema barakliu nia hanoin, pintura naranboot A Gioconda nẻe obraprima ida."
  },
  {
    "word": "obriga",
    "class": "Verbu",
    "meaning": "1. Ho beran halo ema ida atu hala'obuat ruma. Sin. hakaʼas Ez. Patraun obriga ninia sekretáriu serbisu to'o kalanboot. 2. Insiste maka'as atu halo ka hala'o buat ruma. Ez. Keta obriga: ha'u lakohi sosa ida-ne'e!"
  },
  {
    "word": "obrigada",
    "class": "Interjeisaun",
    "meaning": "Espresaun ida neʼebé feto ka fetooan uza hodi agradese."
  },
  {
    "word": "obrigadiñu - obrigadiña, f.",
    "class": "Interjeisaun",
    "meaning": "Espresaun familiár ida neʼebé uza hodi hato'o agradesimentu."
  },
  {
    "word": "obrigadu",
    "class": "Interjeisaun",
    "meaning": "Espresaun ida neʼebé mane ka mane-oan uza hodi agradese."
  },
  {
    "word": "obrigasaun",
    "class": "Substantivu",
    "meaning": "1. Buat neʼebé ema ida tenke halo tanba ida-ne'e nia knaar duni. Sin. devér Ez. Sidadaun sira iha obrigasaun atu selu taxa ba propriedade neʼebé sira soi. 2. Títulu ka surat ida neʼebé fó direitu ba sahin lukru nian ida hosi empreza ida."
  },
  {
    "word": "obseka",
    "class": "Verbu",
    "meaning": "Halo ema atu hanoin nafatin kona-ba buat ruma to'o sai bulak. Sin. habuan"
  },
  {
    "word": "obsekadu – obsekada, f.",
    "class": "Adjetivu",
    "meaning": ""
  },
  {
    "word": "observa",
    "class": "Verbu",
    "meaning": "Hateke didi'ak ema ka buat ruma hodi haree sá mak nia halo ka sá mak akontese. Sin. haninu"
  },
  {
    "word": "observasaun",
    "class": "Substantivu",
    "meaning": "1. Hahalokobserva nian. 2. Opiniaun ida neʼebé ita hato'o. Ez. Atu halo observasaun diak kona-ba povu nia terus, presiza tun ba baze."
  },
  {
    "word": "observatóriu",
    "class": "Substantivu",
    "meaning": "Fatin ida ho teleskópiu boot hodi observa ka hateke ba fulan, fitun no planeta sira."
  },
  {
    "word": "obsesaun",
    "class": "Substantivu",
    "meaning": "Hahalok la bele para atu hanoin kona-ba buat ida, bele mós to'o sai bulak. Sin. habuan Ez. Niahanoin atu sai futebolista diak ida sei hanesan nia obsesaun ida."
  },
  {
    "word": "obstetra",
    "class": "Substantivu",
    "meaning": "Médiku neʼebé bali feto molok, durante no liutiha partu ka tuurahi."
  },
  {
    "word": "obstetrísia",
    "class": "Substantivu",
    "meaning": "Parte medisina nian ida neʼebé trata feto bainhira sira isin-rua no mós durante no liutiha tuur-ahi."
  },
  {
    "word": "obstétriku - obstétrika, f.",
    "class": "Adjetivu",
    "meaning": ""
  },
  {
    "word": "obstipasaun",
    "class": "Substantivu",
    "meaning": "Kondisaunbainhira ema ida la bele ka susar atu li'ur ka soe bee-boot. Sin. tee-toos"
  },
  {
    "word": "obxenu - obxena, f.",
    "class": "Adjetivu",
    "meaning": "(Hahalok ka liafuan) neʼebé foʼer no hakanek kostume ka moralidade di'ak. Sin. kadoor"
  },
  {
    "word": "obxenidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "odamatan",
    "class": "Substantivu",
    "meaning": "Ai-kabelak ka besitahan neʼebé bele loke no taka iha fatin neʼebé ema uza atu tama no sai."
  },
  {
    "word": "odamatan-tilun",
    "class": "Substantivu",
    "meaning": "Parteodamatan ida nian neʼebé ita kaer, hafoin dulas ka hanehan hodi loke no taka. Sin. puxadór"
  },
  {
    "word": "odan",
    "class": "Substantivu",
    "meaning": "Kuadru kloot retangulár hoai-riinbadakbaraktutanmaluhoai-riin naruk rua, neʼebé ema uza atu sa'e didin kabá fatin aas seluk, n.e. bauma-kakuluk."
  },
  {
    "word": "odan-fatinmósodanfuan",
    "class": "Substantivu",
    "meaning": "Samafatin iha odan ka eskada."
  },
  {
    "word": "odas",
    "class": "Substantivu",
    "meaning": "Animál maksusuk raimaran nian neʼebé boot liu hotu, ho ain aat, inurkain naruk, nehan rua naruk hanesan dikur no tilun-tahan belar boot. Odas sira moris iha rai-Áfrika nia balun, rai-Índia, rai- Birmánia no rai-Tailandia. Sin. elefante"
  },
  {
    "word": "odi mós ódiu",
    "class": "Substantivu",
    "meaning": "Sentimentu la gosta ka hakribi ema ka buat ida. Sin. dadinuk Verbu La gosta, lakohi ema ka buat ida. Sin. dinu, hakribi"
  },
  {
    "word": "odontolojia",
    "class": "Substantivu",
    "meaning": "Estudu konaba lala'ok médiku hodi hasai ka hadi'a nehan moras."
  },
  {
    "word": "oe",
    "class": "Substantivu",
    "meaning": "Rota naruk ida hosi du'ut ka au. Sin. ratan"
  },
  {
    "word": "Oekusi",
    "class": "Substantivu",
    "meaning": "1. (Rai- Oekusi) Distritu Timór Lorosa'e nian neʼebé nakfati iha Timór Loromonu no territóriu indonéziu mak hale'u; populasaun maioria ko'alia lia-baikenu. 2. Vila-kapitál rai-Oekusi nian. Sin. Pante Makasár"
  },
  {
    "word": "Oesilu",
    "class": "Substantivu",
    "meaning": "Vila no subdistritu ida iha rai- Oekusi."
  },
  {
    "word": "ofende",
    "class": "Verbu",
    "meaning": "Hatete liafuan ka halo buat ruma neʼebé hatún ema nia dignidade hodi halo vítima neʼe sente laran-kanek. Sin. hakanek"
  },
  {
    "word": "ofensa",
    "class": "Substantivu",
    "meaning": "Hahalok hakanek ema nia laran."
  },
  {
    "word": "ofensivu - ofensiva, f.",
    "class": "Adjetivu",
    "meaning": "Neʼebé hakanek ema nia laran. Sin. makanek"
  },
  {
    "word": "ofensór - ofensora, f.",
    "class": "Substantivu",
    "meaning": "Emaneʼebé ofende. Sin. makanek"
  },
  {
    "word": "oferese",
    "class": "Verbu",
    "meaning": "Hato'o ka hatudu ita-nia hakaran atu fó buat ruma, maski ita la hatene sé ema seluk atu simu ka lae; fó ho respeitu. Sin. hasa'e"
  },
  {
    "word": "oferta",
    "class": "Substantivu",
    "meaning": "1. Hahalok oferese nian. Sin. hasa'en 2. Hahusuk ba ema ruma se nia hakarak buat ruma. 3. Buat ruma neʼebé ita oferese ka fó. Ez. Oferta ne'ebé diak la presiza karu, maibé importante liu mak fó ho laran tomak."
  },
  {
    "word": "ofertóriu",
    "class": "Substantivu",
    "meaning": "Parte misa nian, tuir orasaun Credo, bainhira amlulik hasa'e paun no tuauvas ba Na'i Maromak atu nakfila ba Ita Na'i Jezús Kristu Nia futar Isin no Raan."
  },
  {
    "word": "ofisiál",
    "class": "Adjetivu",
    "meaning": "Neʼebé halo ho autorizasaun hosi xefe ka autoridade ida. Ez. Atu halo pasaporte, rekerente tenke hatama dokumentu ofisiál sira. Substantivu Ema neʼebé okupa pozisaun ruma hanesan autoridade iha eskritóriu ka organizasaun ruma."
  },
  {
    "word": "ofisina",
    "class": "Substantivu",
    "meaning": "Fatin neʼebé ema hadi'a karreta, motór ka mákina ruma bá."
  },
  {
    "word": "ofísiu",
    "class": "Substantivu",
    "meaning": "1. Arte manuál ka meká-nika ida. 2. Profisaun ka kargu públiku ida. 3. Orasaun ka serimónia Igreja nian."
  },
  {
    "word": "ohin",
    "class": "Advérbiu",
    "meaning": "Loron idaneʼebé tuir horise-hik no uluk-ba aban."
  },
  {
    "word": "oho",
    "class": "Verbu",
    "meaning": "Halo ema, animál ka ai-horis ida atu mate. Sin. hamate"
  },
  {
    "word": "oho-an",
    "class": "Substantivu",
    "meaning": "Hahalok halo nia an sai mate. Ez. Oho-an ne'e sala boot ida tanba ita ema nia vida iha Maromak Nia liman. Sin. suisídiu"
  },
  {
    "word": "ohodór",
    "class": "Substantivu",
    "meaning": "Ema ida neʼebé oho ema seluk. Sin. mahohok, ohona'in, limanraan, omisida"
  },
  {
    "word": "oho-na'in",
    "class": "Substantivu",
    "meaning": "Ema ida neʼebé oho ema seluk. Sin. mahohok, obodór, liman-raan, omisida"
  },
  {
    "word": "oin",
    "class": "Adjetivu",
    "meaning": "Parte sorun ka kontráriu hosi kotuk. Ez. Nia hela iha oin maibé ami hela iha kotuk. Substantivu 1. Parte ita ema nia ulun neʼebé iha matan, tilun, inus, ibun. 2. Buat lubun ida ho feisaun ka karakterístika hanesan de'it. Sin. tipu, espésie 3. Dalan ka maneira. Ez. Iha oin rua atu hakerek surat ida – bele hahú ho idea jerál, bele mós ho ideia espesifiku; Gerilleiru sira iha oin barak atu hadau kilat bele liuhosi emboskada no atake ba abrigu inimigu nian."
  },
  {
    "word": "oin-aat",
    "class": "Adjetivu",
    "meaning": "Neʼebé nia oin ka aparénsia ladi'ak ka lafurak. Sin. oin-taneet Ez. Buatamak oin-aat ne'ebá malandru ida neʼebé polísia buka hela. Substantivu Kuakidade oin-aat. Ez. Tanba oin-aat ema lakohi hili nia tuir kompetisaun hananu nian. Hahalok nee injustu lahalimar!"
  },
  {
    "word": "oin-boruk",
    "class": "Adjetivu",
    "meaning": "Oinneʼebéhanesanhirus no la hamnasa. Sin. oinbubu, oin-buis, oinfuik"
  },
  {
    "word": "oin-bosok",
    "class": "Substantivu",
    "meaning": "Ema ida neʼebé habosok ema seluk. Sin. impostór"
  },
  {
    "word": "oin-bubu",
    "class": "Adjetivu",
    "meaning": "Oin neʼebé hanesan hirus no la hamnasa. Sin. oinboruk, oin-buis, oinfuik"
  },
  {
    "word": "oin-buis",
    "class": "Adjetivu",
    "meaning": "Oin neʼebé hanesan hirus no lahamnasa. Sin. oinboruk, oin-bubu, oinfuik"
  },
  {
    "word": "oin-bulak",
    "class": "Adjetivu",
    "meaning": "Neʼebé hola malu ho naran ema ida, la’ós de'it ho nia kaben."
  },
  {
    "word": "oin-bulelu",
    "class": "Adjetivu",
    "meaning": "Neʼebé sente lakon ekilíbriu no besik atu monu. Sin. oinhalai, oin-kleʼuk, oinlanu"
  },
  {
    "word": "oin-di'ak",
    "class": "Adjetivu",
    "meaning": "Neʼebé nia oin ka aparénsiafurak, haloemaselukgostaatuharee."
  },
  {
    "word": "oin-foun",
    "class": "Adjetivu",
    "meaning": "Neʼebé laós baibain ka tuan. SubstantivuEmaneʼebéitalakoñese. Ez. Ha'u haree oin-foun ida iha festa sábadu kalan. Keta mauhuu ida karik?"
  },
  {
    "word": "oin-fuik",
    "class": "Adjetivu",
    "meaning": "Oin neʼebé hanesan hirus no la hamnasa. Sin. oinboruk, oin-bubu, oinbuis"
  },
  {
    "word": "oin-halai",
    "class": "Adjetivu",
    "meaning": "1. Neʼebé sente lakon ekilíbriu no besik atu monu. Sin. oinbulelu, oin-kleʼuk,oinlanu2.Neʼebésente moras (ulun ka laran) tanba movimentu ró, aviaun ka karreta nian. Ez. Apá! Favór para lai karreta tanba hau oinhalai no atu muta. 3. Neʼebé la sensatu no hatudu julgamentu arbiru de'it. Ez. Hau fó tiha ona surat nee ba ó, maibé ó dehan seidauk. Keta ó oin-halai karik? Verbu Sente lakon ekilíbriu no besik atu monu. sente moras tanba movimentu meiu-transporte neʼebé nia sa’e."
  },
  {
    "word": "oin-hanesan",
    "class": "Adjetivu",
    "meaning": "Neʼebéoinatuhanesan ida seluk. Ez. Sira oin-hanesan de'it maibé laós maun-alin."
  },
  {
    "word": "oin-ida",
    "class": "Adjetivu",
    "meaning": "Neʼebé hanesan ka idéntiku, neʼebé iha oin ida de'it. Ez. Ami sosa ai-funan oin-ida deit tanba la iha sira seluk."
  },
  {
    "word": "oin-kabobir",
    "class": "Adjetivu",
    "meaning": "Neʼebé baibain brutu no maledukadu. Sin. baixu"
  },
  {
    "word": "oin-kamutis",
    "class": "Adjetivu",
    "meaning": "Neʼebé nia kór la maka'as, atu sai mutin."
  },
  {
    "word": "oin-karutas",
    "class": "Adjetivu",
    "meaning": "Neʼebé iha oinmerik barak."
  },
  {
    "word": "oin-katar",
    "class": "Adjetivu",
    "meaning": "Neʼebé koʼalia ho modun ka maneira lahó respeitu."
  },
  {
    "word": "oin-kle'uk",
    "class": "Adjetivu",
    "meaning": "Neʼebé sente lakon ekilíbriu no besik atu monu. Sin. oinbulelu, oin-halai, oinlanu."
  },
  {
    "word": "oin-kmanek",
    "class": "Adjetivu",
    "meaning": "(Ema) neʼebéoin-di'ak ka bonita/bonitu."
  },
  {
    "word": "oin-kraik",
    "class": "Adjetivu",
    "meaning": "1. Neʼebé koitadu no hetandepresaunkalarantaridu. Ez. Carlos oin-kraik tanba nia kaben moras по tenke bá ospitál. 2. Neʼebé hatudu an loloos no la foti an tanba buat neʼebé nia iha. Sin. modestu Ez. Maski eskola-boot iha tasi-balun, nia sempre hatudu oin-kraik iha nia moris. Substantivu Hahalok haraik an. Sin. modéstia"
  },
  {
    "word": "oin-lais",
    "class": "Adjetivu",
    "meaning": "Neʼebé hakarak hatene ka haree. Sin. oin-moris, kuriozu"
  },
  {
    "word": "oin-lamidar",
    "class": "Adjetivu",
    "meaning": "Neʼebé hatudu oin la hamnasa."
  },
  {
    "word": "oin-lanu",
    "class": "Adjetivu",
    "meaning": "Neʼebé sente lakon ekilíbriu no besik atu monu. Sin. oinbulelar, oin-halai, oinkleʼuk"
  },
  {
    "word": "oin-lulik",
    "class": "Substantivu",
    "meaning": "Ema ida nia moen ka organ seksuál. Sin. sasánlulik"
  },
  {
    "word": "oin-maka",
    "class": "Adjetivu",
    "meaning": "Neʼebé hatudu ka foti an nu'udar ema neʼebé di'ak liu ema seluk. Sin. matan-aas, arrogante"
  },
  {
    "word": "oin-maka'as",
    "class": "Adjetivu",
    "meaning": "Neʼebé hatudu oin la hamnasa, la konkorda. Sin. oin-toos"
  },
  {
    "word": "oin-mamar",
    "class": "Adjetivu",
    "meaning": "Neʼebé hatudu laran-di'ak."
  },
  {
    "word": "oin-malirin",
    "class": "Adjetivu",
    "meaning": "Neʼebé hatudu katak lakohisimuita, neʼebéniaatitudelabeluk."
  },
  {
    "word": "oin-maran",
    "class": "Adjetivu",
    "meaning": "Neʼebéoinkamutistanba preokupadu ka moras."
  },
  {
    "word": "oin-maus",
    "class": "Adjetivu",
    "meaning": "Neʼebé iha maneira di'ak no hatudu respeitu. Ez. Hahalok ida ne'ebé la oin-maus mak ida neebé la hatene husu lisensa bainhira halo inter-rupsaun."
  },
  {
    "word": "oin-mean",
    "class": "Adjetivu",
    "meaning": "Oin neʼebé mean tanba hirus ka moe. Verbu Oin sai mean tanba hirus ka moe. Ez. Anita oin-mean tanba la hatene hatán hahusuk hosi nia mestra."
  },
  {
    "word": "oin-merik",
    "class": "Substantivu",
    "meaning": "Musamusan iha isin, liuliu iha oin no kakorok, neʼebé mean no hanesan borbullu ki'ik."
  },
  {
    "word": "oin-midar",
    "class": "Adjetivu",
    "meaning": "Neʼebé hatudu oin hamnasa haksolok. Substantivu Hahalok hamnasa neʼebé ibun nia lidun muda sai no sa'e natoon deit hodi hatudu laran-haksolok. Verbu Hatudu laranhaksolok liuhosi hamnasa natoon de'it. Ez. Kaixeiru neʼebé diak tenke oin-midar ba kliente sira."
  },
  {
    "word": "oin-moe",
    "class": "Adjetivu",
    "meaning": "Neʼebé hatudu oin mean tanba moe."
  },
  {
    "word": "oin-moris",
    "class": "Adjetivu",
    "meaning": "1. Neʼebé hakarak hatene ka haree. Sin. oin-lais, kuriozu 2. (Mane) neʼebé gosta baku matan ba feto."
  },
  {
    "word": "oin-naburut",
    "class": "Adjetivu",
    "meaning": "Neʼebé hatudu hirus, estrese ka depresaun. Sin. oinnamkurut"
  },
  {
    "word": "oin-nakukun",
    "class": "Verbul Adjetivu",
    "meaning": "(Sente) atu monu ka lakon ekilíbriu hodi monu ba rai. Ez. Labarik nee oinnakukun tanba hamriik iha loron oras ba oras."
  },
  {
    "word": "oin-na'in",
    "class": "Adjetivul Substantivu",
    "meaning": "(Ema ida) neʼebé simu no trata ema seluk didi'ak, ho laran-luak, hanesan fó fatin ba ema atubele deskansa ka look ai-han ruma. Ez. Ami hato'o obrigadu ba Ita-Boot nia oin-na'in tanba oferese fatin no aihan hirak-nee durante ami-nia vizita."
  },
  {
    "word": "oin-namkurut",
    "class": "Adjetivu",
    "meaning": "Neʼebéhatuduhirus, estrese ka depresaun. Sin. oinnaburut"
  },
  {
    "word": "oin-oin",
    "class": "Adjetivu",
    "meaning": "Tipu hirak neʼebé diferente, la'ós tipu ida de'it maibé barak. Sin. oioin Ez. Ami hetan informasaun oin-oin kona-ba edukasaun bainhira hasoru tiha Ministru-Edukasaun."
  },
  {
    "word": "oin-roit",
    "class": "Adjetivu",
    "meaning": "Neʼebé halo an."
  },
  {
    "word": "oin-seluk",
    "class": "Adjetivu",
    "meaning": "Neʼebé lahanesan; diferente. Advérbiu Seluk hosi ida neʼebé hato'o tiha ona."
  },
  {
    "word": "oin-siin",
    "class": "Adjetivu",
    "meaning": "Neʼebé hatudu oin la haksolok."
  },
  {
    "word": "oin-suar",
    "class": "Adjetivu",
    "meaning": "1. Neʼebé hatudu oin buis hela tan hirus. 2. Neʼebé hatudu laran la haksolok tan laranta'uk."
  },
  {
    "word": "oin-tamak",
    "class": "Adjetivu",
    "meaning": "Neʼebé koʼalia ka kom-porta an ho modun ka maneira neʼebé aatnolahó respeitu. Sin. ointomak, brutu"
  },
  {
    "word": "oin-taneet",
    "class": "Adjetivu",
    "meaning": "Neʼebé nia oin ka aparénsia ladi'ak ka lafurak. Sin. oin-aat"
  },
  {
    "word": "oin-tomak",
    "class": "null",
    "meaning": "haree ointamak"
  },
  {
    "word": "oin-toos",
    "class": "Adjetivu",
    "meaning": "Neʼebé hatudu oin la hamnasa, la konkorda. Sin. oinmakaʼas Ez. Nia oin-toos hanesan fatuk ne'ebé ema taa la han."
  },
  {
    "word": "oinsá",
    "class": "Advérbiu",
    "meaning": "Liafuan ida neʼebé ita uza hodi haktemik ka husu kona-ba maneira halo hatene buat ruma, ka buat ruma nia oin ka aparénsia. Ez. Oinsá ema bá Polu Norte? Ema bá sảe ró neebé tahan malirin no jelu; Ema inglés née oinsá loos? Ne'e ema fuuk-balanda no isinboot."
  },
  {
    "word": "oioin",
    "class": "Adjetivu",
    "meaning": "Tipu hirak neʼebé diferente; la'ós tipu ida de'it maibé barak. Sin. oioin Ez. Iha ikan oioin iha bee-lihun ne'ebá."
  },
  {
    "word": "okaziaun",
    "class": "Substantivu",
    "meaning": "1. Tempu bainhira buat ruma akontese. Sin. dala Ez. Hau hasoru nia iha okaziaun ida durante funu. 2. Akontesimentu importante ida. Sin. eventu Ez. Konférensia ida-ne'e okaziaun kapás ba aminia universidade."
  },
  {
    "word": "okir",
    "class": "Adjetivu",
    "meaning": "(Ai fuan) neʼebé seidauk tasak."
  },
  {
    "word": "okos",
    "class": "Substantivu",
    "meaning": "Parte neʼebé kraik liu. Ez. Nia subar iha meza nia okos."
  },
  {
    "word": "Oksford",
    "class": "Substantivu",
    "meaning": "Vila ida iha rai-Inglaterra neʼebé iha universidade naran-boot tebes ida."
  },
  {
    "word": "oksijéniu",
    "class": "Substantivu",
    "meaning": "Gás lahó kór neʼebé hakonu to'o porsentu ruanuluresin- ida (21%) atmosfera raiklaran nian, neʼebé balada no ai-horis presiza atubele moris; ahi sei la bele lakan se la iha oksijéniu. Símbolu Sientífiku: O2."
  },
  {
    "word": "Oksitánia (rai-)",
    "class": "Substantivu",
    "meaning": "Rain ida nakfati iha Tasi Atlántiku, Tasi Mediterráneu no Fohor-Alpes nia leet neʼebé rai-Fransa kleur ona ukun."
  },
  {
    "word": "oksitaun",
    "class": "Adjetivu",
    "meaning": "Rai-Oksitánia nian. Substantivu 1. Ema Oksitánia. 2. (lia-oksitaun) Lian rejionál neʼebé ko'alia iha Oksitánia ohin loron, atu hanesan liakatalaun. Lian ida-ne'e iha perigu atu lakon tanba governu Fransa nian haburas de'it dalen ofisiál fransés."
  },
  {
    "word": "okulista",
    "class": "Substantivu",
    "meaning": "Ema ida neʼebé fihir ema nia matan ho aparellu espesiál atubele prepara ókulu natoon."
  },
  {
    "word": "okulit",
    "class": "Adjetivu",
    "meaning": "Neʼebé la kuidadu-an. Sin. kuidadu-laek"
  },
  {
    "word": "ókulu",
    "class": "Substantivu",
    "meaning": "Aparellu ida ho lente rua iha kuadru laran neʼebé ema matan-aat ka matanmalahuk tau ba matan atubele haree di'ak liu."
  },
  {
    "word": "ókulu-maksatan",
    "class": "Substantivu",
    "meaning": "Ókulu ida neʼebé traballadór balu tau atubele hamahan nia matan bainhira serbisu ho ahi, nu'udar ezemplu soldadór. Sin. ókuluprotesaun"
  },
  {
    "word": "ókulu-metan",
    "class": "Substantivu",
    "meaning": "Ókulu neʼebé ema tau atu hamahan nia matan hosi loron manas."
  },
  {
    "word": "ókulu-protesaun",
    "class": "Substantivu",
    "meaning": "Ókulu ida neʼebé traballadór balu tau atubele hamahan nia matan bainhira serbisu ho ahi, nu'udar ezemplu soldadór. Sin. ókulu-maksatan"
  },
  {
    "word": "okupa",
    "class": "Verbu",
    "meaning": "1. Hakonu ka enxe espasu ruma. Ez. Ai-funan sira-nee sei okupa fatin barak iha ha'u-nia kuartu. 2. Sai na'in tiha. Ez. Ema okupa uma ilegalmente bainhira sira tun tiha hosi ai-laran iha tinan 1999. 3. Invade hodi hadau tiha. Ez. Militár indonéziu sira okupa Timór Lorosa'e iha tinan 1975. 4. Halaʼo kargu ruma. Ez. Sr. Paulu Martins okupa pozisaun nu'udar xefe polísia RDTL nian iha tinan 2001."
  },
  {
    "word": "okupante",
    "class": "Substantivu",
    "meaning": "1. Na'in. 2. Ema neʼebé okupa ka hadau tiha fatin ka espasu ruma."
  },
  {
    "word": "okupasaun",
    "class": "Substantivu",
    "meaning": "Hahalok okupa espasu ka fatin ruma. Ez. Okupasaun Indonézia durante tinan 25 halo ema barak terus no mate."
  },
  {
    "word": "Olanda (rai-)",
    "class": "Substantivu",
    "meaning": "Rain no estadu ki'ik ida iha Europa Loromonu. Sin. rai-Balanda"
  },
  {
    "word": "olandés - olandeza, f.",
    "class": "Adjetivu",
    "meaning": "Rai-Olanda nian. Sin. balanda. Substantivu 1. Ema Olanda nian. Sin. emabalanda 2. (liaolandés) Dalen jermániku rai-Olanda no rai-Béljika nian, uluk mós lian koloniáliharai-Indonézia. Liafuan tetun balu, n.e. estrika, matroos, doit, sira-nia hun iha liaolandés. Sin. liabalanda"
  },
  {
    "word": "olaria",
    "class": "Substantivu",
    "meaning": "Fatin iha neʼebé halo bloku ka loisa."
  },
  {
    "word": "olat (rai-)",
    "class": "Substantivu",
    "meaning": "Rai-lolon neʼebé kloot, tisak no naruk tun ba kraik. Sin. rai-dodok, rai-tisak"
  },
  {
    "word": "oleiru - oleira, f.",
    "class": "Substantivu",
    "meaning": "Ema neʼebé halo ka tunu bloku ka loisa."
  },
  {
    "word": "óleu",
    "class": "Substantivu",
    "meaning": "Been metan neʼebé halo hosi minarai ka petróleu no uza hodi halo besi mamar ka namdoras atu karreta ka mákina bele la'o di'ak."
  },
  {
    "word": "olimpíada",
    "class": "Substantivu",
    "meaning": "Eventu boot ida iha área desportu nian neʼebé hato'o jogu oioin ho partisipante sira hosi nasaun barak. Atleta timoroan balu (bokse, halai no hi'it-todan) hola parte ba dala uluk nu'udar saseluk Timór independente nian iha olímpika olimpíada iha Sídnei, rai-Austrália, iha tinan 2000. Sin. Jogu Olímpiku Sira"
  },
  {
    "word": "olímpiku - olímpika, f.",
    "class": "Adjetivu",
    "meaning": "Kona-ba olimpíada."
  },
  {
    "word": "olofote",
    "class": "Substantivu",
    "meaning": "Ahi-oan neʼebé nia forsa maka'as tebes no nia raiu bele see ba diresaun oioin de'it, hanesan ahi-oan neʼebé mahein-dadur sira uza atubele kontrola parte hotu hale'u no mós iha kadeia nia laran."
  },
  {
    "word": "Omán (rai-)",
    "class": "Substantivu",
    "meaning": "Rain no estadu ki'ik iha rohan lorosa'e Península Arábia nian."
  },
  {
    "word": "omanense",
    "class": "Adjetivu",
    "meaning": "Rai-Omán nian. Substantivu Ema Omán."
  },
  {
    "word": "Ombai (rai-)",
    "class": "Substantivu",
    "meaning": "Rai-kotun nakfati besik rai-Timór nia raat norueste, neʼebé rai-Indonézia mak ukun. Sin. Alor"
  },
  {
    "word": "omeleta",
    "class": "Substantivu",
    "meaning": "Mantolunniaisinneʼebé baku no tuirmai sona ho mina iha taxu."
  },
  {
    "word": "omenajen",
    "class": "Substantivu",
    "meaning": "Fó ka hatudu respeitu liuhosi serimónia ida. Sin. serapinan Ez. Timoroan sira fó omenajen ba Dr. Sérgio Vieira de Mello, ne'ebé mate iha rai-Irake iha loron 20 fulan-Agostu tinan 2003, liuhosi misa boot ida iha Katedrál Vila Verde."
  },
  {
    "word": "omilia",
    "class": "Substantivu",
    "meaning": "Diskursu neʼebé amlulik hato'o iha igreja hodi haklake evanjellu. Sin. sermaun"
  },
  {
    "word": "omisaun",
    "class": "Substantivu",
    "meaning": "Hahalok omite nian ka buat neʼebé ita omite. Sin. hakmulik Ez. Iha surat-tahan ezame nian nee, mestre hetan omisaun barak."
  },
  {
    "word": "omisida",
    "class": "Adjetivu",
    "meaning": "Kona-ba omisídiu. Substantivu Ema ida neʼebé oho ema seluk. Sin. mahohok, limanraan,ohodór, ohona'in"
  },
  {
    "word": "omisídiu",
    "class": "Substantivu",
    "meaning": "Hahalok oho ema ho intensaun. Ez. Omisídiukonsiderahanesan krime todan hasoru umanidade."
  },
  {
    "word": "omite",
    "class": "Verbu",
    "meaning": "La hatama, inklui ka halo, ho intensaun ka tanba ita haluha de'it. Sin. hakmulik Ez. Komisaun omite tiha Simaun nia naran iha lista, tanba nee nia hirus loos."
  },
  {
    "word": "ómiu",
    "class": "Substantivu",
    "meaning": "Unidade ka kasukat rezisténsia elétrika nian neʼebé hakerek ho símbolu sientífiku !."
  },
  {
    "word": "omnipotente",
    "class": "Adjetivu",
    "meaning": "Neʼebé bele halo hotu-hotu."
  },
  {
    "word": "omnipoténsia",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "omnívoru - omnívora, f.",
    "class": "Adjetivu",
    "meaning": "Neʼebé han tipu ai-han hotu, inklui na'an no ai-tahan. Substantivu Balada ka animál neʼebé han tipu ai-han hotu."
  },
  {
    "word": "omofonia",
    "class": "Substantivu",
    "meaning": "1.Fenómenubainhira liafuan rua nia pronúnsia la lalakar hanesan de' it maibé sira-nia arti ka signifikadu lahanesan; sira-nia hakerek bele mós lahanesan, n.e. mós no moos. 2. Estilu hananu hamutuk meodia ida de'it ho akorde tolu ka haat."
  },
  {
    "word": "omófonu - omófona",
    "class": "Adjetivu",
    "meaning": ""
  },
  {
    "word": "omojéneu - omojéneu, f.",
    "class": "Adjetivu",
    "meaning": "Neʼebé nia forma ka kualidade hanesan de'it."
  },
  {
    "word": "omojeneidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "omónimu",
    "class": "Substantivu",
    "meaning": "Liafuan ida neʼebé nia pronúnsia (no dala ruma mós nia hakerek) hanesan ho liafuan seluk ida, maibé sira-nia arti ka signifikadu lahanesan, n.e. kuda (Verbu) no kuda (animál ida nia naran)."
  },
  {
    "word": "omoseksuál",
    "class": "Adjetivul Substantivu",
    "meaning": "(Kona-ba) mane ida neʼebé sente dadadak ka atrasaun seksuál ba mane seluk, la’ós ba feto. Ez. Igreja sei kontra nafatin omoseksuál sira ne'ebé hakarak kaben ka hola malu tanba idanee la konsidera hanesan hahalok naturál."
  },
  {
    "word": "omoseksualidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "ona",
    "class": "Matadak Verbáll Advérbiu",
    "meaning": "Akontese tiha ona. Forma ida neʼebé tuir Verbu, Adjetivu no naran. Ez. Labarik sira toba ona."
  },
  {
    "word": "Onduras, (rai-)",
    "class": "Substantivu",
    "meaning": "Rain no estadu ida iha Amérika Klarak."
  },
  {
    "word": "ondureñu - ondureña, f.",
    "class": "Adjetivu",
    "meaning": "Rai-Onduras nian. Substantivu Ema Onduras."
  },
  {
    "word": "onestu – onesta, f.",
    "class": "Adjetivu",
    "meaning": "(Ema) neʼebé nia laran di'ak ka moos, nia la naʼok no la bosok. Sin. laranmoos"
  },
  {
    "word": "onestidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "onkolojia",
    "class": "Substantivu",
    "meaning": "Matenek ka siénsia médika konaba kankru."
  },
  {
    "word": "onkolojista",
    "class": "Substantivu",
    "meaning": "Médiku neʼebé matenek konaba kankru no nia tratamentu."
  },
  {
    "word": "onomatopeia",
    "class": "Substantivu",
    "meaning": "Liafuan ida neʼebé nia son fóhanoin liafuan ida-ne'e nia arti ka signifikadu, nu'udar ezemplu liafuan kokoreek, kokoteek."
  },
  {
    "word": "onorífiku - onorífika, f.",
    "class": "Adjetivu",
    "meaning": "Neʼebé fó onra. Sin. mana'ik Ez. Lia-tetun soi espresaun mandik oioin hanesan Ita-Boot, hi'it an, hatún lia."
  },
  {
    "word": "onra",
    "class": "Substantivu",
    "meaning": "Hahalok hatudu respeitu ba ema ka liuliu ba Maromak, santu no santa sira."
  },
  {
    "word": "onsa1",
    "class": "Substantivu",
    "meaning": "Sasukattatodan tuan ida, vale grama 28,35."
  },
  {
    "word": "onsa2 (busa-)",
    "class": "Substantivu",
    "meaning": "Busa fuik ida ho ikun badak. Naran-sientífiku: Felis lynx"
  },
  {
    "word": "onu",
    "class": "Substantivu",
    "meaning": "Au oin ida neʼebé moris iha debu ka besik bee no uza hodi halo didin uma ka hariis-fatin nian."
  },
  {
    "word": "ook",
    "class": "Substantivu",
    "meaning": "Organ ida iha ita-nia isin laran, besikestómagu, neʼebéhusikita-nia raan iha kondisaun di'ak. Sin. aten-raak"
  },
  {
    "word": "opaku - opaka, f.",
    "class": "Adjetivu",
    "meaning": "Neʼebé ita la bele haree-borus. Liafuan-sorun:transparente, hareeborus"
  },
  {
    "word": "opala",
    "class": "Substantivu",
    "meaning": "Fatuk-murak nabilan ida ho kór oioin hanesan baur ka arkuiris neʼebé uza hodi halo joia."
  },
  {
    "word": "opera",
    "class": "Verbu",
    "meaning": "1. Hala'o mákina ka programa ruma. 2. Ko'a isin no hasai ka hadi'a tiha parte aat neʼebé iha isin laran. Ez. Ema neebé foin hetan moras kankru, diak liu husu doutór sira atu opera kedas."
  },
  {
    "word": "ópera",
    "class": "Substantivu",
    "meaning": "Pesa-teatru ida neʼebé hato'o liuhosi múzika no hananu tuir estilu klásiku."
  },
  {
    "word": "operadór - operadora, f.",
    "class": "Substantivu",
    "meaning": "1. Ema neʼebé hala'o operasaun sirúrjiku ka kímiku. 2. Ema ida neʼebé hala'o ka kaer mákina serbisu nian ruma."
  },
  {
    "word": "operasaun",
    "class": "Substantivu",
    "meaning": "1. Hahalok opera nian. 2. Lala'ok médiku hodi ko'a-loke parte ruma hosi ema nia isin atubele hadi'a kanek ka hasai organ moras. Sin. sirurjia"
  },
  {
    "word": "opereta",
    "class": "Substantivu",
    "meaning": "Ópera badak, hanesan pesa-teatruidaneʼebéinkluihananubarak."
  },
  {
    "word": "opiniaun",
    "class": "Substantivu",
    "meaning": "Hanoin neʼebé ita hato'o ba ema seluk liuhosi ko'alia ka hakerek. Sin. hareen, pontudevista Ez. Iha nasaun demokrátika ema tenke respeita ema seluk nia opiniaun."
  },
  {
    "word": "ópiu",
    "class": "Substantivu",
    "meaning": "Ai-moruk narkótiku neʼebé halo hosi ai-funan papoila nia musan. Sin. afian"
  },
  {
    "word": "opoin",
    "class": "Verbu",
    "meaning": "Halo opozisaun ka kontra. Sin. sakar, hasoru Ez. Sira opoin ami-nia ideia tanba sira seidauk hatene ninia objetivu."
  },
  {
    "word": "oponente",
    "class": "Substantivu",
    "meaning": "Ema neʼebé kontra ka opoin. Sin. maksakar, masoruk"
  },
  {
    "word": "oportunidade",
    "class": "Substantivu",
    "meaning": "Okaziaun neʼebé favoravel ka natoon atu halo buat ruma. Sin. babiban Ez. Bainhiraihaoportunidade diak, hảu sei koalia ho xefe konaba ha'u-nia vensimentu."
  },
  {
    "word": "oportunista",
    "class": "Adjetivul Substantivu",
    "meaning": "(Ema ida) neʼebé hatene aproveita oportunidade ho maneira egoísta. Sin. makbiban Ez. Bainhira Timór hetan tiha independénsia, oportunista barak mós hakarak sai membru governu nian."
  },
  {
    "word": "oportunizmu",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "oportunu - oportuna, f.",
    "class": "Adjetivu",
    "meaning": "Neʼebé akontese iha tempu natoon ka konveniente. Sin. konak"
  },
  {
    "word": "opostu - oposta, f.",
    "class": "Adjetivu",
    "meaning": "Neʼebé kontra ka hasoru. Sin. sorun"
  },
  {
    "word": "opozisaun",
    "class": "Substantivu",
    "meaning": "1. Hahalok opoin nian. 2. Pozisaun hasoru ka kontra ema ka buat ruma. Ez. Atu governu lao diak, ita presiza iha partidu balun neʼebé sai opozisaun."
  },
  {
    "word": "opresaun",
    "class": "Substantivu",
    "meaning": "Hahalok oprime nian. Sin. hadesin Ez. Opresaun maka'as iha tempu okupasaun halo povu barak hakarak reziste."
  },
  {
    "word": "opresivu - opresiva, f.",
    "class": "Adjetivu",
    "meaning": "Neʼebé oprime. Sin. madesik Ez. Situasaun opresiva durante okupasaun halo povu la bele espresa nia hanoin no hakarak."
  },
  {
    "word": "opresór",
    "class": "Substantivu",
    "meaning": "Ema ida neʼebé oprime. Sin. madesik Ez. Iha tinan 1999 Timoroan barakliu haksolok tebes tanba sira-nia opresór finalmente sai hosi sirania rain."
  },
  {

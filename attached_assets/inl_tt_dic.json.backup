  {
    "word": "inaugurasaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "indefensivel",
    "class": "Adjetivu",
    "meaning": "Neʼebé la bele defende. Sin. sorilabelek, defendelabelek"

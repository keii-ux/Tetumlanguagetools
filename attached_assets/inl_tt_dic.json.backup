  "sentidu": {
    "type": "Substantivu",
    "definitions": [
      "Ema nia kapasidade naturál atu haree rona, horon, sente ka koko.",
      "Liafuan ka buat nia arti ka signifikadu loloos.",
      "Kapasidade naturál atu hatene tuir.",
      "Sin. konxiénsia.",
      "Lakon sentidu katak la hatene tuir tiha no lakon nia hanoin.",
      "Atensaun; kuidadu.",
      "Hadenin ka komandu militár Sentidu! katak ‘See tilun bá’.",
      "Pontu ba ne’ebé ema ka buat ruma la’o.",

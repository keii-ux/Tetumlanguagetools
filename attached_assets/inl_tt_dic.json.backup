  {
    "word": "isik",
    "class": "Adjetivu",
    "meaning": "Isin nian; konaba isin. Sin. kor-porál, korpóreu"
  },
  {
    "word": "isin",
    "class": "Substantivu",
    "meaning": "1. Ai-fuan no modo nia na'an no kulit hamutuk. 2. Balada ka ema nia na'an, kulit no ruin hamutuk. 3. Buat ida nia parte laran ka importante."
  },
  {
    "word": "isin-balun",
    "class": "Substantivu",
    "meaning": "Liman ka ain. Sin. membru"
  },
  {
    "word": "isin-baruk",
    "class": "Adjetivul Substantivu",
    "meaning": "Sente isin ladún di'ak, moras uitoan."
  },
  {
    "word": "isin-di'ak",
    "class": "Adjetivu",
    "meaning": "Neʼebé la hetan moras ruma ka goza saúde di'ak. Substantivu Kondisaunlahetan moras nian, isintomak funsiona didi'ak. Sin. saúde"
  },
  {
    "word": "isin-fraku",
    "class": "Adjetivul Substantivu",
    "meaning": "(Neʼebé) la iha forsa, liuliu tanba moras ruma."
  },
  {
    "word": "isin-lais",
    "class": "Adjetivul Substantivu",
    "meaning": "(Neʼebé iha) kapasidade atu hanoin ka halo buat ida lailais liu."
  },
  {

  {
    "word": "habain",
    "class": "Substantivu",
    "meaning": "Hahalok habain nian."
  },
  {
    "word": "habali",
    "class": "Verbu",
    "meaning": "1. Bali ka trata tomak hotu moras ruma. 2. (arti figuradu) Rezolve (problema ida) ho tratamentu natoon ruma. Sin. remedeia"
  },
  {
    "word": "habali-belek",
    "class": "Adjetivu",
    "meaning": "Neʼebé ita bele habali. Sin. remediavel"
  },
  {
    "word": "habalin",
    "class": "Substantivu",
    "meaning": "Hahalok, dalan ka fuan habali nian. Sin. remédiu"
  },
  {
    "word": "habalu",
    "class": "Verbu",
    "meaning": "Fahe ba parte rua ketaketak. Ez. Sira habalu tiha paun nẻe molok fó ba labarik sira."
  },
  {
    "word": "habalun",
    "class": "Substantivu",
    "meaning": "Hahalok habalu nian."
  },
  {
    "word": "habanati",
    "class": "Verbu",
    "meaning": "Prepara, forma ka halo tuir banati. Sin. modela"
  },
  {
    "word": "habandu",
    "class": "Verbu",
    "meaning": "Bandu nu'udar lei ofisiál, bandu iha rain tomak. Sin. proskreve"
  },
  {
    "word": "habandun",
    "class": "Substantivu",
    "meaning": "Hahalok habandu nian. Sin. proskrisaun Adjetivu Neʼebé governu ka autoridade ruma habandu tiha ona."
  },
  {
    "word": "habanit",
    "class": "Verbu",
    "meaning": "Manán ema nia atensaun, interese ka domin ho ita-nia kualidade ruma, n.e. isin-furak, intelijénsia, ko'alia kómiku nst. Sin. enkanta, faxina Sub-stantivu Hahalok habanit nian. Sin. enkantu, faxíniu"
  },
  {
    "word": "habarak",
    "class": "Verbu",
    "meaning": "Halosaibarak. Sin. multiplika Substantivu Hahalok nian. Sin. multip-likasaun"
  },
  {
    "word": "habarani",
    "class": "Verbu",
    "meaning": "Fó aten-barani, neon-boot, motivasaun ka korajen ba ema ida. Ez. Ita tenke habarani labarik sira atu hato'o hahusuk kona-ba buat sira neʼebé susar."
  },
  {
    "word": "habaruk",
    "class": "Verbu",
    "meaning": "Halo sai baruk. Ez. Feriadu barak bele habaruk ema. Substantivu Hahalok habaruk nian."
  },
  {
    "word": "habasar",
    "class": "Verbu",
    "meaning": "Hamriik ka hela ema barak rabat malu hanesan iha basar ka merkadu. Ez. Sira lao-habasar iha lurón."
  },
  {
    "word": "habasuk",
    "class": "Verbu",
    "meaning": "Halo sai basuk ka barabarak. Substantivu Hahalok habasuk nian."
  },
  {
    "word": "habatak",
    "class": "Verbu",
    "meaning": "Hadalan bee tama ba batak ida. Substantivu Hahalok habatak nian."
  },
  {
    "word": "habau",
    "class": "Verbu",
    "meaning": "1. Halo sai dodok. 2. Halo sai aat liu, halo piór. Sin. piora"
  },
  {
    "word": "habaun",
    "class": "Substantivu",
    "meaning": "Hahalok habau nian. Sin. (2) piora"
  },
  {
    "word": "habedok",
    "class": "Verbu",
    "meaning": "1. Halo atu bedok, halo atu sai hosi nia dalan baibain nian. Sin. habees 2. Na'ok fundus ka osan boot hodi hadalan fali ba fatin seluk. Sin. dezvia Substantivu Hahalok habedok nian. Sin. (1) habees; (2) dezviu"
  },
  {
    "word": "habee mós habeen",
    "class": "Verbu",
    "meaning": "Halo sai nabeen."
  },
  {
    "word": "habeer",
    "class": "Verbu",
    "meaning": "Halo sai kabeer ka nabilan, porezemplu kose rai ho lilin ka hamoos sapatu. Substantivu Hahalokhabeernian."
  },
  {
    "word": "habeik",
    "class": "Verbu",
    "meaning": "1. Halo sai beik. 2. Halo ka trata hanesan beik. Ez. Keta habeik labarik sira tanba hahalok nee bele hamoe sira. Substantivu Hahalok ha-beik nian."
  },
  {
    "word": "habekan",
    "class": "Verbu",
    "meaning": "1. Halo sai bekan ka mamuk. Sin. hamamuk 2. (arti figuradu) Halo atu la konsege, halo atu la hetan susesu ka rezultadu di'ak. Sin. frustra Substan-tivu Hahalok habekan nian. Sin. (1) hamamuk; (2) frustrasaun"
  },
  {
    "word": "habelak",
    "class": "Verbu",
    "meaning": "Halo sai belak ka kabelak. Substantivu Hahalok habelak nian."
  },
  {
    "word": "habelar",
    "class": "Verbu",
    "meaning": "Halo sai belar. Substantivu Hahalok habelar nian."
  },
  {
    "word": "habele",
    "class": "Verbu",
    "meaning": "1. Halo posivel. Sin. posibilita 2. Halo atu ema ida hetan abilidade ka kapasidade hodi halo buat ruma. Sin. kapasita, abilita Ez. Edukasaun habele joven sira atu hetan serbisu di'ak."
  },
  {
    "word": "habelen",
    "class": "Substantivu",
    "meaning": "Hahalok habele nian."
  },
  {
    "word": "habelit",
    "class": "Verbu",
    "meaning": "Halo atu belit, halo sai belit. Substantivu Hahalok habelit nian."
  },
  {
    "word": "habelu",
    "class": "Verbu",
    "meaning": "Halo sai belun. Ez. Nia gosta habelu ema ne'ebé nia foin hasoru."
  },
  {
    "word": "habesik",
    "class": "Verbu",
    "meaning": "Halo sai besik; halo atu hak-besik, fó leet atubele hakbesik. Ez. Ita tenke habesik meza nee ba ida seluk atu labele iha espasu barak. habetek mós habetik Verbu 1. Halo sai betek. 2. (arti figuradu: habetek neon) Halo bilán, halo atu sente konfuzaun. Sin. konfunde Substantivu Hahalok habetek nian. Sin. (2) konfuzaun"
  },
  {
    "word": "habiban",
    "class": "Verbu",
    "meaning": "Halo atu biban, fó leet ka oportunidade ba. Sin. haleet Ez. Isin-kole habiban sala barak."
  },
  {
    "word": "habidu",
    "class": "Verbu",
    "meaning": "Habosok ema ida hodi halo nia halo tuir ita-nia planu aat ruma, hanesan halo boneka ida dansa. Sin. manipula Ez. Iha tinan 1999 governu indonéziu habidu Timoroan barak atu halo sira apoia kauza autonomia nian."
  },
  {
    "word": "habidun",
    "class": "Substantivu",
    "meaning": "Hahalok habetek nian. Sin. manipulasaun"
  },
  {
    "word": "habiit",
    "class": "Verbu",
    "meaning": "1. Fó kbiit ka forsa. Ez. Vitamina sira habiit ema nia isin hodi fó enerjia. 2. Fó kbiit ka autoridade atu halo buat ruma. Ez. Governu habiit fiskál sira atu prende ema sira neʼebé buka atu hatama droga ilegál mai ita-nia rain. Substantivu Hahalok habiit nian."
  },
  {
    "word": "habit",
    "class": "Substantivu",
    "meaning": "1. Buat neʼebé ita uza atu hametin sasán hanesan roupa ka surat-tahan. 2. Sipu espésie ida neʼebé bele loke no taka an. Verbu 1. Hanehan to'o hametin. 2. Hametin sasán hanesan roupa ka surat-tahan ba buat ida."
  },
  {
    "word": "habokar",
    "class": "Verbu",
    "meaning": "Halo sai bokar. Substantivu Hahalok habokar nian. habokon mós haboko Verbu Halo sai bokon. Ez. Molok kose meza, diak liu haboko lai hena iha bee. Substantivu (habokon) Hahalok habokon nian."
  },
  {
    "word": "habokur",
    "class": "Verbu",
    "meaning": "1. Halo sai bokur. 2.Halo (rai) sai bokur hodi tau estrume. Sin. fertiliza Substantivu Hahalok habokur nian. Sin. (2) fertilizasaun"
  },
  {
    "word": "habook",
    "class": "Verbu",
    "meaning": "Halo atu book an ka duka, hamosu dadukak ka movimentu. Sin. ativa, motiva Substantivu Hahalok ha-book nian. Sin. ativasaun, motivasaun"
  },
  {
    "word": "haboot",
    "class": "Verbu",
    "meaning": "Halo sai boot. Sin. aumenta Substantivu 1. Hahalok haboot nian. 2. Efeitu haboot nian. Sin. aumentu"
  },
  {
    "word": "habosan",
    "class": "Verbu",
    "meaning": "1. Halo sai bosan. 2. Hatais to'o bosan ka sai tuan tiha. Ez. Sira ha-bosan roupa nee tanba sira hatais beibeik hodi halimar iha udan-been. Substantivu Hahalok habosan nian."
  },
  {
    "word": "habosok",
    "class": "Verbu",
    "meaning": "1. Halo sai bosok. Sin. hafalsu 2. Hato'o lia-bosok. Sin. bosok 3. Hateten laloos hodi dezvia atensaun. 4. Hamaus labarik ho liafuan mamar hodi halo dukur. Ez. Aman-inan sira baibain habosok sira-nia oan atu toba sedu. Substantivu Hahalok habosok nian."
  },
  {
    "word": "habou",
    "class": "Verbu",
    "meaning": "Tau ka hada hamutuk sai aas tiha, halo sai bou ida. Ez. Sira habou fatuk iha dalan atu ema bele sosa."
  },
  {
    "word": "habou",
    "class": "Substantivu",
    "meaning": "Hahalok habou nian. Sin. akumulasaun"
  },
  {
    "word": "habuan",
    "class": "Verbu",
    "meaning": "1. Uza liafuan hodi hamulak atu buat aat ruma akontese ba ema ida. Ez. Feto ne'e buan duni tanba nia hakarak habuan katuas ne'ebé la gosta nia. 2. (arti figuradu) Halo ema atu hanoin nafatin kona-ba buat ruma to'o sai bulak. Sin. obseka Substantivu Hahalok habuan nian. Sin. (2) obsesaun Ez. Buatamak nee nia hanoin kona-ba sai riku no naran-boot sai hanesan habuan ida. Adjetivu Neʼebé ema ruma ka buat ruma habuan tiha ona. Sin. (2) obsekadu"
  },
  {
    "word": "habuar",
    "class": "Verbu",
    "meaning": "Halo sai kabuar. Substantivu Hahalok habuar nian."
  },
  {
    "word": "habubu",
    "class": "Verbu",
    "meaning": "1. Halo sai bubu. Ez. Nia mak habubu ha'u-nia ulun tanba tuku maka'as liu. 2. Haboot hodi huu ba laran ka hatama ár."
  },
  {
    "word": "habubu-belek",
    "class": "Adjetivu",
    "meaning": "Neʼebé ita bele habubu. Sin. insuflavel Ez. Kama borraxa idane'e habubu-belek hanesan balaun."
  },
  {
    "word": "habubun",
    "class": "Substantivu",
    "meaning": "Hahalokhabubu nian."
  },
  {
    "word": "habulak",
    "class": "Verbu",
    "meaning": "Halo sai bulak. Substantivu Hahalok halo bulak nian."
  },
  {
    "word": "habun (lia-)",
    "class": "Substantivu",
    "meaning": "Dalen austronéziku ida, atu hanesan lia-tetun maibé ho arkaízmu balu, neʼebé ema ko'alia iha rai-Kribas no Bariki."
  },
  {
    "word": "haburas",
    "class": "Verbu",
    "meaning": "1. Halo sai buras. Ez. Udan neebé monu loroloron haburas rai ne'e. 2. (artifiguradu) Halosairiku. Sin. hariku 3. (arti figuradu) Halo atu la'o ba oin ka sai di'ak liu. Sin. dezenvolve Substan-tivu Hahalok haburas nian. Sin. (3) dezenvolvimentu"
  },
  {
    "word": "habuur",
    "class": "Verbu",
    "meaning": "Book halo lahakmatek. Sin. hakmerak 2. (arti figuradu) inkomoda Substantivu Hahalok habuur nian. Sin. distúrbiu, hakmerak"
  },
  {
    "word": "hada",
    "class": "Verbu",
    "meaning": "Tau buat ida iha buat seluk ida nia leten halodidi'ak to'o aas. Ez. Sira hada fatuk hale'u sira-nia kintál."
  },
  {
    "word": "hadadi",
    "class": "Verbu",
    "meaning": "1. Rai osan hodi la fakar ka gasta. Sin. poupa 2. Rai ka tau matan ba buat ruma ne'ebé ita gosta no lakohi lakon."
  },
  {
    "word": "hadadin",
    "class": "Substantivu",
    "meaning": "Hahalok hadadi nian. Sin. (1) poupansa"
  },
  {
    "word": "hada'et",
    "class": "Verbu",
    "meaning": "Halo atu (moras) da'et. Sin. tranzmite Ez. Lalar no susuk hadaet moras barak."
  },
  {
    "word": "hadak",
    "class": "Substantivu",
    "meaning": "Fatin kabelak hosi au ho ain haat neʼebé baibain ema uza atu tuur ka toba iha leten; dalaruma mós uza atu habai ka tau sasán iha leten."
  },
  {
    "word": "hadalan",
    "class": "Verbu",
    "meaning": "Haruka ka halo laʼo tuir dalan. Sin. kanaliza Substantivu Hahalok hadalan nian. Sin. kanalizasaun"
  },
  {
    "word": "hadame",
    "class": "Verbu",
    "meaning": "1. Fó dame ka pás. 2. Halo atu simu malu filafali."
  },
  {
    "word": "hadamen",
    "class": "Substantivu",
    "meaning": "Hahalokhadamenian."
  },
  {
    "word": "hadaran",
    "class": "Verbu",
    "meaning": "1. Daran ho kuidadu, tau ka hatuur iha fatin loloos. 2. Halo atu sai natoon ba buat ruma. Sin. adapta Ez. Ita bele hadaran livru inglés née ba eskola Timór hodi tradús ba liatetun. Substantivu Hahalok hadaran nian. Sin. (2) adaptasaun"
  },
  {
    "word": "hadat",
    "class": "Substantivu",
    "meaning": "Lei lisan nian, lei tradi-sionál."
  },
  {
    "word": "hadata",
    "class": "Verbu",
    "meaning": "Tau data, liuliu iha dokumentui ida. Sin. data"
  },
  {
    "word": "hadatan",
    "class": "Substantivu",
    "meaning": "Hahalok hadata nian. Sin. datasaun"
  },
  {
    "word": "hadato",
    "class": "Verbu",
    "meaning": "Foti ba dato. Sin. nobilita"
  },
  {
    "word": "hadatok",
    "class": "Verbu",
    "meaning": "Halo sai datok, halo sai hanesan dato."
  },
  {
    "word": "hadaton",
    "class": "Substantivu",
    "meaning": "Hahalok hadato nian. Sin. nobilitasaun"
  },
  {
    "word": "hadau",
    "class": "Verbu",
    "meaning": "1. Hasai tiha hosi ema ida buat neʼebé ninian. 2. Kaer hodi hela ho buat neʼebé la'ós ita nian. Sin. okupa Ez. Durante funu ema barak hadau ema se-luk nia uma no rikusoin sira seluk."
  },
  {
    "word": "hadan",
    "class": "Adjetivu",
    "meaning": "Neʼebé ita hada tiha ona. Substantivu 1. Hada dala ida. 2. Buat neʼebé ita hada tiha ona."
  },
  {
    "word": "hadaun",
    "class": "Substantivu",
    "meaning": "Hahalok hadau nian. Sin. okupasaun, sekuestru"
  },
  {
    "word": "hadedar",
    "class": "Verbu",
    "meaning": "1.Halonakdedar.2. Halota'uk ladi'ak. Sin. terroriza Substantivu Ha-halok hadedar nian."
  },
  {
    "word": "hadeer",
    "class": "Verbu",
    "meaning": "1. Loke matan depoizde deskansa ka toba tiha. 2. Sai hosi toba-fatin ka kuartu depoizde toba tiha. hadele mós hadelek Verbu 1. Halo matan sai delek ba nafatin, halo atu la bele haree ona. Ez. Iha moras balu ne'ebé bele hadelek ema. 2. Halo matan sai aat ba tempu balu de'it. Ez. Ahi ne'ebé lakan maka'as bele hadelek hau. Substantivu (hadelek) Hahalok hadelek nian."
  },
  {
    "word": "hadeni",
    "class": "Verbu",
    "meaning": "Fóorden.Sin. haruka, komanda"
  },
  {
    "word": "hadera",
    "class": "Verbu",
    "meaning": "Hasai buat ruma ne'ebé ita soi ka presiza, liuliu hahán ka bee. Sin. priva. Hadera an katak la han ka hemu, baibain tan motivu relijiozu ka médiku ruma."
  },
  {
    "word": "hadera-an",
    "class": "Adjetivu",
    "meaning": "Neʼebé hadera an, neʼebé la han ka la hemu. Substantivu Hahalok la han ka la hemu nian. Sin. abstinénsia; jejún Ez. Ema barak halo hadera-an nu'udar preparasaun ba Páskua."
  },
  {
    "word": "haderan",
    "class": "Substantivu",
    "meaning": "Hahalok hadera nian. Sin. privasaun"
  },
  {
    "word": "hadesan",
    "class": "Verbu",
    "meaning": "1. Sunu tomak hotu hodi halosaiahikadesande'it. 2.Sunuisin-mate envezde hakoi iha rai. Ez. Budista sira hadesan ema mate; sarani sira hakoi fali. Substantivu Hahalok hadesan nian. Sin. insinerasaun, kremasaun"
  },
  {
    "word": "hadesi",
    "class": "Verbu",
    "meaning": "1. (Buat todan) tuur ka latan iha leten. 2. Hanehan, mós ho sentidu morál. Sin. oprime"
  },
  {
    "word": "hadesin",
    "class": "Substantivu",
    "meaning": "Hahalok hadesi nian. Sin. (2) opresaun"
  },
  {
    "word": "hadi'a",
    "class": "Verbu",
    "meaning": "1. Halo sai prontu. Sin. pre-para, haprontu Ez. Ema sei hadi'a fatin nee atu simu bainaka hosi rai-li'ur. 2. Halo buat neʼebé aat sai di'ak filafali. Sin. repara, haso'i Ez. Hảu buka ema atu hadi'a ami-nia televizaun."
  },
  {
    "word": "hadi'ak",
    "class": "Verbu",
    "meaning": "Halo sai di'ak liu duké baibain. Ez. Populasaun tomak tenke serbisu hamutuk atu hadi'a ita-nia rain ne'ebé daudaun nẻe iha problema bar-ak. Substantivu Hahalok hadi'ak nian."
  },
  {
    "word": "hadi'an 1",
    "class": "Verbu",
    "meaning": "1. Halo sai di'an. 2. (hadi'an rai) Hamoos no kuda rai. Sin. kultiva Substantivu Hahalok hadi'an nian. Sin. (1) hamaus; (2) kultivasaun"
  },
  {
    "word": "hadi'an2",
    "class": "Substantivu",
    "meaning": "Hahalok hadi'a nian. Sin. reparasaun, haso'in"
  },
  {
    "word": "hadiu",
    "class": "Verbu",
    "meaning": "Hateke metimetin ba ema ka buat ida. Sin. fibir"
  },
  {
    "word": "hadiun",
    "class": "Substantivu",
    "meaning": "Hahalok hadiu nian. Sin. fafihir"
  },
  {
    "word": "hadole",
    "class": "Verbu",
    "meaning": "1. Halo atu laʼo ba oin, hadook bá; haruka bá. 2. (hadole lia) Haruka mensajen, tatoli lia. Sin. komunika"
  },
  {
    "word": "hadolen",
    "class": "Substantivu",
    "meaning": "1. Hahalok hadole nian. 2. Hahalok hadole lia nian. Sin. komunikasaun"
  },
  {
    "word": "hadomi",
    "class": "Verbu",
    "meaning": "Sente domin ba ema ka buat ida. Ez. Atu la iha funu, ita ema tenke hadomi malu."
  },
  {
    "word": "hadomin",
    "class": "Substantivu",
    "meaning": "Hahalok hadomi nian. Sin. domin"
  },
  {
    "word": "hadook",
    "class": "Verbu",
    "meaning": "Tau iha fatin neʼebé dook; haruka ba fatin dook. Liafuan-sorun: habesik Ez. Kuidadu ho botir nee, diak liu hadook tiha hosi labarik sira. Sub-stantivu Hahalok hadook nian."
  },
  {
    "word": "hadoor",
    "class": "Verbu",
    "meaning": "1. Halo sai door ka fo'er. 2. Hafo'er meiuambiente, liuliu bee ka ár. Sin. polui Substantivu Hahalok hadoor nian. Sin. poluisaun"
  },
  {
    "word": "hadudu",
    "class": "Verbu",
    "meaning": "1. Dudu ba oin. 2. Book ema ida atu halo buat ruma. Ez. Hau tauk koalia iha sorumutu nee, maibé hau-nia kolega hadudu hau atu hato'o hau-nia opiniaun. 3. Halo atu la'o ba oin. Sin. avansa, promove 4. Buka atu halo ema simu buat ruma neʼebé ita gosta ka hakarak fa'an. Sin. promove"
  },
  {
    "word": "hadudun",
    "class": "Substantivu",
    "meaning": "Hahalokhadudunian. Sin. (3,4) promosaun"
  },
  {
    "word": "haduka",
    "class": "Verbu",
    "meaning": "Haseluk ka muda ba fatin seluk. Sin. dezloka"
  },
  {
    "word": "hadukan",
    "class": "Substantivu",
    "meaning": "Hahalok haduka nian. Sin. dezlokamentu, dezlokasaun"
  },
  {
    "word": "hadulas",
    "class": "Verbu",
    "meaning": "1. Halo hodi la'o hale'u buat ida. 2. Taka fatin hotu atu ema la bele sai ka la husik sai. Ez. Polísia hadulas tiha uma neebé naok-teen nee hela bá. Substantivu Hahalok hadulas nian. Advérbiul prepozisaun Ho movimentu le'uk ka sirkulár. Sin. hale'u Ez. Sira duni naok-teen ne'e hadulas foho."
  },
  {
    "word": "haduni",
    "class": "Verbu",
    "meaning": "Duni ba oin."
  },
  {
    "word": "hadunin",
    "class": "Substantivu",
    "meaning": "Hahalok haduni nian. Sin. propulsaun"
  },
  {
    "word": "haduu",
    "class": "Verbu",
    "meaning": "Duu ka akuza lahó prova metin ida. Sin. alega"
  },
  {
    "word": "haduun",
    "class": "Substantivu",
    "meaning": "Hahalok hadulas nian. Sin. alegasaun"
  },
  {
    "word": "hae",
    "class": "Substantivu",
    "meaning": "Du'ut espésie ida ne'ebé aas, ho tahan toos neʼebé baibain ema uza atu taka no didin uma."
  },
  {
    "word": "ha'e",
    "class": "Matadak Kontrastivu",
    "meaning": "(iha tetun-terik tasi-mane nian) Ne'e ida neʼebé. Sin. maka, mak Ez. Sira hae rona hau = Sira maka rona hau."
  },
  {
    "word": "hafahe",
    "class": "Verbu",
    "meaning": "1. Tau ketaketak tiha. Ez. Funu tinan 1975 hafahe ema barak. 2. Fahe sasán hodi fó ba ema ida-idak buat neʼebé ninian. Sin. distribui 3. Hatama bagrupukakategoriaoioin. Sin. klasifika"
  },
  {
    "word": "hafahen",
    "class": "Substantivu",
    "meaning": "Hahalok hafahe nian. Sin. (2) distribuisaun; (3) klasifikasaun"
  },
  {
    "word": "hafalsu",
    "class": "Verbu",
    "meaning": "Halo sai falsu. Sin. falsifika"
  },
  {
    "word": "hafalsun",
    "class": "Substantivu",
    "meaning": "Hahalok hafalsu nian. Sin. falsifikasaun"
  },
  {
    "word": "hafanun",
    "class": "Verbu",
    "meaning": "1. Fanun ka book atu hamosu reasaun ruma. Sin. estimula 2. (arti figuradu) Halo sai buras. Sin. haburas Substantivu Hahalok hafanun nian. Sin. (1) estímulu"
  },
  {
    "word": "hafee mós hafeen",
    "class": "Verbu",
    "meaning": "Hola feto ida sai hanesan feen maibé la tuir prosesu ha-folinfeto ka barlake. Substantivu (ha-feen) Hahalok hafee nian."
  },
  {
    "word": "hafera",
    "class": "Verbu",
    "meaning": "Halo sai nakfera ka rebenta buat ida ne'ebé tomak."
  },
  {
    "word": "haferan",
    "class": "Substantivu",
    "meaning": "Hahalok hafera nian."
  },
  {
    "word": "hafetu",
    "class": "Verbu",
    "meaning": "Tebe ka halimar ho ain. Ez. Ami futu manu rua atu sira bele hafetu malu."
  },
  {
    "word": "hafetu-malu",
    "class": "Substantivu",
    "meaning": "Jogu tebemalu entre manu neʼebé ema futu no buka tebe kona ida seluk nia oin."
  },
  {
    "word": "hafiar",
    "class": "Verbu",
    "meaning": "Halo atu fiar, hamaus ema neʼebé la fiar. Sin. konvense Ez. Mestre hafiar ha'u katak ha'u bele pasa ezame nee se hau estuda maka'as. Substantivu Hahalok ka efeitu hafiar nian. Sin. kon-viksaun"
  },
  {
    "word": "hafila",
    "class": "Verbu",
    "meaning": "1. Halo atu fila, haruka fila ba fatin dahuluk nian, porezemplu surat neʼebé la to'o ka enderesu laloos. 2. Dulas hodi fila. Ez. Mane ira hafila tiha karreta neebé monu atu kondutór bele sai."
  },
  {
    "word": "hafilan",
    "class": "Substantivu",
    "meaning": "Hahalok hafila nian."
  },
  {
    "word": "hafó",
    "class": "Verbu",
    "meaning": "Fó ka haruka ba fatin ida buat neʼebé ema presiza, n.e. aihan, materiál atu harii uma nst. Sin. fornese"
  },
  {
    "word": "hafoin",
    "class": "Advérbiu",
    "meaning": "Iha tempu neʼebé tuir, liutiha ne'e. Sin. tuirmai Ez. Hau sei asina surat importante ne'e, hafoin hau dehan ba imi saida mak imi tenke halo."
  },
  {
    "word": "hafoli mós hafolin",
    "class": "Verbu",
    "meaning": "1. Hakotu folin. Ez. Lalika hafolin resik sasán sira-nee tanba ema sei la bele sosa. 2. Hakotu folin ba feto neʼebé ita atu hola. Ez. Hafoli feto molok atu hola nia nẻ'e lisan tradisionál povu Timór nian. Substan-tivu (hafolin) Hahalok hafoli nian."
  },
  {
    "word": "hadasin",
    "class": "Verbu",
    "meaning": "1. Tau iha dasin atu tetu. 2. Husu ka bukahatene buat ida nia folin loloos. Sin. avalia Substantivu Ha-halok hadasin nian. Sin. avaliasaun"
  },
  {
    "word": "hafakar",
    "class": "",
    "meaning": "haree fakar"
  },
  {
    "word": "hafodak",
    "class": "Verbu",
    "meaning": "Haloatuhakfodak. Sin.haridak"
  },
  {
    "word": "hafón",
    "class": "Substantivu",
    "meaning": "1. Hahalok hafó nian. 2. Buat neʼebé ita hafó. Sin. fornesimentu"
  },
  {
    "word": "haforsa mós haforte",
    "class": "Verbu",
    "meaning": "Halo sai forte. Sin. hametin Ez. Ita sei haforsa ita-nia unidade atubele harii dame no justisa."
  },
  {
    "word": "haforu",
    "class": "Verbu",
    "meaning": "Husik atu sai hosi kakesik, hadadur, obrigasaun ka kanetik ruma, kore tiha hosi buat ida neʼebé kaer hela ita, halo sai livre. Sin. liberta Ez. Tim-oroan mak haforu sira-nia an rasik hosi kolonialista sira. libertasaun Substan-tivu; Sin. haforun"
  },
  {
    "word": "haforun",
    "class": "Substantivu",
    "meaning": "Hahalok haforu nian. Sin. libertasaun"
  },
  {
    "word": "hafoti",
    "class": "Verbu",
    "meaning": "Foti ka hi'it ba leten."
  },
  {
    "word": "hafoun",
    "class": "Verbu",
    "meaning": "1. Halo foun filafali buat ida. 2. Hadi'a buat ne'ebé tuan ka aat ona. 3. Halo filafali. Sin. haktenik, repete Ez. Governu rua née foin hafoun sira-nia akordu atu hasees konflitu no funu. Substantivu Hahalok hafoun nian. Sin. (1,2) renovasaun"
  },
  {
    "word": "hafreun",
    "class": "Verbu",
    "meaning": "1. Tau freun. 2. (arti figuradu) Hanetik ka hapara. Substantivu Hahalok hafreun nian."
  },
  {
    "word": "hafuda",
    "class": "Verbu",
    "meaning": "Fó ba ema fuda ka aluga. Sin. fó-aluga"
  },
  {
    "word": "hafudan",
    "class": "Substantivu",
    "meaning": "Hahalok hafuda nian."
  },
  {
    "word": "hafuhu",
    "class": "Verbu",
    "meaning": "1. Haree subasubar atu hatene loloos saida mak akontese. Ez. Inimigu sira haruka sira-nia ema atu hafuhu ami-nia atividade sira; Iha rain balu polisia hafuhu ema sira-nia telefone iha uma. 2. Subar hodi haree hosi fatin ida. Ez. Labarik sira hafuhu turista sira neʼebé hariis hela iha pixina."
  },
  {
    "word": "hafuhun",
    "class": "Substantivu",
    "meaning": "Hahalok hafuhu nian. Sin. espionajen"
  },
  {
    "word": "hafuik mós hafui",
    "class": "Verbu",
    "meaning": "Halo sai fuik. Ez. Asu sira ne'ebé hafuik an no hela iha ailaran sai si'ak lahalimar."
  },
  {
    "word": "hafukun mós hafuku",
    "class": "Verbu",
    "meaning": "Prepara ka halo fukun, nu'udar ezemplu iha tali, fiu ka kabas. Substantivu (hafukun) Hahalok hafukun nian."
  },
  {
    "word": "hafunan",
    "class": "Verbu",
    "meaning": "Tau buat neʼebé funafunan atu sai furak liután. Sin. hafutar, dekora Ez. Bainhira ema riku sira prenda, sira hafunan kadeli ho murak. Substantivu Hahalok hafunan nian. Sin. hafutar, dekorasaun"
  },
  {
    "word": "hafutar",
    "class": "Verbu",
    "meaning": "1. Halo sai nobre ka liuraik. Sin. nobilita Ez. Harohan ho laranmoos hafutar ita ema nia klamar. 2. Tau buat neʼebé funafunan atu sai furak liután. Sin. hafunan, dekora 3. Hamoos hodi la iha tan fo'er. Substantivu Hahalok hafutar nian. Sin. (2) dekorasaun"
  },
  {
    "word": "hahaas",
    "class": "Verbu",
    "meaning": "Halo aas ka foti atu sai aas tiha. Substantivu Hahalok hahaas nian."
  },
  {
    "word": "hahaat",
    "class": "Verbu",
    "meaning": "Halo aat. Sin. estraga Substan-tivu Hahalok hahaat nian. Sin. halo-aat, estragu"
  },
  {
    "word": "hahabut",
    "class": "Verbu",
    "meaning": "Tau abut; kuda hosi abut kedas. Ez.. Reza loroloron hahabut grasa no matebek iha ita ema nia klaran. Sub-stantivu Hahalok hahabut nian."
  },
  {
    "word": "hahaek",
    "class": "Verbul Substantivu",
    "meaning": "(Hahalok) ham-nasa ho lian makaʼas no naruk. Ez. La-barik toman-aat ne'ebá hahaek beibeik."
  },
  {
    "word": "hahakat",
    "class": "Substantivu",
    "meaning": "Hahalok hakat nian."
  },
  {
    "word": "hahalas",
    "class": "Verbu",
    "meaning": "Kuda ai-hun, alas ka ai-laran iha rai ida neʼebé maran no ai la iha ka ladún iha. Sin. arboriza Substantivu Ha-halok hahalas nian. Sin. arborizasaun"
  },
  {
    "word": "hahalik",
    "class": "Verbu",
    "meaning": "Halo sai halik. Sin. komplika Substantivu 1. Hahalok hahalik nian. Sin. komplikasaun 2. Kualidade halik. Sin. kompleksidade"
  },
  {
    "word": "hahalok",
    "class": "Substantivu",
    "meaning": "1. Buat neʼebé ita halo. Sin. asaun Ez. Ó-nia hahalok nee sei hamosu problema barak. 2. Oinsá mak ita halo an. Sin. komportamentu Ez. Labarik sira ne'ebé iha hahalok diak mak sira neʼebé hakarak rona aman-inan."
  },
  {
    "word": "hahalok-aat",
    "class": "Adjetivu",
    "meaning": "Neʼebé iha hahalok la di'ak ka la tuir moris baibain nian. Ez. Pesoál neebé hahalok-aat la serve atu hetan promosaun. Substantivu Ka-rakter ka komportamentu aat. hahalok-diak Adjetivu Neʼebé iha hahalok di'ak ka tuir moris baibain nian. Substantivu Karakter ka komportamentu di'ak."
  },
  {
    "word": "hahán",
    "class": "Substantivu",
    "meaning": "Buat sira ne'ebé ema, animál ka buat-moris bele han atu hetan nafatin isindi'ak no la mate. Sin. ai-han, alimentu Ez. Ita-nia maluk barak mak terus tanba hahán la iha."
  },
  {
    "word": "hahanak",
    "class": "Substantivu",
    "meaning": "Hahalok hana nian."
  },
  {
    "word": "hahata",
    "class": "Verbu",
    "meaning": "Halo atu sai atan; hasai ema nia faforuk ka liberdade. Ez.. Diabu buka nafatin atu hahata ita ema hodi dada ita ba aat."
  },
  {
    "word": "hahatan",
    "class": "Substantivu",
    "meaning": "1. Hahalokhahatanian. 2. Estadukakondisaun. Sin. eskravidaun"
  },
  {
    "word": "hahean",
    "class": "Substantivu",
    "meaning": "Hahalok hean nian."
  },
  {
    "word": "hahein",
    "class": "Substantivu",
    "meaning": "Hahalok ka tempu hein nian."
  },
  {
    "word": "haheker",
    "class": "Verbu",
    "meaning": "1. Tuu musan ka kontas ba tali hodi halo eker ka morteen. 2. (arti figuradu) Tau hamutuk buat oioin tuir orden be di'ak; atu forma tatomak ida."
  },
  {
    "word": "hahelak",
    "class": "Substantivu",
    "meaning": "Hahalok ka tempu hela nian. Sin. estadia"
  },
  {
    "word": "hahelik",
    "class": "Substantivu",
    "meaning": "Hahalok heli nian."
  },
  {
    "word": "hahemuk",
    "class": "Substantivu",
    "meaning": "1. Hahalok hemu nian. 2. Líkidu neʼebé ita hemu. Sin. hemun, bebida"
  },
  {
    "word": "hahesik",
    "class": "Substantivu",
    "meaning": "Hahalok hesi nian. Sin. diresaun"
  },
  {
    "word": "hahesuk",
    "class": "Substantivu",
    "meaning": "Hahalok hesuk nian. Sin. afirmasaun, deklarasaun"
  },
  {
    "word": "hahetok",
    "class": "Substantivu",
    "meaning": "Hahalok hetok nian. Sin. persisténsia"
  },
  {
    "word": "hahe'uk",
    "class": "Verbu",
    "meaning": "1. Halo atu he'uk ka hale'uk an. 2. Fó forma ba. Ez.. Artista haheuk figura lafaek nian ho jesu. Substantivu 1. Hahalok he'uk nian. 2. Hahalok hahe'uk nian."
  },
  {
    "word": "hahida",
    "class": "Verbu",
    "meaning": "1. Halosaiidade'it. Sin. unifika Ez. Hahida partidu barak iha governu ida nia laran bele ajuda rezolve tensaun polítika. 2. Hatama knananuk ida ba ai-knanoik ida neʼebé ema haktuir hela. Sin. hahidar"
  },
  {
    "word": "hahidak",
    "class": "Substantivu",
    "meaning": "Kondisaun sai ka hela ida de'it, la ketaketak ona. Sin. unidade Ez. Timór hetan independénsia tanba hahidak neʼebé makaas liu."
  },
  {
    "word": "hahidan",
    "class": "Substantivu",
    "meaning": "Hahalok hahida nian. Sin. (1) unifikasaun"
  },
  {
    "word": "hahidar",
    "class": "",
    "meaning": "haree hahida"
  },
  {
    "word": "hahi'i",
    "class": "Verbu",
    "meaning": "Ko'alia di'ak konaba ema ida hodi foti nia. Sin. gaba, louva Ez. Ita presiza hatene hahi'i ema bainhira sira halo buat di'ak."
  },
  {
    "word": "hahi'i-bosok",
    "class": "VerbulSubstantivu",
    "meaning": "(Hahalok) gaba ho laran-makerek."
  },
  {
    "word": "hahi'in",
    "class": "Substantivu",
    "meaning": "Hahalok hahi'i nian. Sin. louvór. Hahi'in Divinu neʼe orasaun sira neʼebé amlulik sira tenke reza loroloron aleinde santa misa, nakfahe ba matinas, laudes, vésperas, kompletas nst."
  },
  {
    "word": "hahikar",
    "class": "Substantivu",
    "meaning": "Hahalok hikar nian."
  },
  {
    "word": "hahikuk",
    "class": "Substantivu",
    "meaning": "Hahalok hiku nian. Sin. kompoin Substantivu Hahalok haheker nian. Sin. kompozisaun"
  },
  {
    "word": "hahilas",
    "class": "Verbu",
    "meaning": "1. Halo buat ida ka ema ida nia ilas ka imajen. 2. Haree to'ok, n.e. iha mehi. Sin. imajina Substantivu Hahalok hahilas nian. Sin. (2) imajinasaun"
  },
  {
    "word": "hahilik",
    "class": "Substantivu",
    "meaning": "Hahalok hili nian. Sin. eleisaun"
  },
  {
    "word": "hahira",
    "class": "Verbu",
    "meaning": "Hatudu ka kalkula hira. Sin. kuantifika"
  },
  {
    "word": "hahirak",
    "class": "Substantivu",
    "meaning": "Sasán ka ema hira loos. Sin. kuantidade"
  },
  {
    "word": "hahirus",
    "class": "Verbu",
    "meaning": "Halo atu sai hirus."
  },
  {
    "word": "hahoa mós hahoan",
    "class": "Verbu",
    "meaning": "Hahoris balada oan ida. Substantivu (hahoan) Hahalok hahoa nian."
  },
  {
    "word": "hahobok",
    "class": "Verbu",
    "meaning": "Halo atu hobok ka ansi."
  },
  {
    "word": "hahodik",
    "class": "Substantivu",
    "meaning": "Hahalok hodi nian. Sin. lalorik"
  },
  {
    "word": "hahoek",
    "class": "Substantivu",
    "meaning": "Hahalok hoe nian. Sin. tateek"
  },
  {
    "word": "hahohok",
    "class": "Substantivu",
    "meaning": "Hahalok oho nian. Sin. asasíniu"
  },
  {
    "word": "hahoin",
    "class": "Verbu",
    "meaning": "1. Dudu ba oin; halo atu la'o ba oin. Sin. avansa 2. Hato'o ideia ka planu ruma. Sin. propoin, sujere Ez. Nia hahoin atu ami hamaluk nia ba estádiu. Substantivu Hanoin ida neʼebé ita hahoin. Sin. proposta, sujestaun"
  },
  {
    "word": "haho'ir",
    "class": "Substantivu",
    "meaning": "Hahalok ho'ir nian. Sin. salvasaun"
  },
  {
    "word": "hahois",
    "class": "Verbu",
    "meaning": "1. Sisi matak buat ruma neʼebé ita hakarak. 2. Aproveita ema seluk atu hetan buat ruma neʼebé ita kaan. Sin. esplora Substantivu Hahalokhahoisnian. Sin. estorsaun"
  },
  {
    "word": "hahokos",
    "class": "Verbu",
    "meaning": "Hela ka nakfati iha okos."
  },
  {
    "word": "hahokuk",
    "class": "Substantivu",
    "meaning": "Hahalok hoku nian."
  },
  {
    "word": "haholak",
    "class": "Substantivu",
    "meaning": "Hahalok hola nian."
  },
  {
    "word": "hahoman",
    "class": "Substantivu",
    "meaning": "Hahalok homan nian."
  },
  {
    "word": "hahopuk",
    "class": "Substantivu",
    "meaning": "Hahalok hopu nian. Sin. galope"
  },
  {
    "word": "hahoris",
    "class": "Verbu",
    "meaning": "1. Tuur ahi ba ema ka balada. 2. Hamosu ka kria. Substantivu Ha-halok hahoris nian."
  },
  {
    "word": "hahotas",
    "class": "Verbu",
    "meaning": "Haketak fatin ka tempu ho leet ida. Sin. haleet Substantivu Hahalok ka efeitu hahotas nian. Sin. intervalu"
  },
  {
    "word": "hahú",
    "class": "Verbu",
    "meaning": "Hala'o parte dahuluk, halo ba-dadaun. Sin. komesa Ez. Sira foin hahú harii kapela foun ida iha tasiibun."
  },
  {
    "word": "hahuhik",
    "class": "Substantivu",
    "meaning": "Hahalok hihi nian. Sin. rekrutamentu"
  },
  {
    "word": "hahukun",
    "class": "Verbu",
    "meaning": "Hamonu kastigu ba ema ida krime neʼebé nia halo. Sin. kondena Substantivu Hahalok hahukun nian. Sin. kondenasaun"
  },
  {
    "word": "hahún",
    "class": "Verbu",
    "meaning": "Hatuur buat nia hun, komesa harii ka tau baze. Sin. funda Substantivu Hahalok hahún nian. Sin. fundasaun"
  },
  {
    "word": "hahurat",
    "class": "Verbu",
    "meaning": "1. Si'ik hodi fihir urat. 2. (arti luan) Si'ik konaba lia ruma, ka konaba futuru. Sin. profetiza Substan-tivu Hahalok hahurat nian. Sin. pro-fesia, sasi'ik"
  },
  {
    "word": "hahusar",
    "class": "Verbu",
    "meaning": "Halibur-haloot iha fatin ida de'it. Sin. konsentra Substantivu Ha-halok hahusar nian. Sin. konsentrasaun asaun"
  },
  {
    "word": "hahusik",
    "class": "Substantivu",
    "meaning": "Hahalok husik nian."
  },
  {
    "word": "hahusuk",
    "class": "Substantivu",
    "meaning": "1. Hahalok husu nian. 2. Liafuan husu nian. Sin. lia-husu, per-gunta 3. Buat neʼebé ita hato'o ho in-tensaun atu hetan fali nia hatán. Sin. pedidu Ez. Ami iha hahusuk balu atu hato'o ba diretór kona-ba asuntu oioin."
  },
  {
    "word": "hai",
    "class": "Substantivu",
    "meaning": "Ikan espésie ida ho isin mihis no belar no ikun naruk no moruk. Sin. ikan-pari. Naran-sientífiku: Dasyatis"
  },
  {
    "word": "Haití (rai-)",
    "class": "Substantivu",
    "meaning": "Rain no estadu ida iha Tasi- Antillas."
  },
  {
    "word": "haitianu - haitiana",
    "class": "f. Adjetivu",
    "meaning": "Rai-Haití nian. Substantivu Ema Haití."
  },
  {
    "word": "haka'as",
    "class": "Verbu",
    "meaning": "1. Uza forsa hodi hametin uat sira atu hala'o atividade ida. 2. Uza forsa morál ka podér atu halo ema ida halo buat ruma. Sin. obriga Ez. Sol-dadu sira haka'as ami atu fó hahán ba sira maski ami hamlaha. Haka'as an katak halo esforsu. Substantivu Hahalok haka'as nian. Sin. obrigasaun"
  },
  {
    "word": "hakaat",
    "class": "Verbu",
    "meaning": "1. Hatete aat, dehan aat. 2. Tolok ho liafuan aat. Substantivu Ha-halok hakaat nian. Sin. (1) kalúnia, ha-teteaat"
  },
  {
    "word": "hakahik",
    "class": "Verbu",
    "meaning": "Hanetik ka hapara ho li-afuan. Sin. bandu Substantivu Hahalok hakahik nian. Sin. bandun"
  },
  {
    "word": "haka'ik",
    "class": "",
    "meaning": "haree haka'it"
  },
  {

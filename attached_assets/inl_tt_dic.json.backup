      "class": "Substantivu",
      "meaning": "Kafu'ak mamar rua iha ema nia kakorok laran, nakfati loloos iha tatolan nia kraik."
    },
    {
      "word": "amigdalite,",
      "class": "Substantivu",
      "meaning": "Moras amígdala nian."
    },
    {
      "word": "amigu - amiga, f.",
      "class": "Substantivu",
      "meaning": "Ema ida neʼebé ita gosta, baibain koñese kleur ona, no haree malu didi'ak. Sin. belun."
    },
    {
      "word": "ami-nia,",
      "class": "Pronome maksoik",
      "meaning": "Neʼebé ami mak soi."
    },
    {
      "word": "ami-nian,",
      "class": "Pronome maksoik",
      "meaning": "Neʼebé ami mak soi. Maklalin ka variante ne'e hanesan ho ami-nia, maibé tuir Substantivu ida-neʼebé nia refere bá. Ez. Ami la hatene sira-nia lian; ami hatene ami-nian de'it."
    },
    {
      "word": "amistozu - amistoza, f.",
      "class": "Adjetivu",
      "meaning": "(Hahalok ka atitude) hanesan amigu ka belun nian. Sin. belun."
    },
    {
      "word": "amizade,",
      "class": "Substantivu",
      "meaning": "Kondisaun sai ema nia belun. Sin. babelun."
    },
    {
      "word": "amlulik,",
      "class": "Substantivu",
      "meaning": "Mane ida neʼebé hala'o kultu relijiozu no hanorin kona-ba Maromak. Sin. na'i-lulik, padre, amu-lulik."
    },
    {
      "word": "amnézia,",
      "class": "Substantivu",
      "meaning": "Moras haluha buat hotu-hotu, liuliu tanba trauma ka xoke ruma."
    },
    {
      "word": "amnéziku - amnézika, f.",
      "class": "Adjetivu",
      "meaning": "Kona-ba amnézia; ema ne'ebé sofre amnézia."
    },
    {
      "word": "amnistia,",
      "class": "Substantivu",
      "meaning": "Perdua jerál ka kasu sala ba ema ida ka ema-lubun ida neʼebé tribunál ida kondena tiha ona."
    },
    {
      "word": "amónia,",
      "class": "Substantivu",
      "meaning": "1. Gás kór-laek ida ho iis maka'as tebetebes. 2. (Amónia-been) Solusaun ida halo hosi amónia no bee, neʼebé ema uza nu'udar buat-hamoos."
    },
    {
      "word": "amór,",
      "class": "Substantivu",
      "meaning": "1. Sentimentu di'ak, mamar no furak ba ema ruma, baibain ema seksu oin-sorun nian. Sin. domin. 2. Títulu kariñozu neʼebé ema fó ba nia feen, la'en ka amante."
    },
    {
      "word": "amostra,",
      "class": "Substantivu",
      "meaning": "1. Ezemplu ida de'it hosi buat ida neʼebé iha barak, liuliu objetu ida neʼebé ita bele sosa. 2. Banati ba suku hatais. Ez. Ho amostra, feto sira bele suku renda sai loos hanesan de'it."
    },
    {
      "word": "ampere,",
      "class": "Substantivu",
      "meaning": "Unidade ka kahidak báziku ba sasulik nia kbiit."
    },
    {
      "word": "amplifikadór,",
      "class": "Substantivu",
      "meaning": "Aparellu ida hodi aumenta ema nia lian halo boot ka maka'as."
    },
    {
      "word": "ampola,",
      "class": "Substantivu",
      "meaning": "Lampu oin ida ho forma kabuar ka telun, halo hosi vidru mihis, neʼebé ita liga ba elétriku-fatin atu fó naroman."
    },
    {
      "word": "amu,",
      "class": "Substantivu",
      "meaning": "1.Ema ida neʼebé ema seluk nia patraun ka xefe. Sin. na'in, patraun. 2. Títulu haraik-an neʼebé ita fó ba patraun, xefe ka amlulik."
    },
    {
      "word": "amu-lulik,",
      "class": "Substantivu",
      "meaning": "haree amlulik."
    },
    {
      "word": "an,",
      "class": "Pronome malenok",
      "meaning": "Liafuan ida neʼebé refere ba ema rasik ida ne'ebé ko'alia ka hakerek, ka ba hahalok ida neʼebé kona nia de'it. Ez. Nia ko'alia ba nia an duni; Sira fase an ho bee no sabaun."
    },
    {
      "word": "analfabetu - analfabeta, f.",
      "class": "Substantivu | Adjetivu",
      "meaning": "1. (Ema) ne'ebé seidauk hatene lee no hakerek. 2. Ema neʼebé seidauk hetan edukasaun formál."
    },
    {
      "word": "analfabetizmu,",
      "class": "Substantivu",
      "meaning": "Kondisaun analfabetu nian."
    },
    {
      "word": "analista,",
      "class": "Substantivu",
      "meaning": "Ema neʼebé analiza ka baibain halo anālize."
    },
    {
      "word": "analiza,",
      "class": "Verbu",
      "meaning": "Haree didi'ak substánsia, hakerek ka situasaun ida, hodi le'et ka ezamina nia aspetu oioin atubele hatene nia estrutura oinsá loos. Ez. Médiku sira analiza pasiente nia raan uluk hodi haree moras ne'e saida."
    },
    {
      "word": "análize,",
      "class": "Substantivu",
      "meaning": "Hahalok analiza nian."
    },
    {
      "word": "analjéziku - analjézika, f.",
      "class": "Adjetivu | Substantivu",
      "meaning": "(Aimoruk) neʼebé halakon moras."
    },
    {
      "word": "ananás,",
      "class": "Substantivu",
      "meaning": "Ai-fuan ida ho kulit no tahan tarak neʼebé nia isin morin no been barak. Sin. bora-malae, ai-nanás."
    },
    {
      "word": "analojia,",
      "class": "Substantivu",
      "meaning": "Hanesan ka komparasaun ida neʼebé hatudu katak buat rua hanesan malu tanba aspetu ka karakterístika partikulár ruma."
    },
    {
      "word": "análogu - análoga, f.",
      "class": "Adjetivu",
      "meaning": "Ne'ebé hanesan ka bele kompara ho buat seluk."
    },
    {
      "word": "anar,",
      "class": "Substantivu",
      "meaning": "Ai nia rohan neʼebé hela bainhira ahi han tiha ona no bele uza nu'udar ahi-tunu hodi lalar na'an ka atu estrika."
    },
    {
      "word": "anarkia,",
      "class": "Substantivu",
      "meaning": "Estadu ka kondisaun bainhira ukun ka governu la iha."
    },
    {
      "word": "anárkiku - anárkika, f.",
      "class": "Adjetivu",
      "meaning": "Kona-ba anarkia."
    },
    {
      "word": "anarkista,",
      "class": "Substantivu",
      "meaning": "Ema ida neʼebé hali'is ba anarkia, ka hamosu anarkia, mós nu'udar objetivu polítiku."
    },
    {
      "word": "anatomia,",
      "class": "Substantivu",
      "meaning": "(Siénsia kona-ba) estrutura isin nian."
    },
    {
      "word": "anatómiku - anatómika, f.",
      "class": "Adjetivu",
      "meaning": "Kona-ba anatomia."
    },
    {
      "word": "anauk,",
      "class": "Verbu | Substantivu",
      "meaning": "(Hahalok) hakona inus ho inus hodi hatudu domin ka afeisaun."
    },
    {
      "word": "anaun,",
      "class": "Substantivu",
      "meaning": "Ema ida neʼebé moris mai badak-oan no la bele naboot ba estatura normál tanba defeitu jenétiku. Sin. mautuuk (m.), buituuk (f.). Ez. Mestra fó kastigu ba alunu sira ne'ebé goza labarik anaun ne'e."
    },
    {
      "word": "anaunserke,",
      "class": "Konjunsaun",
      "meaning": "Se la...; karik lae... Ez. Ha'u sei selu konta neʼe anaunserke ó selu tiha ona."
    },
    {
      "word": "andaime,",
      "class": "Substantivu",
      "meaning": "Hariin ka estrutura neʼebé ema harii iha uma nia oin atubele sa'e ba leten hodi halo knaar ruma, n.e. halo didin, hadi'a uma-kakuluk, ka hamoos janela. Sin. aldame."
    },
    {
      "word": "andár,",
      "class": "Substantivu",
      "meaning": "Uma aas nia hein ka nivel ida. Sin. labis."
    },
    {
      "word": "Andes (Fohor-),",
      "class": "Substantivu",
      "meaning": "Foho-kadoek aas tebetebes neʼebé tuir kontinente Amérika Súl nia raat loromonu."
    },
    {
      "word": "andór,",
      "class": "Substantivu",
      "meaning": "Ai-kabelak boot ida neʼebé mane na'in-haat ka liu lori iha prosisaun, ho estátua ida iha leten."
    },
    {
      "word": "Andorra (rai-),",
      "class": "Substantivu",
      "meaning": "Rain no estadu ki'ikoan ida iha Fohor-Pireneus, entre rai-Fransa no rai-España, ho populasaun ida neʼebé koʼalia katalaun."
    },
    {
      "word": "andorranu - andorrana, f.",
      "class": "Adjetivu | Substantivu",
      "meaning": "Adjetivu: Rai-Andorra nian. Substantivu: Ema Andorra."
    },
    {
      "word": "anedota,",
      "class": "Substantivu",
      "meaning": "Haktuir badak ida kona-ba mamosuk kómiku ka interesante ida."
    },
    {
      "word": "anedótiku - anedótika, f.",
      "class": "Adjetivu",
      "meaning": "Kona-ba anedota."
    },
    {
      "word": "aneksa,",
      "class": "Verbu",
      "meaning": "1. Hatutan dokumentu ka fixeiru ida ba surat ka lia-tatoli. 2. (Nasaun ida) hadau nasaun seluk nia territóriu."
    },
    {
      "word": "aneksasaun,",
      "class": "Substantivu",
      "meaning": "Hahalok aneksa nian."
    },
    {
      "word": "anemia,",
      "class": "Substantivu",
      "meaning": "Moras kuran raan, ka raan menus hodi fó sinál isin kinur hotu. Sin. raan-mukit."
    },
    {
      "word": "anémiku - anémika, f.",
      "class": "Adjetivu",
      "meaning": "Kona-ba anemia; ne'ebé sofre anemia."
    },
    {
      "word": "anestezia,",
      "class": "Substantivu",
      "meaning": "Ai-moruk ida neʼebé uza hodi sona ita-nia isin halo matek, halakon moras ka la sente moras durante operasaun. Sin. anestéziku."
    },
    {
      "word": "anfíbiu - anfíbia, f.",
      "class": "Substantivu | Adjetivu",
      "meaning": "(Kona-ba) animál ida neʼebé moris iha rai no iha bee hotu, hanesan manduku."
    },
    {
      "word": "Angila (rai-),",
      "class": "Substantivu",
      "meaning": "Rai-kotun no estadu ki'ikoan iha Tasi-Antillas."
    },
    {
      "word": "angilanu - angilana, f.",
      "class": "Adjetivu | Substantivu",
      "meaning": "Adjetivu: Rai-Angila nian. Substantivu: Ema Angila."
    },
    {
      "word": "anglikanu - anglikana, f.",
      "class": "Substantivu | Adjetivu",
      "meaning": "(Kona-ba) kreda protestante neʼebé relijiaun ofisiál rai-Inglaterra no Reinu Naklibur nian. Iha mós anglikanu barak iha rai-Austrália, Zelándia Foun, Áfrika Súl, Kanadá no Estadu Naklibur Sira."
    },
    {
      "word": "anglikanizmu,",
      "class": "Substantivu",
      "meaning": "Doutrina ka prátika kreda anglikana nian."
    },
    {
      "word": "anglisiza,",
      "class": "Verbu",
      "meaning": "Halo atu sai inglés, ka hanesan povu inglés ka nia lian."
    },
    {
      "word": "anglisizadu - anglisizada, f.",
      "class": "Adjetivu",
      "meaning": "Ne'ebé sai tiha ona hanesan inglés."
    },
    {
      "word": "anglisizasaun,",
      "class": "Substantivu",
      "meaning": "Hahalok anglisiza nian."
    },
    {
      "word": "anglisizmu,",
      "class": "Substantivu",
      "meaning": "Liafuan ka espresaun lia-inglés nian ne'ebé tama ba dalen seluk."
    },
    {
      "word": "anglofilia,",
      "class": "Substantivu",
      "meaning": "Gostu ka domin boot ba kultura anglosaksónika ka dalen inglés."
    },
    {
      "word": "anglófilu - anglófila, f.",
      "class": "Adjetivu | Substantivu",
      "meaning": "Adjetivu: Kona-ba anglofilia. Substantivu: Ema ida neʼebé kona anglofilia."
    },
    {
      "word": "anglofobia,",
      "class": "Substantivu",
      "meaning": "Ódiu ka hakribi ba kultura anglosaksónika ka dalen inglés."
    },
    {
      "word": "anglófobu - anglófoba, f.",
      "class": "Adjetivu | Substantivu",
      "meaning": "Adjetivu: Kona-ba anglofobia. Substantivu: Ema ida neʼebé kona anglofobia."
    },
    {
      "word": "anglomania,",
      "class": "Substantivu",
      "meaning": "Gostu ka domin ezajeradu ba kultura anglosaksónika ka dalen inglés."
    },
    {
      "word": "anglómanu - anglómana, f.",
      "class": "Adjetivu | Substantivu",
      "meaning": "Adjetivu: Kona-ba anglomania. Substantivu: Ema ida neʼebé kona anglomania."
    },
    {
      "word": "anglosaksóniku - anglosaksónika, f.",
      "class": "Substantivu | Adjetivu",
      "meaning": "1. (Kona-ba) ema neʼebé ko'alia inglés nu'udar nia dalen-inan. 2. (Kona-ba) membru hosi povu jermániku kulit-mutin neʼebé lori lia-inglés ba rai-Inglaterra hosi rai-Dinamarka no rai-Alemaña norte iha sékulu dalimak liutiha Kristu."
    },
    {
      "word": "Angola (rai-),",
      "class": "Substantivu",
      "meaning": "Rain no estadu ida iha tasimane Áfrika nian, besik Tasi-Boot Atlántiku. Uluk provínsia tasi-balun rai-Portugál nian."
    },
    {
      "word": "angolanu - angolana, f.",
      "class": "Adjetivu | Substantivu",
      "meaning": "Adjetivu: Rai-Angola nian. Substantivu: Ema Angola."
    },
    {
      "word": "anima,",
      "class": "Verbu",
      "meaning": "1. Fó aten-barani, vontade ka motivasaun ba ema ruma. Sin. enkoraja. Ez. Treinadór hatene anima nia jogadór sira atubele joga di'ak liután; Múzika ne'e anima ema barak hodi halo sira dansa la para. 2. Hamoris, haburas. 3. Halo atu sai hanesan ema ka balada moris. Ez. Filme ne'e anima ai-fuan sira, halo sira ko'alia hanesan ita ema."
    },
    {
      "word": "animadu - animada, f.",
      "class": "Adjetivu",
      "meaning": "Ne'ebé ho ánimu; rame."
    },
    {
      "word": "animasaun,",
      "class": "Substantivu",
      "meaning": "Hahalok anima nian."
    },
    {
      "word": "animál,",
      "class": "Substantivu | Adjetivu",
      "meaning": "Substantivu: Kriatura ka buat-moris neʼebé barakliu soi ain haat no la bele hanoin ka ko'alia hanesan ema maibé uza instintu atubele hatene saida mak di'ak no saida mak aat. Sin. balada. Adjetivu: 1. Balada nian, kona-ba balada. 2. Neʼebé la'ós ai-horis ka buat moris-laek hanesan fatuk; kona-ba ema ka balada."
    },
    {
      "word": "anin,",
      "class": "Substantivu",
      "meaning": "1. Elementu neʼebé huu ai, du'ut no bee halo sira nakdoko; ár maka'as neʼebé ita sente maibé la bele kaer ka haree-hetan. 2. Iis neʼebé ema no balada sira respira. Sin. ár."
    },
    {
      "word": "anin-boot,",
      "class": "Substantivu",
      "meaning": "Anin neʼebé huu maka'as hodi halo ai-hun sira mós tohar, batar sira latan ka toba ba rai."
    },
    {
      "word": "anin-dadurus,",
      "class": "Substantivu",
      "meaning": "Anin fuik neʼebé nakdulas no ita bele haree-hetan tanba foti rai-rahun barak."
    },
    {
      "word": "anin-fuik,",
      "class": "Substantivu",
      "meaning": "1. Anin boot no maka'as lahalimar neʼebé bele estraga ai-hun, uma no ró. Sin. tufaun. 2. Anin neʼebé baibain de'it maibé halo ita-nia isin bubu hotu, kafu'ak ne'e katak anin-fuik maka kona."
    },
    {
      "word": "anin-hirin,",
      "class": "Substantivu",
      "meaning": "Anin kmaan ida."
    },
    {
      "word": "anin-laek,",
      "class": "Adjetivu | Substantivu",
      "meaning": "Adjetivu: Iha neʼebé anin la huu. Substantivu: Tempu hakmatek ka kalma; anin la iha."
    },
    {
      "word": "anin-teen,",
      "class": "Substantivu",
      "meaning": "Balada tasi hosi família selenteradu sira-nian, ho isin mamar, tentákulu naruk neʼebé moruk no bele tata. Anin-teen sira baibain namlele iha bee leten."
    },
    {
      "word": "anís,",
      "class": "Substantivu",
      "meaning": "Musan ida neʼebé ema uza atu hamorin dose no hemun oioin."
    },
    {
      "word": "aniversáriu,",
      "class": "Substantivu",
      "meaning": "1. Festa ka celebrasaun tinan-tinan nian hodi hanoin fali mamosuk ruma, n.e. loron moris ka mate nian. 2. Loron halo-tinan."
    },
    {
      "word": "Ánjelus,",
      "class": "Substantivu",
      "meaning": "Orasaun ida ho ave-maria sia neʼebé sarani katóliku sira reza iha dadeer, meiudia no rai-nakaras hodi hanoin fali Kristu Nia enkarnasaun."
    },
    {
      "word": "anju,",
      "class": "Substantivu",
      "meaning": "Klamar ida neʼebé haree-labele, isin-laek no soi kbiit boot, neʼebé Maromak kria atubele serbí Nia no tulun ita ema. Ez. Anju ida maka mai fó-hatene ba Maria katak nia atu sai Jezús nia inan."
    },
    {
      "word": "anjéliku - anjélika, f.",
      "class": "Adjetivu",
      "meaning": "Kona-ba anju; hanesan anju."
    },
    {
      "word": "anju-mahein,",
      "class": "Substantivu",
      "meaning": "Anju ida neʼebé Maromak fó ba ema ida-idak atu hein nia no hasai nia hosi perigu espirituál no fíziku oioin."
    },
    {
      "word": "anju-oan,",
      "class": "Substantivu",
      "meaning": "1. Anju ki'ik ida. 2. Kosok-oan ida neʼebé mate."
    },
    {
      "word": "ankor,",
      "class": "Substantivu",
      "meaning": "Besi todan ida ho tali rohan ida kesi ba nia no rohan seluk fali kesi ba ró, besi neʼebé ema hamonu ba tasi-kidun hodi kaer netik ró atu labele bá-mai. Sin. fatuk-sa'un, ánkora."
    },
    {
      "word": "anó,",
      "class": "Substantivu",
      "meaning": "Títulu hodi hasé mane-oan."
    },
    {
      "word": "anoi,",
      "class": "Substantivu",
      "meaning": "Títulu hodi hasé feto-oan."
    },
    {
      "word": "anomalia,",
      "class": "Substantivu",
      "meaning": "Hahalok ka situasaun ida neʼebé la tuir ka kontra regra sira baibain nian."
    },
    {
      "word": "anómalu - anómala, f.",
      "class": "Adjetivu",
      "meaning": "Ne'ebé la tuir norma; ne'ebé iha anomalia."
    },
    {
      "word": "anónimu - anónima, f.",
      "class": "Adjetivu",
      "meaning": "1. (Ema) neʼebé la fó nia naran. 2. (Ema) neʼebé ita la hatene nia naran, liuliu autór."
    },
    {
      "word": "anonimatu,",
      "class": "Substantivu",
      "meaning": "Kondisaun anónimu nian."
    },
    {
      "word": "anoreksia,",
      "class": "Substantivu",
      "meaning": "Moras ida neʼebé halakon ema nia apetite ka kaan atu han."
    },
    {
      "word": "anoréksiku - anoréksika, f.",
      "class": "Adjetivu",
      "meaning": "Kona-ba anoreksia; ema ne'ebé sofre anoreksia."
    },
    {
      "word": "anormál,",
      "class": "Adjetivu",
      "meaning": "Neʼebé laós normál. Liafuan-sorun: normál."
    },
    {
      "word": "anormalidade,",
      "class": "Substantivu",
      "meaning": "Kualidade ka kondisaun anormál nian."
    },
    {
      "word": "anota,",
      "class": "Verbu",
      "meaning": "Halo nota (iha livru laran)."
    },
    {
      "word": "anotasaun,",
      "class": "Substantivu",
      "meaning": "Hahalok anota nian; nota ne'ebé hakerek."
    },
    {
      "word": "ansi,",
      "class": "Advérbiu",
      "meaning": "Hakarak loos atu bá lailais ka mai lailais. Sin. hobok. Ez. Ha'u hein ansi loos oras atu bele hahú fali vida foun iha Dili."
    },
    {
      "word": "antagonizmu,",
      "class": "Substantivu",
      "meaning": "Hanoin aat ka hali'is ba funu entre ema naʼin-rua."
    },
    {
      "word": "Antártida (rai-),",
      "class": "Substantivu",
      "meaning": "Kontinente malirin tebetebes iha Polu Súl, neʼebé taka nafatin ho jelu no ema ida la bele horik bá."
    },
    {
      "word": "antártiku - antártika, f.",
      "class": "Adjetivu | Substantivu",
      "meaning": "Adjetivu: Rai-Antártida nian. Substantivu: Tasi-Boot Antártiku, tasi ida-neʼebé hale'u rai-Antártida."
    },
    {
      "word": "antena,",
      "class": "Substantivu",
      "meaning": "Lolon elétriku naruk ida neʼebé uza atu kaer laloron rádiu ka televizaun nian."
    },
    {
      "word": "antes,",
      "class": "Advérbiu | Konjunsaun",
      "meaning": "Advérbiu: Iha tempu liu tiha ona; nanis kedas. Sin. uluk. Konjunsaun: Liafuan ida neʼebé haktemik tempu bainhira buat ruma seidauk mosu. Sin. molok, antesde. Ez. Sira prepara jantár ne'e antes ami to'o."
    },
    {
      "word": "antianti,",
      "class": "Substantivu",
      "meaning": "Brinku naruk neʼebé feto sira tara iha tilun-tahan."
    },
    {
      "word": "antibiótiku - antibiótika, f.",
      "class": "Adjetivu | Substantivu",
      "meaning": "Adjetivu: Neʼebé hatau netik mikroorganizmu atubele dezenvolve. Substantivu: (antibiótiku) Substánsia kímika ka ai-moruk neʼebé hatau netik mikroorganizmu. Ez. Penisilina ne'e antibiótiku ida forte tebetebes."
    },
    {
      "word": "antídotu,",
      "class": "Substantivu",
      "meaning": "Ai-moruk ida neʼebé iha kbiit atu halakon venenu nia efeitu aat. Sin. ai-sorun."
    },
    {
      "word": "antífona,",
      "class": "Substantivu",
      "meaning": "Versíkulu ida neʼebé sarani sira sani ka hananu uluk ba salmu ida-idak hosi reza Ofísiu Divinu."
    },
    {
      "word": "antigu - antiga, f.",
      "class": "Adjetivu",
      "meaning": "1. Neʼebé nia otas tuan tebetebes. 2. Neʼebé moris ka eziste tinan barabarak liubá, no ohin ita la hetan ona. Sin. lakin."
    },
    {
      "word": "Antígua (rai-),",
      "class": "Substantivu",
      "meaning": "Rai-kotun no estadu ki'ikoan iha Tasi-Antillas."
    },
    {
      "word": "antiguanu - antiguana, f.",
      "class": "Adjetivu | Substantivu",
      "meaning": "Adjetivu: Rai-Antígua nian. Substantivu: Ema Antígua."
    },
    {
      "word": "antiguidade,",
      "class": "Substantivu",
      "meaning": "1. Tempu ka otas tinan rihun rua ka liu liubá. Sin. bain-lakin. 2. Buat tuan ruma, liuliu movel ka pesa-arte."
    },
    {
      "word": "antikonsesaun,",
      "class": "Substantivu",
      "meaning": "Prátika ka métodu atu hanetik labarik atu nanaran ka hetan forma iha oan-fatin inan nian. Sin. kontrasesaun."
    },
    {
      "word": "antikonsesionál,",
      "class": "Adjetivu | Substantivu",
      "meaning": "Adjetivu: Kona-ba antikonsesaun. Substantivu: Ai-moruk ka aparellu ida neʼebé hamosu antikonsesaun. Sin. kontrasetivu."
    },
    {
      "word": "antillanu - antillana, f.",
      "class": "Adjetivu | Substantivu",
      "meaning": "Adjetivu: Rai-Antillas nian. Substantivu: Ema Antillas."
    },
    {
      "word": "Antillas (rai-),",
      "class": "Substantivu",
      "meaning": "Nusa-lubun boot iha Amérika Klaran nia sorin lorosa'e, nakfahe ba Nusa-Antillas Boot no Nusa-Antillas Ki'ik. Zona ne'e Tasi-Antillas (Tasi Karaiba) mak hale'u."
    },
    {
      "word": "antílope (rusa-),",
      "class": "Substantivu",
      "meaning": "Rusa espésie ida neʼebé horik iha rai-Áfrika."
    },
    {
      "word": "antipatia,",
      "class": "Substantivu",
      "meaning": "Laran-aat ne'ebé ita sente ba buat ka ema neʼebé ita la gosta."
    },
    {
      "word": "antipátiku - antipátika, f.",
      "class": "Adjetivu",
      "meaning": "(Ema ka buat) neʼebé ita la gosta tanba laran-aat, loko-an ka xatu."
    },
    {
      "word": "antisemita,",
      "class": "Adjetivu | Substantivu",
      "meaning": "(Ema) neʼebé hakribi Judeu sira."
    },
    {
      "word": "antisemitizmu,",
      "class": "Substantivu",
      "meaning": "Hakribi ka ódiu ba ema Judeu sira."
    },
    {
      "word": "antiséptiku - antiséptika, f.",
      "class": "Adjetivu | Substantivu",
      "meaning": "Adjetivu: Neʼebé oho mikróbiu sira neʼebé bele halo ema moras no hanetik sira-nia naburas. Substantivu: (antiséptiku) Líkidu ka ai-moruk neʼebé ita tau ba kanek ka fatin fo'er hodi kombate infesaun oioin."
    },
    {
      "word": "antolojia,",
      "class": "Substantivu",
      "meaning": "(Livru neʼebé) trexu literáriu (liuliu poezia) klutuk ka kolesaun ida."
    },
    {
      "word": "antónimu,",
      "class": "Substantivu",
      "meaning": "Liafuan ida ho arti sorun ka kontráriu. Sin. liafuan-sorun."
    },
    {
      "word": "antra,",
      "class": "Substantivu",
      "meaning": "Buat-karan ka prezente neʼebé família noivu nian fó ba família noiva nian loron rua uluk ba festa-kaben."
    },
    {
      "word": "antropolojia,",
      "class": "Substantivu",
      "meaning": "Siénsia kona-ba ema sira-nia sosiedade tradisionál, lisan no kostume oioin."
    },
    {
      "word": "antropolójiku - antropolójika, f.",
      "class": "Adjetivu",
      "meaning": "Kona-ba antropolojia."
    },
    {
      "word": "antropólogu - antropóloga, f.",
      "class": "Substantivu",
      "meaning": "Ema matenek antropolojia."
    },
    {
      "word": "anuál,",
      "class": "Adjetivu",
      "meaning": "Tinan-tinan nian. Sin. tinan."
    },
    {
      "word": "anula,",
      "class": "Verbu",
      "meaning": "Hasai tiha; halakon buat nia kbiit ka validade. Sin. kasu."
    },
    {
      "word": "anulasaun,",
      "class": "Substantivu",
      "meaning": "Hahalok anula nian."
    },
    {
      "word": "Anunsiasaun,",
      "class": "Substantivu",
      "meaning": "Festa loron 25 Marsu nian iha kalendáriu litúrjiku, neʼebé selebra lia-foun ida neʼebé Anju Gabriel hato'o ba Maria Santísima kona-ba atu sai Mesias Nia inan."
    },
    {
      "word": "anúnsiu,",
      "class": "Substantivu",
      "meaning": "1. Lia neʼebé ita fó sai, liuliu ba públiku. 2. Lia-tatoli neʼebé ita publika iha jornál laran, ka liuhosi rádiu ka televizaun."
    },
    {
      "word": "anxova (ikan-),",
      "class": "Substantivu",
      "meaning": "Ikan espésie ida neʼebé ki'ik, lotuk no meer loos, populár nu'udar ikan-lata."
    },
    {
      "word": "apá,",
      "class": "Substantivu",
      "meaning": "Títulu familiár hodi hasé ita-nia aman. Sin. papá, pai."
    },
    {
      "word": "apaga,",
      "class": "Verbu",
      "meaning": "Halakon buat neʼebé ita hakerek, hatui ka grava tiha ona."
    },
    {
      "word": "apagadór,",
      "class": "Substantivu",
      "meaning": "Borraxa ka hena atu apaga hakerek."
    },
    {
      "word": "apaixonadu - apaixonada, f.",
      "class": "Adjetivu",
      "meaning": "Neʼebé iha paixaun; neʼebé hatudu paixaun."
    },
    {
      "word": "apaizana,",
      "class": "Advérbiu | Adjetivu",
      "meaning": "Advérbiu: Ho roupa sivíl ka baibain nian. Adjetivu: Neʼebé hatais sivíl."
    },
    {
      "word": "aparadór,",
      "class": "Substantivu",
      "meaning": "Armáriu kraik ida neʼebé uza hodi rai bikan no sasán seluk ba meza iha sala-jantár."
    },
    {
      "word": "aparellu,",
      "class": "Substantivu",
      "meaning": "Instrumentu natoon ba atividade ruma. Sin. utensíliu."
    },
    {
      "word": "aparente,",
      "class": "Adjetivu",
      "meaning": "(Buat) neʼebé mosu de'it, sein ita hatene se loos ka lae. Ez. Tribunál sei halo investigasaun kona-ba komersiante ne'e nia falénsia aparente."
    },
    {
      "word": "aparentemente,",
      "class": "Advérbiu",
      "meaning": "Tuir aparénsia."
    },
    {
      "word": "aparénsia,",
      "class": "Substantivu",
      "meaning": "Ida neʼebé mosu iha ita-nia oin, forma sensivel; buat ka ema nia aspetu li'ur nian. Sin. kamosuk. Ez. Maski Mateus nia aparénsia kalma, nia afinál ema nervozu-aat."
    },
    {
      "word": "aparese,",
      "class": "Verbu",
      "meaning": "Hahú mosu mai ka sai mai li'ur. Sin. tadu, mosu. Ez. Ninia ulun aparese maibé isin-lolon ita la haree."
    },
    {
      "word": "aparisaun,",
      "class": "Substantivu",
      "meaning": "1. Hahalok aparese ka tadu nian. Sin. tataduk. 2. Ema ka buat sobrenaturál neʼebé mosu ba ema ruma. Ez. Bibi-atan na'in-tolu hetan aparisaun Ita-Nia Feto nian iha Fátima, Portugál, iha tinan 1917."
    },
    {
      "word": "apartadu,",
      "class": "Substantivu",
      "meaning": "Kaixa ki'ik iha didin-lolon ho xave neʼebé uma-korreiu aluga ba ema ka klibur ida atu simu sira-nia korreiu iha laran. Sin. kaixa-postál."
    },
    {
      "word": "apatia,",
      "class": "Substantivu",
      "meaning": "1. Hahalok sente la iha enerjia, isin-maten no la iha reasaun ba buat sira ne'ebé akontese. 2. Kondisaun la liga ka importa, biar importante, no sai baruk-teen, nunka hakarak halo buat ida."
    },
    {
      "word": "apátiku - apátika, f.",
      "class": "Adjetivu",
      "meaning": "Ne'ebé hatudu apatia."
    },
    {
      "word": "apelasaun,",
      "class": "Substantivu",
      "meaning": "Hahalok husu ba tribunál atu haree fali sentensa ruma neʼebé hamonu tiha ona ba sala-na'in ida."
    },
    {
      "word": "apelidu,",
      "class": "Substantivu",
      "meaning": "Naran neʼebé ema ida-idak simu hosi nia família no baibain tau iha kotuk. Sin. naran-família, naran-dikin. Ez. Jaime Soares (Soares ne'e Jaime nia apelidu)."
    },
    {
      "word": "apéndise,",
      "class": "Substantivu",
      "meaning": "1. Katesik ka seksaun iha livru nia rohan neʼebé fó informasaun liután ka hato'o dokumentu ruma. 2. Tubu ki'ik ho ibun taka neʼebé moris sai hosi ema nia laran-metan."
    },
    {
      "word": "apendisite,",
      "class": "Substantivu",
      "meaning": "Moras ida ne'ebé mosu bainhira ema nia apéndise hetan infesaun."
    },
    {
      "word": "aperitivu,",
      "class": "Substantivu",
      "meaning": "Hemun alkóliku neʼebé ema look ba bainaka molok han meiudia ka kalan, atu loke apetite."
    },
    {
      "word": "aperta,",
      "class": "Verbu",
      "meaning": "Hanehan to'o fatin la iha ona."
    },
    {
      "word": "apetite,",
      "class": "Substantivu",
      "meaning": "Ema nia hakarak atu han ai-han ne'ebé di'ak; ema nia gostu ba han."
    },
    {
      "word": "apetitozu - apetitoza, f.",
      "class": "Adjetivu",
      "meaning": "Ne'ebé loke apetite; gostozu."
    },
    {
      "word": "apezarde,",
      "class": "Prepozisaun",
      "meaning": "Maski iha..., maski iha problema kona-ba... Ez. Sira konsege mai Dili apezarde anin-fuik no bee-sa'e."
    },
    {
      "word": "apíkola,",
      "class": "Adjetivu | Substantivu",
      "meaning": "Adjetivu: Kona-ba apikultura. Substantivu: Ema neʼebé hakiak bani. Sin. makiak-bani."
    },
    {
      "word": "apikultura,",
      "class": "Substantivu",
      "meaning": "Knaar hakiak bani."
    },
    {
      "word": "apita,",
      "class": "Verbu",
      "meaning": "1. Huu apitu. 2. Hanehan karreta nia apitu atu fó sinál."
    },
    {
      "word": "apitu,",
      "class": "Substantivu",
      "meaning": "1. Instrumentu ki'ikoan hanesan kafu'i, halo hosi besi-asu, neʼebé ema huu atu dada ema seluk ka asu nia atensaun. 2. Aparellu karreta nian neʼebé halo tarutu maka'as atu dada ema sira-nia atensaun."
    },
    {
      "word": "aplaude,",
      "class": "Verbu",
      "meaning": "Basa liman hodi hahi'i ka foti ema ida, liuliu artista ka desportista. Ez. Ema hotu aplaude artista ne'e tanba nia hananu kapás loos."
    },
    {
      "word": "aplauzu,",
      "class": "Substantivu",
      "meaning": "Hahalok aplaude nian. Sin. basa-liman."
    },
    {
      "word": "aplika,",
      "class": "Verbu",
      "meaning": "Tau nu'udar remédiu ka sasukat neʼebé serve. Sin. hasera. Ez. Ita bele aplika prinsípiu ne'e ba problema sira ne'ebé ita seidauk rezolve."
    },
    {
      "word": "aplikasaun,",
      "class": "Substantivu",
      "meaning": "Hahalok aplika nian. Sin. hasera."
    },
    {
      "word": "Apodeti,",
      "class": "Substantivu",
      "meaning": "1. Sigla ba títulu portugés Associação Popular Democrática Timorense, neʼebé partidu polítiku ida-neʼebé, iha tinan 1974 no 1975, hali’is ba integrasaun ho Repúblika Indonézia. 2. Membru hosi partidu ne'e."
    },
    {
      "word": "apoia,",
      "class": "Verbu",
      "meaning": "Fó apoiu."
    },
    {
      "word": "apoiante,",
      "class": "Substantivu",
      "meaning": "Ema neʼebé fó apoiu."
    },
    {
      "word": "apoiu,",
      "class": "Substantivu",
      "meaning": "Tulun neʼebé ita fó ba ema ruma atu hala'o knaar ruma, ka atu tahan ho susar ruma."
    },
    {
      "word": "apólise (-seguru),",
      "class": "Substantivu",
      "meaning": "Dokumentu ka surat ne'ebé ita simu bainhira hola kontratu seguru nian."
    },
    {
      "word": "aponta,",
      "class": "Verbu",
      "meaning": "1. See kilat. 2. Hatudu ho liman-fuan."
    },
    {
      "word": "aportugezadu - aportugezada, f.",
      "class": "Adjetivu",
      "meaning": "1. Neʼebé sai tiha ona hanesan Portugés sira, tuir sira-nia kostume sira no mós ko'alia sira-nia lian. 2. (Dalen) neʼebé hetan tiha ona influénsia maka'as hosi lia-portugés."
    },
    {
      "word": "apostata,",
      "class": "Verbu",
      "meaning": "Soe hela ita-nia relijiaun atu hakohak ida seluk."
    },
    {
      "word": "apóstata,",
      "class": "Substantivu",
      "meaning": "Ema neʼebé soe hela nia relijiaun atu hakohak relijiaun seluk."
    },
    {
      "word": "apostazia,",
      "class": "Substantivu",
      "meaning": "Hahalok apostata nian."
    },
    {
      "word": "apostoladu,",
      "class": "Substantivu",
      "meaning": "Knaar ka atividade ruma kona-ba halekar fiar sarani."
    },
    {
      "word": "apostóliku - apostólika, f.",
      "class": "Adjetivu",
      "meaning": "Kona-ba apóstolu sira."
    },
    {
      "word": "apóstolu,",
      "class": "Substantivu",
      "meaning": "Ida hosi eskolante na'in sanulu-resin-rua Jezús Kristu nian neʼebé Nia hili atu halekar fiar sarani ba mundu tomak."
    },
    {
      "word": "apóstrofu,",
      "class": "Substantivu",
      "meaning": "Tadak-hakerek ho forma hanesan vírgula tau iha leten ('). Iha lia-tetun, apóstrofu ne'e kapatak-tolan nia sinál neʼebé mosu iha liafuan hanesan sa'e, to'o, di'ak."
    },
    {
      "word": "aprende,",
      "class": "Verbu",
      "meaning": "Buka-hatene kona-ba buat ruma hodi halo tuir ema ida neʼebé hatene ona, ka hodi estuda, lee livru, halo kursu nst. Sin. lota. Ez. Ema moris nunka para atu aprende."
    },
    {
      "word": "aprendís,",
      "class": "Substantivu",
      "meaning": "Ema ne'ebé foin hahú aprende knaar ka ofísiu ruma. Sin. badain-maklotak, badain-aprendís. Ez. Badain-mestre haruka nia aprendís atu hadi'a torneira ne'e."
    },
    {
      "word": "aprendizajen,",
      "class": "Substantivu",
      "meaning": "1. Hahalok ka atividade aprende nian. Sin. lalotak. 2. Treinu ka formasaun neʼebé aprendís ida simu iha serbisu-fatin hodi halo tuir badain ida."
    },
    {
      "word": "apresia,",
      "class": "Verbu",
      "meaning": "1. Fó folin ba buat ruma neʼebé ema halo. Sin. hafolin. 2. Husu ka buka-hatene buat ida nia folin. Sin. hadasin."
    },
    {
      "word": "apresiasaun,",
      "class": "Substantivu",
      "meaning": "Hahalok apresia nian. Sin. hafolin, hadasin."
    },
    {
      "word": "aprezenta,",
      "class": "Verbu",
      "meaning": "1. Lori mai ka hatudu buat ruma ba ema seluk atu haree; hatada buat ruma. Sin. hato'o. Ez. Ha'u aprezenta ha'u-nia kumprimentu ba bainaka sira. 2. Lori ema ruma atu hasoru malu ba dala uluk ho ema ida neʼebé nia seidauk koñese."
    },
    {
      "word": "aprezentadór - aprezentadora, f.",
      "class": "Substantivu",
      "meaning": "1. Ema neʼebé aprezenta. Sin. mato'ok. 2. Ema ne'ebé aprezenta programa rádiu ka televizaun nian."
    },
    {
      "word": "aprezentasaun,",
      "class": "Substantivu",
      "meaning": "Hahalok aprezenta nian. Sin. hato'o."
    },
    {
      "word": "apropriadu - apropriada, f.",
      "class": "Adjetivu",
      "meaning": "Neʼebé natoon ka serve ba situasaun ka kazu partikulár ida. Ez. Ita tenke hili títulu apropriadu ba livru foun."
    },
    {
      "word": "aprova,",
      "class": "Verbu",
      "meaning": "Simu atubele hala'o loloos. Ez. Parlamentu seidauk aprova lei kona-ba funsionamentu públiku."
    },
    {
      "word": "aprovasaun,",
      "class": "Substantivu",
      "meaning": "Hahalok aprova nian."
    },
    {
      "word": "aproveita,",
      "class": "Verbu",
      "meaning": "1. Uza hodi hetan kadi'ak ka vantajen hosi buat ruma; hasai proveitu; lukra ho buat ruma. Ez. Di'ak liu imi aproveita tempu livre hotu-hotu ba estuda. 2. (Ho sentidu negativu) Hetan vantajen ka lukru hosi ema seluk nia esforsu ka serbisu atu ita lalika haka'as an. Sin. esplora."
    },
    {
      "word": "aproveitamentu,",
      "class": "Substantivu",
      "meaning": "Hahalok aproveita nian."
    },
    {
      "word": "aptidaun,",
      "class": "Substantivu",
      "meaning": "1. Kapasidade ka jeitu atu halo buat ida. 2. Kapasidade atu aprende lailais."
    },
    {
      "word": "ár,",
      "class": "Substantivu",
      "meaning": "1. Kakahur ka mistura hosi oksijéniu no gás sira seluk neʼebé tama-sai hosi inus no ibun bainhira ita dada iis ka ida neʼebé forma atmosfera rai nian. Sin. anin. 2. Aparénsia, aspetu. 3. Válvula iha karreta nia motór neʼebé kontrola anin neʼebé tama ba laran, ka gás neʼebé iha roda karreta ka motór nia laran."
    },
    {
      "word": "arabi,",
      "class": "Adjetivu | Substantivu",
      "meaning": "Adjetivu: 1. Rai-Arábia nian. 2. Neʼebé ko'alia lia-arabi. Substantivu: 1. Ema Arábia. 2. Ema neʼebé ko'alia arabi nu'udar nia dalen-inan maski la'ós ema Arábia. 3. (Lia-arabi) Dalen rai-Arábia nian, neʼebé Izlaun mak halekar ba Lorosa'e Klaran besik tomak, ba Áfrika Norte no mós (iha Otas Klaran) ba rai-Sisília, rai-Malta, rai-España no rai-Portugál hotu. Maski lia-arabi la ko'alia ona iha rai-Portugál, lia-portugés sei iha liafuan barak neʼebé mai hosi lia-arabi ne'e, no sira barak tama mós ba lia-tetun, nu'udar ezemplu alfase, azeitona, támara, sapatu, refein, meskita, alfándega. Liafuan arabi seluseluk tama ba lia-tetun liuhosi lia-malaiu, n.e. kaben, ukun, sarani. Sin. árabe."
    },
    {
      "word": "Arábia (rai-),",
      "class": "Substantivu",
      "meaning": "Península boot ida iha Ázia Loromonu. Arábia Saudita mak estadu boot liu iha zona ne'e."
    },
    {
      "word": "Arafura (Tasi-),",
      "class": "Substantivu",
      "meaning": "Tasi luan ida iha rai-Timór, rai-Austrália, no rai-Giné Foun nia leet."
    },
    {
      "word": "aramaiku - aramaika, f.",
      "class": "Substantivu | Adjetivu",
      "meaning": "(Lia-aramaiku) Dalen semítiku ida, nakmaluk ho lia-ebreu no lia-arabi, neʼebé horiuluk ko'alia iha rai-Síria, rai-Palestina no rai-Mezopotámia (Irake ohin nian) maibé neʼebé ohin loron ema sarani uitoan de'it ko'alia iha rai-Irake nia parte norte no mós iha knua tolu besik Damasku iha rai-Síria. Lia-aramaiku ne'e Ita-Nia Jezús Kristu Nia lian-inan. Sin. lia-siríaku."
    },
    {
      "word": "arame,",
      "class": "Substantivu",
      "meaning": "1. Fiu-besi. Ez. Gerrilleiru nẻ'e nia liman-fuan kotu tanba uluk ema kesi ho arame. 2. Liafuan neʼebé tempu uluk ema uza atu dehan telefone."
    },
    {
      "word": "arbiru,",
      "class": "Adjetivu | Advérbiu",
      "meaning": "Naran-aran de'it ka la tuir regra ida ne'ebé loos. Ez. Ladún di'ak bainhira ema koʼalia arbiru, la iha hun ho rohan."
    },
    {
      "word": "arbitra,",
      "class": "Verbu",
      "meaning": "Tesi lia; halo arbitrajen."
    },
    {
      "word": "arbitrajen,",
      "class": "Substantivu",
      "meaning": "1. Hahalok tesi lia kona-ba asuntu ruma. 2. Hahalok kontrola ka tau matan ba jogu ruma iha kampu."
    },
    {
      "word": "arbitráriu - arbitrária, f.",
      "class": "Adjetivu",
      "meaning": "Neʼebé la bazeia ba planu ka sistema ida, neʼebé ema hili naran de'it."
    },
    {
      "word": "arbitrariedade,",
      "class": "Substantivu",
      "meaning": "Kualidade ka hahalok arbitráriu."
    },
    {
      "word": "árbitru,",
      "class": "Substantivu",
      "meaning": "1. Ema neʼebé tesi lia ka halo arbitrajen. Sin. tesi-lia-na'in. 2. Ema neʼebé kontrola jogu hodi tuir regra hotu neʼebé iha."
    },
    {
      "word": "arboriza,",
      "class": "Verbu",
      "meaning": "Kuda ai-hun, alas ka ai-laran iha rai ida neʼebé maran no ai la iha ka ladún iha. Sin. hahalas."
    },
    {
      "word": "arborizasaun,",
      "class": "Substantivu",
      "meaning": "Hahalok arboriza nian. Sin. hahalas."
    },
    {
      "word": "ardózia (fatuk-),",
      "class": "Substantivu",
      "meaning": "1. Fatuk kór-metan ida neʼebé nakfera lailais ba dalas mihis no serve ba halo uma-kakuluk ka atu halo kuadru-metan neʼebé mestre sira hakerek iha laran hodi hanorin alunu sira. 2. Fatuk-ardózia dalas ida iha kuadru ai nia laran neʼebé alunu sira ulukliu uza hodi hakerek iha leten."
    },
    {
      "word": "área,",
      "class": "Substantivu",
      "meaning": "1. Rai-balun ida. Sin. rai-balun, zona. 2. Atividade ka asuntu partikulár ida. Ez. Ha'u-nia alin halo estudu oioin iha área botánika."
    },
    {
      "word": "arena,",
      "class": "Substantivu",
      "meaning": "Fatin públiku ida ba desportu ka komísiu neʼebé ema barabarak bele tama bá."
    },
    {
      "word": "argamasa,",
      "class": "Substantivu",
      "meaning": "Simentu kahur rai-henek, bee, hodi kaer fatuk. Sin. simentu-masa."
    },
    {
      "word": "argola,",
      "class": "Substantivu",
      "meaning": "1. Le'un ida halo hosi besi, plástiku ka masa. 2. Besi le'un neʼebé ema monta iha kabelak iha kampu basketeból nian."
    },
    {
      "word": "argoliña,",
      "class": "Substantivu",
      "meaning": "Brinku hodi hafutar tilun."
    },
    {
      "word": "argumenta,",
      "class": "Verbu",
      "meaning": "Haksesuk ka diskute malu hodi defende ideia ida ka buka lia-loos."
    },
    {
      "word": "argumentasaun,",
      "class": "Substantivu",
      "meaning": "Hahalok argumenta nian."
    },
    {
      "word": "argumentu,",
      "class": "Substantivu",
      "meaning": "Razaun sira neʼebé ema hato'o atu hatudu se hahesuk ka afirmasaun ida loos ka lae, se tuir lójika ka lae. Ez. Susar atu hatán ba kolega ne'e nia argumentu, ne'ebé lójiku tebetebes."
    },
    {
      "word": "ária,",
      "class": "Substantivu",
      "meaning": "Kantiga ida ba lian ida de'it iha ópera laran."
    },
    {
      "word": "aristokrasia,",
      "class": "Substantivu",
      "meaning": "1. Governu iha neʼebé ema di'ak no matenek liu hotu mak ukun. 2. Klase dato ka nobre sira-nian. 3. Dato sira neʼebé ukun rain ida."
    },
    {
      "word": "aristokrata,",
      "class": "Substantivu",
      "meaning": "1. Ema ida ne'ebé pertense ba aristokrasia. Sin. dato. 2. Ema neʼebé ketak ho ema seluk ho nia kbiit, valór, méritu iha área ruma. Ez. Amália Rodrigues aristokrata fadu nian loos."
    },
    {
      "word": "aristokrátiku - aristokrátika, f.",
      "class": "Adjetivu",
      "meaning": "Kona-ba aristokrasia."
    },
    {
      "word": "aritmétika,",
      "class": "Substantivu",
      "meaning": "Siénsia neʼebé estuda númeru sira no sira-nia lalaʼok."
    },
    {
      "word": "Arjélia (rai-),",
      "class": "Substantivu",
      "meaning": "Rain no estadu ida iha Áfrika Norte."
    },
    {
      "word": "arjelinu - arjelina, f.",
      "class": "Adjetivu | Substantivu",
      "meaning": "Adjetivu: Rai-Arjélia nian. Substantivu: Ema Arjélia."
    },
    {
      "word": "Arjentina (rai-),",
      "class": "Substantivu",
      "meaning": "Rain no estadu ida iha Amérika Súl."
    },
    {
      "word": "arjentinu - arjentina, f.",
      "class": "Adjetivu | Substantivu",
      "meaning": "Adjetivu: Rai-Arjentina nian. Substantivu: Ema Arjentina."
    },
    {
      "word": "arjila,",
      "class": "Substantivu",
      "meaning": "Tahu neʼebé ema uza hodi halo kusi, xikra, bikan nst. Sin. rai-mean."
    },
    {
      "word": "arkada,",
      "class": "Substantivu",
      "meaning": "Arku latár ka fileira rua rabat malu."
    },
    {
      "word": "arkaiku - arkaika, f.",
      "class": "Adjetivu",
      "meaning": "Neʼebé tuan no baibain ema la uza ona, maski sei bele serve ba uzu ruma."
    },
    {
      "word": "arkaízmu,",
      "class": "Substantivu",
      "meaning": "Karakter ka feisaun arkaiku."
    },
    {
      "word": "arkanju,",
      "class": "Substantivu",
      "meaning": "Anju mahuluk, neʼebé maka'as liu anju baibain sira."
    },
    {
      "word": "arkeolojia,",
      "class": "Substantivu",
      "meaning": "Siénsia neʼebé estuda kona-ba kultura no sivilizasaun lakin ka antigu neʼebé kleur ona lakon maibé bele hatene liuhosi sasouk ka eskavasaun atu ke'e sai sasán tuan hanesan uma-sohun, bikan, xikra, surik nst."
    },
    {
      "word": "arkeolójiku - arkeolójika, f.",
      "class": "Adjetivu",
      "meaning": "Kona-ba arkeolojia."
    },
    {
      "word": "arkeólogu - arkeóloga, f.",
      "class": "Substantivu",
      "meaning": "Ema matenek arkeolojia."
    },
    {
      "word": "arkidiosezanu - arkidiosezana, f.",
      "class": "Adjetivu",
      "meaning": "Kona-ba arkidioseze."
    },
    {
      "word": "arkidioseze,",
      "class": "Substantivu",
      "meaning": "Dioseze mahuluk ka prinsipál, neʼebé arsebispu ida mak ukun."
    },
    {
      "word": "arkipélagu,",
      "class": "Substantivu",
      "meaning": "Rai-kotun ka illa lubun ida. Sin. nusa-lubun. Ez. Rai-Timór halo parte Nusa-Lubun Malaiu."
    },
    {
      "word": "arkiteta, f.",
      "class": "Substantivu",
      "meaning": "Ema-feto ne'ebé matenek arkitetura neʼebé dezeña uma no hariin oioin."
    },
    {
      "word": "arkitetóniku - arkitetónika, f.",
      "class": "Adjetivu",
      "meaning": "Kona-ba arkitetura."
    },
    {
      "word": "arkitetu, m.",
      "class": "Substantivu",
      "meaning": "Ema-mane ne'ebé matenek arkitetura neʼebé dezeña uma no hariin oioin."
    },
    {
      "word": "arkitetura,",
      "class": "Substantivu",
      "meaning": "Arte kona-ba dezeña uma no hariin oioin."
    },
    {
      "word": "arkiva,",
      "class": "Verbu",
      "meaning": "Tau ka rai iha arkivu."
    },
    {
      "word": "arkivamentu,",
      "class": "Substantivu",
      "meaning": "Hahalok arkiva nian."
    },
    {
      "word": "arkivista,",
      "class": "Substantivu",
      "meaning": "Ema neʼebé hola konta arkivu."
    },
    {
      "word": "arkivu,",
      "class": "Substantivu",
      "meaning": "1. Fatin hodi haloot dokumentu oioin. 2. Dokumentu sira neʼebé ema rai hamutuk, baibain kona-ba asuntu ida (bele uma tomak ka armáriu de'it)."
    },
    {
      "word": "arku,",
      "class": "Substantivu",
      "meaning": "Hariin ka estrutura ida ho tutun le'uk no fatuk-riin rua sorin-sorin. Sin. kle'u."
    },
    {
      "word": "arku-iris,",
      "class": "Substantivu",
      "meaning": "Kle’un ka arku ho kór oioin ne'ebé dala ruma mosu iha kalohan leten bainhira udan tiha. Sin. baur."
    },
    {
      "word": "arma,",
      "class": "Substantivu | Verbu",
      "meaning": "Substantivu: Buat ida neʼebé ema uza atu hakanek ka oho ema seluk, liuliu iha funu laran; tarak no kro'at ka kilat. Verbu: Fó arma ba."
    },
    {
      "word": "armadilla,",
      "class": "Substantivu",
      "meaning": "1. Ai-lulun ka rede neʼebé ema hatuur ka tara atu kaer balada fuik hanesan leki, bibi-rusa, manu-fuik, laho, nst. Sin. lasu, sula. 2. Lasu neʼebé inimigu sira tau iha dalan atubele oho funu-balun sira ka atu kaer sira."
    },
    {
      "word": "armamentu,",
      "class": "Substantivu",
      "meaning": "1. Hahalok fó arma ba ema atu uza. 2. Arma oioin, liuliu funu nian."
    },
    {
      "word": "armáriu,",
      "class": "Substantivu",
      "meaning": "Fatin hosi ai, plástiku, vidru ka besi neʼebé ema uza atu rai ka haloot roupa, bikan ka sasán seluseluk iha laran."
    },
    {
      "word": "armazein,",
      "class": "Substantivu",
      "meaning": "Uma luan boot ida ho fatin atu rai besi, ai, simentu, kilat, ka merkadoria atu fa'an."
    },
    {
      "word": "arméniu - arménia, f.",
      "class": "Adjetivu | Substantivu",
      "meaning": "Adjetivu: Rai-Arménia nian. Substantivu: 1. Ema Arménia. 2. (Lia-arméniu) Dalen rai-Arménia nian. Ez. Iha Funu Mundiál Dahuluk, povu arméniu sai vítima ba jenosídiu ida neʼebé governu turku mak hala'o."
    },
    {
      "word": "Arménia (rai-),",
      "class": "Substantivu",
      "meaning": "Rain no estadu ki'ikoan iha Ázia Loromonu."
    },
    {
      "word": "armistísiu,",
      "class": "Substantivu",
      "meaning": "Akordu ka lia-ida kona-ba hapara funu."
    },
    {
      "word": "armonia,",
      "class": "Substantivu",
      "meaning": "Simu-malu ho lian kapás loos, lian-ida ka neon-laran simu-malu hodi moris iha hakmatek nia laran."
    },
    {
      "word": "armoniza,",
      "class": "Verbu",
      "meaning": "Halo armonia; tau iha armonia."
    },
    {
      "word": "armonizasaun,",
      "class": "Substantivu",
      "meaning": "Hahalok armoniza nian."
    },
    {
      "word": "aroma,",
      "class": "Substantivu",
      "meaning": "Iis di'ak hahán nian."
    },
    {
      "word": "aromatiza,",
      "class": "Verbu",
      "meaning": "Tempra hahán hodi fó aroma."
    },
    {
      "word": "aromatizadu - aromatizada, f.",
      "class": "Adjetivu",
      "meaning": "Ne'ebé hetan aromatizasaun."
    },
    {
      "word": "aromatizasaun,",
      "class": "Substantivu",
      "meaning": "Hahalok aromatiza nian."
    },
    {
      "word": "arpa,",
      "class": "Substantivu",
      "meaning": "Instrumentu muzikál ho forma triangulár no talin barak neʼebé ema kebit hodi toka."
    },
    {
      "word": "arraña-seu,",
      "class": "Substantivu",
      "meaning": "Edifísiu ho andár tetek malu barabarak neʼebé harii iha sidade boot sira. Sin. makoir-lalehan."
    },
    {
      "word": "arranja,",
      "class": "Verbu",
      "meaning": "1. Tau hodi halo didi'ak iha fatin sira. Sin. haklatar, arruma. Ez. Arranja ai-funan roza iha jarra vidru ida. 2. Prepara hodi halo didi'ak ema ruma nia hatais, halo kabeer, sui fuuk kabeer nst."
    },
    {
      "word": "arranju,",
      "class": "Substantivu",
      "meaning": "Hahalok arranja nian. Sin. haklatar."
    },
    {
      "word": "arraska,",
      "class": "Verbu",
      "meaning": "1. Hetan susar. 2. La iha buat ida neʼebé ita presiza. Sin. kuran. Ez. Iha zona ne'ebá, ema sira arraska bee."
    },
    {
      "word": "arrasta,",
      "class": "Verbu",
      "meaning": "Lori ka dada tuir kotuk ho liman. Sin. dasa, rasta."
    },
    {
      "word": "arrastadeira,",
      "class": "Substantivu",
      "meaning": "1. Fatin ida ba moras todan sira uza ba tee ka mii iha kama. 2. Automóvel ki'ik neʼebé la'o hakdasak ka rabat hela ba rai."
    },
    {
      "word": "arredores,",
      "class": "Substantivu",
      "meaning": "Zona hale'u fatin ida, liuliu hale'u uma, knua, vila ka sidade. Sin. sori-sorin."
    },
    {
      "word": "arrepende,",
      "class": "Verbu",
      "meaning": "Hakarak atu fila ba dalan loos liutiha sala. Sin. hanoin-hikas."
    },
    {
      "word": "arrependidu - arrependida, f.",
      "class": "Adjetivu",
      "meaning": "(Ema sala-na'in) neʼebé hakarak fila ba dalan loos, soe tiha buat aat uluk nian. Sin. hanoin-hikas."
    },
    {
      "word": "arrependimentu,",
      "class": "Substantivu",
      "meaning": "Hahalok arrepende nian."
    },
    {
      "word": "arrogante,",
      "class": "Adjetivu",
      "meaning": "Neʼebé hatudu ka foti an nu'udar ema maka'as ka matenek ida. Sin. foti-an, hi'it-an, matan-aas."
    },
    {
      "word": "arrogánsia,",
      "class": "Substantivu",
      "meaning": "Kualidade ka hahalok arrogante nian."
    },
    {
      "word": "arrota,",
      "class": "Verbu",
      "meaning": "Hasai gás hosi estómagu liuhosi ibun ho tarutu, bainhira ema bosu demais ka sente laran-sa'e. Sin. hamseru."
    },
    {
      "word": "arrotu,",
      "class": "Substantivu",
      "meaning": "Hahalok arrota nian. Sin. hamseru."
    },
    {
      "word": "arruma,",
      "class": "Verbu",
      "meaning": "Tau sasán hamutuk iha fatin ida."
    },
    {
      "word": "arrumasaun,",
      "class": "Substantivu",
      "meaning": "Hahalok arruma nian."
    },
    {
      "word": "arsebispu,",
      "class": "Substantivu",
      "meaning": "Ambispu mahuluk; bispu ne'ebé ukun arkidioseze ka provínsia Kreda nian."
    },
    {
      "word": "arsenál,",
      "class": "Substantivu",
      "meaning": "Fatin ba rai kilat, kilat-musan, morteiru no materiál seluseluk funu nian."
    },
    {
      "word": "arséniku,",
      "class": "Substantivu",
      "meaning": "Venenu maka'as ida, neʼebé oho balada ka ema hodi halo sira terus ladi'ak."
    },
    {
      "word": "arte,",
      "class": "Substantivu",
      "meaning": "1. Atividade halo sasán furak ho liman, n.e. retratu ka estátua. 2. Sasán furak ka lotuk neʼebé halo ho liman. 3. Jeitu boot hodi halo buat ruma, n.e. arte te'in nian. 'Arte furak sira' ne'e naran jerál neʼebé ita fó ba atividade hanesan literatura, múzika, drama, pintura no eskultura. Nota: Keta konfunde liafuan rua neʼebé nia signifikadu la hanesan, maka arte no arti."
    },
    {
      "word": "artefaktu,",
      "class": "Substantivu",
      "meaning": "Objetu arte nian, buat ida neʼebé ema halo ho arte. Sin. liman-fatin."
    },
    {
      "word": "artéria,",
      "class": "Substantivu",
      "meaning": "Uat boot ka mahuluk iha isin laran neʼebé hasuli raan. Sin. raan-uat, raan-abut."
    },
    {
      "word": "arteriál,",
      "class": "Adjetivu",
      "meaning": "Kona-ba artéria."
    },
    {
      "word": "arti,",
      "class": "Substantivu",
      "meaning": "(Liafuan) katak saida, hakarak hatete saida. Sin. signifikadu. Ez. Liafuan inglés ne'e nia arti saida? Nota: Keta konfunde liafuan rua ne'ebé nia signifikadu la hanesan, maka arte no arti."
    },
    {
      "word": "artifisiál,",
      "class": "Adjetivu",
      "meaning": "1. Neʼebé la’ós naturál. 2. Ne'ebé ema mak halo."
    },
    {
      "word": "artifisialidade,",
      "class": "Substantivu",
      "meaning": "Kualidade ne'ebé artifisiál."
    },
    {
      "word": "artigu,",
      "class": "Substantivu",
      "meaning": "1. Objetu ida de'it, buat partikulár ida. 2. Hakerek naruk ida iha jornál, revista ka livru nia laran. 3. Ukun-fuan nia katesik ka seksaun ida."
    },
    {
      "word": "artístiku - artístika, f.",
      "class": "Adjetivu",
      "meaning": "Kona-ba arte ka artista."
    },
    {
      "word": "artista,",
      "class": "Substantivu",
      "meaning": "1. Ema neʼebé halo arte. 2. Ema neʼebé halo pintura. Sin. pintór. 3. Ema neʼebé hananu, dansa ka halo drama iha teatru, sinema ka televizaun."
    },
    {
      "word": "artrite,",
      "class": "Substantivu",
      "meaning": "Moras ruin-fukun bubu."
    },
    {
      "word": "artrítiku - artrítika, f.",
      "class": "Adjetivu",
      "meaning": "Kona-ba artrite; ema ne'ebé sofre artrite."
    },
    {
      "word": "ártiku - ártika, f.",
      "class": "Adjetivu",
      "meaning": "Kona-ba Polu Norte. Tasi Ártiku, tasi ida neʼebé hale'u Polu Norte."
    },
    {
      "word": "artillaria,",
      "class": "Substantivu",
      "meaning": "Kilat boot sira, hanesan kañaun no morteiru, neʼebé forsa militár ka mariña mak uza iha funu."
    },
    {
      "word": "Aruba (rai-),",
      "class": "Substantivu",
      "meaning": "Rai-kotun no estadu ki'ikoan iha Tasi-Antillas."
    },
    {
      "word": "arubanu - arubana, f.",
      "class": "Adjetivu | Substantivu",
      "meaning": "Adjetivu: Rai-Aruba nian. Substantivu: Ema Aruba."
    },
    {
      "word": "asafraun,",
      "class": "Substantivu",
      "meaning": "1. Ai-funan espésie ida ho pétala kinur. 2. Ai-funan ne'e nia uut kinur, neʼebé ema uza atu hakór no tempra hahán, liuliu etu. Sin. kunir."
    },
    {
      "word": "asaltante,",
      "class": "Substantivu",
      "meaning": "Ema neʼebé asalta. Sin. atakante, agresór, makratan."
    },
    {
      "word": "asalta,",
      "class": "Verbu",
      "meaning": "1. Ataka ema ka fatin ida lahó na'in hatene ka biban prepara an. Sin. ratan. 2. Selok ema nia uma ka hakarak ka tama tekiteki na'in la hatene."
    },
    {
      "word": "asaltu,",
      "class": "Substantivu",
      "meaning": "Hahalok asalta ka ratan."
    },
    {
      "word": "asasina,",
      "class": "Verbu",
      "meaning": "Oho ema ruma, liuliu ema-boot ka ema naran-boot."
    },
    {
      "word": "asasíniu,",
      "class": "Substantivu",
      "meaning": "Krime oho ema; hahalok asasina nian."
    },
    {
      "word": "asasínu - asasina, f.",
      "class": "Substantivu | Adjetivu",
      "meaning": "Substantivu: Ema ida neʼebé oho ema seluk ho intensaun rasik ka haruka ema seluk mak oho. Sin. mahohok, ohodór. Adjetivu: Ne'ebé asasina. Sin. liman-raan, liman-mean."
    },
    {
      "word": "asaun,",
      "class": "Substantivu",
      "meaning": "1. Babook ka movimentu fíziku ida. 2. Hahalok neʼebé ita hala'o ba motivu partikulár ida, ka ho objetivu partikulár. 3. Osan neʼebé ema investe ba kompañia ida atubele hetan lukru kadavés ka ikusmai. Sin. sahin."
    },
    {
      "word": "asédiu,",
      "class": "Substantivu",
      "meaning": "Hakole ka haterus ema ida hodi buka obriga nia atu halo buat ruma neʼebé nia lakohi halo. Asédiu seksuál mak haterus seksuál neʼebé ema ida halo, liuliu mane halo hasoru feto."
    },
    {
      "word": "asegura,",
      "class": "Verbu",
      "meaning": "Fó serteza kona-ba buat ruma. Sin. hatebes, garante. Ez. Ami bele asegura katak sasán sira-ne'e sei to'o iha ne'ebá."
    },
    {
      "word": "aseleradór,",
      "class": "Substantivu",
      "meaning": "Pedál iha parte liman loos volante okos neʼebé kondutór sama atu halo karreta halai maka'as. Sin. malais."
    },
    {
      "word": "asembleia,",
      "class": "Substantivu",
      "meaning": "1. Ema barak halibur malu liuliu iha eskola, kuartél ka uma-kreda. Sin. lalibur. 2. Konsellu boot governu nian."
    },
    {
      "word": "asentu¹,",
      "class": "Substantivu",
      "meaning": "1. Maneira ko'alia dalen ida. Sin. lalakun. Ez. Sr. Jacques ko'alia tetun ho asentu fransés tanba nia ema Fransa. 2. (Iha linguístika) Lian nia forsa neʼebé ita fó ba vogál iha sílaba ida dada liu duké vogál iha sílaba seluseluk. 3. Tadak-hakerek neʼebé uza atu hatudu katak letra ida nia lalakar ka pronúnsia seluk ka la hanesan baibain. Hodi hakerek lia-tetun, ita uza asentu agudu atu hatudu asentuasaun irregulár, n.e. iha liafuan kafé no kámara. 4. Forsa ka importánsia ne'ebé ita fó ba buat ruma hodi ko'alia ka hakerek."
    },
    {
      "word": "asentu²,",
      "class": "Substantivu",
      "meaning": "Fatin atubele tuur. Sin. tuur-fatin."
    },
    {
      "word": "asesaun,",
      "class": "Substantivu",
      "meaning": "Sentidu ka arti partikulár ida bainhira liafuan ida soi arti oioin. Nu'udar ezemplu, liafuan lalehan iha asesaun rua, ida mak espasu tomak iha rai nia leten, ida seluk maka Maromak Nia hela-fatin. Arti rua ne'e la hanesan de'it. Iha disionáriu ida-ne'e liafuan sira-nia asesaun oioin ami marka ho númeru 1., 2., 3., nst."
    },
    {
      "word": "asesibilidade,",
      "class": "Substantivu",
      "meaning": "Kualidade ne'ebé asesivel."
    },
    {
      "word": "asesivel,",
      "class": "Adjetivu",
      "meaning": "Neʼebé bele to'o bá ka hetan lailais. Sin. to'o-bele, alkansavel. Ez. Aldeia sira hotu iha Timor-Leste oras ne'e asesivel tanba ema bá-mai ho fasil."
    },
    {
      "word": "asesór - asesora, f.",
      "class": "Substantivu",
      "meaning": "Ema neʼebé ajuda instituisaun ka eskritóriu ida ho ninia matenek no espesializasaun téknika iha matéria ruma neʼebé nia domina. Sin. konsultór."
    },
    {
      "word": "asfaltu,",
      "class": "Substantivu",
      "meaning": "Breu metan halo hosi petróleu neʼebé uza atu taka dalan ka halimar-fatin."
    },
    {
      "word": "asidentál,",
      "class": "Adjetivu",
      "meaning": "Ne'ebé akontese derrepente ka la ho intensaun."
    },
    {
      "word": "asidente,",
      "class": "Substantivu",
      "meaning": "Buat neʼebé mosu lahó planu ka derrepente de'it. Sin. dezgrasa, azár. Ez. Karreta xoke malu ne'e asidente, katak la iha intensaun maibé akontese duni."
    },
    {
      "word": "asidés,",
      "class": "Substantivu",
      "meaning": "Kualidade ne'ebé ásidu."
    },
    {
      "word": "ásidu,",
      "class": "Adjetivu | Substantivu",
      "meaning": "(Substánsia) neʼebé siin hanesan derok-been ka tua-siin. Sin. buat-siin."
    },
    {
      "word": "asimila,",
      "class": "Verbu",
      "meaning": "Halo sai hanesan. Ez. Ema neʼebé mai hosi li'ur tenke asimila an ba ita-nia kultura."
    },
    {
      "word": "asimilasaun,",
      "class": "Substantivu",
      "meaning": "Hahalok asimila nian."
    },
    {
      "word": "asina,",
      "class": "Verbu",
      "meaning": "Tau naran iha surat-tahan ka dokumentu ruma nu'udar kompromisu. Asina revista ida katak asina surat no fó osan atubele simu revista nia númeru ida-idak bainhira publika tiha. Asina surat, espresaun eufemístika, katak bá sentina-boot."
    },
    {
      "word": "asinatura,",
      "class": "Substantivu",
      "meaning": "Naran ne'ebé hakerek ho liman rasik iha dokumentu ida."
    },
    {
      "word": "asionista,",
      "class": "Substantivu",
      "meaning": "Ema ida neʼebé soi sahin ka asaun komersiál."
    },
    {
      "word": "asisténsia,",
      "class": "Substantivu",
      "meaning": "Hahalok asiste ka tulun nian."
    },
    {
      "word": "asistente,",
      "class": "Substantivu | Adjetivu",
      "meaning": "(Ema) neʼebé tulun ka sirin. Sin. maksirin."
    },
    {
      "word": "asor (ai-),",
      "class": "Substantivu",
      "meaning": "Ai-horis neʼebé ema Timór balun gosta kuda iha uma oin, iha fuan ki'ik maibé midar, labarik sira gosta ku'u atu han ka manu-fuik sira gosta han nia. Iha espésie rua, maka ai-asor-metan (Eugenia aquea) no ai-asor-mutin (Eugenia jambos)."
    },
    {
      "word": "asorianu - asoriana, f.",
      "class": "Adjetivu | Substantivu",
      "meaning": "Adjetivu: Rai-Asores nian. Substantivu: Ema Asores."
    },
    {
      "word": "Asores (rai-, Nusar-),",
      "class": "Substantivu",
      "meaning": "Nusa-lubun ki'ik iha Tasi-Boot Atlántiku, neʼebé provínsia Portugál nian."
    },
    {
      "word": "asosiasaun,",
      "class": "Substantivu",
      "meaning": "Ema barak buka malu ka halibur hamutuk iha fatin ida atu hala'o atividade oioin ka atu proteje interese sira neʼebé sira fahe lisuk. Sin. klibur, sosiedade, organizasaun."
    },
    {
      "word": "aspas,",
      "class": "Substantivu",
      "meaning": "Tadak ka sinál hanesan vírgula rua nakfilak neʼebé tau iha leten uluk ba no tuir liafuan, baibain ho sinál (“) no hafoin (”). Ez. Maukinta dehan: “Halai, halai, inimigu mai daudaun”."
    },
    {
      "word": "aspetu,",
      "class": "Substantivu",
      "meaning": "1. Kamosuk ka aparénsia li'ur nian. Ez. Ema nẻ'e nia aspetu di'ak loos. 2. Parte hosi buat ruma, ho sentidu abstratu. Ez. Problema ne'e iha aspetu barak."
    },
    {
      "word": "aspirantadu,",
      "class": "Substantivu",
      "meaning": "Aspirante nia tempu koko vokasaun nian ka estájiu."
    },
    {
      "word": "aspirante,",
      "class": "Substantivu",
      "meaning": "Ema neʼebé foin tama orden relijioza ka militár no ulun-boot sira seidauk simu nu'udar membru."
    },
    {
      "word": "aspirasaun,",
      "class": "Substantivu",
      "meaning": "Meta ka alvu neʼebé ita hakarak atu to'o bá."
    },
    {
      "word": "aspirina,",
      "class": "Substantivu",
      "meaning": "Ai-moruk baibain nian neʼebé ema hemu atu halakon moras kmaan oioin."
    },
    {
      "word": "asterisku,",
      "class": "Substantivu",
      "meaning": "Símbolu (*) neʼebé uza iha hakerek no imprime."
    },
    {
      "word": "asteroide,",
      "class": "Substantivu",
      "meaning": "Bola fatuk sira ida neʼebé nakdulas hale'u Loro iha órbita entre planeta Marte no Júpiter nia klaran. Sin. planeta-oan."
    },
    {
      "word": "astrolojia,",
      "class": "Substantivu",
      "meaning": "1. Estudu kona-ba oinsá maka fitun no planeta sira-nia halain iha lalehan hamkona ita ema nia moris, hodi fó rahun di'ak ka aat. 2. Métodu si'ik futuru hodi le'et fitun sira-nia halain. Ez. Sientista, liuliu astrónomu sira, haree astrolojia nuʼudar superstisaun, laós siénsia tuir loos."
    },
    {
      "word": "astrolójiku - astrolójika, f.",
      "class": "Adjetivu",
      "meaning": "Kona-ba astrolojia."
    },
    {
      "word": "astrólogu - astróloga, f.",
      "class": "Substantivu",
      "meaning": "Ema matenek astrolojia."
    },
    {
      "word": "astronauta,",
      "class": "Substantivu",
      "meaning": "Ema ida neʼebé sa'e fogetaun hodi halo viajen iha espasu-li'ur."
    },
    {
      "word": "astronómiku - astronómika, f.",
      "class": "Adjetivu",
      "meaning": "Kona-ba astronomia."
    },
    {
      "word": "astronomia,",
      "class": "Substantivu",
      "meaning": "Estudu sientífiku kona-ba fitun sira no planeta sira."
    },
    {
      "word": "astrónomu - astrónoma, f.",
      "class": "Substantivu",
      "meaning": "Ema matenek astronomia."
    },
    {
      "word": "asu,",
      "class": "Substantivu",
      "meaning": "1. Balada maksusuk ida neʼebé ema hakiak ka hamaus atu hein uma ka lori ba soro. 2. Lia-tolok ba ema laran-fo'er neʼebé ita hakribi."
    },
    {
      "word": "asu-hein,",
      "class": "Substantivu",
      "meaning": "Asu si'ak neʼebé hein ema nia uma ka sasán. Sin. asu-guarda, asu-mahein."
    },
    {
      "word": "asu-kutun,",
      "class": "Substantivu",
      "meaning": "Kutun ki'ikoan neʼebé belit ba balada nia fulun atubele susu nia raan, hodi halo balada ne'e sente isin-katar. Sin. mela. Ez. Asu no busa barak iha asu-kutun."
    },
    {
      "word": "asu-oan,",
      "class": "Substantivu",
      "meaning": "1.Asu neʼebé foin moris. 2. Asu ki'ik."
    },
    {
      "word": "asua'in,",
      "class": "Substantivu",
      "meaning": "1. Ema ida neʼebé luta iha funu laran. Sin. funu-na'in. 2. Ema neʼebé luta ba libertasaun povu nian. 3. Ema aten-barani loos. Sin. eroi, asuba'in. Nota: Iha tetun-terik, liafuan ne'e iha forma seluk, maka asuwa'in."
    },
    {
      "word": "asuliar,",
      "class": "Substantivu",
      "meaning": "Ema ida neʼebé serbisu iha fatin públiku, to'os, natar ka iha plantasaun ruma. Sin. serbisu-na'in, traballadór."
    },
    {
      "word": "Asunsaun,",
      "class": "Substantivu",
      "meaning": "Festa loron 15 Agostu nian, ne'ebé tinan-tinan fó-hanoin fali kona-ba Na'i Maromak foti Ita-Nia Feto isin ho klamar sa'e ba lalehan liutiha nia mate."
    },
    {
      "word": "asuntu,",
      "class": "Substantivu",
      "meaning": "Lia ka problema neʼebé ita trata, baberak ka konsidera. Ez. Ami sei halibur malu atu trata asuntu familiár oioin."
    },
    {
      "word": "ata,",
      "class": "Substantivu",
      "meaning": "Ema ne'ebé serbí ema seluk lahó liberdade ka salariu."
    },
    {
      "word": "Atabae (rai-),",
      "class": "Substantivu",
      "meaning": "Postu administrativu ida iha munisípiu Bobonaru, entre Maliana ho Atsabe nia klaran. Populasaun sira ko'alia dalen kemak no bunak."
    },
    {
      "word": "atake,",
      "class": "Substantivu",
      "meaning": "Hahalok ataka nian. Sin. raratan."
    },
    {
      "word": "ataka,",
      "class": "Verbu",
      "meaning": "1. Uza violénsia hasoru ema atu hakanek ka oho nia. Sin. ratan. 2. Kritika maka'as ema ruma tanba hanoin ruma. 3. (Iha desportu) avansa ba oin atu hatama golu ka buka pontu."
    },
    {
      "word": "Atambua (rai-),",
      "class": "Substantivu",
      "meaning": "Sidade kapitál munisípiu Belu nian, iha Timór Loromonu, neʼebé besik rai-ketan ho Timor-Leste."
    },
    {
      "word": "atan-ha'u,",
      "class": "Substantivu",
      "meaning": "Títulu haraik-an neʼebé ema uza atu troka pronome emak 'ha'u' bainhira ko'alia ho ema boot ida, liuliu membru hosi kleru, no mós bainhira reza. Ez. Amu bispu, atan-ha'u mai atu konfesa."
    },
    {
      "word": "ataúdu,",
      "class": "Substantivu",
      "meaning": "Barata oin ida neʼebé ki'ik."
    },
    {
      "word": "ataurense,",
      "class": "Adjetivu | Substantivu",
      "meaning": "Adjetivu: Rai-Ataúru nian. Substantivu: Ema Ataúru."
    },
    {
      "word": "Ataúru (rai-),",
      "class": "Substantivu",
      "meaning": "Illa no munisípiu ida Timor-Leste nian iha tasi-feto neʼebé nakfati iha sidade Dili nia oin no rai-Alor no rai-Wetar sira-nia leet."
    },
    {
      "word": "até,",
      "class": "Advérbiu | Prepozisaun",
      "meaning": "Advérbiu: Liafuan ida neʼebé ita uza hodi haktemik hahalok ida neʼebé halo ita hakfodak ka sente hirus. Ez. Ha'u la fiar nia, até bele baku fali nia aman! Prepozisaun: To'o. (Uza de'it iha espresaun balu neʼebé ita dada hosi lia-portugés, n.e. até amañán, até logu)."
    },
    {
      "word": "ateízmu,",
      "class": "Substantivu",
      "meaning": "Doutrina ka filozofia neʼebé la simu katak Maromak iha duni."
    },
    {
      "word": "aten,",
      "class": "Substantivu",
      "meaning": "Órgaun boot ida ita-nia isin laran, besik fuan, neʼebé hamoos ita-nia raan no tulun estómagu atu dijere hahán."
    },
    {
      "word": "aten-barani,",
      "class": "Adjetivu | Substantivu",
      "meaning": "(Kualidade) la ta'uk buat ida. Sin. aten-boot."
    },
    {
      "word": "aten-book,",
      "class": "Substantivu",
      "meaning": "Órgaun kaduak ida iha hirus-matan laran neʼebé ema no balada sira presiza atubele dada iis. Sin. bobon, pulmaun."
    },
    {
      "word": "aten-moras,",
      "class": "Adjetivu",
      "meaning": "Neʼebé rai kuna no buka atu vinga an. Sin. vingadór."
    },
    {
      "word": "aten-raak,",
      "class": "Substantivu",
      "meaning": "Órgaun ida iha ita-nia isin laran, besik estómagu, neʼebé husik ita-nia raan iha kondisaun di'ak. Sin. ook."
    },
    {
      "word": "atende,",
      "class": "Verbu",
      "meaning": "Hakbesik atu tulun. Sin. sirin."
    },
    {
      "word": "atensaun,",
      "class": "Substantivu",
      "meaning": "See tilun, tau matan ka loke neon ba buat ruma."
    },
    {
      "word": "atensiozu - atensioza, f.",
      "class": "Adjetivu",
      "meaning": "Neʼebé fó atensaun boot ba ema seluk nia dignidade ka nesesidade. Sin. laran-murak."
    },
    {
      "word": "atentadu,",
      "class": "Substantivu",
      "meaning": "Atake fíziku ba ema ida, ho kasinar ka intensaun atu oho nia."
    },
    {
      "word": "ateu - ateia, f.",
      "class": "Adjetivu | Substantivu",
      "meaning": "Adjetivu: 1. Neʼebé nega Na'i Maromak. 2. Ateízmu nian, kona-ba ateízmu. Substantivu: Ema neʼebé lakohi fiar ba Maromak ka fó ulun ba Nia ukun."
    },
    {
      "word": "atis,",
      "class": "Substantivu",
      "meaning": "Instrumentu ida neʼebé ema uza atu soru tais."
    },
    {
      "word": "atitide,",
      "class": "Substantivu",
      "meaning": "Maneira hanoin kona-ba buat ruma ka ema ruma, neʼebé hamkona mós ita-nia komportamentu. Ez. Ema sira ne'ebé iha atitude arrogante ka egoísta, di'ak liu sira la sai doutór, padre, profesór ka ministru."
    },
    {
      "word": "atitudinál,",
      "class": "Adjetivu",
      "meaning": "Kona-ba atitude."
    },
    {
      "word": "atividade,",
      "class": "Substantivu",
      "meaning": "1. Buat oioin neʼebé ita hala'o hodi kona objetivu ruma. Ez. Ami-nia parókia hala'o atividade barak atu fó tulun ba família kiak sira. 2. Hahalok barak neʼebé ema-lubun ida hala'o hamutuk. Ez. Baibain iha atividade barak iha merkadu munisipál."
    },
    {
      "word": "atlántiku - atlántika, f.",
      "class": "Adjetivu",
      "meaning": "Kona-ba Oseanu ka Tasi-Boot Atlántiku, neʼebé nakfati iha kontinente Amérika, Europa no Áfrika sira-nia leet."
    },
    {
      "word": "atlas,",
      "class": "Substantivu",
      "meaning": "Livru ho mapa barak."
    },
    {
      "word": "atleta,",
      "class": "Substantivu",
      "meaning": "1. Ema neʼebé halai taru ho ema seluk iha kampu desportu. Sin. atletista. 2. Ema isin-forte ida neʼebé hali'is ba desportu. 3. Ema neʼebé pratika ezersísiu fíziku hanesan halai, haksoit, tuda ai ka besi, nst."
    },
    {
      "word": "atlétiku - atlétika, f.",
      "class": "Adjetivu",
      "meaning": "Kona-ba atleta ka atletizmu."
    },
    {
      "word": "atletizmu,",
      "class": "Substantivu",
      "meaning": "Atividade ka kualidade atlétika."
    },
    {
      "word": "atómiku - atómika, f.",
      "class": "Adjetivu",
      "meaning": "1. Átomu nian. 2. Kona-ba kbiit boot neʼebé sai hosi átomu sira neʼebé nakfahe."
    },
    {
      "word": "átomu,",
      "class": "Substantivu",
      "meaning": "Baluk ki’ik liu hotu iha elementu neʼebé bele hola parte iha reasaun kímika."
    },
    {
      "word": "atmosfera,",
      "class": "Substantivu",
      "meaning": "1. Ár no gás sira neʼebé hale'u planeta ida. 2. Lale'uk ka sirkunstánsia sira iha ita-nia sorin-sorin. Sin. ambiente."
    },
    {
      "word": "atraente,",
      "class": "Adjetivu",
      "meaning": "Neʼebé atrai."
    },
    {
      "word": "atrai,",
      "class": "Verbu",
      "meaning": "Dada, liuliu tanba nia furak."
    },
    {
      "word": "atrasaun,",
      "class": "Substantivu",
      "meaning": "Hahalok atrai nian."
    },
    {
      "word": "atrapalla,",
      "class": "Verbu",
      "meaning": "Hanetik ema hodi halo nia sai nervozu."
    },
    {
      "word": "atrazadu - atrazada, f.",
      "class": "Adjetivu",
      "meaning": "(Ema ka sosiedade) neʼebé ninia mama'ek ka dezenvolvimentu la to'o nivel baibain nian; neʼebé hela iha kotuk nafatin no la halo progresu ida. Ez. Maski ema foho balu atrazadu uitoan kona-ba edukasaun no teknolojia, sira-nia domin ba Maromak no sira-nia devosaun ba família dala barak boot liu ema sidade sira-nian."
    },
    {
      "word": "atraza,",
      "class": "Verbu",
      "meaning": "1. La'o neineik. 2. Halo la'o neineik; halo atu to'o tarde."
    },
    {
      "word": "atrazu,",
      "class": "Substantivu",
      "meaning": "Hahalok atraza nian."
    },
    {
      "word": "atrís,",
      "class": "Substantivu",
      "meaning": "Feto ida neʼebé atór. Sin. atór-feto."
    },
    {
      "word": "atrosidade,",
      "class": "Substantivu",
      "meaning": "Krime boot, violentu no kruél lahalimar, liuliu oho ema-lubun ida."

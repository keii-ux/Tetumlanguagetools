  {
    "word": "garantia",
    "class": "Substantivu",
    "meaning": "Promesa ka lia-loos atu halo buat ruma. Sin. kompromisu"
  },
  {
    "word": "garfu",
    "class": "Substantivu",
    "meaning": "Besi ki'ik ho lolon naruk no tutun tarak tolu neʼebé ema uza atu sukit ai-han bainhira han, selae atu sukit fo'er. Sin. aisasukuk, ai-suku"
  },
  {
    "word": "gargón",
    "class": "Substantivu",
    "meaning": "Sanan, bele elétriku ka la'ós, neʼebé ema uza atu nono bee."
  },
  {
    "word": "garnél mós granél",
    "class": "Adjetivu",
    "meaning": "Hahirak ka kuantidade barak hosi merkadoria ruma neʼebé fábrika baibain fa'an ba loja-na'in. Sin. boronAdvérbiuHoboronde'it."
  },
  {
    "word": "garoupa, (ikan-)",
    "class": "Substantivu",

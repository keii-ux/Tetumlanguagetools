    "word": "inokulasaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "inoportunu - inoportuna",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé li'ur hosi tempu ka okaziaun be natoon; neʼebé la kona loos. Sin. lakonak"
  },
  {
    "word": "inoportunidade",
    "class": "Substantivu",
    "meaning": ""
  },

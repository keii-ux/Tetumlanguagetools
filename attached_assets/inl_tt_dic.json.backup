  {
    "word": "hako'ak",
    "class": "",
    "meaning": "haree hakohak"
  },
  {
    "word": "hakohak",
    "class": "VerbulSubstantivu",
    "meaning": "(Hahalok) tau liman hale'u ema ida hodi kaer nia rabat ba itania isin. Sin. hafula Ez. Labarik neebá atu monu: lailais, hakohak nia metimetin!"
  },
  {
    "word": "hakoi",
    "class": "Verbu",
    "meaning": "1. Tau mate-isin iha rai-kuak, hafoin taka ho rai. Sin. taman Ez. Sira hakoi tiha sirania aman iha Baukau. 2. Subar buat ida iha rai laran. Ez. Sira hakoi osan-mean atu inimigu la bele foti."
  },
  {
    "word": "hakoin",
    "class": "Substantivu",
    "meaning": "Hahalok hakoi nian. Sin. hakoi-mate, enterru Adjetivu Ne'ebé ema hakoi tiha ona."
  },
  {
    "word": "hakole",
    "class": "Verbu",
    "meaning": "1. Halo sai kole. Ez. Se ó haruka ema ne'e sobu filafali tenda ne'e, ó sei ha-kole de'it nia. 2. Book to'o hirus ka la bele deskansa. Sin. xateia"
  },
  {
    "word": "hakolen",
    "class": "Substantivu",
    "meaning": "Hahalok hakole nian."
  },
  {
    "word": "hakonu",
    "class": "Verbu",
    "meaning": "Halo sai nakonu. Sin. enxe"
  },
  {
    "word": "hakonun",
    "class": "Substantivu",
    "meaning": "Hahalokhakonu nian."
  },
  {
    "word": "hakore",
    "class": "Verbu",
    "meaning": "Halo atu namkore, halo atu la metin ona. Sin. relaxa Ez. Bainhira sosiedade hakore dixiplina, ema barak fila ba aat."
  },
  {
    "word": "hakoren",
    "class": "Substantivu",
    "meaning": "Hahalok hakore nian. Liafuan-sorun: relaxamentu"
  },
  {
    "word": "hakotu",
    "class": "Verbu",
    "meaning": "1. Hapara ka teri netik buat ida neʼebé la'o daudaun. Ez. Funu hakotu ami-nia relasaun ho kolega indonéziu sira. 2. Selu hotu, nu'udar ezemplu konta, tusan, nst. 3. Kotu lia, halo de-sizaun. Sin. deside Ez. Sira hakotu atu fila ba sira-nia rain."
  },
  {
    "word": "hakotun",
    "class": "Substantivu",
    "meaning": "1. Hahalok hakotu nian. 2. Lia neʼebé ita hakotu tiha ona. Sin. desizaun, lia-kotun"
  },
  {
    "word": "hakribi mós hakribit",
    "class": "Verbu",
    "meaning": "La gosta ka odi maka'as tanba fo'er, dois, laran-dodok nst. Ez. Doutór sira la hakribit ema-moras maski kanek maka'as no fo'er. Substantivu (hakribit) Hahalokkaatitude hakribi nian."
  },
  {
    "word": "hakribin",
    "class": "Substantivu",
    "meaning": "Hahalok hakribi nian."
  },
  {
    "word": "hakridak",
    "class": "Verbu",
    "meaning": "Haksoit uitoan ka hetan xoke ki'ik tan buat ida neʼebé mosu derrepente de'it. Sin. hakfodak Substan-tivu Hahalok hakridak nian."
  },
  {
    "word": "hakro'at",
    "class": "Verbu",
    "meaning": "Halo sai kroʼat. Sin. haroʼat Substantivu Hahalok hakroʼat nian."
  },
  {
    "word": "hakrobuk",
    "class": "Verbu",
    "meaning": "Halibur malu barak hamu-tuk, sai krobuk. Ez. Uvas-fuan moris hakrobuk. Substantivu Hahalok hakro-buk nian."
  },
  {
    "word": "hakru'uk",
    "class": "Verbu",
    "meaning": "Silu ita-nia isinlolon tanba atu hi'it buat ida ka la'o iha buat badak ida nia okos. Ez. Ema aas tenke hakru'uk bainhira tama uma atu nia ulun la kona odamatan-kain. Substantivu Hahalok hakru'uk nian."
  },
  {
    "word": "haksahik",
    "class": "Verbu",
    "meaning": "1. Hetan sahin ka balun ida. 2. Fahe lisuk. Substantivu Hahalok haksahik nian."
  },
  {
    "word": "haksalak",
    "class": "Verbu",
    "meaning": "1. Haree sala, komprende sala. Sin. konfunde 2. Halo ain ka lima-nruin sai naksalak. Sin. dezloka Sub-stantivu Hahalok haksalak nian. Sin. (1) konfuzaun; (2) dezlokamentu"
  },
  {
    "word": "haksesudór",
    "class": "Adjetivu",
    "meaning": "Neʼebé haksesuk lailais ka hamosu haksesuk. Ez. Ema neebé haksesudór sei la hetan maluk barak. Substantivu Ema neʼebé gosta haksesuk."
  },
  {
    "word": "haksesuk",
    "class": "VerbulSubstantivu",
    "meaning": "1. (Hahalok) tetu lia kona-ba buat ruma. Sin. diskute 2. Diskute la para no buka atu manán ka buka loos de'it. Sin. halolon lia"
  },
  {
    "word": "haksi'ak",
    "class": "Verbu",
    "meaning": "1. Hato'o liafuan ho maka’as no hirus, liuliu ba ema ida neʼebé halo sala ka aat ruma. 2. Hakilar hodi si'ak. Sin. tarata Substantivu Hahalokhaksi’ak nian."
  },
  {
    "word": "haksoit",
    "class": "Verbu/Substantivu",
    "meaning": "(Hahalok) hi'it ain hodi dudu an ba oin la kona rai. Ez. Taibere haksoit atu ku'u haas maibé la konsege."
  },
  {
    "word": "haksolok",
    "class": "Adjetivu",
    "meaning": "1. Ne'ebé nakonu ho solok. Sin. ksolok 2. Neʼebé sente satis-feitu. Sin. kontente Verbu Sente solok ka satisfasaun. Ez. Labarik sira haksolok tanba hetan prezente Natál nian hosi amaninan. Substantivu Hahalok hak-solok nian."
  },
  {
    "word": "haksumik",
    "class": "Verbu",
    "meaning": "Subar an, lakohi hatudu oin. Ez. Estudante balu haksumi an atu mestre la bolu sira ba kuadru. Substan-tivu Hahalok haksumik nian. Sin. sasubar"
  },
  {
    "word": "haktamak",
    "class": "Verbu",
    "meaning": "Tama klaran ka mete bainhira ita la halo parte iha buat ida. Ez. Bertu haktamak deit maski prob-lema ne'e laós ninian. Substantivu На halok haktamak nian. Sin. interferénsia"
  },
  {
    "word": "haktanis",
    "class": "Verbu",
    "meaning": "Sente tan situasaun ladún di'ak ka aat ruma. Sin. lamenta Substan-tivu Hahalokhaktanisnian. Sin. lamentu"
  },
  {
    "word": "haktebes",
    "class": "Verbu",
    "meaning": "1. Hatebes didi'ak. 2. Hak-lake ka esplika ho momoos liafuan ida nia arti ka buat ida nia limite sira. Sin. define Ez. Sé mak bele haktebes liafuan nee nia arti? Substantivu Hahalok hak-tebes nian. Sin. definisaun"
  },
  {
    "word": "haktenik",
    "class": "Verbu",
    "meaning": "Dehan ka halo filafali tan. Sin. repete Ez. Favór ida bele haktenik númeru nee atu hau bele hakerek tiha. Substantivu Hahalokhakteniknian. Sin. repetisaun Advérbiu Halo filafali de'it ka repete. Ez. Nia husu haktenik tanba nia susar atu komprende esplika-saun ne'e."
  },
  {
    "word": "hakterus",
    "class": "Verbu",
    "meaning": "Tahan ho, pasiénsia ho, aguenta. Sin. tolera Adjetivu Neʼebé hakterus ka aguenta. Sin. pasiente Sub-stantivu Hahalok hakterus nian. Sin. pasiénsia, tolerasaun"
  },
  {
    "word": "haktolan",
    "class": "Verbu",
    "meaning": "(Substánsia ida) simu been ruma hanesan hemu ka susu tiha. Sin. absorve 2. (arti figuradu) Simu ka tolan influénsia ruma. Substantivu Hahalok haktolan nian. Sin. absorsaun"
  },
  {
    "word": "haktuas",
    "class": "Verbu",
    "meaning": "(Katuas, juis nst.) tuur iha oin hodi tesi lia ruma ka tuir serimónia. Sin. prezide Ez. Juis ida-ne'ebé mak haktuas iha prosesu ne'e? Substantivu Hahalok haktuas nian. Sin. prezidénsia"
  },
  {
    "word": "haktuir",
    "class": "Verbu",
    "meaning": "Hato'o halo tuir buat neʼebé ita rona ka ema ruma dehan. Sin. konta Ez. Sira haktuir buat ne'ebé xefe hatete tiha ba sira. Substantivu Hahalok hak-tuir nian. Prepozisaun Hodi halo tuir. Sin. konforme"
  },
  {
    "word": "haktulak",
    "class": "Verbu",
    "meaning": "Sai tiha ba fatin ruma hodi hela dook ba tempu balu. Adjetivu Neʼebé haktulak. Sin. auzente Substantivu Ha-halok ka estadu haktulak nian. Sin. auzénsia"
  },
  {
    "word": "hakusuk",
    "class": "Verbu",
    "meaning": "1. Husu didi'ak. 2. Husu-litik hodi buka informasaun ka loke lia-loos. Sin. interroga Ez. Polísia seidauk hakusuk sasin-na'in sira. Substantivu Hahalok hakusuk nian. Sin. interro-gatóriu"
  },
  {
    "word": "halai",
    "class": "Verbu",
    "meaning": "1. Hakat lailais no makaas. 2. Sees ka hakdook lailais hosi fatin ruma. Sin. teku 3. (arti figuradu) Sees hosi re-sponsabilidade ida. Ez. Nia halai hosi uma tanba nia apá baku nia loroloron."
  },
  {
    "word": "halain",
    "class": "Substantivu",
    "meaning": "1. Hahalok halai nian. 2. Distánsia ka diresaun halai nian. Sin. kursu"
  },
  {
    "word": "halais",
    "class": "Verbu",
    "meaning": "Halo atu lailais, halo sai lais. Sin. aselera Ez. Imi tenke halais iminia serbisu tanba oras atu besik too ona. Substantivu Hahalok halais nian. Sin. aselerasaun"
  },
  {
    "word": "halai-taru",
    "class": "Substantivul Verbu",
    "meaning": "(Halai iha) kompetisaun ida atu dewordina sé mak lais liu. Ez. Ema gosta hala'i-taru kuda iha rai-Suai."
  },
  {
    "word": "halakon",
    "class": "Verbu",
    "meaning": "1. Halo atu lakon ka la iha ona. 2. Halo atu sai mohu. Ez. Ami ha-lakon nehek ho ai-moruk atu la bele hobur masin-midar. 3. Hasai ka kasu (ukun-fuan ka lei). Sin. abole 4. Halo aat tiha. Sin. estraga5.Soeleetbuatidane'e serve ka folinboot. Sin. hakfakar, desperdisa 6. La aproveita didi'ak, porezemplu tempu ka oportunidade ida. Substan-tivu Hahalok ka efeitu halakon nian."
  },
  {
    "word": "halanu",
    "class": "Verbu",
    "meaning": "1. Halosailanutanbahemutua. 2. Halo sai lanu tanba hemu ai-moruk."
  },
  {
    "word": "halanun",
    "class": "Substantivu",
    "meaning": "Hahalok ka efeitu ha-lanu nian. Sin. (2) intoksikasaun"
  },
  {
    "word": "hala'o",
    "class": "Verbu",
    "meaning": "1. La'o tuir. Ez. Asudin sira hala'o liurai ne'e. 2. Halo buat ruma atu la'o ka funsiona. Ez. Sé mak hala'o pro-jetu ne'e? 3. Halo atu lao ba oin ka halo progresu. Sin. promove, avansa Ez. Hala'o povu nia kadia'k maka governu nia knaar mahuluk. 4. Husik tempu liu hodi halo buat ruma. Ez. Sarani sira halao kuarezma hodi hadera an no halo peniténsia."
  },
  {
    "word": "hala'on",
    "class": "Substantivu",
    "meaning": "Hahalok hala'o nian. Sin. (2) ezekusaun, realizasaun; (3) promosaun"
  },
  {
    "word": "halarek",
    "class": "Verbu",
    "meaning": "1. Halo sai klarek. 2. Keʼe sai balun ida. 3. (arti figuradu) Hasai balun ida. Ez. Ho dolar atus rua nee ami bele halarek ami-nia tusan. Substantivu Ha-halok halarek nian."
  },
  {
    "word": "halatar",
    "class": "Verbu",
    "meaning": "Tau iha latar ka liña. Sin. hakadak Substantivu Hahalok halatar nian. Sin. hakadak"
  },
  {
    "word": "haleet",
    "class": "Verbu",
    "meaning": "1. Haketak fatin ka tempu ho leet ida. 2. Rezerva ka husik hela tempu ruma. Ez. Ó tenke haleet hela loron ida atubele serbisu iha uma. 3. Fó leet ka oportunidade ba. Sin. habiban Substan-tivu Hahalok haleet nian."
  },
  {
    "word": "halekar",
    "class": "Verbu",
    "meaning": "1. Husik nakloke, n.e. biti ka kolxaun ida. 2. Kari ba fatifatin. 3. Hato'o avizu, anúnsiu, programa ka atividade ida ba fatifatin. Substantivu Hahalok halekar nian. Sin. (3) difuzaun"
  },
  {
    "word": "halele",
    "class": "Verbu",
    "meaning": "1. Halo atu namlele. 2. Duni sai."
  },
  {
    "word": "halelen",
    "class": "Substantivu",
    "meaning": "Hahalok halele nian."
  },
  {
    "word": "halelir",
    "class": "Verbu",
    "meaning": "Hatudu laran-susar no hanoin ba susar ne'ebé akontese, porezemplu mate. Sin. lamenta, haktanis Substant-ivu Hahalok halelir nian. Sin. lamentu"
  },
  {
    "word": "halena",
    "class": "Verbu",
    "meaning": "Fila hodi hatoba ka hatuur lolo-os fali, nu'udar ezemplu kopu, liman, nst."
  },
  {
    "word": "haleno",
    "class": "Verbu",
    "meaning": "Hatudu buat ida, hanesan iha lalenok. Sin. reflete Ez. Uma-lulik haleno itania kultura no fiar loloos."
  },
  {
    "word": "halenon",
    "class": "Substantivu",
    "meaning": "Hahalok haleno nian. Sin. reflesaun"
  },
  {
    "word": "halerik",
    "class": "VerbulSubstantivu",
    "meaning": "(Hahalok) dada iis hodi hatudu laran-baruk atu hala'o buat ida. 2. (Hahalok) hato'o itania laran-baruk, dehan katak ita la kontente. Ez. Ema neʼebé halerik demais sei susar atu serbisu hamutuk iha grupu."
  },
  {
    "word": "halerikdór",
    "class": "Substantivu",
    "meaning": "Ema neʼebé halerik lailais ka beibeik."
  },
  {
    "word": "haletak",
    "class": "Verbu",
    "meaning": "Halo atu hanoin ka hakarak hatene konaba buat ruma. Sin. interesa, preokupa"
  },
  {
    "word": "hale'u",
    "class": "Verbu",
    "meaning": "1. Bá, mai ka hela iha sorin hotu-hotu. 2. Halo le'un ka sírkulu ida atu buat ruma hela iha laran ka la bele sai, taka iha sorisorin hotu. Ez. Milísia sira haleu uma-kreda no buka atu oho refujiadu sira. Advérbiu Ho movimentu le'uk ka sirkulár. Sin. hale'u prepozi-saun Iha sorisorin hotu. Ez. Labarik sira hananu hale'u meza."
  },
  {
    "word": "hale'un",
    "class": "Substantivu",
    "meaning": "1. Hahalok haleʼu nian. 2. Fatin hotu-hotu neʼebé haleur Verbu 1. Halo sai kleur. 2. Dada oras atubele kleur tan. Ez. Bainhira ekipa ida nia pontu liu ona, jogadór sira buka haleur hodi pasa bola iha de'it sirania área. Substantivu Hahalok haleur nian. Sin. atrazu"
  },
  {
    "word": "hali",
    "class": "Verbu",
    "meaning": "1. Dulas hale'u. 2. Dulas bainhira homan buat ida hosi akadiru, tali-tahan, nst. Substantivu Ai-huntahan ki'ikneʼebé dala barak liu iha hun boot no abut tabele iha nia hun ka sanak sira. Ema balu han hali nia dikin neʼebé bele halo mós ba modo. Naran-Botániku: Ficus benjamina"
  },
  {
    "word": "halibur",
    "class": "Verbu",
    "meaning": "Lori hodi tau ka rai hamutuk. Ez. Pároku halibur sarani sira atubele kumprimentu ambispu. Substantivu Hahalok halibur nian. Sin. reuniaun"
  },
  {
    "word": "halihu mós halihun",
    "class": "Verbu",
    "meaning": "Halo atu nalihun. Substantivu (halihun) Hahalok halihu nian."
  },
  {
    "word": "hali'is",
    "class": "Verbu",
    "meaning": "1. Sadere ka tun ba sorin ida; hamriik kleʼuk ka loloos. Sin. nakli'is Ez. Tanba rai ne'e hali'is makaʼas, karreta ne'ebé liu bele baku-fila. 2. Hakbesik baibain ba hahalok ruma. Ez. Mestre nee hali'is ba tarata alunu sira bainhira sira la komprende. Substantivu Hahalok ka kondisaun hali'is nian. Sin. inklina-saun, tendénsia, nakli'is"
  },
  {
    "word": "halik",
    "class": "Adjetivu",
    "meaning": "1. Neʼebé ita hali tiha ona. 2. Ne'ebé susar atu komprende ka trata tanba iha elementu ka aspetu barak. Sin. kompleksu, komplikadu"
  },
  {
    "word": "halimar",
    "class": "Verbu",
    "meaning": "1. Hala'o atividade neʼebé la'ós sériu maibé atu haksolok de'it; hala'o pasatempu ida. 2. Hala'o desportu ruma. Sin. joga 3. Hela no la halo buat ida sériu. Ez. Tempu uluk, feto sira halimar deit iha uma maibé agora sira mós bele sai funsionáriu iha fatin barak. Substan-tivu Hahalokhalimarnian. Sin. (2,3) jogu"
  },
  {
    "word": "haliras",
    "class": "Verbu",
    "meaning": "Fó hanoin ka ideia ba ema atu halo buat foun ruma, liuliu obra artístika. Sin. inspira Ez. Rai-ilas furak rai- Timór haliras artista barak. Substantivu Ha-halok hamehi nian. Sin. inspirasaun"
  },
  {
    "word": "haliri",
    "class": "Verbu",
    "meaning": "1. = halirin 2. Halo atu sente kómodu. 3. Halo festa hodi hanoin hikas okaziaun espesiál ruma neʼebé akontese tempu uluk. Sin. selebra, festeja"
  },
  {
    "word": "halirin",
    "class": "Verbu",
    "meaning": "Halo sai malirin ka fresku. Substantivu1. Hahalokhalirinnian. 2. Ha-halok haliri nian. Sin. festa, selebrasaun"
  },
  {
    "word": "hali'ur",
    "class": "Verbu",
    "meaning": "1. Hasai ba li’ur. Sin. elimina Ez. Sira hali'ur ema nain-haat hosi kandidatu naʼin-hitu ne'ebé sei simu bolsaestudu. 2. Soe fo'er neʼebé iha ka-bun laran liuhosi kidun. Sin. tee Sub-stantivu Hahalok hali'ur nian. Sin. eliminasaun"
  },
  {
    "word": "halo",
    "class": "Verbu",
    "meaning": "1. Hala’o ka hamosu buat ida. 2. Harii estrutura ida, n.e. ponte, uma, nst. 3. Hotu (tempu ruma). Ez. Lakleur halo tinan ida ba ita-nia independénsia."
  },
  {
    "word": "halo-aat",
    "class": "Adjetivu",
    "meaning": "Neʼebé halo ka hamosu aat. Substantivu Hahalok halo aat ka estraga nian. Sin. hahaat"
  },
  {
    "word": "halodidi'ak",
    "class": "Advérbiu",
    "meaning": "Ho modu didi'ak. Ez. Botir vidru ne'e, favór Ita falun dididi'ak."
  },
  {
    "word": "haloke",
    "class": "Verbu",
    "meaning": "1. Loke buat ida neʼebé kleur ona taka ka subar hela. Sin. deskobre 2. Fó sai informasaun ida neʼebé kleur ona subar. Sin. revela"
  },
  {
    "word": "haloken",
    "class": "Substantivu",
    "meaning": "Hahalok haloke nian kabuatneʼebéitahaloke. Sin. deskoberta; revelasaun Livru Haloken Nian (ka Apokalipse) ne'e livru dahikus iha Bíblia nia naran."
  },
  {
    "word": "haloko",
    "class": "Verbu",
    "meaning": "Fó sai no halekar informasaun kona-ba buat ida nia kualidade di'ak ka folin boot. Sin. promove halokon Sub-stantivu; Sin. promosaun"

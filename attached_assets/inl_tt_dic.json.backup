  },
  {
    "word": "orgullu",
    "class": "Substantivu",
    "meaning": "1. Sentimentu satisfasaun nian bainhira ita ka ema be besik ita halo buat di'ak ka furak ruma. Sin. laran-kmanek 2. Sentimentu dignidade no respeitu nian ba ita-nia an. 3. Sentimentu bainhira ema ida sente nia di'ak liu ema seluk. Sin. laran-bubu"
  },
  {
    "word": "orienta",
    "class": "Substantivu",
    "meaning": "1.Taukahariiihahalolon ka diresaun partikulár ida, katak norte, súl, lorosa'e ka loromonu. 2. Fó dalan ka treinu. 3. Supervizaun ba teze ka projetu hakerek nian ida."
  },
  {
    "word": "orientadór - orientadora, f.",
    "class": "Adjetivu",
    "meaning": "Neʼebé fó dalan; kona-ba orientasaun. Substantivu 1. Ema neʼebé fó konsellu, treinu ka formasaun ruma. 2. Profesóruniversidade neʼebé superviziona estudante ida neʼebé prepara nia teze."
  },
  {
    "word": "orientál",
    "class": "Adjetivu",
    "meaning": "1.Neʼebénakfatiihalorosa'e; neʼebé hosi parte lorosa'e; lorosa'e nian. Sin. lorosa'ek 2. Neʼebé hosi Ázia Lorosa'e. Ez. Maioria ema orientál sira-nia fuuk kór-metan."
  },
  {
    "word": "orientasaun",
    "class": "Substantivu",
    "meaning": "1. Halolon ka diresaun partikulár ida, katak norte, súl, lorosa'e ka loromonu. 2. Hahalok fó dalan ka treinu. 3. Supervizaun ba teze ka projetu hakerek nian ida."
  },
  {
    "word": "orifísiu",
    "class": "Substantivu",
    "meaning": "Kuak ki'ik."
  },
  {
    "word": "orijen",
    "class": "Substantivu",
    "meaning": "Buat ida nia hun; fatin iha neʼebé nia hahú. Sin. hun-fatin"
  },
  {
    "word": "orijinál",

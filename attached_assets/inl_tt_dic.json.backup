  {
    "word": "hakno'an-laek",
    "class": "Substantivu",
    "meaning": "Kualidade laha-kno'ak. Sin. independénsia"
  },
  {
    "word": "haknoik",
    "class": "Verbu",
    "meaning": "Fó konsellu. Sin. akonsella Substantivu Konsellu."

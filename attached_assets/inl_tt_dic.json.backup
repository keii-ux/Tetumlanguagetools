  },
  {
    "word": "insetívoru - insetívora",
    "class": "f. Adjetivul Substan-tivu",
    "meaning": "(Animál) neʼebé han insetu sira. Sin. mahánkutun Ez. Manduku no teki balada insetívoru."
  },
  {
    "word": "insetu",
    "class": "Substantivu",
    "meaning": "Animál ki’ik sira neʼebé dolar, haksoit ka semo, n.e. nehek, lala'ek, lalar, susuk nst. Sin. kutun"
  },
  {
    "word": "insidente",
    "class": "Substantivu",
    "meaning": "Buat ladi’ak neʼebé akontese, kazu susar ka aat."
  },
  {
    "word": "insignifikante",
    "class": "Adjetivu",
    "meaning": "1. Neʼebé la impor-tante ka la fó sentidu ida. 2. Neʼebé la hatudu rezultadu diak ka folin diak ida."
  },
  {
    "word": "insignifikánsia",
    "class": "Verbu",
    "meaning": ""
  },
  {
    "word": "insineradór",
    "class": "Substantivu",
    "meaning": "Bidón atu sunu fo'er. Sin. bidón-sunu, madesan"
  },
  {
    "word": "insinerasaun",
    "class": "Substantivu",
    "meaning": "Hahalok sunu to-mak hotu nian. Sin. hadesan, kremasaun"
  },
  {
    "word": "insinseru - insinsera",
    "class": "Adjetivu",
    "meaning": "Neʼebé la iha sinseridade, nuʼudar ezemplu hatudu sentimentu neʼebé la'ós tuir loloos buat neʼebé nia sente ka bosok hela. Sin. lasi-nseru, laranmakerek, nanál-sanak"
  },
  {
    "word": "insinseridade",
    "class": "Substantivu",
    "meaning": "Ez. Insinseridade halo ema sira susar atu fiar malu."
  },
  {
    "word": "insiste",
    "class": "Verbu",
    "meaning": "Husu ka rekomenda ho maka’as atu hala'o buat ida. Sin. litik Ez. Gov-ernu insiste ba naʼin sira hatama sirania balada ba luhan."
  },
  {
    "word": "insisténsia",
    "class": "Substantivu",
    "meaning": "; Sin. lalitik"

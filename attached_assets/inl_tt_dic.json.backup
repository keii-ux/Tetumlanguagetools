    "class": "Adjetivu",
    "meaning": ""
  },
  {
    "word": "fera",
    "class": "Verbu",
    "meaning": "1. Fahe ho kbiit buat ida tomak ba parte rua ka liu, hanesan mantolun, nst. 2. Estraga maka'as. 3. Hasai feto-raan ida nia virjindade."
  },
  {
    "word": "feriadu",
    "class": "Substantivu",
    "meaning": "Deskansu hosi knaar oioin ba ema hotu. Ez. Feriadu Páskua nian sei hahú iha fulan-Abríl. Feriadu boot katak feriadu ne'ebé lori tempu naruk."
  },
  {
    "word": "férias",
    "class": "Substantivu",
    "meaning": "Tempu livre hosi atividade sira baibain nian tuir oráriu serbisu-fatin ka eskola nian ruma. Ez. Estudante sira sei hala'o férias tanba sira remata ona ezame finál."
  },
  {
    "word": "ferik",
    "class": "Adjetivu",
    "meaning": "Feto ne'ebé sai otas tanba moris kleur ona, baibain fuuk bele mutin no kulit namkurut ona."
  },
  {
    "word": "fermentu",
    "class": "Substantivu",
    "meaning": "Tipu kulat ida neʼebé uza atu kahur ho trigu hodi halo paun ka dose, selae atu halo serveja."
  },
  {
    "word": "fermentu-rahun",
    "class": "Substantivu",
    "meaning": "Kulat-uut atu halo paun, dose ka serveja."
  },
  {
    "word": "ferramenta",
    "class": "Substantivu",
    "meaning": "Instrumentu ka besi ba arte ka ofísiu ruma."
  },
  {
    "word": "ferrujen",
    "class": "Adjetivul Substantivu",
    "meaning": "Substánsia tarak kameak neʼebé mosu iha besi ka besi-asu neʼebé bee ka oksijéniu mak kona. Sin. besi-meak"
  },
  {
    "word": "fertil",
    "class": "Adjetivu",
    "meaning": "1. Neʼebé bele fó fuan ka oan barak. Sin. bokur; Liafuan-sorun: kiuk 2. (Feto) neʼebé hahoris oan barak. Sub-stantivu fertilidade"
  },
  {
    "word": "fertiliza",
    "class": "Verbu",
    "meaning": "Halo sai fertil. Sin. habokur"
  },
  {
    "word": "fertilizante",
    "class": "Adjetivu",
    "meaning": "1. Ai-moruk kímiku neʼebé bele halo rai sai fertil. 2. Rai-metan, estrume."
  },
  {
    "word": "festa",
    "class": "Substantivu",
    "meaning": "Halibur-malu ka loron es-pesiál atu selebra buat di'ak ruma."
  },
  {
    "word": "festa-na'in",
    "class": "Substantivu",
    "meaning": "Ema neʼebé halo festa hodi konvida ema seluk atu hanhemu, liulu iha nia uma rasik."
  },
  {
    "word": "festivál",
    "class": "Substantivu",
    "meaning": "Festa públika ho espe-tákulu oioin, liuliu hananu nian."
  },
  {
    "word": "feto",
    "class": "Substantivu",
    "meaning": "Ema neʼebé pertense ba seksu idaneʼebé bele ko'us hodi iha oan. Liafuan-sorun: mane"
  },
  {
    "word": "feto-aat",
    "class": "Substantivu",
    "meaning": "Feto ida neʼebé hala'o relasaun seksuál ho mane neʼebé laós nia kaben. Sin. feto-bikan, fetomanas, feto-nona"
  },
  {
    "word": "feto-bikan",
    "class": "",
    "meaning": "haree fetoaat"
  },
  {
    "word": "feto-faluk",
    "class": "Substantivu",
    "meaning": "Feto ka feen neʼebé nia la'en mate hela tiha. Ez. Feto-faluk barak tenke hetan tulun hosi governu tanba sira-nia la'en mate durante rez-isténsia nuʼudar asua'in."
  },
  {
    "word": "feto-foun",
    "class": "Substantivu",
    "meaning": "Oan-mane nia feen. Liafuan-sorun: banin-feto"
  },
  {
    "word": "fetok",
    "class": "Adjetivu",
    "meaning": "1. Feto nian, kona-ba feto, neʼebé pertense ba seksu ida neʼebé bele iha oan. Sin. inak 2. (Mane) neʼebé halo an hanesan feto."
  },
  {
    "word": "feto-kait",
    "class": "Substantivu",
    "meaning": "Feto ida neʼebé mane ida hadomi no hala'o relasaun seksuál ho nia, maibé la’ós nia feen. Sin. amante, fetonona, kamarua, kait"
  },
  {
    "word": "feto-klosan",

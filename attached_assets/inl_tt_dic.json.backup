  },
  {
    "word": "irremediavel",
    "class": "Adjetivu",
    "meaning": "Neʼebé ita la bele remedeia ka haloos. Sin. habali-labelek, haloos-labelerk"
  },
  {
    "word": "irremediabilidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "irreparavel",
    "class": "Adjetivu",
    "meaning": "Neʼebé ita la bele hadi'a. Sin. hadi’a-labelek"
  },
  {
    "word": "irreparabilidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "irresponsavel",
    "class": "Adjetivu",
    "meaning": "Neʼebé hatudu ati-tude responsavel. Sin. laresponsavel, latesak Ez. Empregadu nee bele halo aat projetu tomak ho nia hahalok irrespo-nsavel."
  },
  {
    "word": "irresponsabilidade",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "irrezistivel",
    "class": "Adjetivu",
    "meaning": "Neʼebé sei la bele reziste ka susar atu kontrola. Sin. satanlabelek"
  },
  {
    "word": "irriga",
    "class": "Verbu",
    "meaning": "Dada ka husik bee liuhosi kanu ka beedalan ba fatin ida hodi halo ai-horis moris ka buras. Sin. haroo"
  },
  {
    "word": "irrigasaun",
    "class": "Substantivu",
    "meaning": "; Sin. haroon"
  },
  {
    "word": "isik",
    "class": "Adjetivu",
    "meaning": "Isin nian; konaba isin. Sin. kor-porál, korpóreu"
  },
  {
    "word": "isin",
    "class": "Substantivu",
    "meaning": "1. Ai-fuan no modo nia na'an no kulit hamutuk. 2. Balada ka ema nia na'an, kulit no ruin hamutuk. 3. Buat ida nia parte laran ka importante."
  },
  {
    "word": "isin-balun",
    "class": "Substantivu",
    "meaning": "Liman ka ain. Sin. membru"
  },
  {
    "word": "isin-baruk",
    "class": "Adjetivul Substantivu",
    "meaning": "Sente isin ladún di'ak, moras uitoan."
  },
  {
    "word": "isin-di'ak",
    "class": "Adjetivu",
    "meaning": "Neʼebé la hetan moras ruma ka goza saúde di'ak. Substantivu Kondisaunlahetan moras nian, isintomak funsiona didi'ak. Sin. saúde"
  },
  {
    "word": "isin-fraku",
    "class": "Adjetivul Substantivu",
    "meaning": "(Neʼebé) la iha forsa, liuliu tanba moras ruma."
  },
  {
    "word": "isin-lais",
    "class": "Adjetivul Substantivu",
    "meaning": "(Neʼebé iha) kapasidade atu hanoin ka halo buat ida lailais liu."
  },
  {
    "word": "isin-lolon",
    "class": "Substantivu",
    "meaning": "Isin nia lolon."
  },
  {
    "word": "isin-malirin",
    "class": "Substantivu",
    "meaning": "Moras neʼebé halo ema sente malirin no nakdedar nafatin."
  },
  {
    "word": "isin-metak mós isinmetan",
    "class": "Substantivu",
    "meaning": "Parte kulit nian ne'ebé sai azúl tanba hetan tuku ruma. Sin. isin-lolon metan, baku-fatin, isinazuladu"
  },
  {
    "word": "isin-molik",
    "class": "Adjetivul Substantivu",
    "meaning": "(Neʼebé) isin-lolon la taka ka nakloke tomak; la hatais roupa ida. Sin. isin-tanan"
  },
  {
    "word": "isin-moras",
    "class": "Substantivul Adjetivu",
    "meaning": "(Kondis-aun) la iha saúde ka lakon saúde nian; sente isin-baruk loos."
  },
  {
    "word": "isin-rua",
    "class": "Substantivu/Adjetivu",
    "meaning": "(Kondisaun bainhira feto) ko'us oan iha knotak laran ba kurakuran fulan sia nia laran. Sin. ho estadu hela"
  },
  {
    "word": "isin-tanan",
    "class": "Adjetivul Substantivu",
    "meaning": "(Neʼebé) la iha hatais ruma taka isin. Sin. isin-molik"
  },
  {
    "word": "isin-todan",
    "class": "Adjetivu",
    "meaning": "Neʼebé sente katak forsa la iha atu hala'o atividade ka knaar ruma. Sin. baruk"
  },
  {
    "word": "iska",
    "class": "Substantivu",
    "meaning": "Ai-han uitoan neʼebé ema tau iha kail nia rohan ka iha lasu atubele dada no kaer ikan ka animal seluk. Sin. umpa"
  },
  {
    "word": "iskeiru",
    "class": "Substantivu",
    "meaning": "Utensíliu ki’ik atu ha-mosu ahi, bele enxe ho gás ka minarai."
  },
  {
    "word": "isní (lia-)",
    "class": "Substantivu",
    "meaning": "Dialetu liaidalaka nian neʼebé ko'alia iha subdistritu Turiskai. Ema Isní, katak makdalek lian ida-ne'e nian."
  },
  {
    "word": "ispániku - ispánika",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé nia hun iha rai-España."
  },
  {
    "word": "ispanu-amerikanu - ispanu-amerikana",
    "class": "f. Adjetivul Substantivu",
    "meaning": "(Konaba) ema Amérika neʼebé ko'alia españól ka nia bizavón sira ema ispániku."
  },
  {
    "word": "Istambúl",
    "class": "Substantivu",
    "meaning": "Sidade boot ida iha rai-Turkia. Konstantinopla maka nia naran uluk nian."
  },
  {
    "word": "isterektomia",
    "class": "Substantivu",
    "meaning": "Operasaun sirúr-jika kona-ba tesi sai feto nia oan-fatin ka úteru."
  },
  {
    "word": "isteria",
    "class": "Substantivu",
    "meaning": "1. Moras nervozu neʼebé hatudu konvulsaun ka bibimaten. 2. Kondisaun nervus no laran tuku-tuku makaʼas; pániku tan buat ida ne'ebé halo ema sente ta'uk ka laran-manas liu. Ez. Isteria kona foin-sa'e fanátiku sira bainhira ditadór mosu kedas iha sira-nia oin, halo sira hakilar no tanis hanesan ema bulak."
  },
  {
    "word": "istériku - istérika",
    "class": "f. Adjetivu",
    "meaning": "Ez. Feto nee sai istériku bainhira nia haree nia alin mate tanba karreta xoke."
  },
  {
    "word": "istmu",
    "class": "Substantivu",
    "meaning": "Rai-dilan kloot no naruk ida neʼebé tutan península ida ba rai-boot. Sin. raikain"
  },
  {
    "word": "istória",
    "class": "Substantivu",
    "meaning": "1. Ai-knanoik, liuliu kona-ba ema nia moris. Sin. kontu, aiknanoik Ez. Avón sira gosta konta istória kona-ba bibi-atan neʼebé badinas no neonna'in. 2. Haktuir kona-ba moris povu ka ema ida nian. Ez. Loron 20 fulan-Maiu sai parte istória Timor-Leste nian ida tanba iha loron ne'e ita hetan fali independénsia."
  },
  {
    "word": "istoriadór - istoriadora",
    "class": "f. Substantivu",
    "meaning": "Ema neʼebé estuda no hakerek kona-ba istória, liuliu nuʼudar serbisu profisionál."
  },
  {
    "word": "istóriku - istórika",
    "class": "f. Adjetivu",
    "meaning": "1. Istória nian, kona-ba istória. 2. Neʼebé iha importá-nsia ba istória povu ka nasaun nian. Ez. Loron 30 fulan- Setembru sai loron istóriku ida ba povu Timor-Leste."
  },
  {
    "word": "istori malu",
    "class": "Verbu",
    "meaning": "Ko'alia aat no briga to'o baku malu."
  },
  {
    "word": "istori-malu",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "ita",
    "class": "Pronome Emak",
    "meaning": "1. Ó no ha'u hamutuk. 2. Imi no ami hamutuk."
  },
  {
    "word": "Ita",
    "class": "Pronome Emak Onorífiku",
    "meaning": "Liafuan neʼebé troka Pronome ó bainhira ita hakarak hatudu respeitu ba ema ida. Pronome ne'e ita sempre hakerek ho letra i boot."
  },
  {
    "word": "Ita-Boot",
    "class": "Pronome Emak Onorífiku",
    "meaning": "Liafuan neʼebé troka Pronome ó bainhira ita hakarak hatudu respeitu boot ba ema ida. Pronome ne'e ita sempre hakerek ho letra i no b boot. Hodi hasé ema naʼinrua ka liu, ita dehan ka hakerek Ita-Boot sira hodi troka Pronome imi."
  },
  {
    "word": "Itália (rai-)",
    "class": "Substantivu",
    "meaning": "Rain no estadu ida iha Europa Súl. Nia kapitál, Roma, ho-riuluk sentru Impériu Romanu nian no ohin sei sede Kreda Katólika nian."
  },
  {
    "word": "italianu - italiana",
    "class": "f. Adjetivu",
    "meaning": "Rai-Itália nian; kona-ba rai-Índia. Substantivu 1. EmaItá-lia. 2. (lia-italianu) Dalen rai-Itália nian."
  },
  {
    "word": "itáliku - itálika",
    "class": "f. Adjetivu",
    "meaning": "Kona-ba Itália antiga. Substantivu Estilu-hakerek hato-ba ida hanesan tuirmai nee: hakerek itáliku. Sin. letrahatoba"
  },
  {
    "word": "ita-nia",
    "class": "Pronome Maksoik",
    "meaning": "Neʼebé ita mak soi. Ez. Ita-nia povu koalia dalen barak."
  },
  {
    "word": "Ita-nia",
    "class": "Pronome Maksoik",
    "meaning": "Neʼebé Ita mak soi. Ez. Hau atu karimba Itania pasaporte."
  },
  {
    "word": "ita-nian",
    "class": "Pronome Maksoik",
    "meaning": "Neʼebé ita mak soi. Maklalin ka variante nee hanesan ho ita-nia, maibé tuir Substantivu ida-neʼebé nia refere bá. Ez. Ita la presiza sira-nia osan; ita soi ita-nian."
  },
  {
    "word": "Ita-nian",
    "class": "Pronome Maksoik",
    "meaning": "Neʼebé Ita mak soi. Maklalin ka variante ne'e hanesan ho Ita-nia, maibé tuir Substantivu ida-neʼebé nia refere bá. Ez. Kaneta nee Ita-nian, Sr. Filipe?"
  },
  {
    "word": "itineráriu",
    "class": "Substantivu",
    "meaning": "Oráriu kompletu kona-ba viajen ida, neʼebé temi fatin hotu-hotu ne'ebé ita atu bá."
  },
  {
    "word": "iupi",
    "class": "Substantivu",
    "meaning": "Ema ida neʼebé moris iha família riku no sai boot ho mentali-dade materialista no maromak-laek. Li-afuan inglés ne'e (yuppie) refere beibeik ba joven sira iha rain riku sira Mundu Dahuluk nian. Ez. Timoroan sira la gosta iupi portugés sira neebé mai serbisu iha Timór no lakohi aprende lia-tetun."
  },
  {
    "word": "izentu - izenta",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé livre, katak lei ka taxa, ka kastigu sei la kona. Sin. foruk Ez. Korpu diplomátiku sira baibain hatama sasán maibé sira izentu hosi taxa importasaun nian."
  },
  {
    "word": "izensaun",
    "class": "Substantivu",
    "meaning": "; Sin. haforun"
  },
  {
    "word": "izlámiku - izlámika",
    "class": "f. Adjetivu",
    "meaning": "Izlaun nian, kona-ba fiar Izlaun."
  },
  {
    "word": "izlandés - izlandeza",
    "class": "Adjetivu",
    "meaning": "Rai-Izlándia nian, kona-ba rai- Izlándia. Substan-tivu 1. Ema Izlándia. 2. (lia-izlandés) Dalen Izlándia nian."
  },
  {
    "word": "Izlándia (rai-)",
    "class": "Substantivu",
    "meaning": "Rai-kotun boot no estadu iha Tasi Nórdiku, nakfati iha Europa nia sorin nordueste."
  },
  {
    "word": "Izlaun",
    "class": "Substantivu",
    "meaning": "Relijiaun ida, ohin loron naklekar ba Ázia no Áfrika parte boot, neʼebé Maomé mak harii iha rai- Arábia iha sékulu dahituk liutiha Kristu."
  },
  {
    "word": "izoladu - izolada",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé hela ketak ka dook tiha hosi sira seluk. Sin. haksiit"
  },
  {
    "word": "izolamentu",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "izola",
    "class": "Verbu",
    "meaning": "1. Haketak ka hadook tiha hosi ema seluk. Ez. Prizaun balu izola tiha prizoneiru sira ne'ebé siak no violentu. 2. Hadi'a materiál ruma atu manas, lian ka eletrisidade la bele liu borus."
  },
  {
    "word": "Izraél (rai-)",
    "class": "Substantivu",
    "meaning": "Estadu ida iha Loro-sa'e Klarak neʼebé okupa territóriu rai-Palestina nian no povu judeu mak ukun."
  },
  {
    "word": "izraelita",
    "class": "Adjetivu",
    "meaning": "Izraél nian, konaba rai-Izraél. Substantivu 1. Ema Izraél. 2. Ema judeu (lalika sidadaun rai-Izraél nian)."
  },
  {
    "word": "Jakarta",
    "class": "Substantivu",
    "meaning": "Sidade boot iha rai-Java Loromonu neʼebé sai kapitál Indonézia nian, sentru ba governu no komérsiu."
  },
  {
    "word": "jaketa",
    "class": "Substantivu",
    "meaning": "Faru mahar no naruk neʼebé bele uza atu tahan ema hosi ma-lirin no mós anin."
  },
  {
    "word": "Jaku",
    "class": "Substantivu",
    "meaning": "Illa ki’ikoan ida pertense ba no besik distritu Lospalos; rai neʼebé ema la horik bá maibé fatin ida ne'ebé turista sira gosta vizita."
  },
  {
    "word": "jambata",
    "class": "Substantivu",
    "meaning": "Ai-lalete boot neʼebé uza atu hakat liu mota ka rai-olat. Sin. ponte"
  },
  {
    "word": "jambua",
    "class": "Substantivu",
    "meaning": "Ai-fuan ida hanesan saburaka maibé boot liu ho laran mean ka mutin bainhira nia tasak. Naran Botániku: Citrus paradisi"
  },
  {
    "word": "Janeiru (fulan-)",
    "class": "Substantivu",
    "meaning": "Fulan dahuluk neʼebé hahú bainhira troka tinan tuan ba tinan foun."
  },
  {
    "word": "janela",
    "class": "Substantivu",
    "meaning": "1. Kuak kuadradu didin-lolon uma nian ka iha karreta nia lolon neʼebé taka ho vidru-tahan, bele loke atu simu anin, naroman ka ema bele hateke tuir. 2. Iha komputadór, janela katak fatin ho kuadradu ki'ikoan iha lidun liman loos neʼebé ema bele uza atu taka nia programa."
  },
  {
    "word": "jantár",
    "class": "Substantivu",
    "meaning": "1. Han kalan nian. 2. Festa ki'ik neʼebé hamutuk ho han-kalan. Ez. Señór Antóniu konvida ema balu ba halo jantár ho nia família tomak."
  },
  {
    "word": "Japaun, (rai-)",
    "class": "Substantivu",
    "meaning": "Rain no estadu ida iha Ázia Lorosa'e neʼebé konsege okupa Timór durante Funu Raiklaran Daruak nian hosi tinan 1942-1945."
  },
  {
    "word": "japonés - japoneza",
    "class": "f. Adjetivu",
    "meaning": "Rai-Japaun nian. Substantivu 1. Ema Japaun. 2. (lia-japonés) Lian rai- Japaun nian."
  },
  {
    "word": "jardín",
    "class": "Substantivu",
    "meaning": "1. Área rai iha uma sorin neʼebé iha ai-funan, ai-hun, no du'ut. 2. Parke ki'ik neʼebé ita hetan iha sidade. Ez. Labarik sira halimar iha jardín Ita-Na'I-Feto Fátima nian."
  },
  {
    "word": "jardín infantil",
    "class": "Substantivu",
    "meaning": "Fatin-halimar ho eskola ba prepara labarik sira atu tama eskola primáriu."
  },
  {
    "word": "jardinajen",
    "class": "Substantivu",
    "meaning": "1. Serbisu hodi kuda ai-funan no ai-hun oioin iha jardín laran. 2. Serbisu halo jardín nuʼudar profisaun. Sin. ortikultura"
  },
  {
    "word": "jardineiru - jardineira",
    "class": "f. Substantivu",
    "meaning": "Ema neʼebé tau matan ka haree jardín hanesan ninia serbisu baibain nian ka nu'udar pasatempu."
  },
  {
    "word": "jarra",
    "class": "Substantivu",
    "meaning": "Fatin atu tau ai-funan. Sin. vazu"
  },
  {
    "word": "jatu",
    "class": "Substantivu",
    "meaning": "1. Líkidumusan neʼebé sai tanba hetan presaun, hanesan mina-morin kaleen neʼebé ema rega ba isin-lolon. 2. Mákina neʼebé funsiona tanba hamanas ár hafoin husik sai hosi jatu neʼebé makaʼas tebes. 3. (aviaun-jatu) Aviaun ka kasemok neʼebé uza forsa mákina jatu nian."
  },
  {
    "word": "Java (rai-)",
    "class": "Substantivu",
    "meaning": "Rai-kotun boot ka illa iha Indonézia neʼebé nakfati iha rai-Samatra no rai-Bali nia leet."
  },
  {
    "word": "javanés - javaneza",
    "class": "f. Adjetivu",
    "meaning": "Rai-Java nian. Substantivu 1. Ema Java, Java-oan. 2. (lia-javanés) Lian rai- Java nian."
  },
  {
    "word": "jáz",
    "class": "Substantivu",
    "meaning": "Estilu múzika populár ho rítmu neʼebé maka'as no envolve im-provizasaun."
  },
  {
    "word": "jeitu",
    "class": "Substantivu",
    "meaning": "1. Matenek no abilidade neʼebé ema iha atu hala'o buat ida. 2. Tipu serbisu ka téknika ruma ne'ebé presiza kursu ka matenek espesiál."
  },
  {
    "word": "jejún",
    "class": "Substantivu",
    "meaning": "Tempu durante ne'ebé ema la han, liuliu tan motivu relijiozu ka médiku. Ez. Molok atu Páskua, sa-rani sira halo jejún iha sesta-feira sema-nasemana."
  },
  {
    "word": "jeladu - jelada",
    "class": "f. Adjetivu",
    "meaning": "Malirin tanba tau iha jeleira ka tau kahur ho jelu-fatuk. Substantivu Sorvete neʼebé ema han hodi halo laran malirin. Ez. Diak liu hemu bee jeladu bainhira loron manas maka'as."
  },
  {
    "word": "jeleira",
    "class": "Substantivu",
    "meaning": "Kaixa malirin ne'ebé liga ba eletrisidade atubele malirin nafatin hodi uza ba rai ai-han ka hemu hanesan ai-fuan, pudín, bee, naan no buat se-luseluk tan."
  },
  {
    "word": "jelu",
    "class": "Substantivu",
    "meaning": "Bee neʼebé malirin to'o nahisi hodi sai toos hanesan fatuk."
  },
  {
    "word": "jelu-fatuk",
    "class": "Substantivu",
    "meaning": "Bee neʼebé ema rai ka halo to'o malirin no toos hanesan fatuk."
  },
  {
    "word": "jenerál",
    "class": "Substantivu",
    "meaning": "Diviza iha militár nia laran neʼebé dala barakliu marka ho fitun."
  },
  {
    "word": "jeneraliza",
    "class": "Verbu",
    "meaning": "1. Halo inferénsia jerál. 2. Ko'alia sala hodi la halo distinsaun sira ne'ebé presiza. Ez. Bainhira ema ha-tete katak rai-Timór tomak maran, ema nee jeneraliza de'it, tanba loloos parte barak iha rai-Timór mós matak no buras."
  },
  {
    "word": "jeneralizasaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "jéneru",
    "class": "Substantivu",
    "meaning": "Oin ka tipu ida. Sin. espésie Ez. Iha rai-Timór iha aifuan jéneru oioin, hanesan hudi, haas, aidila, derok no seluseluk tan."
  },
  {
    "word": "jéniu",
    "class": "Substantivu",
    "meaning": "1. Jeitu di'ak tebes ka kapasidade iha buat ruma. 2. Ema ne'ebé matenek, kreativu liu ka iha tal-entu barak."
  },
  {
    "word": "jéniu-aat",
    "class": "Adjetivul Substantivu",
    "meaning": "Hirus-teen, nervozu lailais bainhira ema la tuir nia hakarak. Ez. Labarik nee iha jéniu-aat hanesan nia avó-mane."
  },
  {
    "word": "jéniu-di'ak",
    "class": "Adjetivu",
    "meaning": "Neʼebé nia hahalok di'ak no hakmatek."
  },
  {
    "word": "jenosídiu",
    "class": "Substantivu",
    "meaning": "Buka oho povu tomak ida. Ez. Ema sira neebé pratika jenosídiu iha Bóznia sei lori ba tribunál interna-sionál, maibé militár indonéziu sira neʼebé halo krime jenosídiu iha Timór la hetan kastigu ida."
  },
  {
    "word": "jentiu - jentia",
    "class": "f. Adjetivul Substantivu",
    "meaning": "1. La'ós sarani, la tuir sarani nia hanorin no hanoin, la iha fiar iha Kristu. 2. Ani-mista, molok tama kristianizmu 3. (Ema) la'ós judeu."
  },
  {
    "word": "jenuinu - jenuina",
    "class": "f. Adjetivu",
    "meaning": "Loos ka tebes, tuir buat ne'ebé iha ka mosu, tuir reali-dade loloos."
  },
  {
    "word": "jeofízika",
    "class": "Substantivu",
    "meaning": "Matenek ka siénsia kona-ba rai nia karakterístika fízika sira."
  },
  {
    "word": "jeógrafu - jeógrafa",
    "class": "f. Substantivu",
    "meaning": "Ema matenek kona-ba jeografia."
  },
  {
    "word": "jeografia",
    "class": "Substantivu",
    "meaning": "1. Matenek ka siénsia kona-ba rai nia belak, nia karakterístika fízika sira, produsaun naturál, ema, di-vizaun polítika, komérsiu no buat se-luseluk tan."
  },
  {
    "word": "jeográfiku - jeográfika",
    "class": "f. Adjetivu",
    "meaning": ""
  },
  {
    "word": "jeolojia",
    "class": "Substantivu",
    "meaning": "Matenek ka serbisu kona-ba raiisin, nia estrutura, kompozi-saun no nia mama'ek ka dezenvolvi-mentu."
  },
  {
    "word": "jeolójiku - jeolójika",
    "class": "f. Adjetivu",
    "meaning": ""
  },
  {
    "word": "jeometria",
    "class": "Substantivu",
    "meaning": "Matemátika nia sanak ida neʼebé estuda kona-ba rela-saun pontu, liña, kurva, belak no se-luseluk tan."
  },
  {
    "word": "jeradór",
    "class": "Substantivu",
    "meaning": "1. Mákina ne'ebé de'it mak bele fó sai gás, suar, eletrisidade no seluseluk tan. 2. Mákina ida ne'ebé bele fó enerjia ka eletrisidade no serve liuliu bainhira ahi mate."
  },
  {
    "word": "jerál",
    "class": "Adjetivu",
    "meaning": "1. Neʼebé hakohak ka kona parte hotu-hotu, la'ós balun de'it. Sin. universál 2. Ordináriu, baibain nian. 3. La'ós espesiál ka partikulár ida, la hali'is ba ida de'it ka lokál. Substantivu Galeria ka fatin aas iha teatru laran, hosi ne'ebé ema sira hateke ba espetákulu."
  },
  {
    "word": "jerániu (ai-)",
    "class": "Substantivu",
    "meaning": "Planta ida neʼebé fó ai-funan furak ho kór oioin. Ema sira kuda beibeik aifunan jerániu ne'e iha vazu laran."
  },
  {
    "word": "jerasaun",
    "class": "Substantivu",
    "meaning": "1. Dezenvolvimentu umakain nian hosi tempu uluk bei'ala sira to'o oras ne'e daudaun. 2. Ema lubun ho otas hanesan. Sin. dalas 3. Otas hosi dalas ida ba dalas seluk. Ez. Ema neebé oho ema seluk, sei hetan malisan hosi jerasaun ba jerasaun."
  },
  {
    "word": "jerénsia",
    "class": "Substantivu",
    "meaning": "Knaar jerente nian."
  },
  {
    "word": "jerensiál",
    "class": "Adjetivu",
    "meaning": ""
  },
  {
    "word": "jerente",
    "class": "Substantivu",
    "meaning": "Ema neʼebé hala'o emp-reza ka komérsiu ida. Sin. mala'ok"
  },
  {
    "word": "jeriatria",
    "class": "Substantivu",
    "meaning": "Sanak hosi medisina neʼebé konaba katuas no ferik sira no sira-nia moras oinoin."
  },
  {
    "word": "jeriátriku - jeriátrika",
    "class": "f. Adjetivu",
    "meaning": ""
  },
  {
    "word": "jerikán",
    "class": "Substantivu",
    "meaning": "Masa ka kaleen atu rai mina-rai, bee, gazolina ka buat seluseluk tan neʼebé líkidu."
  },
  {
    "word": "Jeruzalein",
    "class": "Substantivu",
    "meaning": "Sidade boot iha rai-Palestina, sentru antigu no naranboot ba fiar judéu, sarani no musulmanu."
  },
  {
    "word": "jestaun",
    "class": "Substantivu",
    "meaning": "Knaar hala'o empreza ida, liuliu empreza komersiál. Sin. halaon"
  },
  {
    "word": "jestu",
    "class": "Substantivu",
    "meaning": "Espresaun neʼebé ema hato'o liuhosi nia oin, isin ka liman bainhira fó sai hanoin ka emosaun ho intensaun halo maka'as ka espresa nia hanoin ba ema seluk."
  },
  {
    "word": "jestikula",
    "class": "Verbu",
    "meaning": "; Sin. balmas, hakfikur"
  },
  {
    "word": "jesu",
    "class": "Substantivu",
    "meaning": "Ligadura neʼebé ema uza atu bobar liman ka ain tohar, nakonu ho simentu mutin neʼebé sai toos atu labele bokon bainhira bee kona. Ez. Labarik nee ain tohar, tanba nee doutór sira tau jesu ba nia ain atu labele book an demais."
  },
  {
    "word": "jezuita",
    "class": "Substantivu",
    "meaning": "Membru Kompañia Jezús nian, orden katólika ida ne'ebé Inásiu de Loyola mak harii iha tinan 1534."
  },
  {
    "word": "Jezús Kristu",
    "class": "Substantivu",
    "meaning": "Maromak Nia Oan no maksoin ema sira-nian. Sarani sira, hodi hatudu respeitu boot, baibain haktemik Nia ho títulu Ita Naʼi Jezús Kristu selae Ita Na'i de'it."
  },
  {
    "word": "jigante",
    "class": "Substantivu",
    "meaning": "Ema neʼebé boot tebes la hanesan baibain. Sin. ema kloe. Ez. Bainhira David funu hasoru Goliát, hanesan mós nia funu hasoru jigante ida, maibé to'oikus David mak manán."
  },
  {
    "word": "jin",
    "class": "Substantivu",
    "meaning": "Tua-manas inglés ida, halo hosi trigu hamorin ho zimbru-musan."
  },
  {
    "word": "jinasta",
    "class": "Substantivu",
    "meaning": "Ema ida neʼebé pratika jinástika."
  },
  {
    "word": "jinástika",
    "class": "Substantivu",
    "meaning": "Kursu ezersísiu fíziku nian ba dezenvolve isin, halo nia sai toos no maka'as."
  },
  {
    "word": "jináziu",
    "class": "Substantivu",
    "meaning": "Fatin ka uma neʼebé ema uza ba jinástika ka desportu seluk."
  },
  {
    "word": "jinekolojia",
    "class": "Substantivu",
    "meaning": "Siénsia konaba moras sira feto nian."
  },
  {
    "word": "jinekolojista",
    "class": "Substantivu",
    "meaning": "Médiku ka mate-nek-na'in neʼebé estuda ka halo investi-gasaun kona-ba jinekolojia."
  },
  {
    "word": "jipe",
    "class": "Substantivu",
    "meaning": "Karreta ki'ik ida neʼebé na-kloke no iha roda haat, dala barak liu militár sira mak uza tanba nia forte no lailais maski la'o iha fatuk ka tahu nia laran."
  },
  {
    "word": "jipiñu",
    "class": "Substantivu",
    "meaning": "Karreta ida neʼebé boot no aas liu karreta baibain nian. Ez. Kar-reta governu nian ohin loron barakliu jipiñu."
  },
  {
    "word": "jirafa",
    "class": "Substantivu",
    "meaning": "Animál maksusuk ka mamíferu rai-Áfrika nian neʼebé aas, kakorok naruk no iha ain haat. Nia fulun kinur, no taka ho pontu boot barak ho kórmetan."
  },
  {
    "word": "jirasól",
    "class": "Substantivu",
    "meaning": "Ai-funan aas neʼebé iha funan-tahan boot no kinur; dala ruma ema han nia musan bainhira tuan tiha ona tanba midar hanesan fore-rai."
  },
  {
    "word": "jíria",
    "class": "Substantivu",
    "meaning": "Ko'alia ida neʼebé grupu oioin, porezemplu joven sira, militár sira ka mariñeiru sira gosta uza, ho liafuan espesiál neʼebé ema seluseluk ladún hatene. Sin. kalaun Ez. Iha joven sira nia jíria liafuan ‘manduku’ katak ‘noiva’."
  },
  {
    "word": "jís",
    "class": "Substantivu",
    "meaning": "Fatuk mutin halo hosi ahu neʼebé dala barak uza iha eskola atu hake-rek ba kuadru; iha mós jís ho kór oin-oin."
  },
  {
    "word": "joallaria",
    "class": "Substantivu",
    "meaning": "1. Knaar ka arte halo joia sira hosi fatuk-murak. 2. Fatuk-murak ka joia oioin. 3. Loja neʼebé fa'an fatuk-murak oioin."
  },
  {
    "word": "joalleiru - joalleira",
    "class": "f. Substantivu",
    "meaning": "Ema neʼebé prepara ka fa'an fatukmurak ka joallaria."
  },
  {
    "word": "jogadór - jogadora",
    "class": "f. Substantivu",
    "meaning": "Ema neʼebé pratika desportu ka jogu ruma. Ez. Jogadór-futeból hanesan futebolista ka tebebola-na'in, no jogador-basketeból hanesan basketebolista."
  },
  {
    "word": "jogu",
    "class": "Substantivu",
    "meaning": "Halimar ida."
  },
  {
    "word": "joia",
    "class": "Substantivu",
    "meaning": "Fatuk-murak ida neʼebé prepara tiha ona nu'udar enfeite."
  },
  {
    "word": "jókei",
    "class": "Substantivu",
    "meaning": "Ema neʼebé halai kuda iha kompetisaun halai-taru kuda."
  },
  {
    "word": "jornál",
    "class": "Substantivu",
    "meaning": "Publikasaun ida imprime iha surattahan belar no naruk neʼebé fó sai nafatin lia-foun oioin, artíkulu no mós publisidade. Ez. Ema neʼebé lee jornál loron-loron, sei hetan informa-saun barak."
  },
  {
    "word": "jornalista",
    "class": "Substantivu",
    "meaning": "1. Ema neʼebé nia serbisu, profisaun ka interese mak buka informasaun atu fó sai liuhosi jornál. 2. Reporter ba rádiu ka televizaun. 3. Ema neʼebé hakerek nia diáriu."
  },
  {
    "word": "jornalizmu",
    "class": "Substantivu",
    "meaning": "Kona-ba serbisu atu hakerek, edita no publika nian. Ez. Jornalizmu durante okupasaun indo-nézia nia kualidade aat lahalimar."
  },
  {
    "word": "joven",
    "class": "Substantivu",
    "meaning": "Ema neʼebé la'ós tan ona labarik maibé mós seidauk sai adultu. Sin. foin-sa’e, adolexente"
  },
  {
    "word": "judaízmu",
    "class": "Substantivu",
    "meaning": "Relijiaun povu judeu nian, neʼebé horiuluk mosu mai iha rai-Palestina no sai fiar sarani nia hun."
  },
  {
    "word": "judaiku - judaika",
    "class": "f. Adjetivu",
    "meaning": ""
  },
  {
    "word": "judeu - judia",
    "class": "f. Substantivu/Adjetivu",
    "meaning": "(Ema) neʼebé tuir judaízmu, ka pertense ba povu ebreu. Ez. Ita Na'I Jezús Kristu maksoin povu judeu nian no ita-nian mós."
  },
  {
    "word": "judikatura",
    "class": "Substantivu",
    "meaning": "Serbisu-fatin ba juis ka tesi-lia na'in sira."
  },
  {
    "word": "judisiál",
    "class": "Adjetivu",
    "meaning": "1. Kona-ba ka própriu ba ukun judisiáriu ka administrasaun justisa nian. Sin. legál 2. Kona-ba tribunál, tribunál nian."
  },
  {
    "word": "judoka",
    "class": "Substantivu",
    "meaning": "Ema neʼebé pratika ka domina desportu judu."
  },
  {
    "word": "judu",
    "class": "Substantivu",
    "meaning": "Desportu japonés ida neʼebé nia forma mai hosi ju-jitsu. Iha desportu ne'e jogadór sori an hosi mak-sakar nia atake oioin."
  },
  {
    "word": "juis",
    "class": "Substantivu",
    "meaning": "Ema neʼebé tesi lia, liuliu iha tribunál. Sin. tesi-lia naʼin"
  },
  {
    "word": "julga",
    "class": "Verbu",
    "meaning": "Tesi lia. Ez. Problema ne'e sei lori ba tribunál atu juis bele julga."
  },
  {
    "word": "julgamentu",
    "class": "Substantivu",
    "meaning": "Hakotun ka desi-zaun neʼebé halo ka hamonu ba ema bainhira lia ida lori ba tribunál. Sin. tesi-lia, lia-tesin"
  },
  {
    "word": "Jullu (fulan-)",
    "class": "Substantivu",
    "meaning": "Fulan dahituk tinan nian, tuir fulan- Juñu no uluk-fulan- Agostu."
  },
  {
    "word": "júnior",
    "class": "Adjetivu",
    "meaning": "1. Klosan liu. Adjetivul Substantivu (Iha desportu) jogadór ho tinan entre 16 no 19. Liafuan-sorun: sénior"
  },
  {
    "word": "junta",
    "class": "Substantivu",
    "meaning": "Ema-lubun neʼebéhamutuk atu halo desizaun kona-ba buat ruma. Sin. komisaun"
  },
  {
    "word": "Juñu (fulan-)",
    "class": "Substantivu",
    "meaning": "Fulan daneen tinan nian neʼebé tuir fulan-Maiu no uluk-ba fulan-Jullu."
  },
  {
    "word": "jura",
    "class": "Verbu",
    "meaning": "Hato'o liafuan ho fiar katak buat neʼebé hato'o ne'e loos no tebes. Bainhira jura ema dala barak temi Maromak, matebian ka ema lulik ruma nia naran hanesan sasin ba buat neʼebé nia hato'o."
  },
  {
    "word": "jura-falsu",
    "class": "Substantivu",
    "meaning": "Hahalokfótestemuñu loloos ka tebes iha tribunál, maski lori Maromak ka ema lulik ruma nia naran nu'udar sasin."
  },
  {
    "word": "juradu - jurada",
    "class": "f. Substantivu",
    "meaning": "1. Ema neʼebé jura tiha ona atu hakotu lia iha kazu ruma iha tribunál. 2. Ema neʼebé jura tiha ona fó sasin ba kazu iha tribunál."
  },
  {
    "word": "juramentu",
    "class": "Substantivu",
    "meaning": "Hahalok ema jura nian hodi hasa'e lia ba Maromak, santu ruma ka ema lulikna'in ruma nu'udar sasin. Ez. Bainhira feto no mane kaben iha igreja, sira rua halo juramentu atubele hela hamutuk iha susar ka diak nia laran."
  },
  {
    "word": "juri",
    "class": "Substantivu",
    "meaning": "1. Ema-lubun ida neʼebé fihir ka hili tiha ona tuir lei no halo juramentu atu hala'o ka fó desizaun ba kazu ruma iha tribunál. 2. Ema-lubun neʼebé avalia kandidatu sira iha ezame ruma, selae mataruk ka konkorrente sira iha kom-petisaun ruma."
  },
  {
    "word": "jurídiku - jurídika",
    "class": "f. Adjetivu",
    "meaning": "Kona-ba ju-dikatura ka tribunál."
  },
  {
    "word": "jurisprudénsia",
    "class": "Substantivu",
    "meaning": "Siénsia konaba lei no direitu sira."
  },
  {
    "word": "jurista",
    "class": "Substantivu",
    "meaning": "Ema peritu ka matenek loos kona-ba lei."
  },
  {
    "word": "jurus",
    "class": "Substantivu",
    "meaning": "Osan neʼebé ema hetan nia funan bainhira tau ka depozita iha banku ka fó-empresta ba ema seluk. Sin. osan-funan"
  },
  {
    "word": "justifika",
    "class": "Verbu",
    "meaning": "Haklaken ka esplika ho ra-zaun tansá mak buat ruma loos ka ne-sesáriu. Ez. Oinsá mak sira bele justifika fakar osan barak nune'e bainhira ita-nia orsamentu ki'ik de'it?"
  },
  {
    "word": "justifikasaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "justisa",
    "class": "Substantivu",
    "meaning": "1. Hahalok trata ema hanesan, katak la iha ema ida hetan tratamentu di'ak ka aat liu ema seluk. 2. Hahalok fó kastigu natoon ba ema maksalak ka kriminozu. Ez. Sira neʼebé halo korrupsaun tenke lori ba tribunál atu hetan justisa no kastigu."
  },
  {
    "word": "justisa-na'in",
    "class": "Substantivu",
    "meaning": "1. Ema neʼebé nia serbisu ka responsabilidade mak halo desizaun kona-ba kazu ida bazeia ba informasaun sira neʼebé nia hetan ka iha. Sin. juis 2. Ema iha tribunál neʼebé hetan responsabilidade atu oinsá hala'o ka aplika lei. Sin. jurista"
  },
  {
    "word": "justu - justa",
    "class": "f. Adjetivu",
    "meaning": "Loloos tanba tuir razaun ka justisa. Ez. Juis nia desizaun justu loos tanba ema sira-nee merese duni kastigu boot."
  },
  {
    "word": "juveníl",
    "class": "Adjetivu",
    "meaning": "1. Foin-sa’e ka joven nian, kona-ba foin-sa’e ka joven. 2. Neʼebé halo an hanesan joven ka foinsa'e. Ez. Eskola tenke kria fatin-rekreiu ba nia estudante sira atu labele monu ba nakar ka hahalok juveníl aat, hanesan vandal-izmu no baku-malu iha dalan bainhira sai hosi eskola."
  },
  {
    "word": "juventude",
    "class": "Substantivu",
    "meaning": "1. Foin-sa’e ka joven nia otas. 2. Ema foin-sa’e sira konsidera nu'udar grupu."
  },
  {
    "word": "ka",
    "class": "Konjunsaun",
    "meaning": "Liafuan ida neʼebé hato'o alternativa rua. Sin. eh, ou Ez. Halo ida-ne'e ka ida neʼebá? Nota: Forma ka di'ak liu eh (tetun-terik) no ou (luzizmu)"
  },
  {
    "word": "kaan",
    "class": "Verbul Substantivu",
    "meaning": "Hakarak liu duké baibain. Ez. Feto isin-rua kaan han haas."
  },
  {
    "word": "ka'an",
    "class": "Substantivu",
    "meaning": "Feto nia la'en nia biin ka alin-feto ka prima. Sin. kuñada"
  },
  {
    "word": "ka'an",
    "class": "Substantivu",
    "meaning": "Organ ida iha inan nia úteru ka oan-fatin neʼebé fó-han ba kaukau, no sai ba li’ur bainhira bebé moris mai. Sin. manemalun; feto-malun"
  },
  {
    "word": "ka'an",
    "class": "Adjetivu",
    "meaning": "Neʼebé to'os ka makaʼas."
  },
  {
    "word": "ka'an-fuan",
    "class": "Substantivu",
    "meaning": "Ema ka balada iha oan-fatin ka úteru neʼebé seidauk moris mai. Sin. kaukau"
  },
  {
    "word": "kaba",
    "class": "Verbu",
    "meaning": "Kabeen sai ka turu."
  },
  {
    "word": "kaban",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "kabaas",
    "class": "Substantivu",
    "meaning": "Parte ita-nia isin nian entre kakorok no liman-hun. Ez. Ami baibain tula sasán ba ita-nia kabaas leten."
  },
  {
    "word": "kabala",
    "class": "Substantivu",
    "meaning": "Hatais ida neʼebé mane timór kesi hale'u sira-nia knotak, liuliu bainhira bidu. Verbu Kesi hale'u knotak, liuliu tais ka lipa."
  },
  {
    "word": "kabaur",
    "class": "Adjetivu",
    "meaning": "1. Neʼebé iha kór oioin hanesan baur ka arkuiris. 2. (Ai-horis ka balada) neʼebé hakiak hosi tipu ai-horis ka balada oioin, la'ós oin ida de'it. Sin. íbridu"
  },
  {
    "word": "kabeen",
    "class": "Substantivu",
    "meaning": "Been iha ibun laran neʼebé baibain tulun nata no tolan aihan."
  },
  {
    "word": "kabeer",
    "class": "Adjetivu",
    "meaning": "Neʼebé la nakbetok. Li-afuan-sorun: tarak, karutas Ez. Ai-kabelak nee kabeer hanesan vidru."
  },
  {
    "word": "kabelak",
    "class": "Adjetivu",
    "meaning": "Neʼebé belar, la kabuar. Sin. tetuk Ez. Banku ne'e la kómodu tanba ladún kabelak. Substantivu Parte neʼebé iha leten liu neʼebé bele hatuur buat ida bá, porezemplu meza ida nia kabelak, nst. Sin. superfísie"
  },
  {
    "word": "kabelak-estrika",
    "class": "Substantivu",
    "meaning": "Fatin estrika nian hosi ai kabelak halo ho sorin luan, sorin kloot hodi dudu kalsa ka faru ho besiestrika iha leten."
  },
  {
    "word": "kabelereiru - kabelereira",
    "class": "f. Substantivu",
    "meaning": "Ema neʼebé tesi ema seluk nia fuuk nuʼudar nia serbisu baibain nian. Sin. badain-fuuk"
  },
  {
    "word": "kaben",
    "class": "Verbu",
    "meaning": "Hetan lisensa hosi kreda no governu atu hela hamutuk hodi harii uma-kain ida nu'udar feen-la'en. Substan-tivu 1. Estadu, kondisaun ka sakramentu kaben nian. 2. Ema neʼebé kaben tiha ona. Sin. la’en - feen"
  },
  {
    "word": "kaben-na'in",
    "class": "Substantivu",
    "meaning": "Mane ka feto neʼebé kaben tiha ona."
  },
  {
    "word": "kaben-ruak",
    "class": "Substantivu",
    "meaning": "Krime kaben fila-fali bainhira ita sei kaben hela, katak itania la'en ka feen seidauk mate. Sin. bigamia"
  },
  {
    "word": "kabide",
    "class": "Substantivu",
    "meaning": "Fatin tara roupa nian. Ez. Tara faru sira-nee iha kabide atu labele namkurut."
  },
  {
    "word": "kabidu",
    "class": "Substantivu",
    "meaning": "Klibur hosi amlulik sira katedrál nian."
  },
  {
    "word": "kabier",
    "class": "Substantivu",
    "meaning": "Osan, rai ka sasán neʼebé ema ida bier ba ema seluk. Sin. legadu"
  },
  {
    "word": "kabina mós kabine",
    "class": "Substantivu",
    "meaning": "1. Fatin iha loja ka tasi-ibun neʼebé ema uza atu koko ka troka hatais sira. 2. Fatin iha aviaun nia oin neʼebé própriu ba pilota sira."
  },
  {
    "word": "kabina-telefone",
    "class": "Substantivu",
    "meaning": "Fatin ki'ik ida hanesan uma-oan neʼebé iha telefone atu ema bele uza hodi telefona."
  },
  {
    "word": "kabobir",
    "class": "Adjetivu",
    "meaning": "(Liafuan ka hahalok) neʼebé lafurak, ema baixu no modun-aat de'it mak uza ka hala'o. Sin. grosu, obxenu"
  },
  {
    "word": "kabograma",
    "class": "Substantivu",
    "meaning": "Telegrama ida neʼebé ema haruka liuhosi kabu iha tasi okos."
  },
  {
    "word": "kaboot",
    "class": "Adjetivu",
    "meaning": "Neʼebé boot natoon no mós importante. Sin. konsideravel, laki'ik"
  },
  {
    "word": "kabresi mós kabrestu",
    "class": "Substantivu",
    "meaning": "1. Sintu ka naʼan-kulit ida hodi kaer metin balada ida, baibain kuda ka karau. 2. wordu populár ba: sutién."
  },
  {
    "word": "kabu",
    "class": "Substantivu",
    "meaning": "1. Talin boot no mahar, halo ho lahan metáliku no uza liuliu atu kesi ró ka ba liña-telefone. 2. Postu mil-itár idane'ebé aas liu postu prasa ka soldadu-razu ninian."
  },
  {
    "word": "kabuar",
    "class": "Adjetivu",
    "meaning": "1. Neʼebé nia lolon hanesan bola, ulun-fatuk, leʼun ka sírkulu. 2. Ne'ebé bokur no soi isin-diak. Ez. La-barik ne'e kabuar loos."
  },
  {
    "word": "kabubu mós kabubun",
    "class": "Substantivu",
    "meaning": "Rai neʼebé bou, liuliu iha natar ninin atu satan bee."
  },
  {
    "word": "kabuk",
    "class": "Adjetivu",
    "meaning": "Neʼebé hetan isin-rua (lia-fuan neʼebé ita baibain emprega ba balada sira; ba ema ita uza fali isin-rua ka ko'us. Ez. Asu-inan ne'ebé kabuk hela, lakleur tan nia hahoris ona."
  },
  {
    "word": "kabun",
    "class": "Substantivu",
    "meaning": "Parte oin ema nia isin nian neʼebé hakohak estómagu, laran-metan no hetan tee-oan."
  },
  {
    "word": "kabun-belar",
    "class": "Substantivu",
    "meaning": "Parte isin nian neʼebé hakohak kabun no organ sira neʼebé hale'u nia. Sin. abdomen"
  },
  {
    "word": "kabun-dulas",
    "class": "Substantivu",
    "meaning": "Sente moras makaʼas iha kabun laran; sente talin-laran atu kotu tanba han sala ka moras ruma."
  },
  {
    "word": "kabun-laran",
    "class": "Substantivu",
    "meaning": "Orgaun iha ema no balada nia laran neʼebé simu hodi dulas ai-han ne'ebé tolan. Sin. estómagu"
  },
  {
    "word": "kabun-teek",
    "class": "Adjetivu",
    "meaning": "Neʼebé soi kabun boot liu baibain tan han-hemu resik ka mo-ras ruma."
  },
  {
    "word": "kabura",
    "class": "Substantivu",
    "meaning": "Ai-horis ne'ebé moris iha besik bee no iha rai malirin. Espésie balu ema ko'a hodi halo modo ba han."
  },
  {
    "word": "kabu-ronda",
    "class": "Substantivu",
    "meaning": "1. Ulun-boot ronda nian. 2. Ema neʼebé tau matan ba buat ruma atu ema labele book."
  },
  {
    "word": "Kabuverde (rai-)",
    "class": "Substantivu",
    "meaning": "Nusa-lubun no estadu dalen portugés ida besik rai-Áfrika nia raat loromonu."
  },
  {
    "word": "kabuverdianu - kabuverdiana",
    "class": "f. Adjetivu",
    "meaning": "Rai-Kabuverde nian. Substantivu Ema Kabuverde."
  },
  {
    "word": "kada",
    "class": "Adjetivu",
    "meaning": "Ida-idak (NB: Liafuan ida-ne'e sempre hamriik ulukba Substantivu ne'ebé nia kualifika). Ez. Kada tinan ami bá vizita ami-nia tiun iha Suai."
  },
  {
    "word": "kadadak",
    "class": "Adjetivu",
    "meaning": "Neʼebé tuituir malu ka tuir kedas ida fali iha latar ka liña ida.."
  },
  {
    "word": "kadastru",
    "class": "Substantivu",
    "meaning": "1. Rejistu públiku ba rai ka rikusoin nia valór. 2. Fixeiru neʼebé polísia rai kona-ba ema krimi-nozu ida nia hahalok no kastigu sira ne'ebé nia hetan tiha ona."
  },
  {
    "word": "kadavés",
    "class": "Advérbiu",
    "meaning": "1. Dala balu. Ez. Hau kadavés bá reza tersu iha kapela ne'ebá. 2. Dala ruma, kala, karik. Ez. Kadavés nia la mai ida, ita la'o uluk ona, keta hein."
  },
  {
    "word": "kadeia",
    "class": "Substantivu",
    "meaning": "Dadur-fatin ba ema neʼebé halo sala ka kontra lei sira. Sin. prizaun"
  },
  {
    "word": "kadeira-roda",
    "class": "Substantivu",
    "meaning": "Kadeira ho roda, la presiza foti bainhira hakarak muda, dudu ka tuba ho ain kadeira halai ka muda ona."
  },
  {
    "word": "kadeli",
    "class": "Substantivu",
    "meaning": "Sírkulu hosi metál osan-mean ka osan-mutin neʼebé ema tau iha limanfuan."
  },
  {
    "word": "kaderneta",
    "class": "Substantivu",
    "meaning": "1. Livru-oan neʼebé ema uza atu aponta buat balu bá bainhira tuir aula. 2. Livru-oan neʼebé uza atu aponta estudante nia komportamentu."
  },
  {
    "word": "kadesa mós kadesan",
    "class": "Substantivu",
    "meaning": "Rahun ka uut hosi buat ruma ne'ebé ai-han. Sin. ahikadesan, ahi-kudesan"
  },
  {
    "word": "kadiadu",
    "class": "Substantivu",
    "meaning": "Besi-kalsu ki'ik ida neʼebé halo hosi metál ho forma U. Ez. Bainhira sai ba li'ur tau kadiadu ba odamatan, hafoin xave tiha."
  },
  {
    "word": "kadi'ak",
    "class": "Substantivu",
    "meaning": "Di'ak neʼebé ema simu. liuliu hosi ema seluk ne'ebé laran-luak no tulun saugati. Sin. benefísiu"
  },
  {
    "word": "kadiuk",
    "class": "Substantivu",
    "meaning": "Balada krustáseu tasi-ibun ka mota-ibun nian ho liman-kukun boot."
  },
  {
    "word": "kadoek",
    "class": "Adjetivu/Advérbiu",
    "meaning": "Neʼebé tuituir malu. Sin. nadodon. Substantivu Latar ka liña halo hosi objetu barak nadodon. Haree mós fohokadoek, nusa-kadoek"
  },
  {
    "word": "kadoo",
    "class": "Substantivu",
    "meaning": "Instrumentu naruk na-toon ho nehan barak neʼebé ema uza atu tesi ai ho maneira dada fila-fila. Iha kadoo-besi no kadoomákina. Verbu Tesi ai ho kadoo."
  },
  {
    "word": "kadoo-liman",
    "class": "Substantivu",
    "meaning": "Kadoo ki'ik. Sin. kakorak"
  },
  {
    "word": "kadoor",
    "class": "Adjetivu",
    "meaning": "(Hahalok ka liafuan) neʼebé fo'er no hakanek kostume ka moralidade di'ak. Sin. obxenu Substantivu Kualidade kadoor Sin. obxenidade"
  },
  {
    "word": "kaduak",
    "class": "Adjetivu",
    "meaning": "Neʼebé moris mai hamutuk ka belit malu. Sin. duplu Haree mós oan-kaduak"
  },
  {
    "word": "Kaduar",
    "class": "Substantivu",
    "meaning": "Fitun-lubun no sinál datoluk zodiáku nian."
  },
  {
    "word": "kadunan",
    "class": "Substantivu",
    "meaning": "1. Liurai nia horik-fatin. Sin. palásiu 2. (arti figuradu) Uma boot no kapás, hanesan liurai ka ema riku nian."
  },
  {
    "word": "kaebauk",
    "class": "Substantivu",
    "meaning": "Enfeite osanmutin ho forma fulanbalun nian neʼebé Timoroan sira tau iha reen-toos hodi bá bidu."
  },
  {
    "word": "kaer",
    "class": "Verbu",
    "meaning": "1. Tau iha liman laran. 2. Rai iha liman laran. 3. Hapara ema ka balada atu la bele halai hosi ita. Ez. Polísia kaer na'okteen sira iha kalan.. 4. Hala'o veíkulu ka meiu transporte nian ida. Sin. lori Ez. Nia kaer aviaun ba tinan lima ona."
  },
  {
    "word": "kafé",
    "class": "Substantivu",
    "meaning": "1. (kafé-hun) Ai-horis ida neʼebé prodús musan hodi halo been neʼebé ema bele hemu. 2. Hemun meta-nmalahuk ne'ebé moruk uitoan no bai-bainkahurhomasin-midaratubelehemu."
  },
  {
    "word": "kafeikultura",
    "class": "Substantivu",
    "meaning": "Kuda kafé hodi halo negósiu."
  },
  {
    "word": "kafé-musan",
    "class": "Substantivu",
    "meaning": "Kafé fuan ida, neʼebé ema lalar, hafoin harahun atubele kahur ho bee nakali."
  },
  {
    "word": "kafé-soos",
    "class": "Substantivu",
    "meaning": "Kafé neʼebé nia rahun ema la uza ona depoizde ta'es tiha. Sin. kafé-teen"
  },
  {
    "word": "kafeteira",
    "class": "Substantivu",
    "meaning": "Vazu ka buli hodi pre-para kafé. Ez. Foti kafeteira mai tau kafé."
  },
  {
    "word": "kafeziñu",
    "class": "Substantivu",
    "meaning": "Kafé forte iha xikra ki'ikoan ida; baibain han hotu tiha tuir kostume ka toman malae-mutin sira sei hemu kafé ki’ikoan molok hamriik."
  },
  {
    "word": "kafoli",
    "class": "Substantivu",
    "meaning": "Hena ida neʼebé mane sira bobar hale'u knotak no sasán lulik."
  },
  {
    "word": "kafu'ak",
    "class": "Substantivu",
    "meaning": "Bubun ki’ikoan ida. Ez. Sasoro ne'e iha kafu'ak barak ona tanba bee la too."
  },
  {
    "word": "kafunan",
    "class": "Substantivu",
    "meaning": "Tipu kulat ka fungu kór-matak ka malahuk neʼebé mosu ai-han tuan ka iha valeta bokon. Sin. ku-lapur, utur"
  },
  {
    "word": "kaha",
    "class": "Substantivu",
    "meaning": "Ai-nanik oin ida ho tahan matak no fuan naruk natoon ne'ebé ema bele han matak de'it. Sin. pepinu"
  },
  {
    "word": "kahaat",
    "class": "Substantivu",
    "meaning": "Ida hosi balun haat neʼebé hamutuk forma lolon ida de'it. Sin. kuartu"
  },
  {
    "word": "kahatus",
    "class": "Substantivu",
    "meaning": "Ida hosi balun atus ida neʼebé hamutuk forma lolon ida de'it. Sin. sentézimu"
  },
  {
    "word": "kahe",
    "class": "Verbu",
    "meaning": "Hatuur buat ida iha buat seluk nia leten, ho sorisorin tabele hela."
  },
  {
    "word": "kahituk",
    "class": "Substantivu",
    "meaning": "Ida hosi balun hitu neʼebé hamutuk forma lolon ida de'it. Sin. sétimu kahoman Substantivu Buat homan."
  },
  {
    "word": "kahorik",
    "class": "Adjetivu",
    "meaning": "Neʼebé baibain moris ka horik iha rain ida. Sin. rai-nain, indíjena, nativu Ez. Ai-fuan kahorik oioin moris iha rai-Timór, hanesan hudi, haas no kulu."
  },
  {
    "word": "kahur",
    "class": "Verbu",
    "meaning": "1. Tau hamutuk ka kedok ho buat seluk hodi halo sai ida. Ez. Sira kahur kafé ho susubeen hodi halo sai midar liután. 2. Tama fali ba ema selu-seluk nia leet. Ez. Iha ita-nia rain ema metan no mutin kleur ona kahur malu no hola malu."
  },
  {
    "word": "kaidani",
    "class": "Substantivu",
    "meaning": "Hahán ki'ik, liuliu naʼan ka ikan tunu, hodi han akompaña hemu tua. Sin. petisku"
  },
  {
    "word": "Kaiena",
    "class": "Substantivu",
    "meaning": "Sidadekapitál rai-Giana Franseza nian."
  },
  {
    "word": "kaikoli (ai-)",
    "class": "Substantivu",
    "meaning": "1. Kabura boboot neʼebé moris hanesan ai-hun ho lolon naruk. Naran-Botániku: Cyathea aus-tralis 2. (Kaikoli) Bairru ida iha sidade Dili nia laran besik merkadu tuan, iha Balidi no Vilaverde nia leet."
  },
  {
    "word": "kail",
    "class": "Substantivu",
    "meaning": "Arame meik neʼebé kle'uk no iha kaʼit atu lasu ikan iha bee ka tasi laran. Verbu Lasu (ikan) ho kail. Sin. hakail"
  },
  {
    "word": "kail-isin",
    "class": "Substantivu",
    "meaning": "Ka'it meik iha kail nia rohan."
  },
  {
    "word": "kail-talin",
    "class": "Substantivu",
    "meaning": "Fiu naruk neʼebé ema kesi kai isin bá, baibain halo hosi plás-tiku toos."
  },
  {
    "word": "kain",
    "class": "Substantivu",
    "meaning": "Lolon mihis ida, liuliu ai-funan ka ai-tahan nia lolon."
  },
  {
    "word": "kain-",
    "class": "Matadak",
    "meaning": "Markadór neʼebé ita bai-bain tau uluk-ba numerál bainhira Sub-stantivu ida-ne'ebé nia tuir haktemik objetu naruk ruma, n.e. rota kain tolu, aisaar ka'in-lima, nst."
  },
  {
    "word": "kainbatik",
    "class": "",
    "meaning": "haree kambate"
  },
  {
    "word": "Kairu",
    "class": "Substantivu",
    "meaning": "Sidadekapitál rai-Ejitu nian."
  },
  {
    "word": "kairui (lia-)",
    "class": "Substantivu",
    "meaning": "Dialetu ida hosi sira haat ne'ebé forma dalen kawaimina; ema ko'alia lian ne'e iha rejiaun konsellu Manatutu nian iha parte klarak."
  },
  {
    "word": "kait mós feto-kait",
    "class": "Substantivu",
    "meaning": "Feto neʼebé sai namorada ba mane maibé laʼós nia feen loloos. Sin. kamarua, amante"
  },
  {
    "word": "ka'it",
    "class": "Verbu",
    "meaning": "Kaer lolon ida hosi ai, masa ka besi hodi dada mai besik, porezemplu haas, sabraka, nst. liuliu bainhira objetu nee iha aas ka iha kraik liu. Substantivu Tutun ka rohan meik ida neʼebé serve atu ka'it sasán."
  },
  {
    "word": "kaixa",
    "class": "Substantivu",
    "meaning": "1. Fatin lidunhaat hosi ai ka besi atu rai sasán iha laran. Sin. doos 2. Fatin neʼebé ita baibain selu bá iha loja laran hodi hetan resibu ba selun. Sin. selu-fatin Ez. Bainhira ita bá sosa sasán, tenke selu iha kaixa. 3. Ema neʼebé hein balkaun iha loja laran, hodi simu osan no fó resibu. Kaixa postál ne'e karta-fatin, surat-fatin iha uma-korreiu. Sin. apartadu"
  },
  {
    "word": "kaixaforte",
    "class": "Substantivu",
    "meaning": "Kaixa halo ho besi hodi rai ka haloot sasán folin-boot sira hanesan osan-mean, rikusoin sira uluk. Sin. kofre"
  },
  {
    "word": "kaixa-korreiu",
    "class": "Substantivu",
    "meaning": "Kaixa iha uma nia oin ne'ebé karteiru loroloron tau surat bá. Sin. kartafatin, surat-fatin"
  },
  {
    "word": "kaixa-rejistadora",
    "class": "Substantivu",
    "meaning": "Mákina ida neʼebé loja-na'in rai osan no troku iha laran; imprime no fó sai mós resibu ba selun ida-idak."
  },
  {
    "word": "kaixaun",
    "class": "Substantivu",
    "meaning": "Ai-balun boot ba ha-loot mate-isin."
  },
  {
    "word": "kaixote",
    "class": "Substantivu",
    "meaning": "Kaixa halo ho ai-kabelak."
  },
  {
    "word": "kaixumba",
    "class": "Substantivu",
    "meaning": "Balada nia dikur ne'ebé ho kuak boot ida iha nia rohan hodi tau tabaku ba fuma."
  },
  {
    "word": "kajú (ai-)",
    "class": "Substantivu",
    "meaning": "Ai-hun boot ida ne'ebé fó nós ka musan ki'ik kle’uk no ema bele han. Naran-Botániku: Anacardium occidentale"
  },
  {
    "word": "kaka",
    "class": "Verbu",
    "meaning": "Loke ho beran atu tau buat ruma ba laran, liuliu freun ba kuda nia ibun."
  },
  {
    "word": "kakae",
    "class": "Substantivu",
    "meaning": "Manu-fuik espésie ida neʼebé bele hasara ema. Sin. kakatua Naran-sientífiku: Kakatoe"
  },
  {
    "word": "kakahek",
    "class": "Substantivu",
    "meaning": "Hahalok kahe nian."
  },
  {
    "word": "kakahur",
    "class": "Substantivu",
    "meaning": "1. Hahalok kahur nian. 2. Substánsia ida neʼebé iha eleme-ntu rua kahur malu. Sin. mistura"
  },
  {
    "word": "kaka'it",
    "class": "Substantivu",
    "meaning": "Hahalok kaʼit nian."
  },
  {
    "word": "kakaluk",
    "class": "Substantivu",
    "meaning": "1. Manu nia kabun-laran. 2. Birun neʼebé ema kaer atubele sees hosi susar."
  },
  {
    "word": "kakamat",
    "class": "Substantivu",
    "meaning": "1. Hahalok kamat nian. 2. (ai-kakamat) Ai-nanik espésie ida ho tarak."
  },
  {
    "word": "kakarut",
    "class": "Substantivu",
    "meaning": "Hahalok karut nian."
  },
  {
    "word": "kakasuk",
    "class": "Substantivu",
    "meaning": "Hahalok kasu nian."
  },
  {
    "word": "kakatua",
    "class": "Substantivu",
    "meaning": "Manu-fuik espésie ida neʼebé bele hasara ema. Sin. kakae Naran-sientífiku: Kakatoe"
  },
  {
    "word": "kakau",
    "class": "Substantivu",
    "meaning": "Ai-horis neʼebé nia musan ema uza atu halo xokolate. Naran Sientífiku: Theobroma cacao"
  },
  {
    "word": "kakebit",
    "class": "Substantivu",
    "meaning": "Hahalok kebit nian."
  },
  {
    "word": "kakedok",
    "class": "Substantivu",
    "meaning": "Hahalok kedok nian."
  },
  {
    "word": "kake'ek",
    "class": "Substantivu",
    "meaning": "Hahalok keʼe nian."
  },
  {
    "word": "kakehe",
    "class": "Substantivu",
    "meaning": "Objetu neʼebé uza atu kehe oin bainhira rai manas, liuliu feto sira. Sin. leke"
  },
  {
    "word": "kakehek",
    "class": "Substantivu",
    "meaning": "Hahalok kehe nian."
  },
  {
    "word": "kakein",
    "class": "Substantivu",
    "meaning": "1. Hahalok kein nian. 2. Liafuan sira neʼebé ita hayto'o hodi kein ka avizxa. Sin. avizu Ez. Diak liu imi see tilun ba xefe nia kakein konaba perigu boot nee."
  },
  {
    "word": "kakesar",
    "class": "Substantivu",
    "meaning": "Hahalok kesar nian. Sin. keixa, reklamasaun"
  },
  {
    "word": "kakeu (ai-)",
    "class": "Substantivu",
    "meaning": "Ai-hun espésie ida ho tahan lotuk hanesan kesak, neʼebé moris iha motaninin. Bainhira anin huu nia tahan lian furak loos. Serve mós ba sunu ka halo aimaran. Naran Botá-niku: Casuarina equisetifolia"
  },
  {
    "word": "kaki",
    "class": "Substantivu",
    "meaning": "Sasán dapur nian neʼebé baibain uza atu dulas. trigu, aifarina nst. Sin. dadulas, peneira Verbu Dulas trigu, aifarina nst."
  },
  {
    "word": "kakí (hena-)",
    "class": "Substantivu",
    "meaning": "Hena kór kinur-kameak neʼebé ema baibain uza hodi halo farda militár."
  },
  {
    "word": "kakiak",
    "class": "Substantivu",
    "meaning": "Kualidade kiak."
  },
  {
    "word": "kakilik",
    "class": "Substantivu",
    "meaning": "Hahalok kili nian."
  },
  {
    "word": "kakiuk",
    "class": "Substantivu",
    "meaning": "Kualidade kiuk. Sin. esterilidade"
  },
  {
    "word": "kako'ak",
    "class": "Substantivu",
    "meaning": "Hahalok ko'a nian."
  },
  {
    "word": "kako'ak (manu-)",
    "class": "Substantivu",
    "meaning": "Manu-fuik ki'ik ida, kór-malahuk no ulun fulun-laek neʼebé nia lian hanesan ko'a! ko'a! Naran-sientífiku: Philemon timorensis"
  },
  {
    "word": "kakoet",
    "class": "Substantivu",
    "meaning": "Hahalok koet nian."
  },
  {
    "word": "kakoik",
    "class": "Substantivu",
    "meaning": "Hahalok koi nian."
  },
  {
    "word": "kakoir",
    "class": "Substantivu",
    "meaning": "Hahalok koir nian."
  },
  {
    "word": "kakoluk",
    "class": "Substantivu",
    "meaning": "Hahalok kolu nian."
  },
  {
    "word": "kakonak",
    "class": "Substantivu",
    "meaning": "Hahalok kona nian."
  },
  {
    "word": "kakorak",
    "class": "Substantivu",
    "meaning": "Kadoo ki'ik. Sin. ka-doo-liman Adjetivu Neʼebé taratarak hanesan kadoo ka lafaek nia ikun."
  },
  {
    "word": "kakorok",
    "class": "Substantivu",
    "meaning": "1. (uzu loos) Parte isin nian entre ita-nia oin no lakatruin, ho ezófagu ka talin iha laran. Sin. gar-ganta 2. (uzu populár) Kakorok no knoruk hamutuk, parte entre ulun-fatuk no isinlolon. Sin. kliak"
  },
  {
    "word": "kakorok-maran",
    "class": "Adjetivu/ Substantivu",
    "meaning": ""
  },
  {
    "word": "kakorok-moras",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "kakorok-boka mós kakorok-bubu",
    "class": "Sub-stantivu",
    "meaning": "Bubun neʼebé mosu iha kakorok tanba glándula tiroide naboot"
  },
  {
    "word": "kakorok-fukun",
    "class": "Substantivu",
    "meaning": "Fukun hanesan ai-fuan metin iha kakorok-talin nia laran ne'ebé mosu iha oan-mane sira-nia ka-korok bainhira sira sai boot."
  },
  {
    "word": "kakorok-kain",
    "class": "Substantivu",
    "meaning": "Tubu iha itania kakorok laran neʼebé husik ár tama no sai hosi aten-book. Sin. trakeia"
  },
  {
    "word": "kakorok-talin",
    "class": "Substantivu",
    "meaning": "1.Tubu iha ita-nia kakorok laran neʼebé lori hahán tolan hosi tatolan ba iha estómagu. Sin. ezófagu 2. (uzu populár) Tubu neʼebé lori ár ba ita-nia pulmaun bainhira dada iis. Sin. bobon-talin"
  },
  {
    "word": "kakosek",
    "class": "Substantivu",
    "meaning": "Hahalok kose nian."
  },
  {
    "word": "kakosok",
    "class": "Substantivu",
    "meaning": "Kualidade kosok."
  },
  {
    "word": "kakotuk",
    "class": "Substantivu",
    "meaning": "Hahalok kotu nian."
  },
  {
    "word": "kako'us",
    "class": "Substantivu",
    "meaning": "Hahalok ko'us nian."
  },
  {
    "word": "kaktu",
    "class": "Substantivu",
    "meaning": "Ai-horis mahar neʼebé moris iha rai-maran ka dezertu, baibain iha tarak neʼebé taka nia isin. Sin. kla-tun, ai-reti"
  },
  {
    "word": "kakuluk",
    "class": "Substantivu",
    "meaning": "Parte ida neʼebé taka uma ida nia leten ka tutun, baibain halo hosi zinku, tali-tahan, nst."
  },
  {
    "word": "kakumuk",
    "class": "Substantivu",
    "meaning": "Hahalok kumu nian. Sin. masajen"
  },
  {
    "word": "kakun",
    "class": "Substantivu",
    "meaning": "Modo ka nuu nia kulit li'ur."
  },
  {
    "word": "kakuran",
    "class": "Substantivu",
    "meaning": "1. Hahalok kuran nian. 2. Buat ne'ebee ita kuran. Sin. nesesidade"
  },
  {
    "word": "kakuruk",
    "class": "Substantivu",
    "meaning": "Hahalok kuru nian."
  },
  {
    "word": "kakusak",
    "class": "Substantivu",
    "meaning": "Hahalok kusa nian."
  },
  {
    "word": "kakutak",
    "class": "Substantivu",
    "meaning": "1. Organ iha ema nia ulun-fatuk laran neʼebé kontrola nia isin no habele ema atu hanoin no sente. 2. (arti figuradu) Kapasidade atu hanoin ho lójika. Sin. intelijénsia"
  },
  {
    "word": "kakuuk",
    "class": "Substantivu",
    "meaning": "Manu maksorok ka kasadór neʼebé kasa iha kalan. Manu ne'e nia matanfuan boot. Sin. lakuuk"
  },
  {
    "word": "kaku'uk",
    "class": "Substantivu",
    "meaning": "1. Hahalok ku'u nian. 2. (Ai-kaku'uk) Instrumentu ki'ik ida ho hasan metál no kaer-fatin rua neʼebé serve ba ku'u hodi foti buat ki'ik sira neʼebé metin hela. Sin. ailaknabit, pinsa"
  },
  {
    "word": "kakuun",
    "class": "Substantivu",
    "meaning": "Nuu nia kulit laran neʼebé toos."
  },
  {
    "word": "kaku'uk",
    "class": "Substantivu",
    "meaning": "Instrumentu boot ida ho sanak rua neʼebé badain-besi ema uza atu habit ka foti besi manas. Sin. ailaknabit, ai-lakuuk"
  },
  {
    "word": "kala",
    "class": "Advérbiu",
    "meaning": "1. Bele mosu. Sin. dala ruma, karik Ez. Bá haree nia kala mai ona. 2. Kurakuran, maizumenus. Ez. Iha nee ba ne'ebá kala kilómetru tolu."
  },
  {
    "word": "kala (ai-)",
    "class": "Substantivu",
    "meaning": "Ai-hun espésie ida neʼebé boot no soi tahan lotuk. Sin. ai-turi Naran-Botániku: Sesbania grandiflora"
  },
  {
    "word": "kalabousu",
    "class": "Substantivu",
    "meaning": "1. Kadeia iha rai okos 2. kadeia iha portu polísia nian ka iha kuartél. 3. (arti figuradu) Fatin bokon no nakukun."
  },
  {
    "word": "kalabu",
    "class": "Adjetivu",
    "meaning": "1. Neʼebé nia kór nakukun. 2. Ne'ebé tan nia matan aat uitoan haree salabu buat sira ne'ebé la besik. Sin. haree-badak, míope; Liafuan-so-run: hareedook, prezbita"
  },
  {
    "word": "kaladi",
    "class": "Substantivu",
    "meaning": "1. Tipu espésie ida. 2. Naran-ruak neʼebé haktemik ema zona loromonu nian, liuliu mambae-oan sira."
  },
  {
    "word": "kalakalan mós kalankalan",
    "class": "Substantivu",
    "meaning": "Kalan ida ba kalan seluk, kalan tuituir malu. Ez. Ami kalakalan la toba tanba na'ok-teen barak; Ami ronda kalan-kalan de'it."
  },
  {
    "word": "kalamidade",
    "class": "Substantivu",
    "meaning": "Eventu neʼebé kauza dezastre boot iha nasaun laran ka rejiaun ida nia laran, ba ema barabarak. Ez. Kalamidade hanesan rai-nakdoko halo ema barak mate."
  },
  {
    "word": "kalan",
    "class": "Substantivu",
    "meaning": "Tempu neʼebé loro tun tiha ona hodi halo nakukun; la iha naroman, haree rai la hetan."
  },
  {
    "word": "kalan-kalan",
    "class": "",
    "meaning": "haree kalakalan"
  },
  {
    "word": "kalatan",
    "class": "Adjetivu",
    "meaning": "Neʼebé nia pozisaun hanesan latan hela. Sin. orizontál; Li-afuan-sorun: vertikál, kriik"
  },
  {
    "word": "kalaun",
    "class": "Substantivu",
    "meaning": "Maneira koʼalia informál hodi uza liafuan baixu ka kómiku neʼebé ema sériu ka matenel baibain la uza. Sin. jíria"
  },
  {
    "word": "kaldeira",
    "class": "Substantivu",
    "meaning": "Xaleira boot."
  },
  {
    "word": "kaldeirada",
    "class": "Substantivu",
    "meaning": "Naan, liuliu naʼan-bibi, neʼebé te'in kahur ho fehuk, to-mate, senoura, liis no temperu oioin; presiza mós tuamanas atu hamorin."
  },
  {
    "word": "kaldu",
    "class": "Substantivu",
    "meaning": "Hahán been, liuliu ba ema-moras sira, neʼebé baibain halo hodi tau naʼanmanu iha bee hamutuk ho modo tahan, liis no temperu oioin, hafoin husik kleur iha ahi leten to'o do-dok. Sin. sopa"
  },
  {
    "word": "kaleen",
    "class": "Substantivu",
    "meaning": "1. Metál mihis neʼebé baibain uza atu rai ai-han iha laran selae atu halo uma. 2. Resipiente ka fatin ida halo hosi kaleen. Sin. lata"
  },
  {
    "word": "kalenan",
    "class": "Adjetivu",
    "meaning": "Neʼebé toba ho kotuk tun ba kama ka biti. 2. (arti figuradu) Neʼebé baruk-teen, isinmamar"
  },
  {
    "word": "kalesi (ai-)",
    "class": "Substantivu",
    "meaning": "Ai-horis atu hanesan aiamendueira neʼebé moris iha rain tropikál sira. Naran-Botániku: wordi-nalia calappa"
  },
  {
    "word": "kalesi-malae",
    "class": "Substantivu",
    "meaning": "Aiamendueira nia musan han-belek, neʼebé ema uza hodi halo dose no rebusadu oioin. Sin. améndua"
  },
  {
    "word": "kaligrafia",
    "class": "Substantivu",
    "meaning": "1. Arte konaba hakerek ho letra di'ak no furak. 2. Ema ida nia modun rasik hakerek ho liman. Sin. letra Ez. Susar lee diretór nia kaligrafia"
  },
  {
    "word": "kaliks",
    "class": "",
    "meaning": "Naran Vazu halo ho osan-mutin osan-mean ka riti, ho forma hanesan kopu boot ida ho ain, neʼebé amlulik uza hodi halulik tuauvas iha misa."
  },
  {
    "word": "kalili",
    "class": "",
    "meaning": "Naran Xapa ida neʼebé baibain sol-dadu kaer iha liman atu proteje nia hosi atake neʼebé uza kro'at."
  },
  {
    "word": "kalilin",
    "class": "Substantivu",
    "meaning": "Parte isin neʼebé iha liman-hun ka kabaas nia okos."
  },
  {
    "word": "kalimak",
    "class": "Substantivu",
    "meaning": "Ida hosi balun lima neʼebé hamutuk forma lolon ida de'it. Sin. kintu"
  },
  {
    "word": "kálise",
    "class": "Substantivu",
    "meaning": "1. Kopu ki’ik ho ain ka lahó ain neʼebé baibain ema uza atu tau tua hodi hemu. 2. = kaliks"
  },
  {
    "word": "kalkuladora",
    "class": "Substantivu",
    "meaning": "Mákina ba sura númeru neʼebé uza ba halo konta."
  },
  {
    "word": "kalkula",
    "class": "Verbu",
    "meaning": "1. Sura númeru. 2. Tetu hodi uza matemátika. Sin. bada, baberak"
  },
  {
    "word": "kálkulu",
    "class": "Substantivu",
    "meaning": "; Sin. badan"
  },
  {
    "word": "kalkulista",
    "class": "Adjetivu",
    "meaning": "Neʼebé buka oin no baibain iha motivu atu hetan kadi'ak ruma ba nia an."
  },
  {
    "word": "kalmante",
    "class": "Substantivu",
    "meaning": "Ai-moruk neʼebé halo hakmatek moras no halo matan dukur."
  },
  {
    "word": "kalma",
    "class": "Adjetivu/Substantivu",
    "meaning": "(Neʼebé) hak-matek, nonook no la book an."
  },
  {
    "word": "kalohan",
    "class": "Substantivu",
    "meaning": "Bee-suar kafu'ak boot ida hanesan abuabu merin loos neʼebé mutin ka malahok no namlele iha lalehan."
  },
  {
    "word": "kaloria",
    "class": "Substantivu",
    "meaning": "Unidade sasukat kona-ba enerjia neʼebé ai-han fó ba ema."
  },
  {
    "word": "kalsa",
    "class": "Substantivu",
    "meaning": "Hena pedasuk ida neʼebé taka isin hosi knotak ba kraik, hatama ain rua ba parte rua ketaketak."
  },
  {
    "word": "kalsaun",
    "class": "Substantivu",
    "meaning": "Kalsa ainbadak."
  },
  {
    "word": "kalsu",
    "class": "Substantivu",
    "meaning": "Buat ida neʼebé ita hatama ka sokar ba fatin kloot ida. Sin. ai-seti, aiselat"
  },
  {
    "word": "kalúnia",
    "class": "Substantivu",
    "meaning": "Lia-bosok neʼebé ema ida hato'o kona-ba ema seluk atubele hafo'er nia naran."
  },
  {
    "word": "kalu",
    "class": "Substantivu",
    "meaning": "Kulit neʼebé mahar tiha ona liuliu iha liman-fuan nia sorin. Sin. kulit-mahar Adjetivu Neʼebé nia kulit mahar tiha ona Ez. Kuda nia kotuk kalu ona, tula naha mós la kanek."
  },
  {
    "word": "kama",
    "class": "Substantivu",
    "meaning": "Fatin atu toba bá. Sin. toba-fatin"
  },
  {
    "word": "kamada",
    "class": "Substantivu",
    "meaning": "1. Balun ida neʼebé la-tan iha balun seluk nia leten. Sin. dalas"
  },
  {
    "word": "kama-huur",
    "class": "Substantivu",
    "meaning": "Kosok-oan nia toba-fatin. Sin. bersu"
  },
  {
    "word": "kámara",
    "class": "Substantivu",
    "meaning": "1. Uma boot governu nian ne'ebé hala'o knaar públiku oioin. ba ema sira 2. Uma boot Kreda Kató-lika nian ba padre sira atu deskansa bá ka hela bá, bele mós hodi serbisu bá. 3. (siénsia) Fatin taka neʼebé ár, naroman ka bee la bele tama bá. 4. Mákina foto-gráfika boot neʼebé uza atu halo filme."
  },
  {
    "word": "kamarada",
    "class": "Substantivu",
    "meaning": "Ema neʼebé ita-nia maluk iha funu ka luta polítika."
  },
  {
    "word": "kamarua mós kamrua",
    "class": "Substantivu",
    "meaning": "Feto ne'ebé sai namorada ba mane hodi hela hamutuk no nia maski la'ós nia feen loloos. Sin. fetokait, amante"
  },
  {
    "word": "kamat",
    "class": "Verbu",
    "meaning": "1. (Balada) ataka hodi koi ho limankukun. 2. (Ema) kaer ra’ut ho liman. Ez. Keta kamat hahán, suru ho kanuru. Kamat malu katak lamas malu ka baku malu ho liman."
  },
  {
    "word": "kambate mós kambatik, kainbatik",
    "class": "Substa-ntivu",
    "meaning": "Hatais hanesan lipa neʼebé baibain iha kór ka modelu oioin no feto sira mak hatais."
  },
  {
    "word": "Kamberra",
    "class": "Substantivu",
    "meaning": "Sidadekapitál rai-Austrália nian."
  },
  {
    "word": "kambista",
    "class": "Substantivu",
    "meaning": "Ema neʼebé halo ka troka osan. Ez. Kambista maka bele troka dolar hirak-nee ba rupia indonézia."
  },
  {
    "word": "kámbiu",
    "class": "Substantivu",
    "meaning": "Hahalok ka serbisu troka osan nasaun ida nian ba fali osan nasaun seluk ninian."
  },
  {
    "word": "Kamboja (rai-)",
    "class": "Substantivu",
    "meaning": "Rain no estadu iha Ázia Sudeste, halo parte rai-Indoxina."
  },
  {
    "word": "kambojanu - kambojana",
    "class": "f. Adjetivu",
    "meaning": "Rai-Kamboja nian. Substantivu 1. Ema Kamboja. 2. (lia-kambojanu) Dalen rai-Kamboja nian."
  },
  {
    "word": "kamedar",
    "class": "Substantivu",
    "meaning": "Sulfatu kaduak hosi alumíniu no potásiu. Sin. alumen Ez. Ema baibain tau kamedar ba kanek ki'ik atu hapara raan suli."
  },
  {
    "word": "kameli (ai-)",
    "class": "Substantivu",
    "meaning": "Ai-hun espésie ida neʼebe nia ai morin tebetebes no folin boot. Ai-hun furak ne'e uluk moris barak iha distritu Same, Lospalos, Suai no Bobonaru. Sin. ai-morin Naran-Botániku: Santalum"
  },
  {
    "word": "kamelu (kuda-)",
    "class": "Substantivu",
    "meaning": "Balada maksusuk boot ida ho fulun mahar neʼebé bele tahan atu laʼo iha rai-fuik maran la hemu bee ba tempu naruk."
  },
  {
    "word": "kamerik",
    "class": "Substantivu",
    "meaning": "Ema ka buat ida nia karakterístika aat ida. Sin. defeitu"
  },
  {
    "word": "kamerik-laek",
    "class": "Adjetivu",
    "meaning": "Neʼebé la iha defeitu fíziku ka morál. Sin. perfeitu"
  },
  {
    "word": "kamiaun",
    "class": "Substantivu",
    "meaning": "Kamioneta boot."
  },
  {
    "word": "kamii (ai-)",
    "class": "Substantivu",
    "meaning": "Ai-hun espésie ida neʼebé soi kulit toos no fó fuan ida neʼebé fó mina ba halo lilin no tinta. Sin. badut; Naran-Botániku: Aleurites moluccana"
  },
  {
    "word": "kamillaun",
    "class": "Substantivu",
    "meaning": "Ida hosi balun mil-laun ida neʼebé hamutuk forma lolon ida de'it. Sin. milionézimu"
  },
  {
    "word": "kamiñudeferru",
    "class": "Substantivu",
    "meaning": "Dalan neʼebé halo hosi besi atu komboiu ka karreta-elétriku bele halai iha leten hosi fatin ida ba fatin seluk. Sin. dalanbesi"
  },
  {
    "word": "kamioneta",
    "class": "Substantivu",
    "meaning": "Karreta boot ba lori ka tula naha todan."
  },
  {
    "word": "kamiza",
    "class": "Substantivu",
    "meaning": "1. Hatais neʼebé ema tau iha isin-lolon nia balun leten. Sin. faru 2. Hena ne'ebé iha vidru- petro-máks nia laran neʼebé bainhira sunu, bele fó naroman."
  },
  {
    "word": "kamiziña",
    "class": "Substantivu",
    "meaning": "1. Faru ki'ik neʼebé baibain bebé sira hatais. 2. Faru ki'ik feto siranian ne'ebé bele hatais iha laran."
  },
  {
    "word": "kamizola",
    "class": "Substantivu",
    "meaning": "Kamiza ida neʼebé la iha botaun no ita hatais hodi halo ulun liu hosi kuak iha leten."
  },
  {
    "word": "kamomila (ai-)",
    "class": "Substantivu",
    "meaning": "Ai-horis ida neʼebé nia funan morin serve ba halo xáhoman ne'ebé tulun dijestaun no halo matan dukur."
  },
  {
    "word": "kamoos",
    "class": "Adjetivu",
    "meaning": "Neʼebé moos tomak hotu, la iha fo'er ida. Sin. puru"
  },
  {
    "word": "kamosuk",
    "class": "Substantivu",
    "meaning": "Ida neʼebé mosu iha ita-nia oin, forma sensivel; buat ka ema nia aspetu li'ur nian. Sin. aparénsia Ez. Maski Mateus nia kamosuk kalma, nia afinál ema nervozu- aat."
  },
  {
    "word": "kampaíña",
    "class": "Substantivu",
    "meaning": "1. Sinu ki’ik neʼebé ema tau iha ka besik odamatan uma nian atu bainaka sira bele toka envezde dere odamatan. 2. Sinu ki'ik neʼebé baibain uza iha semináriu, konventu ka dormitóriu atu toka hodi bolu ba reza, han, toba, hadeer bainhira oras to'o. Sin. sinu-oan"
  },
  {
    "word": "kampaña",
    "class": "Substantivu",
    "meaning": "Atividade oioin ne'ebé ema hala'o hamutuk atu to'o ba objetivu ida ka hetan buat ida ne'ebé ita kaan, liuliu iha kontestu polítiku. Ez. Partidu sira prepara ona kampaña eleitorál foun."
  },
  {
    "word": "kampaña mós kainpaña",
    "class": "Substantivu",
    "meaning": "Hatais hanesan lipa neʼebé feto sira mak hatais."
  },
  {
    "word": "kampara",
    "class": "Substantivu",
    "meaning": "Sandáliasneʼebéniahun halo hosi ai."
  },
  {
    "word": "kampiaun",
    "class": "Substantivu",
    "meaning": "Atleta ne'ebé manán halai-taru ida."
  },
  {
    "word": "kampionatu",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "kampu",
    "class": "Substantivu",
    "meaning": "1. Rai luan no mamuk ida. Sin. raiklees 2 Fatin neʼebé ema uza atu hala'o jogu ruma hanesan futeból, basketból, nst. 3. Fatin iha li'ur sidade ka vila; zona rurál. Sin. foho Ez. Ami sei bá kampu atu halo entrevista ho povu balu. 4. Fatin ne'ebé iha mina-matan. Ez. Iha kampu mina-rai barak iha Irake."
  },
  {
    "word": "kamria (ai-)",
    "class": "Substantivu",
    "meaning": "Ai-hun espésie ida neʼebé fó akar. Sin. rumbia"
  },
  {
    "word": "kamuda",
    "class": "Substantivu",
    "meaning": "Manduku nia oan neʼebé sei ki'ik no metan, ho ikun naruk."
  },
  {
    "word": "kamudi",
    "class": "Substantivu",
    "meaning": "Ai-kabelak ka besi-ka-belak ka roda iha ró-ikun nia okos neʼebé ema dulas ka fila atu hala'o ró tuir ninia dalan."
  },
  {
    "word": "kamuflajen",
    "class": "Substantivu",
    "meaning": "(Soldadu) hasubar an hodi hatais kór hanesan ho nia sori-sorin. Ez. Militar sira halo kamuflajen hodi pinta oin halo metan, taka sira-nia akampamentu ho ai-tahan matak atu funu-balun sira la bele haree-hetan ka haree sala."
  },
  {
    "word": "kamurak",
    "class": "Adjetivu",
    "meaning": "Neʼebéihamurak, hanesan murak ka halo hosi murak. Sin. metáliku"
  },
  {
    "word": "kamutis",
    "class": "Adjetivu",
    "meaning": "1. Neʼebé kór ladún iha. 2. Ne'ebé nia kór hanesan mutin ka malahuk."
  },
  {
    "word": "kana",
    "class": "Verbu",
    "meaning": "Foti ain hodi tula iha fatin se-luk. Sin. hakat"
  },
  {
    "word": "kanaban",
    "class": "",
    "meaning": "haree knaban"
  },
  {
    "word": "Kanadá (rai-)",
    "class": "Substantivu",
    "meaning": "Rain no estadu boot ida iha Amérika norte."
  },
  {
    "word": "kanadianu - kanadiana",
    "class": "f. Adjetivu",
    "meaning": "Rai-Kanadá nian. Substantivu Ema Kanadá. Ez.Kanadianu sira koʼalia inglés ka fransés."
  },
  {
    "word": "kanahek",
    "class": "Substantivu",
    "meaning": "Rai nia luan ne'ebé ita hateke bá ka sukat. Sin. área"
  },
  {
    "word": "kanál",
    "class": "Substantivu",
    "meaning": "1. Fatin hosi neʼebé bee liu. Sin. bee-dalan 3. Dalan iha isin ka mákina nia laran neʼebé hasuli been ruma (n.e. raan ka matan-been) hosi fatin ida ba fatin seluk. Sin. kaseik 4. Dalan ba informasaun."
  },
  {
    "word": "kanaliza",
    "class": "Verbu",
    "meaning": "Haruka ka halo laʼo tuir dalan ida ka liuhosi kanu ida. Sin. hadalan"
  },
  {
    "word": "kanalizadór",
    "class": "Substantivu",
    "meaning": "Badain beekanu halo serbisu dada bee nian."
  },
  {
    "word": "kanalizasaun",
    "class": "Substantivu",
    "meaning": "1.Hahalokhadalan nian. Sin. hadalan 2. Sistema bee-kanu nian iha uma laran. 3. Badain bee-kanu nia ofísiu ka knaar."
  },
  {
    "word": "káñamu",
    "class": "Substantivu",
    "meaning": "Ai-horis espésie ida neʼebé nia fibra neʼebé ema hasai hosi ai-sanak ka lolon serve atu halo tali, su-rat-tahan ka droga. Naran-Botániku: Cannabis sativa"
  },
  {
    "word": "kanapé",
    "class": "Substantivu",
    "meaning": "Tuur-fatin neʼebé ita baibain hetan iha saladevizita neʼebé naruk no mamar, taka ho hena ka kulit. Sin. sofá"
  },
  {
    "word": "Kanárias (rai-, Nusar-)",
    "class": "Substantivu",
    "meaning": "Nusa-lubun ida besik raat loromonu rai-Áfrika nian neʼebé rai-España mak ukun."
  },
  {
    "word": "kanarinu - kanarina",
    "class": "f. Adjetivul Substantivu",
    "meaning": ""
  },
  {
    "word": "kanáriu (manu-)",
    "class": "Substantivu",
    "meaning": "Manu oin ida ho kór-kinur ka modok, no lian furak loos atu rona."
  },
  {
    "word": "kañaun",
    "class": "Substantivu",
    "meaning": "Kilat boot ida, bainhira tuur iha roda rua leten, neʼebé uza iha funu hodi tiru musan besi ho forma bola boot nian. Sin. pesa"
  },
  {
    "word": "kandelabru",
    "class": "Substantivu",
    "meaning": "Kandieiru boot neʼebé tabele iha kakuluk-laran, halo ho sanak no ahi-lakan fatin barabarak."
  },
  {
    "word": "Kandelária",
    "class": "Substantivu",
    "meaning": "Festa ne'ebé sarani sira selebra iha loron 2 Fevereiru hodi hanoin fali Ita Na'i-Feto Maria Santísima tama ba templu liutiha tuur ahi hodi hato'o Meninu Jezús ba amlulik sira."
  },
  {
    "word": "kandidata an",
    "class": "Verbu",
    "meaning": "Hato'o an nu'udar kandidatu. Ez. Sr. Francisco Xavier do Amaral kandidata nia an ba prezidente ba tinan 2001."
  },
  {
    "word": "kandidatura",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "kandidatu - kandidata",
    "class": "f. Substantivu",
    "meaning": "Ema neʼebé hatudu, liuhosi dalan formál (rekerimentu ka ezame), nia vontade atu sai membru ba klibur ruma selae atu hetan diploma ruma."
  },
  {
    "word": "kandieiru",
    "class": "Substantivu",
    "meaning": "Lampu oin ida neʼebé ita sunu ho mina-rai."
  },
  {
    "word": "kanedok mós knedok",
    "class": "Substantivu",
    "meaning": "Kanuru boot ida neʼebé serve atu prepara hahán ka suru sasorok ka sopa."
  },
  {
    "word": "kaneen",
    "class": "Substantivu",
    "meaning": "Ida hosi balun neen neʼebé hamutuk forma lolon ida de'it. Sin. sestu"
  },
  {
    "word": "kanek",
    "class": "Substantivu",
    "meaning": "Isin neʼebé kilat ka buat meik no kro'at ruma mak sona ka koʼa. Halo moras no bele hetan infesaun. Verbu Hetan kanek."
  },
  {
    "word": "kanek-fatin",
    "class": "Substantivu",
    "meaning": "Tadak ka marka neʼebé hela iha isin bainhira buat ruma ko'a ka sona tiha. Sin. fitar"
  },
  {
    "word": "kaneka",
    "class": "Substantivu",
    "meaning": "Hemu-fatin boot ui-toan, ho tilun."
  },
  {
    "word": "kanek-folok",
    "class": "Substantivu",
    "meaning": "Kanek dodok no dois ona. Sin. gangrena"
  },
  {
    "word": "kanela (ai-)",
    "class": "Substantivu",
    "meaning": "Ai-hun ida neʼebé nia kulit fó tempra morin ida. Naran Botániku: Cinnamomum"
  },
  {
    "word": "kaneta",
    "class": "Substantivu",
    "meaning": "Kain besi ka plástiku ida neʼebé ema uza atu hakerek. Kaneta tradisionál sira iha kanu ki'ik ida ba hatama tinta no tutun meik."
  },
  {
    "word": "kanetik",
    "class": "Substantivu",
    "meaning": "Buat ida neʼebé hanetik ita atu laʼo ba oin. Sin. buatnetik, ob-stákulu"
  },
  {
    "word": "kánfora",
    "class": "Substantivu",
    "meaning": "Ai-moruk ho forma substánsia mutin kristál toos no morin nian, neʼebé ema baibain tau ba roupa sira atu hadook katuma."
  },
  {
    "word": "kangurú",
    "class": "Substantivu",
    "meaning": "Balada marsupiál rai-Austrália nian, hanesan rusa, ho ain kotuk rua boot neʼebé nia uza hodi hasoit."
  },
  {
    "word": "kanibál",
    "class": "Substantivu",
    "meaning": "Ema fuik horiuluk nian neʼebé han ema seluk nia naʼan (kriminozu ka funu-balun ne'ebé oho tiha) nu'udar lisan. Sin. duruhui, an-tropófagu"
  },
  {
    "word": "kanibalizmu",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "kanipa",
    "class": "Substantivu",
    "meaning": "Tua folinbaratu neʼebé baibain ema halo hodi kahur tua-manas, bee no bani-been."
  },
  {
    "word": "kanivete",
    "class": "Substantivu",
    "meaning": "Tudik-oan neʼebé nia tahan bele silu halo badak no ema bele lori iha bolsu."
  },
  {
    "word": "kankru",
    "class": "Substantivu",
    "meaning": "Moras todan kona-ba sélula sira iha isin laran hamosu bubun barak ne'ebé naburas no naklekar bá-mai. Sin. baboraskle'an"
  },
  {
    "word": "kankun",
    "class": "Substantivu",
    "meaning": "Modo matak ne'ebé moris iha beelaran, hanesan espinafre. Naran-Botániku: Ipomoea reptans"
  },
  {
    "word": "kanoniza",
    "class": "Verbu",
    "meaning": "(Kreda) foti ema beatu ka beata ida ba santu ka santa, hodi hatama nia naran ba kalendáriu litúrjiku."
  },
  {
    "word": "kanonizadu - kanonizada",
    "class": "f. Adjetivu",
    "meaning": ""
  },
  {
    "word": "kanonizasaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "kanosianu - kanosiana",
    "class": "f. Substantivu",
    "meaning": "(kanosiana) Madre ida neʼebé membru ba kongregasaun nidaneʼebé Maddalena di Canossa (1774-1835) mak harii iha rai-Itália no haruka misionária ba rain barak, inklui Timór. Adjetivu Kona-ba kongregasaun Maddalena di Canossa nian."
  },
  {
    "word": "kansela",
    "class": "Verbu",
    "meaning": "Kasu ka halakon, liuliu iha kontestu administrasaun nian."
  },
  {
    "word": "kanselamentu",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "Kanser",
    "class": "Substantivu",
    "meaning": "Konstelasaun ka fitun-lubun zodiáku nian, ne'ebé ema repre-zenta ho ilas kadiuk nian. Sin. Kadiuk Trópiku Kanser Nian, liña haree-labe-lek hale'u planeta Rai ne'ebé haketak zona temperada norte nian hosi zona tropikál. Liafuan-sorun: Trópiku Ka-prikórniu Nian"
  },
  {
    "word": "kanserozu - kanseroza",
    "class": "f. Substantivu",
    "meaning": "Ema moras kankru."
  },
  {
    "word": "kanta",
    "class": "Verbu",
    "meaning": "Hamosu múzika ho lian, hodi halo liafuan sira kona loos ho melodia. Sin. hananu Ez. Loron-domingu koru kanta ho lian kapás loos iha uma-kreda."
  },
  {
    "word": "kantadór",
    "class": "Substantivu",
    "meaning": "Ema neʼebé kanta. Sin. mananuk, kantór"
  },
  {
    "word": "kantarola",
    "class": "Verbul Substantivu",
    "meaning": "Hananu iha ibun laran de'it."
  },
  {
    "word": "Kantaun",
    "class": "Substantivu",
    "meaning": "Sidade no provínsia iha ra-Xina súl."
  },
  {
    "word": "kantiga",
    "class": "Substantivu",
    "meaning": "Poezia ne'ebé nakfahe ba estrofe badak neʼebé ema bele kanta. Sin. knananuk"
  },
  {
    "word": "kántiku",
    "class": "Substantivu",
    "meaning": "Knananuk neʼebé ema sira kanta hodi hahi'i Maromak ka santu sira, liuliu iha uma-kreda."
  },
  {
    "word": "kantonés - kantoneza",
    "class": "f. Adjetivu",
    "meaning": "Rai-Kantaun nian. Substantivu 1. Ema Kantaun. 2. (lia-kantonés) Dialetu xinés rai-Kantaun nian, ne'ebé koalia iha zona tomak hale'u, inklui mós rai-Makau."
  },
  {
    "word": "kantór - kantora",
    "class": "f. Substantivu",
    "meaning": "Ema ne'ebé hananu ka kanta. Sin. kantadór, mananuk"
  },
  {
    "word": "kantu",
    "class": "Substantivu",
    "meaning": "1. Parte entre didin rua neʼebé tutan no hasoru malu. Sin. lidun 2. (desportu) Parte rohan liu hosi baliza nia sorin karuk ka loos."
  },
  {
    "word": "kantu",
    "class": "Substantivu",
    "meaning": "1. Hahalok kanta ka hananu nian. Sin. hananun 2. Knan-anuk, kantiga ka kántiku."
  },
  {
    "word": "kanu",
    "class": "Substantivu",
    "meaning": "1. Tubu baesi ka pleastiku neʼebé dada bee no husik bee halai tuir. 2. Bee-dalan be ema ke'e iha natar sira hodi hatama bee ba natar."
  },
  {
    "word": "kanuru",
    "class": "Substantivu",
    "meaning": "Objetu ida neʼebé ema uza atu suru, kedok, serve ka han ai-han."
  },
  {
    "word": "kaos",
    "class": "Substantivu",
    "meaning": "Runguranga neʼebé mosu iha fatin ida; situasaun ordenlaek neʼebé hamosu sabraut. Ez. Mosu kaos iha si-dade laran bainhira bomba ida rebenta iha palásiu nia oin."
  },
  {
    "word": "kaótiku - kaótika",
    "class": "f. Adjetivu",
    "meaning": ""
  },
  {
    "word": "kapa",
    "class": "Substantivu",
    "meaning": "1. Roupa liʼur naruk no luan neʼebé taka isin tomak hodi satan udan, anin ka malirin. 2. Papelaun ka surattahan mahar neʼebé baibain taka parte oin no kotuk livru ida nian. Sin. (livru-) fafalun"
  },
  {
    "word": "kapa",
    "class": "Substantivu",
    "meaning": "Letra K nia naran. Sin. ká"
  },
  {
    "word": "kapa",
    "class": "Verbu",
    "meaning": "Hasai tiha baladaaman nia organ-reprodusaun atu labele fó oan. Sin. nali"
  },
  {
    "word": "kapan",
    "class": "Adjetivu",
    "meaning": "Neʼebé la bele fó oan tanba ema hasai tiha ona ninia organreprodu-saun. Sin. nalin"
  },
  {
    "word": "kapan",
    "class": "Substantivu",
    "meaning": "Hena neʼebé ita uza atu taka xumasu. Sin. kluniknuan, froñas"
  },
  {
    "word": "kapás",
    "class": "Adjetivu",
    "meaning": "Neʼebé furak ka di’ak tebe-tebes no kona loos ema nia laran. Sin. kmanek"
  },
  {
    "word": "kapasete",
    "class": "Substantivu",
    "meaning": "Objetu kabuar hane-san xapeu maibé mahar no todan ne'ebé taka ulun-fatuk tomak no baibain ema uza atu taka ulun hodi hasatan ulun hosi kanek todan bainhira hetan dezastre. Ez. Kapasete funu nian taka soldadu nia ulun ba satan kilat-musan bainhira funu-balun tiru hasoru."
  },
  {
    "word": "kapasidade",
    "class": "Substantivu",
    "meaning": "1. Kondisaun bele halo buat ruma. Sin. babelek 2. Jeitu atu halo buat ruma."
  },
  {
    "word": "kapasita",
    "class": "Verbu",
    "meaning": "Prepara ka tulun atubele halo buat ruma. Sin. habele"
  },
  {
    "word": "kapasitadu - kapasitada",
    "class": "f. Adjetivu",
    "meaning": ""
  },
  {
    "word": "kapasitasaun",
    "class": "Substantivu",
    "meaning": "; Sin. habelen"
  },
  {
    "word": "kapatás",
    "class": "Substantivu",
    "meaning": "Ema neʼebé haree ka tau matan ba ema serbisu-na'in sira bainhira serbisu hela, liuliu iha to'os ka fatinkonstrusaun ruma. Sin. makaer"
  },
  {
    "word": "kapela",
    "class": "Substantivu",
    "meaning": "Uma-kreda ki’ik."
  },
  {
    "word": "kapelania",
    "class": "Substantivu",
    "meaning": "Kapelaun nia kargu."
  },
  {
    "word": "kapelaun",
    "class": "Substantivu",
    "meaning": "Amlulik neʼebé nia knaar baibain nian tulun ka serbí ema grupu partikulár ida. Ez. Padre Mateus kapelaun iha ospitál boot ida iha rai-Portugál."
  },
  {
    "word": "kapeliña",
    "class": "Substantivu",
    "meaning": "Kapela ki’okoan."
  },
  {
    "word": "kapitál",
    "class": "Adjetivu",
    "meaning": "1. Sidade ida neʼebé sentru governu nian iha rain ida, ho prezi-dente, ministru sira no sira-nia pesoál serbisu bá. 2. Fundus neʼebé ema presiza ba knaar ka projetu ruma. Sin.osan-hun, osan-inan kapitalista, Substantivu, Ad-jetivu"
  },
  {
    "word": "kapitalizmu",
    "class": "Substantivu",
    "meaning": "1. Sistema ka rejime ekonómiku no sosiál iha neʼebé meiupro-dusaun sira ema privadu, la'ós governu, mak kontrola, hodi soi mós liberdade atu tau folin sira tuir sira-nia hakarak. 2. Governu ida neʼebé haraik liberdade ba kontratu-na'in sira atu sai riku hodi dezenvolve ekonomia nasionál no mós simu sira-nia influénsia iha kontestu polítiku. kapitalista Substantivu, Adjetivu"
  },
  {
    "word": "kapitaun",
    "class": "Substantivu",
    "meaning": "1. Xefe militár neʼebé komanda kombatelubun ka kompañia ida 2. Postu ierarkia militár nian ne'ebé entre tanente no majór. 3. Ema neʼebé kaer ró ka aviaun, mariñeiru ka pilotu sira-nia ulunboot."
  },
  {
    "word": "kapítulu",
    "class": "Substantivu",
    "meaning": "1. Parte boot ida-idak neʼebé nakfahe iha livru ida hodi trata lia ketaketak maibé kona malu. Ez. Biblia Sagrada iha kapítulu barabarak. 2. Monje, padre ka madre sira-nia lalibur hodi tetu hamutuk lia oioin."
  },
  {
    "word": "kapó",
    "class": "Substantivu",
    "meaning": "Karreta nia kakuluk."
  },
  {
    "word": "kapó-oin",
    "class": "Substantivu",
    "meaning": "Motór-karreta nia matan."
  },
  {
    "word": "kapote",
    "class": "Substantivu",
    "meaning": "Hena mahar no boot taka isin nian bainhira rai-malirin, liuliu iha tempu raikalan. Sin. kobertór"
  },
  {
    "word": "kaprixu",
    "class": "Substantivu",
    "meaning": "Hahalok beik, egoísta no naran de'it. Sin. dadekur"
  },
  {
    "word": "kaprixozu - kaprixoza",
    "class": "f. Adjetivu",
    "meaning": "; Sin. dekur"
  },
  {
    "word": "kápsula",
    "class": "Substantivu",
    "meaning": "1. Fafalun metál ho forma silíndrika neʼebé hamahan buat idane'ebé ita tau ba laran. 2. Fafalun ki'ikoan halo hosi jelatina ne'ebé ai-moruk rahun iha bá atu ema bele hemu. Ez. Ai-moruk nee Ita tenke hemu káp-sula rua loroloron."
  },
  {
    "word": "kapta",
    "class": "Verbu",
    "meaning": "Simu laloran ka sinál eletróniku neʼebé emisora rádiu ka televizaun nian mak halekar."
  },
  {
    "word": "kaptasaun",
    "class": "Substantivu",
    "meaning": ""
  },
  {
    "word": "kaputxinu",
    "class": "Substantivu",
    "meaning": "Kafé oin ida ho susubeen-furin iha leten."
  },
  {
    "word": "kapuxu",
    "class": "Substantivu",
    "meaning": "Xapeu neʼebé taka ulun to'o knoruk ka kabaas bainhira rai ma-lirin makaʼas."
  },
  {
    "word": "karabina",
    "class": "Substantivu",
    "meaning": "Kilat-ahi hanesan ho kilat, maibé ki'ik."
  },
  {
    "word": "karaíba",
    "class": "Adjetivu",
    "meaning": "Tasi-Antillas ka Nusar-Antillas nian. Substantivu Ema mahorik ka rai-na'in Nusar- Antillas nian, membru ba rasa índia."
  },
  {
    "word": "karak",
    "class": "Verbu",
    "meaning": "Hakarak tebes buat neʼebé ita iha to'o susar atu fó ka fahe ba ema seluk."
  },
  {
    "word": "karakól",
    "class": "Substantivu",
    "meaning": "Animál molusku ne'ebé nia isin moris iha knuuk laran ida, dolar iha rai ka belit iha fatuk sira; barakliu moris iha rai malirin sira ka rai ne'ebé iha bee. Sin. kudaku"
  },
  {
    "word": "karak-teen",
    "class": "Adjetivu",
    "meaning": "Neʼebé susar atu fó sai nia sasán ka rikusoin ba ema seluk; neʼebé hakarak simu de'it maibé lakohi fó. Sin. teen-toos"
  },
  {
    "word": "karakter",
    "class": "Substantivu",
    "meaning": "Ema ka balada ida nia natureza ka personalidade rasik, ida neʼebé habook ka motiva nia hahalok sira. Ez. Ema neʼebé hakilar tun-sa'e bainhira hetan buat ruma ne'ebé nia la gosta hatudu nia karakter hanesan ema nervozu aat."
  },
  {
    "word": "karakterístika",
    "class": "Substantivu",
    "meaning": "Elementu ida de'it neʼebé halo diferensa entre ema, animál ka sasán ho sira seluk. Sin. fei-saun, feitiu"
  },
  {
    "word": "karamelu",
    "class": "Substantivu",
    "meaning": "Rebusadu ka dose ida neʼebé halo hodi teʼin masin-midar to'o nabeen."
  },
  {
    "word": "karan",
    "class": "Substantivu",
    "meaning": "1. Hahalok hakarak nian. Sin. hakaran, dezeju 2. Buat ida neʼebé ita fó saugati ba ema seluk atu halo nia haksolok. Sin. buatkaran, prezente"
  },
  {
    "word": "karas",
    "class": "Substantivu",
    "meaning": "1. Parte oin hosi ita-nia isin-lolon entre kabaas ho kabun. Sin. hirusmatan 2. Sasukat hosi ita-nia liman-fuannia rohanto'o hirus-matannia klaran."
  },
  {
    "word": "karat",
    "class": "Substantivu",
    "meaning": "Kabeen iha inus-kuak no aten-book laran ne'ebé tasak, mahar no kantál ona. Sin. me’ar-tasak, fleuma"
  },
  {
    "word": "karaté",
    "class": "Substantivu",
    "meaning": "Desportu japonés ida kona-ba defende an, hanesan hafetu."
  },
  {
    "word": "karau",
    "class": "Substantivu",
    "meaning": "Balada maksusuk ain-haat ho dikur neʼebé gosta toba iha bee ka taho; baibain agrikultór timoroan sira uza atu halai natar. Naran Zooló-jiku: Bubalus bubalis"
  },
  {
    "word": "karau-baka",
    "class": "Substantivu",
    "meaning": "Karau neʼebé nia isin ladún toos hanesan karautimur. Sin. karau-malae; Naran Zoolójiku: Bos taurus"
  },
  {
    "word": "karau-inan",
    "class": "Substantivu",
    "meaning": "Karau neʼebéhahoris no fó-susu oan."
  },
  {
    "word": "karauk",
    "class": "Adjetivu",
    "meaning": "Karau nian. Sin. bovinu"
  },
  {
    "word": "karau-kulit",
    "class": "Substantivu",
    "meaning": "Kulit karau nian neʼebé ita kurte atu hafila ba materiál ida hodi halo sapatu, futu-kabun, karteira nst. Sin. koiru"
  },
  {
    "word": "karau-malae",
    "class": "",
    "meaning": "haree karau-baka"
  },
  {
    "word": "karau-oan",
    "class": "Substantivu",
    "meaning": "Karau neʼebé sei ki'ik no sei susu inan nia susubeen."
  },
  {
    "word": "karau-timur",
    "class": "Substantivu",
    "meaning": "Karau raina'in Timór nian neʼebé kór-metan no baibain ema uza atu halai natar."
  },
  {
    "word": "karbúnkulu",
    "class": "Substantivu",
    "meaning": "Fisur neʼebé mosu iha ema nia kakorok ka oin. Sin. baboras, baborasdoku"
  },
  {
    "word": "karburadór",
    "class": "Substantivu",
    "meaning": "Aparellu ida ida karreta laran neʼebé kahur karburante-musan ho ár hodi hamoris motór no halo motór la'o."
  },
  {
    "word": "karburante",
    "class": "Substantivu",
    "meaning": "Kombustivel ka mina ida neʼebé rebenta ho tarutu atubele halo motór la'o."
  },
  {
    "word": "kardeál",
    "class": "Substantivu",
    "meaning": "Ambispu ho títulu aas kleru katóliku nian neʼebé Amu-Papa hili atubele fó konsellu ba nia no tulun nia ukun Kreda."
  },
  {
    "word": "kardíaku - kardíaka",
    "class": "f. Adjetivu",
    "meaning": "Organ fuan nian. Ez. Ema sira neebé sofre moras kardíaku labele han bokur barak."
  },
  {
    "word": "kardinál",
    "class": "Adjetivu",
    "meaning": "1. Neʼebé iha importánsia boot. Sin. kapitál, mahuluk 2. (Númeru) neʼebé hatudu hahirak ka kuantidade la tuir orden, nu'udar ezemplu 6, 34, 256 nst. Liafuan-sorun: ordinál"
  },
  {
    "word": "karea",
    "class": "Substantivu",
    "meaning": "Kutun ka insetu ida hane-san nehek neʼebé kórmutin no han ai-halo fuhuk. Sin. mirain"
  },
  {
    "word": "kareka",
    "class": "Adjetivu",
    "meaning": "Neʼebé nia ulun la iha fuuk moris bá. Sin. ulun-molik, temek"
  },
  {
    "word": "karga",
    "class": "Substantivu",
    "meaning": "1. Naha neʼebé ró-ahi ida tula. Sin. ró-nahan 2. Kbiit elétriku neʼebé lolon ida rai iha nia laran. 3. Raratan ka atake neʼebé tropa sira halo ho beran boot."
  },
  {
    "word": "kargu",
    "class": "Substantivu",
    "meaning": "Ema ida nia tatuur, pozi-saun ka responsabilidade rasik iha ser-bisu-fatin. Ez. Prezidente atu hasai ema ne'e hosi kargu ministru nian."
  },
  {
    "word": "kari",
    "class": "Verbu",
    "meaning": "1. Soe bá-mai iha fatin ida, po-rezemplu kari hare-musan iha natar. Sin. lekar 2. Halekar hanoin ida ba ema seluseluk."
  },
  {
    "word": "karidade",
    "class": "Substantivu",
    "meaning": "1. Hakaran atu tulun no fó di'ak ba ema seluk, liuliu ema kiak ka sira ne'ebé terus. 2. Hanoin pozitivu kona-ba ema seluk maski bele iha mo-tivu ba kritika nia. 3. Klibur ka organi-zasaun ida ne'ebé tulun ema kiak sira."
  },
  {
    "word": "karitativu - karitativa",
    "class": "f. Adjetivu",
    "meaning": ""
  },
  {
    "word": "karihun",
    "class": "Substantivu",
    "meaning": "Ida hosi balun rihun ida neʼebé hamutuk forma lolon ida de'it. Sin. milézimu"
  },
  {
    "word": "karik",
    "class": "Advérbiu",
    "meaning": "Bele mosu. Sin. dala ruma, kala Ez. Karik ha'u sei liu hosi nia uma molok bá serbisu. Bainhira ita tau lia-fuan nee iha orasaun nia kotuk liu, nia arti hanesan Konjunsaun se: n.e. Ez. Ó hakarak karik, ha'u konvida mós nia (= Se ó hakarak, ha'u konvida mós nia)."
  },
  {
    "word": "karikatura",
    "class": "Substantivu",
    "meaning": "Dezeñu ka hakerek kómiku ida neʼebé halo pouku ema ka buat ruma ho ezajera nia karakterístika sira, n.e. halo aat ema nia oin, fó fuuk nakrakat, roupa naklees, oioin de'it."
  },
  {
    "word": "karíl",
    "class": "Substantivu",
    "meaning": "Hahán oin ida hanesan mollu neʼebé halo hosi ikan ka naan-manu, teʼin hamutuk ho nuu-been no temperu manas oioin hanesan ai-manas boot, kinur, nst."
  },
  {
    "word": "karimba",
    "class": "Verbu",
    "meaning": "Tau karimbu."
  },
  {
    "word": "karimbu",
    "class": "Substantivu",
    "meaning": "Borraxatahan ida neʼebé ko'a halo kabuar ka kuadradu ho letra oioin tuir instituisaun ruma nia logo-tipu neʼebé hatama ba tinta hodi hanehan ba surattahan atu marka dokumentu ida ho ofisiál. Ez. Asina hotu tau ka hanehan karimbu bá."
  },
  {
    "word": "kariñu",
    "class": "Substantivu",
    "meaning": "Sentimentu ka hahalok domin nian, liuliu ba ema seluk ne'ebé ita gosta. Sin. laran-maluk, afeisaun Ez. Maski presiza trata labarik sira ho kariñu, hanorin dixiplina mós importante tebe-tebes."
  },
  {
    "word": "kariñozu - kariñoza",
    "class": "f. Adjetivu",
    "meaning": ""
  },
  {
    "word": "karioka",
    "class": "Adjetivu",
    "meaning": "Hosi Riudejaneiru, kona-ba Riudejaneiru (sidade boot iha rai-Brazíl). Substantivu Ema Riudejaneiru."
  },
  {
    "word": "karitativu - karitativa",
    "class": "f. Adjetivu",
    "meaning": "Neʼebé hatudu kaidade ka halo karidade ba ema seluk."
  },
  {
    "word": "karizma",
    "class": "Substantivu",
